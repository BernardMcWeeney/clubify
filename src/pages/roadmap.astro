---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';

const roadmapItems = [
  {
    quarter: "Q1 2026",
    status: "completed",
    features: [
      { name: "Custom website templates", description: "Choose from 3 professional templates", done: true },
      { name: "Fixture management", description: "Track matches, results, and standings", done: true },
      { name: "News & posts", description: "Rich text editor with image uploads", done: true },
      { name: "Team management", description: "Invite members with role-based access", done: true },
      { name: "Social media publishing", description: "Auto-publish to Facebook and Twitter", done: true }
    ]
  },
  {
    quarter: "Q2 2026",
    status: "in_progress",
    features: [
      { name: "Mobile app", description: "Native iOS and Android apps for members", done: false },
      { name: "Push notifications", description: "Match reminders and news alerts", done: false },
      { name: "Member directory", description: "Private directory for club members", done: false },
      { name: "Event management", description: "Create and manage club events", done: false }
    ]
  },
  {
    quarter: "Q3 2026",
    status: "planned",
    features: [
      { name: "Online payments", description: "Collect membership fees and event tickets", done: false },
      { name: "Merchandise store", description: "Sell club gear and merchandise online", done: false },
      { name: "Sponsor management", description: "Enhanced sponsor showcase with analytics", done: false },
      { name: "Custom domains", description: "Connect your own domain (e.g. www.yourclub.ie)", done: false }
    ]
  },
  {
    quarter: "Q4 2026",
    status: "planned",
    features: [
      { name: "Advanced analytics", description: "Website traffic and engagement insights", done: false },
      { name: "Email newsletters", description: "Send newsletters directly from Clubify", done: false },
      { name: "Match highlights", description: "Video hosting and highlight reels", done: false },
      { name: "API access", description: "Integrate Clubify with other tools", done: false }
    ]
  }
];

function getStatusBadge(status: string) {
  switch (status) {
    case 'completed':
      return { class: 'bg-green-100 text-green-700', text: 'Completed' };
    case 'in_progress':
      return { class: 'bg-blue-100 text-blue-700', text: 'In Progress' };
    default:
      return { class: 'bg-slate-100 text-slate-600', text: 'Planned' };
  }
}
---

<Layout title="Roadmap - Clubify">
  <Navigation />
  <PageHeader
    title="Product Roadmap"
    description="See what we're building and what's coming next"
    badge="Roadmap"
  />

  <section class="py-16 bg-white">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <!-- Intro -->
      <div class="text-center mb-12">
        <p class="text-lg text-slate-600 max-w-2xl mx-auto">
          We're constantly improving Clubify based on feedback from clubs like yours. Here's what we're working on and what's planned for the future.
        </p>
      </div>

      <!-- Roadmap Timeline -->
      <div class="space-y-12">
        {roadmapItems.map((item, index) => {
          const badge = getStatusBadge(item.status);
          return (
            <div class="relative">
              {/* Timeline connector */}
              {index < roadmapItems.length - 1 && (
                <div class="absolute left-6 top-14 bottom-0 w-0.5 bg-slate-200 -mb-12"></div>
              )}

              <div class="flex items-start gap-6">
                {/* Timeline dot */}
                <div class={`w-12 h-12 rounded-full flex items-center justify-center flex-shrink-0 ${
                  item.status === 'completed' ? 'bg-green-500' :
                  item.status === 'in_progress' ? 'bg-blue-500' : 'bg-slate-300'
                }`}>
                  {item.status === 'completed' ? (
                    <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                    </svg>
                  ) : item.status === 'in_progress' ? (
                    <svg class="w-6 h-6 text-white animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                    </svg>
                  ) : (
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                  )}
                </div>

                <div class="flex-1">
                  <div class="flex items-center gap-3 mb-4">
                    <h2 class="text-xl font-bold text-slate-900">{item.quarter}</h2>
                    <span class={`px-3 py-1 rounded-full text-xs font-semibold ${badge.class}`}>
                      {badge.text}
                    </span>
                  </div>

                  <div class="bg-slate-50 rounded-2xl border border-slate-200 p-6">
                    <ul class="space-y-4">
                      {item.features.map((feature) => (
                        <li class="flex items-start gap-3">
                          <div class={`w-5 h-5 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5 ${
                            feature.done ? 'bg-green-100 text-green-600' : 'bg-slate-200 text-slate-400'
                          }`}>
                            {feature.done ? (
                              <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                              </svg>
                            ) : (
                              <div class="w-2 h-2 bg-slate-400 rounded-full"></div>
                            )}
                          </div>
                          <div>
                            <p class={`font-medium ${feature.done ? 'text-slate-900' : 'text-slate-700'}`}>
                              {feature.name}
                            </p>
                            <p class="text-sm text-slate-500">{feature.description}</p>
                          </div>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Feature Request CTA -->
      <div class="mt-16 bg-gradient-to-br from-primary-50 to-accent-50 rounded-3xl p-8 md:p-12 text-center border border-primary-100">
        <h2 class="text-2xl font-bold text-slate-900 mb-4">Have a Feature Request?</h2>
        <p class="text-slate-600 max-w-lg mx-auto mb-6">
          We build Clubify based on what clubs actually need. If there's something you'd like to see, let us know.
        </p>
        <a
          href="/contact"
          class="inline-flex items-center gap-2 px-6 py-3 bg-primary-600 hover:bg-primary-700 text-white font-semibold rounded-xl transition-colors shadow-lg shadow-primary-600/25"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
          </svg>
          Request a Feature
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
