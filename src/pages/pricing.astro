---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Pricing from '../components/Pricing.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';

const features = [
  {
    category: "Website & App",
    items: ["Professional club website", "Mobile app (iOS & Android)", "Custom domain support", "Mobile responsive design", "SSL encryption"]
  },
  {
    category: "Content & Media",
    items: ["News & announcements", "Fixtures & results", "League tables", "Media library (5GB)", "Rich text editor"]
  },
  {
    category: "Communication",
    items: ["Push notifications", "Social media auto-publish", "Contact forms", "Centralized inbox", "Email notifications"]
  },
  {
    category: "Management",
    items: ["Unlimited team members", "Role-based permissions", "Sponsor management", "Analytics dashboard", "Audit log"]
  }
];
---

<Layout title="Pricing - Clubify | Simple, Transparent Pricing">
  <Navigation />

  <!-- Hero Section -->
  <section class="pt-32 pb-16 bg-white relative overflow-hidden">
    <div class="absolute inset-0 mesh-gradient-light opacity-50"></div>
    <div class="absolute inset-0 grid-pattern"></div>

    <div class="relative mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
      <div class="section-badge-pill mx-auto mb-6 w-fit">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        Pricing
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-slate-900 mb-6">
        Simple, transparent pricing
      </h1>
      <p class="text-xl text-slate-600 max-w-2xl mx-auto">
        Everything your club needs in one plan. No hidden fees, no surprise charges.
      </p>
    </div>
  </section>

  <!-- Pricing Component -->
  <Pricing />

  <!-- Feature Breakdown -->
  <section class="py-20 bg-white">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">Everything included</h2>
        <p class="text-lg text-slate-600">No feature gates. No upsells. Every club gets access to all features.</p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        {features.map((category) => (
          <div>
            <h3 class="font-semibold text-slate-900 mb-4 pb-2 border-b border-slate-200">{category.category}</h3>
            <ul class="space-y-3">
              {category.items.map((item) => (
                <li class="flex items-center gap-2 text-sm text-slate-600">
                  <svg class="w-4 h-4 text-primary-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Trust Section -->
  <section class="py-16 bg-slate-50 border-y border-slate-100">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="text-center">
          <div class="w-12 h-12 mx-auto mb-4 rounded-xl bg-primary-100 flex items-center justify-center">
            <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
          </div>
          <h3 class="font-semibold text-slate-900 mb-1">GDPR Compliant</h3>
          <p class="text-sm text-slate-500">Your data is protected</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 mx-auto mb-4 rounded-xl bg-primary-100 flex items-center justify-center">
            <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h3 class="font-semibold text-slate-900 mb-1">7-Day Free Trial</h3>
          <p class="text-sm text-slate-500">Try before you commit</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 mx-auto mb-4 rounded-xl bg-primary-100 flex items-center justify-center">
            <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </div>
          <h3 class="font-semibold text-slate-900 mb-1">Cancel Anytime</h3>
          <p class="text-sm text-slate-500">No contracts</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 mx-auto mb-4 rounded-xl bg-primary-100 flex items-center justify-center">
            <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
          </div>
          <h3 class="font-semibold text-slate-900 mb-1">Irish Support</h3>
          <p class="text-sm text-slate-500">Local team, local support</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <FAQ />

  <!-- Enterprise CTA -->
  <section class="py-16 bg-white">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="bg-slate-900 rounded-2xl p-8 md:p-12 text-center">
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">Need custom features or volume pricing?</h2>
        <p class="text-slate-300 mb-8 max-w-xl mx-auto">We work with larger organizations and federations. Get in touch to discuss your specific requirements.</p>
        <a href="/contact" class="inline-flex items-center gap-2 px-8 py-4 bg-white text-slate-900 font-semibold rounded-xl hover:bg-slate-100 transition-colors">
          Contact for enterprise pricing
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
