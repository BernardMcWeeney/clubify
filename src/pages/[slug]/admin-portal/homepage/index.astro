---
import AdminLayout from '../../../../components/admin/AdminLayout.astro';
import { DatabaseService } from '../../../../lib/db';
import { getAuthContext } from '../../../../lib/auth';
import { getDefaultConfig, TEMPLATES, type BlockConfig } from '../../../../lib/templates';

const { slug } = Astro.params;

if (!Astro.locals.runtime.env.DB) {
  return Astro.redirect('/admin?error=db_not_configured');
}

const db = new DatabaseService(Astro.locals.runtime.env.DB);
const { user } = await getAuthContext(Astro.cookies, db);

if (!user) {
  return Astro.redirect('/admin/login');
}

const club = await db.getClubBySlug(slug!);
if (!club) {
  return Astro.redirect('/admin');
}

const member = await db.getClubMember(club.id, user.id);
if (!member) {
  return Astro.redirect('/admin');
}

const canEdit = ['admin', 'pro'].includes(member.role);

// Get homepage config
const homepageConfig = await db.getHomepageConfig(club.id);
const templateId = club.template as 'classic' | 'matchday' | 'community';
const template = TEMPLATES[templateId];
const defaultBlocks = getDefaultConfig(templateId);

let blocks: BlockConfig[];
if (homepageConfig) {
  const config = JSON.parse(homepageConfig.config);
  blocks = config.blocks;
} else {
  blocks = defaultBlocks;
}

// Block display info
const blockInfo: Record<string, { name: string; description: string; icon: string }> = {
  'hero': {
    name: 'Hero Banner',
    description: 'Main welcome section with club crest and tagline',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>'
  },
  'next-fixture': {
    name: 'Next Fixture',
    description: 'Countdown to the next upcoming match',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>'
  },
  'latest-news': {
    name: 'Latest News',
    description: 'Recent posts and announcements',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>'
  },
  'latest-result': {
    name: 'Latest Result',
    description: 'Most recent match result',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>'
  },
  'results-ticker': {
    name: 'Results Ticker',
    description: 'Scrolling recent results banner',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>'
  },
  'notices': {
    name: 'Notices',
    description: 'Important club announcements',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"/>'
  },
  'highlight-cards': {
    name: 'Highlight Cards',
    description: 'Featured content cards',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>'
  },
  'volunteer-spotlight': {
    name: 'Volunteer Spotlight',
    description: 'Featured community members',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>'
  },
  'sponsors': {
    name: 'Sponsors',
    description: 'Club sponsors and partners',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/>'
  },
  'contact': {
    name: 'Contact',
    description: 'Club contact information and location',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>'
  },
};
---

<AdminLayout
  title="Homepage Editor"
  club={club}
  user={user}
  member={member}
  currentPage="homepage"
>
  <div class="max-w-4xl">
    <!-- Template info -->
    <div class="bg-slate-800/50 rounded-xl border border-slate-700/50 p-6 mb-6">
      <div class="flex items-center justify-between">
        <div>
          <div class="flex items-center gap-2 mb-1">
            <h2 class="text-lg font-semibold text-white">{template.name}</h2>
            <span class="px-2 py-0.5 bg-green-500/20 text-green-400 rounded text-xs font-medium">Active</span>
          </div>
          <p class="text-slate-400 text-sm">{template.description}</p>
        </div>
        <a
          href={`/${slug}`}
          target="_blank"
          class="flex items-center gap-2 px-4 py-2 bg-slate-700 hover:bg-slate-600 text-white rounded-lg text-sm transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
          </svg>
          Preview
        </a>
      </div>
    </div>

    {!canEdit && (
      <div class="bg-amber-500/10 border border-amber-500/20 rounded-xl p-4 mb-6">
        <div class="flex items-center gap-3">
          <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
          </svg>
          <p class="text-amber-400 text-sm">You need Admin or PRO role to edit the homepage layout.</p>
        </div>
      </div>
    )}

    <!-- Blocks list -->
    <div class="space-y-3" id="blocks-container" data-club-id={club.id}>
      {blocks.sort((a, b) => a.order - b.order).map((block, index) => {
        const info = blockInfo[block.type] || { name: block.type, description: '', icon: '' };
        return (
          <div
            class={`block-item bg-slate-800/50 rounded-xl border ${block.visible ? 'border-slate-700/50' : 'border-slate-700/50 opacity-50'} p-4 transition-all`}
            data-block-id={block.id}
            data-order={block.order}
            data-required={block.required}
            data-locked={block.locked}
          >
            <div class="flex items-center gap-4">
              <!-- Drag handle / order controls -->
              <div class="flex flex-col gap-1">
                {canEdit && !block.locked && (
                  <>
                    <button
                      class="move-up p-1 text-slate-500 hover:text-white disabled:opacity-30 disabled:cursor-not-allowed transition-colors"
                      disabled={index === 0}
                      title="Move up"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/>
                      </svg>
                    </button>
                    <button
                      class="move-down p-1 text-slate-500 hover:text-white disabled:opacity-30 disabled:cursor-not-allowed transition-colors"
                      disabled={index === blocks.length - 1}
                      title="Move down"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                      </svg>
                    </button>
                  </>
                )}
                {block.locked && (
                  <div class="p-1 text-slate-600" title="This block is locked">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                    </svg>
                  </div>
                )}
              </div>

              <!-- Icon -->
              <div class="w-10 h-10 rounded-lg bg-slate-700/50 flex items-center justify-center">
                <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={info.icon} />
              </div>

              <!-- Info -->
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2">
                  <h3 class="text-white font-medium">{info.name}</h3>
                  {block.required && (
                    <span class="px-1.5 py-0.5 bg-blue-500/20 text-blue-400 rounded text-xs">Required</span>
                  )}
                  {block.locked && (
                    <span class="px-1.5 py-0.5 bg-slate-600 text-slate-400 rounded text-xs">Locked</span>
                  )}
                </div>
                <p class="text-slate-500 text-sm truncate">{info.description}</p>
              </div>

              <!-- Visibility toggle -->
              {canEdit && !block.required && (
                <label class="relative inline-flex items-center cursor-pointer">
                  <input
                    type="checkbox"
                    class="sr-only peer visibility-toggle"
                    checked={block.visible}
                    data-block-id={block.id}
                  />
                  <div class="w-11 h-6 bg-slate-700 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-green-500/50 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-green-500"></div>
                </label>
              )}
              {block.required && (
                <div class="text-slate-500 text-sm">Always visible</div>
              )}
            </div>
          </div>
        );
      })}
    </div>

    <!-- Actions -->
    {canEdit && (
      <div class="flex items-center justify-between mt-6 pt-6 border-t border-slate-700/50">
        <button
          id="reset-btn"
          class="px-4 py-2 text-slate-400 hover:text-white transition-colors text-sm"
        >
          Reset to default
        </button>
        <div class="flex items-center gap-3">
          <span id="save-status" class="text-slate-500 text-sm hidden">Saved</span>
          <button
            id="save-btn"
            class="px-6 py-2 bg-green-500 hover:bg-green-600 text-white font-medium rounded-lg transition-colors text-sm disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Save Changes
          </button>
        </div>
      </div>
    )}

    <!-- Help text -->
    <div class="mt-8 p-4 bg-slate-800/30 rounded-xl border border-slate-700/30">
      <h3 class="text-white font-medium mb-2">Tips</h3>
      <ul class="text-slate-400 text-sm space-y-1">
        <li>Use the arrow buttons to reorder blocks on your homepage</li>
        <li>Toggle visibility to show or hide optional blocks</li>
        <li><span class="text-blue-400">Required</span> blocks cannot be hidden</li>
        <li><span class="text-slate-400">Locked</span> blocks cannot be moved or removed</li>
        <li>Click "Preview" to see your changes on the live site</li>
      </ul>
    </div>
  </div>
</AdminLayout>

<script>
  const container = document.getElementById('blocks-container') as HTMLElement;
  const saveBtn = document.getElementById('save-btn') as HTMLButtonElement;
  const resetBtn = document.getElementById('reset-btn') as HTMLButtonElement;
  const saveStatus = document.getElementById('save-status') as HTMLElement;
  const clubId = container?.dataset.clubId;

  let hasChanges = false;

  function markChanged() {
    hasChanges = true;
    saveBtn.disabled = false;
    saveStatus.classList.add('hidden');
  }

  function getBlocksData() {
    const blockElements = container.querySelectorAll('.block-item');
    const blocks: Array<{
      id: string;
      type: string;
      required: boolean;
      locked: boolean;
      visible: boolean;
      order: number;
      settings: Record<string, unknown>;
    }> = [];

    blockElements.forEach((el, index) => {
      const blockId = (el as HTMLElement).dataset.blockId!;
      const isRequired = (el as HTMLElement).dataset.required === 'true';
      const isLocked = (el as HTMLElement).dataset.locked === 'true';
      const toggle = el.querySelector('.visibility-toggle') as HTMLInputElement;
      const isVisible = isRequired || toggle?.checked || false;

      blocks.push({
        id: blockId,
        type: blockId, // Block ID matches type
        required: isRequired,
        locked: isLocked,
        visible: isVisible,
        order: index,
        settings: {},
      });
    });

    return blocks;
  }

  function swapBlocks(index1: number, index2: number) {
    const blocks = container.querySelectorAll('.block-item');
    if (index2 < 0 || index2 >= blocks.length) return;

    const block1 = blocks[index1];
    const block2 = blocks[index2];

    // Check if either block is locked
    if ((block1 as HTMLElement).dataset.locked === 'true' ||
        (block2 as HTMLElement).dataset.locked === 'true') {
      return;
    }

    // Swap in DOM
    if (index1 < index2) {
      container.insertBefore(block2, block1);
    } else {
      container.insertBefore(block1, block2);
    }

    // Update order attributes
    container.querySelectorAll('.block-item').forEach((el, i) => {
      (el as HTMLElement).dataset.order = String(i);
    });

    // Update disabled states
    updateButtonStates();
    markChanged();
  }

  function updateButtonStates() {
    const blocks = container.querySelectorAll('.block-item');
    blocks.forEach((block, index) => {
      const upBtn = block.querySelector('.move-up') as HTMLButtonElement;
      const downBtn = block.querySelector('.move-down') as HTMLButtonElement;

      if (upBtn) upBtn.disabled = index === 0;
      if (downBtn) downBtn.disabled = index === blocks.length - 1;
    });
  }

  // Move up/down handlers
  container?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest('.move-up, .move-down');
    if (!btn) return;

    const blockItem = btn.closest('.block-item') as HTMLElement;
    const blocks = Array.from(container.querySelectorAll('.block-item'));
    const currentIndex = blocks.indexOf(blockItem);

    if (btn.classList.contains('move-up')) {
      swapBlocks(currentIndex, currentIndex - 1);
    } else {
      swapBlocks(currentIndex, currentIndex + 1);
    }
  });

  // Visibility toggle handlers
  container?.querySelectorAll('.visibility-toggle').forEach((toggle) => {
    toggle.addEventListener('change', () => {
      const blockItem = (toggle as HTMLElement).closest('.block-item') as HTMLElement;
      if ((toggle as HTMLInputElement).checked) {
        blockItem.classList.remove('opacity-50');
      } else {
        blockItem.classList.add('opacity-50');
      }
      markChanged();
    });
  });

  // Save handler
  saveBtn?.addEventListener('click', async () => {
    saveBtn.disabled = true;
    saveBtn.textContent = 'Saving...';

    try {
      const blocks = getBlocksData();
      const res = await fetch(`/api/clubs/${clubId}/homepage-config`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ blocks, overrides: {} }),
      });

      const data = await res.json();

      if (!res.ok) {
        throw new Error(data.error || 'Failed to save');
      }

      hasChanges = false;
      saveStatus.textContent = 'Saved!';
      saveStatus.classList.remove('hidden');
      saveBtn.textContent = 'Save Changes';

      setTimeout(() => {
        saveStatus.classList.add('hidden');
      }, 3000);
    } catch (error: any) {
      console.error('Save error:', error);
      alert(error.message || 'Failed to save changes');
      saveBtn.disabled = false;
      saveBtn.textContent = 'Save Changes';
    }
  });

  // Reset handler
  resetBtn?.addEventListener('click', async () => {
    if (!confirm('Reset to default layout? This will remove all your customizations.')) {
      return;
    }

    try {
      const res = await fetch(`/api/clubs/${clubId}/homepage-config`, {
        method: 'DELETE',
      });

      if (!res.ok) {
        throw new Error('Failed to reset');
      }

      // Reload page to show default config
      window.location.reload();
    } catch (error: any) {
      console.error('Reset error:', error);
      alert(error.message || 'Failed to reset');
    }
  });

  // Warn on unsaved changes
  window.addEventListener('beforeunload', (e) => {
    if (hasChanges) {
      e.preventDefault();
      e.returnValue = '';
    }
  });
</script>
