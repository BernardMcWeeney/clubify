---
import AdminLayout from '../../../../components/admin/AdminLayout.astro';
import { DatabaseService } from '../../../../lib/db';
import { getAuthContext } from '../../../../lib/auth';
import { hasPermission, ROLE_LABELS, ROLE_DESCRIPTIONS, ROLE_HIERARCHY, type Role } from '../../../../lib/permissions';

const { slug } = Astro.params;

if (!Astro.locals.runtime.env.DB) {
  return Astro.redirect('/admin?error=db_not_configured');
}

const db = new DatabaseService(Astro.locals.runtime.env.DB);
const { user } = await getAuthContext(Astro.cookies, db);

if (!user) {
  return Astro.redirect('/admin/login');
}

const club = await db.getClubBySlug(slug!);
if (!club) {
  return Astro.redirect('/admin');
}

const member = await db.getClubMember(club.id, user.id);
if (!member) {
  return Astro.redirect('/admin');
}

const canInvite = hasPermission(member.role as Role, 'team.invite');
const canRemove = hasPermission(member.role as Role, 'team.remove');
const canChangeRole = hasPermission(member.role as Role, 'team.change_role');

// Get all team members
const members = await db.getClubMembers(club.id);

// Assignable roles (all except admin)
const assignableRoles = ROLE_HIERARCHY.filter(r => r !== 'admin');
---

<AdminLayout
  title="Team"
  club={club}
  user={user}
  member={member}
  currentPage="team"
>
  <div class="max-w-4xl">
    <div class="flex items-center justify-between mb-6">
      <p class="text-slate-400">
        Manage your club's team members and their access levels.
      </p>
      {canInvite && (
        <button
          id="invite-btn"
          class="flex items-center gap-2 px-4 py-2 bg-green-500 hover:bg-green-600 text-white font-medium rounded-lg transition-colors text-sm"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
          </svg>
          Invite Member
        </button>
      )}
    </div>

    <!-- Members list -->
    <div class="bg-slate-800/50 rounded-xl border border-slate-700/50 overflow-hidden">
      <div class="divide-y divide-slate-700/50">
        {members.map((m) => {
          const isCurrentUser = m.user_id === user.id;
          const isAdmin = m.role === 'admin';
          const canEdit = canChangeRole && !isCurrentUser && !isAdmin;
          const canDelete = canRemove && !isCurrentUser && !isAdmin;

          return (
            <div class="p-4 hover:bg-slate-800/30 transition-colors" data-member-id={m.id}>
              <div class="flex items-center gap-4">
                <!-- Avatar -->
                <div class="w-12 h-12 rounded-full bg-slate-700 flex items-center justify-center text-white font-medium text-lg">
                  {m.user.name.charAt(0).toUpperCase()}
                </div>

                <!-- Info -->
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2">
                    <h3 class="text-white font-medium truncate">{m.user.name}</h3>
                    {isCurrentUser && (
                      <span class="px-2 py-0.5 bg-slate-600 text-slate-300 rounded text-xs">You</span>
                    )}
                  </div>
                  <p class="text-slate-400 text-sm truncate">{m.user.email}</p>
                </div>

                <!-- Role badge -->
                <div class="flex items-center gap-3">
                  {canEdit ? (
                    <select
                      class="role-select bg-slate-700 border border-slate-600 text-white rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-green-500"
                      data-user-id={m.user_id}
                      data-current-role={m.role}
                    >
                      {ROLE_HIERARCHY.map((role) => (
                        <option value={role} selected={m.role === role}>
                          {ROLE_LABELS[role]}
                        </option>
                      ))}
                    </select>
                  ) : (
                    <span class={`px-3 py-1 rounded-full text-xs font-medium ${
                      m.role === 'admin' ? 'bg-purple-500/20 text-purple-400' :
                      m.role === 'pro' ? 'bg-blue-500/20 text-blue-400' :
                      m.role === 'treasurer' ? 'bg-amber-500/20 text-amber-400' :
                      m.role === 'editor' ? 'bg-green-500/20 text-green-400' :
                      'bg-slate-600 text-slate-300'
                    }`}>
                      {ROLE_LABELS[m.role as Role] || m.role}
                    </span>
                  )}

                  {canDelete && (
                    <button
                      class="remove-member-btn p-2 text-slate-500 hover:text-red-400 transition-colors"
                      data-user-id={m.user_id}
                      data-user-name={m.user.name}
                      title="Remove member"
                    >
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                      </svg>
                    </button>
                  )}
                </div>
              </div>

              {/* Member joined date */}
              <p class="text-slate-500 text-xs mt-2 ml-16">
                Joined {new Date(m.joined_at).toLocaleDateString('en-IE', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric'
                })}
              </p>
            </div>
          );
        })}
      </div>
    </div>

    <!-- Role descriptions -->
    <div class="mt-8 p-4 bg-slate-800/30 rounded-xl border border-slate-700/30">
      <h3 class="text-white font-medium mb-3">Role Permissions</h3>
      <div class="grid sm:grid-cols-2 gap-3">
        {ROLE_HIERARCHY.map((role) => (
          <div class="flex items-start gap-3">
            <span class={`mt-0.5 px-2 py-0.5 rounded text-xs font-medium ${
              role === 'admin' ? 'bg-purple-500/20 text-purple-400' :
              role === 'pro' ? 'bg-blue-500/20 text-blue-400' :
              role === 'treasurer' ? 'bg-amber-500/20 text-amber-400' :
              role === 'editor' ? 'bg-green-500/20 text-green-400' :
              'bg-slate-600 text-slate-300'
            }`}>
              {ROLE_LABELS[role]}
            </span>
            <p class="text-slate-400 text-sm">{ROLE_DESCRIPTIONS[role]}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Invite Modal -->
  <div id="invite-modal" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" id="invite-modal-backdrop"></div>
    <div class="absolute inset-0 flex items-center justify-center p-4">
      <div class="bg-slate-800 rounded-2xl border border-slate-700 w-full max-w-md p-6 relative">
        <button id="close-invite-modal" class="absolute top-4 right-4 text-slate-400 hover:text-white">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>

        <h2 class="text-xl font-bold text-white mb-4">Invite Team Member</h2>
        <p class="text-slate-400 text-sm mb-6">
          Send an invitation email to add a new member to your club.
        </p>

        <form id="invite-form" class="space-y-4">
          <div>
            <label for="invite-email" class="block text-sm font-medium text-slate-300 mb-2">Email address</label>
            <input
              type="email"
              id="invite-email"
              name="email"
              required
              class="w-full px-4 py-3 bg-slate-700/50 border border-slate-600 rounded-xl text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent"
              placeholder="member@example.com"
            />
          </div>

          <div>
            <label for="invite-role" class="block text-sm font-medium text-slate-300 mb-2">Role</label>
            <select
              id="invite-role"
              name="role"
              class="w-full px-4 py-3 bg-slate-700/50 border border-slate-600 rounded-xl text-white focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent"
            >
              {assignableRoles.map((role) => (
                <option value={role} selected={role === 'editor'}>
                  {ROLE_LABELS[role]} - {ROLE_DESCRIPTIONS[role]}
                </option>
              ))}
            </select>
          </div>

          <div id="invite-error" class="hidden p-3 bg-red-500/10 border border-red-500/20 rounded-lg">
            <p class="text-red-400 text-sm"></p>
          </div>

          <div id="invite-success" class="hidden p-3 bg-green-500/10 border border-green-500/20 rounded-lg">
            <p class="text-green-400 text-sm"></p>
          </div>

          <button
            type="submit"
            id="invite-submit"
            class="w-full py-3 px-6 bg-green-500 hover:bg-green-600 text-white font-semibold rounded-xl transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Send Invitation
          </button>
        </form>
      </div>
    </div>
  </div>
</AdminLayout>

<script define:vars={{ clubId: club.id }}>
  // Modal controls
  const inviteBtn = document.getElementById('invite-btn');
  const inviteModal = document.getElementById('invite-modal');
  const closeModalBtn = document.getElementById('close-invite-modal');
  const modalBackdrop = document.getElementById('invite-modal-backdrop');
  const inviteForm = document.getElementById('invite-form');
  const inviteSubmit = document.getElementById('invite-submit');
  const inviteError = document.getElementById('invite-error');
  const inviteSuccess = document.getElementById('invite-success');

  function openModal() {
    inviteModal?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    inviteModal?.classList.add('hidden');
    document.body.style.overflow = '';
    inviteForm?.reset();
    inviteError?.classList.add('hidden');
    inviteSuccess?.classList.add('hidden');
  }

  inviteBtn?.addEventListener('click', openModal);
  closeModalBtn?.addEventListener('click', closeModal);
  modalBackdrop?.addEventListener('click', closeModal);

  // Invite form submission
  inviteForm?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const email = (document.getElementById('invite-email') as HTMLInputElement).value;
    const role = (document.getElementById('invite-role') as HTMLSelectElement).value;

    inviteSubmit.disabled = true;
    inviteSubmit.textContent = 'Sending...';
    inviteError?.classList.add('hidden');
    inviteSuccess?.classList.add('hidden');

    try {
      const res = await fetch(`/api/clubs/${clubId}/team/invite`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, role }),
      });

      const data = await res.json();

      if (!res.ok) {
        throw new Error(data.error || 'Failed to send invitation');
      }

      // Show success message
      if (inviteSuccess) {
        inviteSuccess.querySelector('p')!.textContent = data.devMode
          ? 'Invitation created! (Dev mode - check console for link)'
          : `Invitation sent to ${email}`;
        inviteSuccess.classList.remove('hidden');
      }

      // Reset form after delay
      setTimeout(() => {
        closeModal();
        window.location.reload();
      }, 2000);
    } catch (error: any) {
      if (inviteError) {
        inviteError.querySelector('p')!.textContent = error.message;
        inviteError.classList.remove('hidden');
      }
      inviteSubmit.disabled = false;
      inviteSubmit.textContent = 'Send Invitation';
    }
  });

  // Role change handlers
  document.querySelectorAll('.role-select').forEach((select) => {
    select.addEventListener('change', async (e) => {
      const target = e.target as HTMLSelectElement;
      const userId = target.dataset.userId;
      const currentRole = target.dataset.currentRole;
      const newRole = target.value;

      if (newRole === currentRole) return;

      if (!confirm(`Change this member's role to ${newRole}?`)) {
        target.value = currentRole!;
        return;
      }

      try {
        const res = await fetch(`/api/clubs/${clubId}/team/${userId}/role`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ role: newRole }),
        });

        if (!res.ok) {
          const data = await res.json();
          throw new Error(data.error || 'Failed to update role');
        }

        target.dataset.currentRole = newRole;
      } catch (error: any) {
        alert(error.message);
        target.value = currentRole!;
      }
    });
  });

  // Remove member handlers
  document.querySelectorAll('.remove-member-btn').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const userId = target.dataset.userId;
      const userName = target.dataset.userName;

      if (!confirm(`Remove ${userName} from the team? They will lose access to the admin portal.`)) {
        return;
      }

      try {
        const res = await fetch(`/api/clubs/${clubId}/team/${userId}`, {
          method: 'DELETE',
        });

        if (!res.ok) {
          const data = await res.json();
          throw new Error(data.error || 'Failed to remove member');
        }

        // Remove from DOM
        const memberRow = target.closest('[data-member-id]');
        memberRow?.remove();
      } catch (error: any) {
        alert(error.message);
      }
    });
  });
</script>
