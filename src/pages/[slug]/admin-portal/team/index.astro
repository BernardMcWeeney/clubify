---
import AdminLayout from '../../../../components/admin/AdminLayout.astro';
import AdminPageTemplate from '../../../../components/admin/AdminPageTemplate.astro';
import AdminCard from '../../../../components/admin/AdminCard.astro';
import StatusChip from '../../../../components/admin/StatusChip.astro';
import Icon from '../../../../components/admin/Icon.astro';
import Button from '../../../../components/ui/Button.astro';
import { DatabaseService } from '../../../../lib/db';
import { getAuthContext } from '../../../../lib/auth';
import { hasPermission, ROLE_LABELS, ROLE_DESCRIPTIONS, ROLE_HIERARCHY, type Role } from '../../../../lib/permissions';

const { slug } = Astro.params;

if (!Astro.locals.runtime.env.DB) {
  return Astro.redirect('/admin?error=db_not_configured');
}

const db = new DatabaseService(Astro.locals.runtime.env.DB);
const { user } = await getAuthContext(Astro.cookies, db);

if (!user) {
  return Astro.redirect('/admin/login');
}

const club = await db.getClubBySlug(slug!);
if (!club) {
  return Astro.redirect('/admin');
}

const member = await db.getClubMember(club.id, user.id);
if (!member) {
  return Astro.redirect('/admin');
}

const canInvite = hasPermission(member.role as Role, 'team.invite');
const canRemove = hasPermission(member.role as Role, 'team.remove');
const canChangeRole = hasPermission(member.role as Role, 'team.change_role');

const members = await db.getClubMembers(club.id);
const assignableRoles = ROLE_HIERARCHY.filter(r => r !== 'admin');

const roleVariants: Record<string, 'success' | 'warning' | 'error' | 'info' | 'neutral'> = {
  admin: 'info',
  pro: 'info',
  treasurer: 'warning',
  editor: 'success',
  viewer: 'neutral',
};

const breadcrumbs = [
  { label: 'Dashboard', href: `/${slug}/admin-portal` },
  { label: 'Team' },
];
---

<AdminLayout
  title="Team"
  club={club}
  user={user}
  member={member}
  currentPage="team"
>
  <Fragment slot="header-actions">
    {canInvite && (
      <button id="invite-btn" class="btn-primary">
        <Icon name="users" size="md" />
        Invite Member
      </button>
    )}
  </Fragment>

  <AdminPageTemplate
    title="Team"
    subtitle="Manage your club's team members and their access levels"
    breadcrumbs={breadcrumbs}
  >
    <!-- Stats -->
    <div class="grid grid-cols-3 gap-4">
      <div class="stat-card stat-card-accent">
        <p class="stat-card-label">Total Members</p>
        <p class="stat-card-value">{members.length}</p>
      </div>
      <div class="stat-card">
        <p class="stat-card-label">Admins</p>
        <p class="stat-card-value">{members.filter((m: any) => m.role === 'admin' || m.role === 'pro').length}</p>
      </div>
      <div class="stat-card">
        <p class="stat-card-label">Editors</p>
        <p class="stat-card-value">{members.filter((m: any) => m.role === 'editor').length}</p>
      </div>
    </div>

    <!-- Members list -->
    <AdminCard padding="none">
      <div class="px-5 py-4 border-b border-slate-100">
        <h2 class="text-lg font-semibold text-slate-900">Members</h2>
      </div>
      <div class="divide-y divide-slate-100">
        {members.map((m: any) => {
          const isCurrentUser = m.user_id === user.id;
          const isAdmin = m.role === 'admin';
          const canEdit = canChangeRole && !isCurrentUser && !isAdmin;
          const canDelete = canRemove && !isCurrentUser && !isAdmin;

          return (
            <div class="p-5 hover:bg-slate-50 transition-colors" data-member-id={m.id}>
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-full flex items-center justify-center text-white font-medium text-lg" style="background: var(--admin-accent)">
                  {m.user.name.charAt(0).toUpperCase()}
                </div>

                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2">
                    <h3 class="text-slate-900 font-medium truncate">{m.user.name}</h3>
                    {isCurrentUser && (
                      <StatusChip variant="neutral" size="sm">You</StatusChip>
                    )}
                  </div>
                  <p class="text-slate-500 text-sm truncate">{m.user.email}</p>
                  <p class="text-slate-400 text-xs mt-1">
                    Joined {new Date(m.joined_at).toLocaleDateString('en-IE', {
                      year: 'numeric',
                      month: 'short',
                      day: 'numeric'
                    })}
                  </p>
                </div>

                <div class="flex items-center gap-3">
                  {canEdit ? (
                    <select
                      class="role-select input text-sm py-1.5 w-auto"
                      data-user-id={m.user_id}
                      data-current-role={m.role}
                    >
                      {ROLE_HIERARCHY.map((role) => (
                        <option value={role} selected={m.role === role}>
                          {ROLE_LABELS[role]}
                        </option>
                      ))}
                    </select>
                  ) : (
                    <StatusChip variant={roleVariants[m.role] || 'neutral'} size="sm">
                      {ROLE_LABELS[m.role as Role] || m.role}
                    </StatusChip>
                  )}

                  {canDelete && (
                    <button
                      class="remove-member-btn p-1.5 text-slate-400 hover:text-red-500 hover:bg-red-50 rounded-md transition-colors"
                      data-user-id={m.user_id}
                      data-user-name={m.user.name}
                      title="Remove member"
                    >
                      <Icon name="trash" size="md" />
                    </button>
                  )}
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </AdminCard>

    <!-- Role descriptions -->
    <AdminCard>
      <h3 class="text-lg font-semibold text-slate-900 mb-4">Role Permissions</h3>
      <div class="grid sm:grid-cols-2 gap-4">
        {ROLE_HIERARCHY.map((role) => (
          <div class="flex items-start gap-3">
            <StatusChip variant={roleVariants[role] || 'neutral'} size="sm" class="mt-0.5">
              {ROLE_LABELS[role]}
            </StatusChip>
            <p class="text-sm text-slate-600">{ROLE_DESCRIPTIONS[role]}</p>
          </div>
        ))}
      </div>
    </AdminCard>
  </AdminPageTemplate>

  <!-- Invite Modal -->
  <div id="invite-modal" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-xl max-w-md w-full">
      <div class="px-6 py-4 border-b border-slate-200 flex items-center justify-between">
        <div>
          <h2 class="text-lg font-semibold text-slate-900">Invite Team Member</h2>
          <p class="text-sm text-slate-500">Send an invitation email to add a new member</p>
        </div>
        <button id="close-invite-modal" class="p-1.5 text-slate-400 hover:text-slate-600 rounded-md hover:bg-slate-100 transition-colors">
          <Icon name="close" size="xl" />
        </button>
      </div>

      <form id="invite-form" class="p-6 space-y-4">
        <div>
          <label class="label">Email address</label>
          <input type="email" id="invite-email" name="email" required class="input" placeholder="member@example.com" />
        </div>

        <div>
          <label class="label">Role</label>
          <select id="invite-role" name="role" class="input">
            {assignableRoles.map((role) => (
              <option value={role} selected={role === 'editor'}>
                {ROLE_LABELS[role]} - {ROLE_DESCRIPTIONS[role]}
              </option>
            ))}
          </select>
        </div>

        <div id="invite-error" class="hidden p-3 rounded-lg bg-red-50 border border-red-200">
          <p class="text-red-600 text-sm"></p>
        </div>

        <div id="invite-success" class="hidden p-3 rounded-lg bg-emerald-50 border border-emerald-200">
          <p class="text-emerald-600 text-sm"></p>
        </div>

        <div class="flex justify-end gap-3 pt-2">
          <button type="button" id="cancel-invite" class="btn-secondary">Cancel</button>
          <button type="submit" id="invite-submit" class="btn-primary">Send Invitation</button>
        </div>
      </form>
    </div>
  </div>
</AdminLayout>

<script define:vars={{ clubId: club.id }}>
  const inviteBtn = document.getElementById('invite-btn');
  const inviteModal = document.getElementById('invite-modal');
  const closeModalBtn = document.getElementById('close-invite-modal');
  const cancelInviteBtn = document.getElementById('cancel-invite');
  const inviteForm = document.getElementById('invite-form');
  const inviteSubmit = document.getElementById('invite-submit');
  const inviteError = document.getElementById('invite-error');
  const inviteSuccess = document.getElementById('invite-success');

  function openModal() {
    inviteModal?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    inviteModal?.classList.add('hidden');
    document.body.style.overflow = '';
    inviteForm?.reset();
    inviteError?.classList.add('hidden');
    inviteSuccess?.classList.add('hidden');
  }

  inviteBtn?.addEventListener('click', openModal);
  closeModalBtn?.addEventListener('click', closeModal);
  cancelInviteBtn?.addEventListener('click', closeModal);

  inviteModal?.addEventListener('click', (e) => {
    if (e.target === inviteModal) closeModal();
  });

  inviteForm?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const email = (document.getElementById('invite-email') as HTMLInputElement).value;
    const role = (document.getElementById('invite-role') as HTMLSelectElement).value;

    inviteSubmit.disabled = true;
    inviteSubmit.textContent = 'Sending...';
    inviteError?.classList.add('hidden');
    inviteSuccess?.classList.add('hidden');

    try {
      const res = await fetch(`/api/clubs/${clubId}/team/invite`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, role }),
      });

      const data = await res.json();

      if (!res.ok) {
        throw new Error(data.error || 'Failed to send invitation');
      }

      if (inviteSuccess) {
        inviteSuccess.querySelector('p')!.textContent = data.devMode
          ? 'Invitation created! (Dev mode - check console for link)'
          : `Invitation sent to ${email}`;
        inviteSuccess.classList.remove('hidden');
      }

      setTimeout(() => {
        closeModal();
        window.location.reload();
      }, 2000);
    } catch (error: any) {
      if (inviteError) {
        inviteError.querySelector('p')!.textContent = error.message;
        inviteError.classList.remove('hidden');
      }
      inviteSubmit.disabled = false;
      inviteSubmit.textContent = 'Send Invitation';
    }
  });

  document.querySelectorAll('.role-select').forEach((select) => {
    select.addEventListener('change', async (e) => {
      const target = e.target as HTMLSelectElement;
      const userId = target.dataset.userId;
      const currentRole = target.dataset.currentRole;
      const newRole = target.value;

      if (newRole === currentRole) return;

      if (!confirm(`Change this member's role to ${newRole}?`)) {
        target.value = currentRole!;
        return;
      }

      try {
        const res = await fetch(`/api/clubs/${clubId}/team/${userId}/role`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ role: newRole }),
        });

        if (!res.ok) {
          const data = await res.json();
          throw new Error(data.error || 'Failed to update role');
        }

        target.dataset.currentRole = newRole;
      } catch (error: any) {
        alert(error.message);
        target.value = currentRole!;
      }
    });
  });

  document.querySelectorAll('.remove-member-btn').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const userId = target.dataset.userId;
      const userName = target.dataset.userName;

      if (!confirm(`Remove ${userName} from the team? They will lose access to the admin portal.`)) {
        return;
      }

      try {
        const res = await fetch(`/api/clubs/${clubId}/team/${userId}`, {
          method: 'DELETE',
        });

        if (!res.ok) {
          const data = await res.json();
          throw new Error(data.error || 'Failed to remove member');
        }

        const memberRow = target.closest('[data-member-id]');
        memberRow?.remove();
      } catch (error: any) {
        alert(error.message);
      }
    });
  });
</script>
