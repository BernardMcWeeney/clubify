---
import AdminLayout from '../../../../components/admin/AdminLayout.astro';
import { DatabaseService } from '../../../../lib/db';
import { getAuthContext } from '../../../../lib/auth';

const { slug } = Astro.params;

if (!Astro.locals.runtime.env.DB) {
  return Astro.redirect('/admin?error=db_not_configured');
}

const db = new DatabaseService(Astro.locals.runtime.env.DB);
const { user } = await getAuthContext(Astro.cookies, db);

if (!user) {
  return Astro.redirect('/admin/login');
}

const club = await db.getClubBySlug(slug!);
if (!club) {
  return Astro.redirect('/admin');
}

const member = await db.getClubMember(club.id, user.id);
if (!member) {
  return Astro.redirect('/admin');
}

const sponsors = await db.getSponsors(club.id);
const sponsorRows = sponsors.map((s) => ({
  ...s,
  placements: s.placements ? JSON.parse(s.placements) : ['home'],
}));

const placementOptions = [
  { id: 'home', label: 'Home', hint: 'Homepage and hero sections' },
  { id: 'news', label: 'News', hint: 'News listing and posts' },
  { id: 'fixtures', label: 'Fixtures', hint: 'Fixture pages and results' },
  { id: 'about', label: 'About', hint: 'About page' },
  { id: 'contact', label: 'Contact', hint: 'Contact page' },
  { id: 'page', label: 'Pages', hint: 'Custom pages' },
  { id: 'forms', label: 'Forms', hint: 'Public forms pages' },
  { id: 'all', label: 'All pages', hint: 'Show everywhere' },
];

const tiers = ['main', 'gold', 'silver', 'bronze'];
const canManage = ['admin', 'pro'].includes(member.role);

// Group by tier
const sponsorsByTier = {
  main: sponsorRows.filter(s => s.tier === 'main'),
  gold: sponsorRows.filter(s => s.tier === 'gold'),
  silver: sponsorRows.filter(s => s.tier === 'silver'),
  bronze: sponsorRows.filter(s => s.tier === 'bronze'),
};
---

<AdminLayout
  title="Sponsors"
  club={club}
  user={user}
  member={member}
  currentPage="sponsors"
>
  <Fragment slot="header-actions">
    <button id="new-sponsor" class="flex items-center gap-2 px-4 py-2.5 bg-green-500 hover:bg-green-600 text-white rounded-xl transition-colors text-sm font-medium shadow-lg shadow-green-500/25" disabled={!canManage}>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
      </svg>
      New Sponsor
    </button>
  </Fragment>

  <div class="max-w-7xl mx-auto" id="sponsors-page" data-club-id={club.id}>
    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-slate-900 mb-2">Sponsors</h1>
      <p class="text-slate-600">Manage your club partners and showcase them across your website</p>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
      <div class="bg-gradient-to-br from-amber-50 to-orange-50 rounded-2xl p-6 border border-amber-100">
        <div class="flex items-center justify-between mb-4">
          <div class="w-12 h-12 bg-amber-500 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
            </svg>
          </div>
        </div>
        <p class="text-sm font-medium text-amber-700 mb-1">Main Partners</p>
        <p class="text-3xl font-bold text-amber-900">{sponsorsByTier.main.length}</p>
      </div>

      <div class="bg-gradient-to-br from-yellow-50 to-amber-50 rounded-2xl p-6 border border-yellow-100">
        <div class="flex items-center justify-between mb-4">
          <div class="w-12 h-12 bg-yellow-500 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l.7 2.154a1 1 0 00.95.69h2.264c.969 0 1.371 1.24.588 1.81l-1.833 1.332a1 1 0 00-.364 1.118l.7 2.154c.3.922-.755 1.688-1.538 1.118l-1.833-1.332a1 1 0 00-1.176 0l-1.833 1.332c-.783.57-1.838-.196-1.539-1.118l.7-2.154a1 1 0 00-.363-1.118L6.497 7.58c-.783-.57-.38-1.81.588-1.81h2.264a1 1 0 00.95-.69l.7-2.154z"/>
            </svg>
          </div>
        </div>
        <p class="text-sm font-medium text-yellow-700 mb-1">Gold Tier</p>
        <p class="text-3xl font-bold text-yellow-900">{sponsorsByTier.gold.length}</p>
      </div>

      <div class="bg-gradient-to-br from-slate-50 to-gray-50 rounded-2xl p-6 border border-slate-200">
        <div class="flex items-center justify-between mb-4">
          <div class="w-12 h-12 bg-slate-400 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l.7 2.154a1 1 0 00.95.69h2.264c.969 0 1.371 1.24.588 1.81l-1.833 1.332a1 1 0 00-.364 1.118l.7 2.154c.3.922-.755 1.688-1.538 1.118l-1.833-1.332a1 1 0 00-1.176 0l-1.833 1.332c-.783.57-1.838-.196-1.539-1.118l.7-2.154a1 1 0 00-.363-1.118L6.497 7.58c-.783-.57-.38-1.81.588-1.81h2.264a1 1 0 00.95-.69l.7-2.154z"/>
            </svg>
          </div>
        </div>
        <p class="text-sm font-medium text-slate-700 mb-1">Silver Tier</p>
        <p class="text-3xl font-bold text-slate-900">{sponsorsByTier.silver.length}</p>
      </div>

      <div class="bg-gradient-to-br from-orange-50 to-red-50 rounded-2xl p-6 border border-orange-100">
        <div class="flex items-center justify-between mb-4">
          <div class="w-12 h-12 bg-orange-600 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l.7 2.154a1 1 0 00.95.69h2.264c.969 0 1.371 1.24.588 1.81l-1.833 1.332a1 1 0 00-.364 1.118l.7 2.154c.3.922-.755 1.688-1.538 1.118l-1.833-1.332a1 1 0 00-1.176 0l-1.833 1.332c-.783.57-1.838-.196-1.539-1.118l.7-2.154a1 1 0 00-.363-1.118L6.497 7.58c-.783-.57-.38-1.81.588-1.81h2.264a1 1 0 00.95-.69l.7-2.154z"/>
            </svg>
          </div>
        </div>
        <p class="text-sm font-medium text-orange-700 mb-1">Bronze Tier</p>
        <p class="text-3xl font-bold text-orange-900">{sponsorsByTier.bronze.length}</p>
      </div>
    </div>

    {sponsorRows.length > 0 ? (
      <div class="space-y-8">
        <!-- Main Partners -->
        {sponsorsByTier.main.length > 0 && (
          <div>
            <div class="flex items-center gap-3 mb-6">
              <div class="w-10 h-10 bg-gradient-to-br from-amber-500 to-orange-600 rounded-xl flex items-center justify-center">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
                </svg>
              </div>
              <h2 class="text-2xl font-bold text-slate-900">Main Partners</h2>
              <span class="px-3 py-1 bg-amber-100 text-amber-700 rounded-full text-sm font-semibold">{sponsorsByTier.main.length}</span>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {sponsorsByTier.main.map((sponsor: any) => (
                <button
                  type="button"
                  class="sponsor-card group bg-white rounded-2xl border-2 border-slate-200 p-6 hover:border-amber-400 hover:shadow-xl transition-all duration-300 text-left"
                  data-sponsor={JSON.stringify(sponsor)}
                >
                  <div class="aspect-video bg-slate-50 rounded-xl flex items-center justify-center mb-4 overflow-hidden border border-slate-100">
                    {sponsor.logo_url ? (
                      <img src={sponsor.logo_url} alt={sponsor.name} class="w-full h-full object-contain p-4" />
                    ) : (
                      <div class="text-4xl font-bold text-slate-300">
                        {sponsor.name.slice(0, 2).toUpperCase()}
                      </div>
                    )}
                  </div>
                  <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-amber-600 transition-colors">{sponsor.name}</h3>
                  <p class="text-sm text-slate-600 mb-4 line-clamp-2">{sponsor.sponsoring || 'No description'}</p>
                  <div class="flex items-center justify-between">
                    <span class={`px-3 py-1.5 rounded-full text-xs font-semibold ${sponsor.is_active ? 'bg-green-100 text-green-700' : 'bg-slate-100 text-slate-500'}`}>
                      {sponsor.is_active ? 'Active' : 'Hidden'}
                    </span>
                    {sponsor.website_url && (
                      <svg class="w-5 h-5 text-slate-400 group-hover:text-amber-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                      </svg>
                    )}
                  </div>
                </button>
              ))}
            </div>
          </div>
        )}

        <!-- Gold Tier -->
        {sponsorsByTier.gold.length > 0 && (
          <div>
            <div class="flex items-center gap-3 mb-6">
              <div class="w-10 h-10 bg-gradient-to-br from-yellow-500 to-amber-600 rounded-xl flex items-center justify-center">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l.7 2.154a1 1 0 00.95.69h2.264c.969 0 1.371 1.24.588 1.81l-1.833 1.332a1 1 0 00-.364 1.118l.7 2.154c.3.922-.755 1.688-1.538 1.118l-1.833-1.332a1 1 0 00-1.176 0l-1.833 1.332c-.783.57-1.838-.196-1.539-1.118l.7-2.154a1 1 0 00-.363-1.118L6.497 7.58c-.783-.57-.38-1.81.588-1.81h2.264a1 1 0 00.95-.69l.7-2.154z"/>
                </svg>
              </div>
              <h2 class="text-2xl font-bold text-slate-900">Gold Tier</h2>
              <span class="px-3 py-1 bg-yellow-100 text-yellow-700 rounded-full text-sm font-semibold">{sponsorsByTier.gold.length}</span>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-6">
              {sponsorsByTier.gold.map((sponsor: any) => (
                <button
                  type="button"
                  class="sponsor-card group bg-white rounded-2xl border-2 border-slate-200 p-5 hover:border-yellow-400 hover:shadow-xl transition-all duration-300 text-left"
                  data-sponsor={JSON.stringify(sponsor)}
                >
                  <div class="aspect-video bg-slate-50 rounded-xl flex items-center justify-center mb-3 overflow-hidden border border-slate-100">
                    {sponsor.logo_url ? (
                      <img src={sponsor.logo_url} alt={sponsor.name} class="w-full h-full object-contain p-3" />
                    ) : (
                      <div class="text-2xl font-bold text-slate-300">
                        {sponsor.name.slice(0, 2).toUpperCase()}
                      </div>
                    )}
                  </div>
                  <h3 class="text-base font-bold text-slate-900 mb-1 group-hover:text-yellow-600 transition-colors">{sponsor.name}</h3>
                  <span class={`inline-block px-2.5 py-1 rounded-full text-xs font-semibold ${sponsor.is_active ? 'bg-green-100 text-green-700' : 'bg-slate-100 text-slate-500'}`}>
                    {sponsor.is_active ? 'Active' : 'Hidden'}
                  </span>
                </button>
              ))}
            </div>
          </div>
        )}

        <!-- Silver Tier -->
        {sponsorsByTier.silver.length > 0 && (
          <div>
            <div class="flex items-center gap-3 mb-6">
              <div class="w-10 h-10 bg-gradient-to-br from-slate-400 to-slate-600 rounded-xl flex items-center justify-center">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l.7 2.154a1 1 0 00.95.69h2.264c.969 0 1.371 1.24.588 1.81l-1.833 1.332a1 1 0 00-.364 1.118l.7 2.154c.3.922-.755 1.688-1.538 1.118l-1.833-1.332a1 1 0 00-1.176 0l-1.833 1.332c-.783.57-1.838-.196-1.539-1.118l.7-2.154a1 1 0 00-.363-1.118L6.497 7.58c-.783-.57-.38-1.81.588-1.81h2.264a1 1 0 00.95-.69l.7-2.154z"/>
                </svg>
              </div>
              <h2 class="text-2xl font-bold text-slate-900">Silver Tier</h2>
              <span class="px-3 py-1 bg-slate-100 text-slate-700 rounded-full text-sm font-semibold">{sponsorsByTier.silver.length}</span>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4">
              {sponsorsByTier.silver.map((sponsor: any) => (
                <button
                  type="button"
                  class="sponsor-card group bg-white rounded-xl border-2 border-slate-200 p-4 hover:border-slate-400 hover:shadow-lg transition-all duration-300"
                  data-sponsor={JSON.stringify(sponsor)}
                >
                  <div class="aspect-square bg-slate-50 rounded-lg flex items-center justify-center mb-2 overflow-hidden border border-slate-100">
                    {sponsor.logo_url ? (
                      <img src={sponsor.logo_url} alt={sponsor.name} class="w-full h-full object-contain p-2" />
                    ) : (
                      <div class="text-xl font-bold text-slate-300">
                        {sponsor.name.slice(0, 2).toUpperCase()}
                      </div>
                    )}
                  </div>
                  <p class="text-xs font-semibold text-slate-900 text-center line-clamp-1">{sponsor.name}</p>
                </button>
              ))}
            </div>
          </div>
        )}

        <!-- Bronze Tier -->
        {sponsorsByTier.bronze.length > 0 && (
          <div>
            <div class="flex items-center gap-3 mb-6">
              <div class="w-10 h-10 bg-gradient-to-br from-orange-600 to-red-600 rounded-xl flex items-center justify-center">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l.7 2.154a1 1 0 00.95.69h2.264c.969 0 1.371 1.24.588 1.81l-1.833 1.332a1 1 0 00-.364 1.118l.7 2.154c.3.922-.755 1.688-1.538 1.118l-1.833-1.332a1 1 0 00-1.176 0l-1.833 1.332c-.783.57-1.838-.196-1.539-1.118l.7-2.154a1 1 0 00-.363-1.118L6.497 7.58c-.783-.57-.38-1.81.588-1.81h2.264a1 1 0 00.95-.69l.7-2.154z"/>
                </svg>
              </div>
              <h2 class="text-2xl font-bold text-slate-900">Bronze Tier</h2>
              <span class="px-3 py-1 bg-orange-100 text-orange-700 rounded-full text-sm font-semibold">{sponsorsByTier.bronze.length}</span>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4">
              {sponsorsByTier.bronze.map((sponsor: any) => (
                <button
                  type="button"
                  class="sponsor-card group bg-white rounded-xl border-2 border-slate-200 p-4 hover:border-orange-400 hover:shadow-lg transition-all duration-300"
                  data-sponsor={JSON.stringify(sponsor)}
                >
                  <div class="aspect-square bg-slate-50 rounded-lg flex items-center justify-center mb-2 overflow-hidden border border-slate-100">
                    {sponsor.logo_url ? (
                      <img src={sponsor.logo_url} alt={sponsor.name} class="w-full h-full object-contain p-2" />
                    ) : (
                      <div class="text-xl font-bold text-slate-300">
                        {sponsor.name.slice(0, 2).toUpperCase()}
                      </div>
                    )}
                  </div>
                  <p class="text-xs font-semibold text-slate-900 text-center line-clamp-1">{sponsor.name}</p>
                </button>
              ))}
            </div>
          </div>
        )}
      </div>
    ) : (
      <div class="bg-white rounded-2xl border border-dashed border-slate-200 p-16 text-center">
        <div class="w-20 h-20 bg-amber-100 rounded-2xl flex items-center justify-center mx-auto mb-6">
          <svg class="w-10 h-10 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l.7 2.154a1 1 0 00.95.69h2.264c.969 0 1.371 1.24.588 1.81l-1.833 1.332a1 1 0 00-.364 1.118l.7 2.154c.3.922-.755 1.688-1.538 1.118l-1.833-1.332a1 1 0 00-1.176 0l-1.833 1.332c-.783.57-1.838-.196-1.539-1.118l.7-2.154a1 1 0 00-.363-1.118L6.497 7.58c-.783-.57-.38-1.81.588-1.81h2.264a1 1 0 00.95-.69l.7-2.154z"/>
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-slate-900 mb-3">No sponsors yet</h3>
        <p class="text-slate-500 mb-8 max-w-md mx-auto">Add your club partners and showcase them across your website and app. Perfect for recognizing local businesses who support your club.</p>
        <button id="empty-new" class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-amber-500 to-orange-600 text-white rounded-xl text-sm font-semibold hover:shadow-lg hover:scale-105 transition-all" disabled={!canManage}>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          Add your first sponsor
        </button>
      </div>
    )}
  </div>

  <!-- Edit Modal -->
  <div id="edit-modal" class="hidden fixed inset-0 bg-black bg-opacity-50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
      <div class="sticky top-0 bg-white border-b border-slate-200 px-6 py-4 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-gradient-to-br from-amber-500 to-orange-600 rounded-xl flex items-center justify-center">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l.7 2.154a1 1 0 00.95.69h2.264c.969 0 1.371 1.24.588 1.81l-1.833 1.332a1 1 0 00-.364 1.118l.7 2.154c.3.922-.755 1.688-1.538 1.118l-1.833-1.332a1 1 0 00-1.176 0l-1.833 1.332c-.783.57-1.838-.196-1.539-1.118l.7-2.154a1 1 0 00-.363-1.118L6.497 7.58c-.783-.57-.38-1.81.588-1.81h2.264a1 1 0 00.95-.69l.7-2.154z"/>
            </svg>
          </div>
          <div>
            <h2 class="text-xl font-bold text-slate-900">Sponsor Details</h2>
            <p class="text-sm text-slate-500" id="form-mode">New sponsor</p>
          </div>
        </div>
        <button id="close-modal" class="w-8 h-8 rounded-lg hover:bg-slate-100 flex items-center justify-center transition-colors">
          <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <form id="sponsor-form" class="p-6 space-y-5">
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-2">Sponsor name *</label>
          <input id="sponsor-name" type="text" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-amber-500 focus:border-transparent transition-all" placeholder="Greenfield Builders" required />
        </div>

        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-2">Logo URL</label>
          <input id="sponsor-logo" type="text" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-amber-500 focus:border-transparent transition-all" placeholder="https://example.com/logo.png" />
        </div>

        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-2">Website</label>
          <input id="sponsor-website" type="text" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-amber-500 focus:border-transparent transition-all" placeholder="https://example.com" />
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">Tier</label>
            <select id="sponsor-tier" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-amber-500 focus:border-transparent transition-all">
              {tiers.map((tier) => (
                <option value={tier}>{tier.charAt(0).toUpperCase() + tier.slice(1)}</option>
              ))}
            </select>
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">Sort order</label>
            <input id="sponsor-order" type="number" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-amber-500 focus:border-transparent transition-all" value="0" />
          </div>
        </div>

        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-2">Sponsoring / Notes</label>
          <textarea id="sponsor-notes" rows="3" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-amber-500 focus:border-transparent transition-all" placeholder="Main kit sponsor, U14s jersey..."></textarea>
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">Start date</label>
            <input id="sponsor-start" type="date" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-amber-500 focus:border-transparent transition-all" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">End date</label>
            <input id="sponsor-end" type="date" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-amber-500 focus:border-transparent transition-all" />
          </div>
        </div>

        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-3">Placements</label>
          <div class="grid gap-2">
            {placementOptions.map((option) => (
              <label class="flex items-center gap-3 rounded-xl border border-slate-200 px-4 py-3 text-sm text-slate-700 hover:bg-slate-50 transition-colors cursor-pointer">
                <input type="checkbox" class="placement-checkbox rounded border-slate-300 text-amber-600 focus:ring-2 focus:ring-amber-500" value={option.id} />
                <div class="flex-1">
                  <p class="font-medium text-slate-800">{option.label}</p>
                  <p class="text-xs text-slate-500">{option.hint}</p>
                </div>
              </label>
            ))}
          </div>
        </div>

        <label class="flex items-center gap-3 p-4 rounded-xl border-2 border-green-200 bg-green-50 cursor-pointer">
          <input id="sponsor-active" type="checkbox" class="rounded border-slate-300 text-green-600 focus:ring-2 focus:ring-green-500" checked />
          <span class="text-sm font-semibold text-green-900">Sponsor is active</span>
        </label>

        <div class="flex items-center justify-between pt-4 border-t border-slate-200">
          <button id="delete-sponsor" type="button" class="px-5 py-3 rounded-xl text-sm font-semibold text-red-600 hover:bg-red-50 transition-all" disabled={!canManage}>Delete Sponsor</button>
          <button type="submit" class="px-6 py-3 rounded-xl bg-gradient-to-r from-amber-500 to-orange-600 text-white text-sm font-semibold hover:shadow-lg hover:scale-105 transition-all" disabled={!canManage}>Save Sponsor</button>
        </div>
      </form>
    </div>
  </div>
</AdminLayout>

<script>
  const page = document.getElementById('sponsors-page');
  const clubId = page?.dataset.clubId;
  const modal = document.getElementById('edit-modal') as HTMLElement;
  const form = document.getElementById('sponsor-form') as HTMLFormElement;
  const formMode = document.getElementById('form-mode') as HTMLElement;
  const deleteBtn = document.getElementById('delete-sponsor') as HTMLButtonElement;
  const closeModalBtn = document.getElementById('close-modal') as HTMLButtonElement;

  const fields = {
    name: document.getElementById('sponsor-name') as HTMLInputElement,
    logo: document.getElementById('sponsor-logo') as HTMLInputElement,
    website: document.getElementById('sponsor-website') as HTMLInputElement,
    tier: document.getElementById('sponsor-tier') as HTMLSelectElement,
    order: document.getElementById('sponsor-order') as HTMLInputElement,
    notes: document.getElementById('sponsor-notes') as HTMLTextAreaElement,
    start: document.getElementById('sponsor-start') as HTMLInputElement,
    end: document.getElementById('sponsor-end') as HTMLInputElement,
    active: document.getElementById('sponsor-active') as HTMLInputElement,
  };

  let currentId: number | null = null;

  function showModal() {
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function hideModal() {
    modal.classList.add('hidden');
    document.body.style.overflow = '';
  }

  function clearForm() {
    currentId = null;
    formMode.textContent = 'New sponsor';
    fields.name.value = '';
    fields.logo.value = '';
    fields.website.value = '';
    fields.tier.value = 'main';
    fields.order.value = '0';
    fields.notes.value = '';
    fields.start.value = '';
    fields.end.value = '';
    fields.active.checked = true;
    document.querySelectorAll('.placement-checkbox').forEach((el) => {
      (el as HTMLInputElement).checked = false;
    });
    deleteBtn.style.display = 'none';
  }

  function fillForm(data: any) {
    currentId = data.id;
    formMode.textContent = 'Editing ' + data.name;
    fields.name.value = data.name || '';
    fields.logo.value = data.logo_url || '';
    fields.website.value = data.website_url || '';
    fields.tier.value = data.tier || 'main';
    fields.order.value = data.sort_order ?? 0;
    fields.notes.value = data.sponsoring || '';
    fields.start.value = data.start_date || '';
    fields.end.value = data.end_date || '';
    fields.active.checked = data.is_active === 1;

    const placements = data.placements || ['home'];
    document.querySelectorAll('.placement-checkbox').forEach((el) => {
      (el as HTMLInputElement).checked = placements.includes((el as HTMLInputElement).value);
    });
    deleteBtn.style.display = 'block';
  }

  document.getElementById('new-sponsor')?.addEventListener('click', () => {
    clearForm();
    showModal();
  });

  document.getElementById('empty-new')?.addEventListener('click', () => {
    clearForm();
    showModal();
  });

  closeModalBtn?.addEventListener('click', hideModal);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) hideModal();
  });

  document.querySelectorAll('.sponsor-card').forEach((card) => {
    card.addEventListener('click', () => {
      const data = JSON.parse((card as HTMLElement).dataset.sponsor || '{}');
      fillForm(data);
      showModal();
    });
  });

  deleteBtn?.addEventListener('click', async () => {
    if (!currentId) return;
    if (!confirm('Delete this sponsor?')) return;

    const res = await fetch(`/api/clubs/${clubId}/sponsors/${currentId}`, {
      method: 'DELETE',
    });

    if (res.ok) {
      window.location.reload();
    } else {
      const data = await res.json();
      alert(data.error || 'Failed to delete sponsor');
    }
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!clubId) return;

    const placements = Array.from(document.querySelectorAll('.placement-checkbox'))
      .filter((el) => (el as HTMLInputElement).checked)
      .map((el) => (el as HTMLInputElement).value);

    const payload = {
      name: fields.name.value.trim(),
      logo_url: fields.logo.value.trim() || null,
      website_url: fields.website.value.trim() || null,
      tier: fields.tier.value,
      sort_order: parseInt(fields.order.value || '0', 10),
      sponsoring: fields.notes.value.trim() || null,
      start_date: fields.start.value || null,
      end_date: fields.end.value || null,
      placements: placements.length ? placements : ['home'],
      is_active: fields.active.checked ? 1 : 0,
    };

    const endpoint = currentId
      ? `/api/clubs/${clubId}/sponsors/${currentId}`
      : `/api/clubs/${clubId}/sponsors`;

    const res = await fetch(endpoint, {
      method: currentId ? 'PATCH' : 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });

    if (res.ok) {
      window.location.reload();
    } else {
      const data = await res.json();
      alert(data.error || 'Failed to save sponsor');
    }
  });

  clearForm();
</script>

<style>
  @import "../../../../styles/global.css";
</style>
