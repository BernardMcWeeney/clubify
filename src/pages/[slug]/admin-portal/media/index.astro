---
import AdminLayout from '../../../../components/admin/AdminLayout.astro';
import AdminPageTemplate from '../../../../components/admin/AdminPageTemplate.astro';
import AdminCard from '../../../../components/admin/AdminCard.astro';
import Icon from '../../../../components/admin/Icon.astro';
import { DatabaseService } from '../../../../lib/db';
import { getAuthContext } from '../../../../lib/auth';

const { slug } = Astro.params;

if (!Astro.locals.runtime.env.DB) {
  return Astro.redirect('/admin?error=db_not_configured');
}

const db = new DatabaseService(Astro.locals.runtime.env.DB);
const { user } = await getAuthContext(Astro.cookies, db);

if (!user) {
  return Astro.redirect('/admin/login');
}

const club = await db.getClubBySlug(slug!);
if (!club) {
  return Astro.redirect('/admin');
}

const member = await db.getClubMember(club.id, user.id);
if (!member) {
  return Astro.redirect('/admin');
}

const canUpload = ['admin', 'pro', 'editor'].includes(member.role);
const canDelete = ['admin', 'pro'].includes(member.role);

const r2Configured = !!Astro.locals.runtime.env.MEDIA;

interface MediaItem {
  id: string;
  filename: string;
  url: string;
  mime_type: string;
  size: number;
  alt_text: string | null;
  created_at: string;
  uploaded_by_name: string | null;
}

const results = await Astro.locals.runtime.env.DB.prepare(`
  SELECT m.*, u.name as uploaded_by_name
  FROM media m
  LEFT JOIN users u ON m.uploaded_by = u.id
  WHERE m.club_id = ?
  ORDER BY m.created_at DESC
`).bind(club.id).all();

const media = (results.results || []) as MediaItem[];

function formatFileSize(bytes: number): string {
  if (bytes < 1024) return bytes + ' B';
  if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
  return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
}

function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString('en-IE', {
    day: 'numeric',
    month: 'short',
  });
}

const breadcrumbs = [
  { label: 'Dashboard', href: `/${slug}/admin-portal` },
  { label: 'Media' },
];
---

<AdminLayout
  title="Media"
  club={club}
  user={user}
  member={member}
  currentPage="media"
>
  <Fragment slot="header-actions">
    {canUpload && r2Configured && (
      <button id="upload-btn" class="btn-primary">
        <Icon name="upload" size="md" />
        Upload
      </button>
    )}
  </Fragment>

  <AdminPageTemplate
    title="Media Library"
    subtitle="Upload and manage images for your website"
    breadcrumbs={breadcrumbs}
    wide
  >
    <div slot="actions" class="text-sm text-slate-500">
      {media.length} file{media.length !== 1 ? 's' : ''}
    </div>

    {!r2Configured && (
      <div class="alert alert-info">
        <Icon name="alert-triangle" size="lg" class="alert-icon flex-shrink-0 mt-0.5" />
        <div>
          <p class="text-sm font-medium text-amber-800">Media storage not configured</p>
          <p class="text-sm text-amber-700">R2 bucket needs to be set up to enable uploads.</p>
        </div>
      </div>
    )}

    {media.length > 0 ? (
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
        {media.map((item) => (
          <div
            class="group bg-white rounded-xl border border-slate-200 overflow-hidden hover:border-slate-300 hover:shadow-md transition-all"
            data-media-id={item.id}
            data-media-url={item.url}
          >
            <div class="aspect-square relative overflow-hidden bg-slate-100">
              {item.mime_type.startsWith('image/') ? (
                <img
                  src={item.url}
                  alt={item.alt_text || item.filename}
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center">
                  <Icon name="file-text" size="xl" class="text-slate-300" />
                </div>
              )}

              <!-- Overlay -->
              <div class="absolute inset-0 bg-slate-900/60 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-2">
                <button class="copy-url-btn p-2 bg-white hover:bg-slate-100 text-slate-700 rounded-lg transition-colors" title="Copy URL">
                  <Icon name="copy" size="lg" />
                </button>
                {canDelete && (
                  <button class="delete-btn p-2 bg-red-500 hover:bg-red-600 text-white rounded-lg transition-colors" title="Delete">
                    <Icon name="trash" size="lg" />
                  </button>
                )}
              </div>
            </div>

            <div class="p-3">
              <p class="text-sm font-medium text-slate-900 truncate" title={item.filename}>{item.filename}</p>
              <p class="text-xs text-slate-500 mt-0.5">{formatFileSize(item.size)} · {formatDate(item.created_at)}</p>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <AdminCard>
        <div class="py-12 text-center">
          <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-slate-100 flex items-center justify-center">
            <Icon name="image" size="xl" class="text-slate-400" />
          </div>
          <h3 class="text-lg font-medium text-slate-900 mb-1">No media yet</h3>
          <p class="text-sm text-slate-500 mb-4">Upload images to use in your posts and pages</p>
          {canUpload && r2Configured && (
            <button id="upload-btn-empty" class="btn-primary">
              <Icon name="upload" size="md" />
              Upload your first image
            </button>
          )}
        </div>
      </AdminCard>
    )}
  </AdminPageTemplate>

  <!-- Upload Modal -->
  <div id="upload-modal" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-sm flex items-center justify-center z-50 p-4">
    <div class="bg-white rounded-xl shadow-xl max-w-md w-full border border-slate-200">
      <div class="px-6 py-4 border-b border-slate-200">
        <h3 class="text-lg font-semibold text-slate-900">Upload Media</h3>
      </div>

      <form id="upload-form" class="p-6 space-y-4">
        <div
          id="drop-zone"
          class="border-2 border-dashed border-slate-300 rounded-xl p-8 text-center cursor-pointer transition-all hover:border-slate-400"
        >
          <div class="w-12 h-12 mx-auto mb-3 rounded-full flex items-center justify-center icon-accent-bg">
            <Icon name="image" size="xl" class="opacity-70 icon-accent" />
          </div>
          <p class="text-slate-600 mb-1">Drop image here or click to browse</p>
          <p class="text-slate-400 text-xs">JPEG, PNG, GIF, WebP, SVG (max 10MB)</p>
          <input type="file" id="file-input" accept="image/*" class="hidden" />
        </div>

        <div id="file-preview" class="hidden">
          <div class="flex items-center gap-3 p-3 bg-slate-50 rounded-xl border border-slate-200">
            <img id="preview-img" src="" alt="Preview" class="w-16 h-16 object-cover rounded-lg" />
            <div class="flex-1 min-w-0">
              <p id="preview-name" class="text-sm font-medium text-slate-900 truncate"></p>
              <p id="preview-size" class="text-xs text-slate-500"></p>
            </div>
            <button type="button" id="clear-file" class="p-1.5 text-slate-400 hover:text-red-500 hover:bg-red-50 rounded-lg transition-colors">
              <Icon name="x" size="lg" />
            </button>
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-slate-700 mb-2">Alt text (optional)</label>
          <input type="text" id="alt-text" class="input-themed w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 placeholder-slate-400 focus:outline-none focus:bg-white transition-colors" placeholder="Describe the image..." />
        </div>

        <div class="flex justify-end gap-3 pt-2">
          <button type="button" id="cancel-upload" class="btn-secondary">Cancel</button>
          <button type="submit" id="submit-upload" class="btn-primary" disabled>Upload</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Toast -->
  <div id="toast" class="hidden fixed bottom-6 right-6 bg-slate-900 text-white px-4 py-3 rounded-xl shadow-xl z-50">
    <span id="toast-text">URL copied!</span>
  </div>
</AdminLayout>

<script define:vars={{ clubId: club.id, slug }}>
  const uploadBtn = document.getElementById('upload-btn');
  const uploadBtnEmpty = document.getElementById('upload-btn-empty');
  const uploadModal = document.getElementById('upload-modal');
  const cancelUpload = document.getElementById('cancel-upload');
  const uploadForm = document.getElementById('upload-form');
  const dropZone = document.getElementById('drop-zone');
  const fileInput = document.getElementById('file-input');
  const filePreview = document.getElementById('file-preview');
  const previewImg = document.getElementById('preview-img');
  const previewName = document.getElementById('preview-name');
  const previewSize = document.getElementById('preview-size');
  const clearFile = document.getElementById('clear-file');
  const submitBtn = document.getElementById('submit-upload');
  const toast = document.getElementById('toast');
  const toastText = document.getElementById('toast-text');

  let selectedFile = null;

  function showToast(message) {
    toastText.textContent = message;
    toast?.classList.remove('hidden');
    setTimeout(() => toast?.classList.add('hidden'), 3000);
  }

  function formatFileSize(bytes) {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
  }

  function openModal() {
    uploadModal?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    uploadModal?.classList.add('hidden');
    document.body.style.overflow = '';
    clearFileSelection();
  }

  function clearFileSelection() {
    selectedFile = null;
    fileInput.value = '';
    filePreview?.classList.add('hidden');
    dropZone?.classList.remove('hidden');
    submitBtn?.setAttribute('disabled', '');
  }

  function handleFile(file) {
    if (!file) return;

    const allowedTypes = ['image/jpeg', 'image/png', 'image/gif', 'image/webp', 'image/svg+xml'];
    if (!allowedTypes.includes(file.type)) {
      alert('Invalid file type. Allowed: JPEG, PNG, GIF, WebP, SVG');
      return;
    }

    if (file.size > 10 * 1024 * 1024) {
      alert('File too large. Maximum size is 10MB');
      return;
    }

    selectedFile = file;
    previewName.textContent = file.name;
    previewSize.textContent = formatFileSize(file.size);

    const reader = new FileReader();
    reader.onload = (e) => { previewImg.src = e.target.result; };
    reader.readAsDataURL(file);

    dropZone?.classList.add('hidden');
    filePreview?.classList.remove('hidden');
    submitBtn?.removeAttribute('disabled');
  }

  uploadBtn?.addEventListener('click', openModal);
  uploadBtnEmpty?.addEventListener('click', openModal);
  cancelUpload?.addEventListener('click', closeModal);
  clearFile?.addEventListener('click', clearFileSelection);

  uploadModal?.addEventListener('click', (e) => {
    if (e.target === uploadModal) closeModal();
  });

  dropZone?.addEventListener('click', () => fileInput?.click());
  fileInput?.addEventListener('change', (e) => handleFile(e.target.files[0]));

  dropZone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropZone.style.borderColor = 'var(--admin-accent)';
    dropZone.style.backgroundColor = 'var(--admin-accent-soft)';
  });

  dropZone?.addEventListener('dragleave', () => {
    dropZone.style.borderColor = '';
    dropZone.style.backgroundColor = '';
  });

  dropZone?.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.style.borderColor = '';
    dropZone.style.backgroundColor = '';
    handleFile(e.dataTransfer.files[0]);
  });

  uploadForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!selectedFile) return;

    submitBtn.disabled = true;
    submitBtn.textContent = 'Uploading...';

    const formData = new FormData();
    formData.append('file', selectedFile);
    formData.append('altText', document.getElementById('alt-text')?.value || '');

    try {
      const response = await fetch(`/api/clubs/${clubId}/media`, {
        method: 'POST',
        body: formData,
      });

      const result = await response.json();
      if (!response.ok) throw new Error(result.error || 'Upload failed');
      window.location.reload();
    } catch (error) {
      alert(error.message || 'Upload failed');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Upload';
    }
  });

  document.querySelectorAll('.copy-url-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const card = btn.closest('[data-media-url]');
      const url = card?.dataset.mediaUrl;
      if (url) {
        await navigator.clipboard.writeText(url);
        showToast('URL copied!');
      }
    });
  });

  document.querySelectorAll('.delete-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const card = btn.closest('[data-media-id]');
      const mediaId = card?.dataset.mediaId;
      if (!mediaId || !confirm('Delete this image?')) return;

      btn.disabled = true;
      try {
        const response = await fetch(`/api/clubs/${clubId}/media/${mediaId}`, { method: 'DELETE' });
        if (!response.ok) {
          const result = await response.json();
          throw new Error(result.error || 'Delete failed');
        }
        card?.remove();
        showToast('Image deleted');
      } catch (error) {
        alert(error.message || 'Delete failed');
        btn.disabled = false;
      }
    });
  });
</script>

<style>
  .input-themed:focus {
    border-color: var(--admin-accent, #14b8a6);
    box-shadow: 0 0 0 2px var(--admin-ring, rgba(20, 184, 166, 0.2));
  }
  .icon-accent-bg {
    background: var(--admin-accent-soft, rgba(20, 184, 166, 0.1));
  }
  .icon-accent {
    color: var(--admin-accent, #14b8a6);
  }
</style>
