---
import AdminLayout from '../../../components/admin/AdminLayout.astro';
import { DatabaseService } from '../../../lib/db';
import { getAuthContext } from '../../../lib/auth';

const { slug } = Astro.params;

// Check if database is configured
if (!Astro.locals.runtime.env.DB) {
  return Astro.redirect('/admin?error=db_not_configured');
}

// Get auth context
const db = new DatabaseService(Astro.locals.runtime.env.DB);
const { user } = await getAuthContext(Astro.cookies, db);

// Redirect if not logged in
if (!user) {
  return Astro.redirect('/admin/login');
}

// Get club
const club = await db.getClubBySlug(slug!);
if (!club) {
  return Astro.redirect('/admin');
}

// Check membership
const member = await db.getClubMember(club.id, user.id);
if (!member) {
  return Astro.redirect('/admin');
}

// Get club members
const members = await db.getClubMembers(club.id);
---

<AdminLayout
  title="Dashboard"
  club={club}
  user={user}
  member={member}
  currentPage="dashboard"
>
  <Fragment slot="header-actions">
    <a href={`/${slug}/admin-portal/posts/new`} class="flex items-center gap-2 px-4 py-2 bg-green-500 hover:bg-green-600 text-white rounded-xl transition-colors text-sm font-medium shadow-lg shadow-green-500/25">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
      </svg>
      New post
    </a>
  </Fragment>

  <!-- Quick stats -->
  <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <div class="bg-white rounded-xl p-5 border border-slate-200 shadow-sm">
      <div class="flex items-center justify-between mb-3">
        <span class="text-slate-500 text-sm font-medium">Status</span>
        {club.is_live ? (
          <span class="px-2.5 py-1 bg-green-100 text-green-700 rounded-full text-xs font-medium">Live</span>
        ) : (
          <span class="px-2.5 py-1 bg-amber-100 text-amber-700 rounded-full text-xs font-medium">Draft</span>
        )}
      </div>
      <p class="text-xl font-bold text-slate-900">{slug}.clubify.ie</p>
    </div>

    <div class="bg-white rounded-xl p-5 border border-slate-200 shadow-sm">
      <div class="flex items-center justify-between mb-3">
        <span class="text-slate-500 text-sm font-medium">Template</span>
        <div class="w-8 h-8 rounded-lg bg-slate-100 flex items-center justify-center">
          <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5z"/>
          </svg>
        </div>
      </div>
      <p class="text-xl font-bold text-slate-900 capitalize">{club.template}</p>
    </div>

    <div class="bg-white rounded-xl p-5 border border-slate-200 shadow-sm">
      <div class="flex items-center justify-between mb-3">
        <span class="text-slate-500 text-sm font-medium">Team members</span>
        <div class="w-8 h-8 rounded-lg bg-slate-100 flex items-center justify-center">
          <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1z"/>
          </svg>
        </div>
      </div>
      <p class="text-xl font-bold text-slate-900">{members.length}</p>
    </div>

    <div class="bg-white rounded-xl p-5 border border-slate-200 shadow-sm">
      <div class="flex items-center justify-between mb-3">
        <span class="text-slate-500 text-sm font-medium">Your role</span>
        <div class="w-8 h-8 rounded-lg bg-slate-100 flex items-center justify-center">
          <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
        </div>
      </div>
      <p class="text-xl font-bold text-slate-900 capitalize">{member.role}</p>
    </div>
  </div>

  <!-- Quick actions & Setup checklist -->
  <div class="grid md:grid-cols-2 gap-6 mb-8">
    <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm">
      <h2 class="text-lg font-bold text-slate-900 mb-4">Quick actions</h2>
      <div class="grid grid-cols-2 gap-3">
        <a href={`/${slug}/admin-portal/posts/new`} class="flex flex-col items-center gap-2 p-4 bg-slate-50 rounded-xl border border-slate-200 hover:border-green-300 hover:shadow-md transition-all">
          <div class="w-10 h-10 rounded-lg bg-green-100 flex items-center justify-center">
            <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
            </svg>
          </div>
          <span class="text-slate-700 text-sm font-medium">New post</span>
        </a>
        <a href={`/${slug}/admin-portal/fixtures/new`} class="flex flex-col items-center gap-2 p-4 bg-slate-50 rounded-xl border border-slate-200 hover:border-blue-300 hover:shadow-md transition-all">
          <div class="w-10 h-10 rounded-lg bg-blue-100 flex items-center justify-center">
            <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
          </div>
          <span class="text-slate-700 text-sm font-medium">Add fixture</span>
        </a>
        <a href={`/${slug}/admin-portal/homepage`} class="flex flex-col items-center gap-2 p-4 bg-slate-50 rounded-xl border border-slate-200 hover:border-purple-300 hover:shadow-md transition-all">
          <div class="w-10 h-10 rounded-lg bg-purple-100 flex items-center justify-center">
            <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5z"/>
            </svg>
          </div>
          <span class="text-slate-700 text-sm font-medium">Edit homepage</span>
        </a>
        <a href={`/${slug}/admin-portal/team`} class="flex flex-col items-center gap-2 p-4 bg-slate-50 rounded-xl border border-slate-200 hover:border-amber-300 hover:shadow-md transition-all">
          <div class="w-10 h-10 rounded-lg bg-amber-100 flex items-center justify-center">
            <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
            </svg>
          </div>
          <span class="text-slate-700 text-sm font-medium">Invite member</span>
        </a>
      </div>
    </div>

    <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm">
      <h2 class="text-lg font-bold text-slate-900 mb-4">Setup checklist</h2>
      <div class="space-y-3">
        <label class="flex items-center gap-3">
          <div class={`w-6 h-6 rounded-full flex items-center justify-center ${club.crest_url ? 'bg-green-100' : 'bg-slate-100'}`}>
            {club.crest_url ? (
              <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
            ) : (
              <div class="w-2 h-2 rounded-full bg-slate-300"></div>
            )}
          </div>
          <span class={club.crest_url ? 'text-slate-400 line-through' : 'text-slate-700'}>Upload club crest</span>
        </label>
        <label class="flex items-center gap-3">
          <div class={`w-6 h-6 rounded-full flex items-center justify-center ${club.primary_color ? 'bg-green-100' : 'bg-slate-100'}`}>
            {club.primary_color ? (
              <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
            ) : (
              <div class="w-2 h-2 rounded-full bg-slate-300"></div>
            )}
          </div>
          <span class={club.primary_color ? 'text-slate-400 line-through' : 'text-slate-700'}>Set club colours</span>
        </label>
        <label class="flex items-center gap-3">
          <div class={`w-6 h-6 rounded-full flex items-center justify-center ${club.contact_email ? 'bg-green-100' : 'bg-slate-100'}`}>
            {club.contact_email ? (
              <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
            ) : (
              <div class="w-2 h-2 rounded-full bg-slate-300"></div>
            )}
          </div>
          <span class={club.contact_email ? 'text-slate-400 line-through' : 'text-slate-700'}>Add contact info</span>
        </label>
        <label class="flex items-center gap-3">
          <div class={`w-6 h-6 rounded-full flex items-center justify-center ${members.length > 1 ? 'bg-green-100' : 'bg-slate-100'}`}>
            {members.length > 1 ? (
              <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
            ) : (
              <div class="w-2 h-2 rounded-full bg-slate-300"></div>
            )}
          </div>
          <span class={members.length > 1 ? 'text-slate-400 line-through' : 'text-slate-700'}>Invite team members</span>
        </label>
        <label class="flex items-center gap-3">
          <div class={`w-6 h-6 rounded-full flex items-center justify-center ${club.is_live ? 'bg-green-100' : 'bg-slate-100'}`}>
            {club.is_live ? (
              <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
            ) : (
              <div class="w-2 h-2 rounded-full bg-slate-300"></div>
            )}
          </div>
          <span class={club.is_live ? 'text-slate-400 line-through' : 'text-slate-700'}>Go live</span>
        </label>
      </div>
    </div>
  </div>

  <!-- Team members -->
  <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-bold text-slate-900">Team members</h2>
      <a href={`/${slug}/admin-portal/team`} class="text-green-600 hover:text-green-700 text-sm font-medium">Manage team</a>
    </div>
    <div class="space-y-3">
      {members.map((m) => (
        <div class="flex items-center gap-3 p-3 bg-slate-50 rounded-xl border border-slate-200">
          <div class="w-10 h-10 rounded-full bg-gradient-to-br from-slate-700 to-slate-800 flex items-center justify-center text-white font-medium shadow-sm">
            {m.user.name.charAt(0).toUpperCase()}
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-slate-900 font-medium truncate">{m.user.name}</p>
            <p class="text-slate-500 text-sm truncate">{m.user.email}</p>
          </div>
          <span class={`px-3 py-1 rounded-full text-xs font-medium ${
            m.role === 'admin' ? 'bg-purple-100 text-purple-700' :
            m.role === 'pro' ? 'bg-blue-100 text-blue-700' :
            m.role === 'treasurer' ? 'bg-amber-100 text-amber-700' :
            m.role === 'editor' ? 'bg-green-100 text-green-700' :
            'bg-slate-100 text-slate-600'
          }`}>{m.role}</span>
        </div>
      ))}
    </div>
  </div>
</AdminLayout>
