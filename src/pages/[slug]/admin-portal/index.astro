---
import AdminLayout from '../../../components/admin/AdminLayout.astro';
import AdminPageTemplate from '../../../components/admin/AdminPageTemplate.astro';
import AdminSection from '../../../components/admin/AdminSection.astro';
import AdminCard from '../../../components/admin/AdminCard.astro';
import StatusChip from '../../../components/admin/StatusChip.astro';
import Icon from '../../../components/admin/Icon.astro';
import { DatabaseService } from '../../../lib/db';
import { getAuthContext } from '../../../lib/auth';
import { getSport } from '../../../lib/sports';

const { slug } = Astro.params;

if (!Astro.locals.runtime.env.DB) {
  return Astro.redirect('/admin?error=db_not_configured');
}

const db = new DatabaseService(Astro.locals.runtime.env.DB);
const { user } = await getAuthContext(Astro.cookies, db);

if (!user) {
  return Astro.redirect('/admin/login');
}

const club = await db.getClubBySlug(slug!);
if (!club) {
  return Astro.redirect('/admin');
}

const member = await db.getClubMember(club.id, user.id);
if (!member) {
  return Astro.redirect('/admin');
}

const sport = getSport(club.club_type || 'gaa');
const upcomingFixtures = await db.getUpcomingFixtures(club.id, 3);
const playedFixtures = await db.getPlayedFixtures(club.id, 3);
const latestResult = playedFixtures[0] || null;

const postsResult = await Astro.locals.runtime.env.DB.prepare(`
  SELECT id, title, summary, status, published_at, created_at
  FROM posts
  WHERE club_id = ?
  ORDER BY created_at DESC
  LIMIT 5
`).bind(club.id).all();

const draftPostsResult = await Astro.locals.runtime.env.DB.prepare(`
  SELECT COUNT(*) as count
  FROM posts
  WHERE club_id = ? AND status = 'draft'
`).bind(club.id).first();

const postCountResult = await Astro.locals.runtime.env.DB.prepare(`
  SELECT COUNT(*) as count
  FROM posts
  WHERE club_id = ?
`).bind(club.id).first();

const fixtureCountResult = await Astro.locals.runtime.env.DB.prepare(`
  SELECT COUNT(*) as count
  FROM fixtures
  WHERE club_id = ?
`).bind(club.id).first();

const pageCountResult = await Astro.locals.runtime.env.DB.prepare(`
  SELECT COUNT(*) as count
  FROM pages
  WHERE club_id = ?
`).bind(club.id).first();

const contactCountResult = await Astro.locals.runtime.env.DB.prepare(`
  SELECT COUNT(*) as count
  FROM contact_submissions
  WHERE club_id = ? AND created_at >= datetime('now','-7 days')
`).bind(club.id).first();

const formCountResult = await Astro.locals.runtime.env.DB.prepare(`
  SELECT COUNT(*) as count
  FROM form_submissions
  WHERE club_id = ? AND created_at >= datetime('now','-7 days')
`).bind(club.id).first();

const mediaCountResult = await Astro.locals.runtime.env.DB.prepare(`
  SELECT COUNT(*) as count
  FROM media
  WHERE club_id = ?
`).bind(club.id).first();

const posts = postsResult.results || [];
const draftPostsCount = (draftPostsResult as any)?.count || 0;
const postCount = (postCountResult as any)?.count || 0;
const fixtureCount = (fixtureCountResult as any)?.count || 0;
const pageCount = (pageCountResult as any)?.count || 0;
const contactCount = (contactCountResult as any)?.count || 0;
const formCount = (formCountResult as any)?.count || 0;
const mediaCount = (mediaCountResult as any)?.count || 0;
const inboxCount = contactCount + formCount;

function formatDate(dateStr: string | null): string {
  if (!dateStr) return '-';
  return new Date(dateStr).toLocaleDateString('en-IE', {
    day: 'numeric',
    month: 'short',
  });
}

function formatFullDate(dateStr: string | null): string {
  if (!dateStr) return '-';
  return new Date(dateStr).toLocaleDateString('en-IE', {
    weekday: 'short',
    day: 'numeric',
    month: 'short',
  });
}
---

<AdminLayout
  title="Dashboard"
  club={club}
  user={user}
  member={member}
  currentPage="dashboard"
>
  <Fragment slot="header-actions">
    <a href={`/${slug}/admin-portal/posts/new`} class="btn-primary">
      <Icon name="plus" size="md" />
      <span class="hidden sm:inline">New post</span>
    </a>
  </Fragment>

  <div class="max-w-6xl space-y-6">
    <!-- Welcome -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl font-semibold text-slate-900">Welcome back, {user.name.split(' ')[0]}</h1>
        <p class="text-slate-500 mt-1">Here's what's happening with {club.name}</p>
      </div>
      <div class="flex items-center gap-3">
        <div class="flex items-center gap-2 px-3 py-1.5 rounded-full text-sm font-medium" class:list={[club.is_live ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700']}>
          <span class:list={["w-2 h-2 rounded-full", club.is_live ? "bg-emerald-500" : "bg-amber-500"]}></span>
          {club.is_live ? 'Live' : 'Draft'}
        </div>
        <button
          id="toggle-live"
          data-live={club.is_live ? '1' : '0'}
          data-club-id={club.id}
          class="text-sm font-medium text-slate-600 hover:text-slate-900 px-3 py-1.5 rounded-lg hover:bg-slate-100 transition-colors"
        >
          {club.is_live ? 'Set to Draft' : 'Go Live'}
        </button>
      </div>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      <a href={`/${slug}/admin-portal/posts`} class="stat-card group hover:border-slate-300 transition-colors">
        <div class="flex items-center justify-between">
          <p class="stat-card-label">Posts</p>
          <Icon name="posts" size="xl" class="text-slate-300 group-hover:text-slate-400 transition-colors" />
        </div>
        <p class="stat-card-value">{postCount}</p>
      </a>
      <a href={`/${slug}/admin-portal/fixtures`} class="stat-card group hover:border-slate-300 transition-colors">
        <div class="flex items-center justify-between">
          <p class="stat-card-label">Fixtures</p>
          <Icon name="calendar" size="xl" class="text-slate-300 group-hover:text-slate-400 transition-colors" />
        </div>
        <p class="stat-card-value">{fixtureCount}</p>
      </a>
      <a href={`/${slug}/admin-portal/media`} class="stat-card group hover:border-slate-300 transition-colors">
        <div class="flex items-center justify-between">
          <p class="stat-card-label">Media</p>
          <Icon name="media" size="xl" class="text-slate-300 group-hover:text-slate-400 transition-colors" />
        </div>
        <p class="stat-card-value">{mediaCount}</p>
      </a>
      <a href={`/${slug}/admin-portal/inbox`} class="stat-card group hover:border-slate-300 transition-colors">
        <div class="flex items-center justify-between">
          <p class="stat-card-label">Inbox (7d)</p>
          <Icon name="inbox" size="xl" class="text-slate-300 group-hover:text-slate-400 transition-colors" />
        </div>
        <p class="stat-card-value">{inboxCount}</p>
      </a>
    </div>

    <!-- Draft Alert -->
    {draftPostsCount > 0 && (
      <div class="card card-padded flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-amber-50 border-amber-200">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-lg bg-amber-100 flex items-center justify-center">
            <Icon name="edit" size="xl" class="text-amber-600" />
          </div>
          <div>
            <p class="font-medium text-amber-900">{draftPostsCount} draft post{draftPostsCount > 1 ? 's' : ''} ready for review</p>
            <p class="text-sm text-amber-700">Review and publish when ready</p>
          </div>
        </div>
        <a href={`/${slug}/admin-portal/posts`} class="btn-secondary text-amber-700 border-amber-300 hover:bg-amber-100">
          Review drafts
        </a>
      </div>
    )}

    <!-- Main Grid -->
    <div class="grid gap-6 lg:grid-cols-3">
      <!-- Left Column -->
      <div class="lg:col-span-2 space-y-6">
        <!-- Quick Actions -->
        <div class="card">
          <div class="px-5 py-4 border-b border-slate-100">
            <h2 class="font-semibold text-slate-900">Quick actions</h2>
          </div>
          <div class="p-5 grid grid-cols-2 sm:grid-cols-4 gap-3">
            <a href={`/${slug}/admin-portal/posts/new`} class="flex flex-col items-center gap-2 p-4 rounded-lg border border-slate-200 hover:border-slate-300 hover:bg-slate-50 transition-colors text-center">
              <Icon name="edit" size="xl" class="text-slate-400" />
              <span class="text-sm font-medium text-slate-700">New post</span>
            </a>
            <a href={`/${slug}/admin-portal/fixtures/new`} class="flex flex-col items-center gap-2 p-4 rounded-lg border border-slate-200 hover:border-slate-300 hover:bg-slate-50 transition-colors text-center">
              <Icon name="calendar" size="xl" class="text-slate-400" />
              <span class="text-sm font-medium text-slate-700">Add fixture</span>
            </a>
            <a href={`/${slug}/admin-portal/media`} class="flex flex-col items-center gap-2 p-4 rounded-lg border border-slate-200 hover:border-slate-300 hover:bg-slate-50 transition-colors text-center">
              <Icon name="media" size="xl" class="text-slate-400" />
              <span class="text-sm font-medium text-slate-700">Upload media</span>
            </a>
            <a href={`/${slug}/admin-portal/website`} class="flex flex-col items-center gap-2 p-4 rounded-lg border border-slate-200 hover:border-slate-300 hover:bg-slate-50 transition-colors text-center">
              <Icon name="layout" size="xl" class="text-slate-400" />
              <span class="text-sm font-medium text-slate-700">Edit website</span>
            </a>
          </div>
        </div>

        <!-- Recent Posts -->
        <div class="card">
          <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between">
            <h2 class="font-semibold text-slate-900">Recent posts</h2>
            <a href={`/${slug}/admin-portal/posts`} class="text-sm font-medium text-slate-500 hover:text-slate-700">View all</a>
          </div>
          {posts.length === 0 ? (
            <div class="p-8 text-center">
              <p class="text-slate-500">No posts yet</p>
              <a href={`/${slug}/admin-portal/posts/new`} class="text-sm font-medium link mt-2 inline-block">Create your first post</a>
            </div>
          ) : (
            <div class="divide-y divide-slate-100">
              {posts.slice(0, 4).map((post: any) => (
                <a href={`/${slug}/admin-portal/posts/${post.id}`} class="flex items-center justify-between px-5 py-4 hover:bg-slate-50 transition-colors">
                  <div class="min-w-0 flex-1">
                    <p class="font-medium text-slate-900 truncate">{post.title}</p>
                    <p class="text-sm text-slate-500 mt-0.5">{formatDate(post.published_at || post.created_at)}</p>
                  </div>
                  <StatusChip variant={post.status === 'published' ? 'success' : 'neutral'} size="sm" class="ml-4">
                    {post.status}
                  </StatusChip>
                </a>
              ))}
            </div>
          )}
        </div>

        <!-- Fixtures -->
        <div class="card">
          <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between">
            <h2 class="font-semibold text-slate-900">Fixtures & Results</h2>
            <a href={`/${slug}/admin-portal/fixtures`} class="text-sm font-medium text-slate-500 hover:text-slate-700">Manage</a>
          </div>
          <div class="p-5 grid gap-4 sm:grid-cols-2">
            <div>
              <p class="text-xs font-medium uppercase tracking-wide text-slate-400 mb-3">Upcoming</p>
              {upcomingFixtures.length === 0 ? (
                <p class="text-sm text-slate-500">No fixtures scheduled</p>
              ) : (
                <div class="space-y-2">
                  {upcomingFixtures.slice(0, 2).map((fixture) => (
                    <div class="p-3 rounded-lg border border-slate-200 bg-slate-50">
                      <p class="text-sm font-medium text-slate-900">{fixture.home_team} vs {fixture.away_team}</p>
                      <p class="text-xs text-slate-500 mt-1">{formatFullDate(fixture.match_date)} {fixture.venue ? `• ${fixture.venue}` : ''}</p>
                    </div>
                  ))}
                </div>
              )}
            </div>
            <div>
              <p class="text-xs font-medium uppercase tracking-wide text-slate-400 mb-3">Latest Result</p>
              {latestResult ? (
                <div class="p-3 rounded-lg border border-slate-200 bg-slate-50">
                  <p class="text-sm font-medium text-slate-900">{latestResult.home_team} vs {latestResult.away_team}</p>
                  <p class="text-xs text-slate-500 mt-1">{formatFullDate(latestResult.match_date)}</p>
                </div>
              ) : (
                <p class="text-sm text-slate-500">No results yet</p>
              )}
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column -->
      <div class="space-y-6">
        <!-- Site Status -->
        <AdminCard>
          <div class="flex items-center gap-3 mb-4">
            <div class:list={["w-10 h-10 rounded-lg flex items-center justify-center", club.is_live ? "bg-emerald-100" : "bg-slate-100"]}>
              <Icon name="globe" size="xl" class={club.is_live ? "text-emerald-600" : "text-slate-500"} />
            </div>
            <div>
              <p class="font-medium text-slate-900">Your website</p>
              <p class="text-sm text-slate-500">{slug}.clubify.ie</p>
            </div>
          </div>
          <a href={`/${slug}`} target="_blank" class="btn-secondary w-full justify-center">
            <Icon name="external-link" size="md" />
            View site
          </a>
        </AdminCard>

        <!-- Inbox Summary -->
        <AdminCard>
          <div class="flex items-center justify-between mb-4">
            <h3 class="font-semibold text-slate-900">Inbox</h3>
            <span class="text-xs text-slate-400">Last 7 days</span>
          </div>
          <p class="text-3xl font-semibold text-slate-900">{inboxCount}</p>
          <p class="text-sm text-slate-500 mt-1">new submissions</p>
          <a href={`/${slug}/admin-portal/inbox`} class="btn-secondary w-full justify-center mt-4">View inbox</a>
        </AdminCard>

        <!-- Sport Info -->
        <AdminCard>
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center text-white" style={`background-color: ${sport.primaryColor}`}>
              <Icon name="activity" size="xl" />
            </div>
            <div>
              <p class="font-medium text-slate-900">{sport.name}</p>
              <p class="text-sm text-slate-500">{club.county}</p>
            </div>
          </div>
          <a href={`/${slug}/admin-portal/settings/club`} class="text-sm font-medium link">Edit club settings</a>
        </AdminCard>

        <!-- Help -->
        <AdminCard class="bg-slate-50 border-slate-200">
          <h3 class="font-semibold text-slate-900 mb-2">Need help?</h3>
          <p class="text-sm text-slate-600 mb-4">Check out our guides to get the most from Clubify.</p>
          <a href="https://clubify.ie/help" target="_blank" class="text-sm font-medium link">View help centre</a>
        </AdminCard>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  const toggleBtn = document.getElementById('toggle-live');
  if (toggleBtn) {
    toggleBtn.addEventListener('click', async () => {
      const clubId = toggleBtn.getAttribute('data-club-id');
      const isLive = toggleBtn.getAttribute('data-live') === '1';
      const newLiveState = !isLive;

      toggleBtn.setAttribute('disabled', 'true');
      toggleBtn.textContent = newLiveState ? 'Going live...' : 'Setting to draft...';

      try {
        const response = await fetch(`/api/clubs/${clubId}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ is_live: newLiveState }),
        });

        if (!response.ok) throw new Error('Failed to update');
        window.location.reload();
      } catch (error) {
        console.error('Toggle live error:', error);
        toggleBtn.removeAttribute('disabled');
        toggleBtn.textContent = isLive ? 'Set to Draft' : 'Go Live';
        alert('Failed to update. Please try again.');
      }
    });
  }
</script>
