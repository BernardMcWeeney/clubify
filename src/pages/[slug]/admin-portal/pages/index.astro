---
import AdminLayout from '../../../../components/admin/AdminLayout.astro';
import AdminPageTemplate from '../../../../components/admin/AdminPageTemplate.astro';
import AdminTable from '../../../../components/admin/AdminTable.astro';
import StatusChip from '../../../../components/admin/StatusChip.astro';
import Icon from '../../../../components/admin/Icon.astro';
import Button from '../../../../components/ui/Button.astro';
import { DatabaseService } from '../../../../lib/db';
import { getAuthContext } from '../../../../lib/auth';

const { slug } = Astro.params;

if (!Astro.locals.runtime.env.DB) {
  return Astro.redirect('/admin?error=db_not_configured');
}

const db = new DatabaseService(Astro.locals.runtime.env.DB);
const { user } = await getAuthContext(Astro.cookies, db);

if (!user) {
  return Astro.redirect('/admin/login');
}

const club = await db.getClubBySlug(slug!);
if (!club) {
  return Astro.redirect('/admin');
}

const member = await db.getClubMember(club.id, user.id);
if (!member) {
  return Astro.redirect('/admin');
}

interface Page {
  id: string;
  title: string;
  slug: string;
  is_published: number;
  created_at: string;
  updated_at: string;
}

const pages = await db.getPages(club.id) as Page[];
const publishedPages = pages.filter(p => p.is_published);
const draftPages = pages.filter(p => !p.is_published);

function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString('en-IE', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  });
}

const breadcrumbs = [
  { label: 'Dashboard', href: `/${slug}/admin-portal` },
  { label: 'Pages' },
];
---

<AdminLayout
  title="Pages"
  club={club}
  user={user}
  member={member}
  currentPage="pages"
>
  <Fragment slot="header-actions">
    <Button href={`/${slug}/admin-portal/pages/new`} variant="primary">
      <Icon name="plus" size="md" />
      New page
    </Button>
  </Fragment>

  <AdminPageTemplate
    title="Pages"
    subtitle="Create and manage custom pages for your club website"
    breadcrumbs={breadcrumbs}
    wide
  >
    <div slot="actions" class="flex items-center gap-4 text-sm">
      <span class="text-slate-500">{publishedPages.length} published</span>
      <span class="text-slate-300">|</span>
      <span class="text-slate-500">{draftPages.length} drafts</span>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-3 gap-4 mb-6">
      <div class="stat-card stat-card-accent">
        <p class="stat-card-label">Total Pages</p>
        <p class="stat-card-value">{pages.length}</p>
      </div>
      <div class="stat-card">
        <p class="stat-card-label">Published</p>
        <p class="stat-card-value">{publishedPages.length}</p>
      </div>
      <div class="stat-card">
        <p class="stat-card-label">Drafts</p>
        <p class="stat-card-value">{draftPages.length}</p>
      </div>
    </div>

    <!-- Suggestions -->
    <div class="alert alert-info mb-6">
      <Icon name="info" size="lg" class="alert-icon flex-shrink-0 mt-0.5" />
      <div>
        <p class="text-sm font-medium" style="color: var(--admin-accent)">Suggested pages</p>
        <p class="text-sm text-slate-600">About, Contact, Sponsors, Safeguarding, Privacy Policy</p>
      </div>
    </div>

    {pages.length > 0 ? (
      <AdminTable>
        <thead slot="head">
          <tr>
            <th>Title</th>
            <th class="hidden md:table-cell">URL</th>
            <th>Status</th>
            <th class="hidden sm:table-cell">Updated</th>
            <th class="w-12"></th>
          </tr>
        </thead>
        <tbody slot="body">
          {pages.map((page) => (
            <tr>
              <td>
                <a href={`/${slug}/admin-portal/pages/${page.id}`} class="font-medium text-slate-900 hover:text-slate-600 transition-colors">
                  {page.title}
                </a>
              </td>
              <td class="hidden md:table-cell">
                <span class="text-sm text-slate-500 font-mono">/{slug}/{page.slug}</span>
              </td>
              <td>
                <StatusChip variant={page.is_published ? 'success' : 'neutral'} size="sm">
                  {page.is_published ? 'Published' : 'Draft'}
                </StatusChip>
              </td>
              <td class="hidden sm:table-cell">
                <span class="text-sm text-slate-500">{formatDate(page.updated_at)}</span>
              </td>
              <td>
                <div class="flex items-center justify-end gap-1">
                  <a
                    href={`/${slug}/admin-portal/pages/${page.id}`}
                    class="p-1.5 text-slate-400 hover:text-slate-600 rounded-md hover:bg-slate-100 transition-colors"
                    title="Edit"
                  >
                    <Icon name="edit" size="md" />
                  </a>
                  {page.is_published && (
                    <a
                      href={`/${slug}/${page.slug}`}
                      target="_blank"
                      class="p-1.5 text-slate-400 hover:text-slate-600 rounded-md hover:bg-slate-100 transition-colors"
                      title="View"
                    >
                      <Icon name="external-link" size="md" />
                    </a>
                  )}
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </AdminTable>
    ) : (
      <AdminTable
        emptyTitle="No pages yet"
        emptyDescription="Create pages like About, Contact, and Sponsors for your club."
      >
        <div slot="empty" class="text-center py-8">
          <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-slate-100 flex items-center justify-center">
            <Icon name="pages" size="xl" class="text-slate-400" />
          </div>
          <h3 class="text-lg font-medium text-slate-900 mb-1">No pages yet</h3>
          <p class="text-sm text-slate-500 mb-4">Create pages like About, Contact, and Sponsors for your club.</p>
          <Button href={`/${slug}/admin-portal/pages/new`} variant="primary">
            <Icon name="plus" size="md" />
            Create your first page
          </Button>
        </div>
      </AdminTable>
    )}
  </AdminPageTemplate>
</AdminLayout>
