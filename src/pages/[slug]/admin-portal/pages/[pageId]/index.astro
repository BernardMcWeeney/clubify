---
import AdminLayout from '../../../../../components/admin/AdminLayout.astro';
import AdminPageTemplate from '../../../../../components/admin/AdminPageTemplate.astro';
import AdminCard from '../../../../../components/admin/AdminCard.astro';
import StatusChip from '../../../../../components/admin/StatusChip.astro';
import Icon from '../../../../../components/admin/Icon.astro';
import Button from '../../../../../components/ui/Button.astro';
import { DatabaseService } from '../../../../../lib/db';
import { getAuthContext } from '../../../../../lib/auth';

const { slug, pageId } = Astro.params;

if (!Astro.locals.runtime.env.DB) {
  return Astro.redirect('/admin?error=db_not_configured');
}

const db = new DatabaseService(Astro.locals.runtime.env.DB);
const { user } = await getAuthContext(Astro.cookies, db);

if (!user) {
  return Astro.redirect('/admin/login');
}

const club = await db.getClubBySlug(slug!);
if (!club) {
  return Astro.redirect('/admin');
}

const member = await db.getClubMember(club.id, user.id);
if (!member) {
  return Astro.redirect('/admin');
}

if (!['admin', 'pro', 'editor'].includes(member.role)) {
  return Astro.redirect(`/${slug}/admin-portal/pages`);
}

const page = await Astro.locals.runtime.env.DB.prepare(`
  SELECT * FROM pages WHERE id = ? AND club_id = ?
`).bind(pageId, club.id).first();

if (!page) {
  return Astro.redirect(`/${slug}/admin-portal/pages`);
}

const canPublish = ['admin', 'pro'].includes(member.role);
const canDelete = ['admin', 'pro'].includes(member.role);

const breadcrumbs = [
  { label: 'Dashboard', href: `/${slug}/admin-portal` },
  { label: 'Pages', href: `/${slug}/admin-portal/pages` },
  { label: 'Edit Page' },
];
---

<AdminLayout
  title="Edit Page"
  club={club}
  user={user}
  member={member}
  currentPage="pages"
>
  <Fragment slot="header-actions">
    {page.is_published && (
      <a
        href={`/${slug}/${page.slug}`}
        target="_blank"
        class="flex items-center gap-2 px-4 py-2 border border-slate-200 text-slate-600 rounded-lg hover:bg-slate-50 transition-colors text-sm"
      >
        <Icon name="external-link" size="md" />
        View page
      </a>
    )}
  </Fragment>

  <AdminPageTemplate
    title="Edit Page"
    subtitle={page.title}
    breadcrumbs={breadcrumbs}
  >
    <div slot="actions">
      {page.is_published ? (
        <StatusChip variant="success" size="sm">Published</StatusChip>
      ) : (
        <StatusChip variant="neutral" size="sm">Draft</StatusChip>
      )}
    </div>

    <form id="page-form">
      <AdminCard>
        <div class="space-y-6">
          <div>
            <label for="title" class="block text-sm font-medium text-slate-700 mb-2">Title *</label>
            <input
              type="text"
              id="title"
              name="title"
              required
              maxlength="200"
              value={page.title}
              class="input-themed w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 placeholder-slate-400 focus:outline-none focus:bg-white transition-colors"
            />
          </div>

          <div>
            <label for="metaDescription" class="block text-sm font-medium text-slate-700 mb-2">Description (SEO)</label>
            <textarea
              id="metaDescription"
              name="metaDescription"
              rows="2"
              maxlength="160"
              class="input-themed w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 placeholder-slate-400 focus:outline-none focus:bg-white transition-colors resize-none"
            >{page.meta_description || ''}</textarea>
          </div>

          <div>
            <label for="content" class="block text-sm font-medium text-slate-700 mb-2">Content</label>
            <textarea
              id="content"
              name="content"
              rows="20"
              class="input-themed w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 placeholder-slate-400 focus:outline-none focus:bg-white transition-colors font-mono text-sm"
            >{page.content || ''}</textarea>
          </div>

          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pt-4 border-t border-slate-200">
            <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3 w-full sm:w-auto">
              <Button type="submit" name="action" value="save" variant="primary">
                Save Changes
              </Button>

              {!page.is_published && canPublish && (
                <button
                  type="submit"
                  name="action"
                  value="publish"
                  class="w-full sm:w-auto px-6 py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl transition-colors font-medium"
                >
                  Publish
                </button>
              )}

              {page.is_published && canPublish && (
                <button
                  type="submit"
                  name="action"
                  value="unpublish"
                  class="w-full sm:w-auto px-6 py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl transition-colors font-medium"
                >
                  Unpublish
                </button>
              )}
            </div>

            {canDelete && (
              <button
                type="button"
                id="delete-btn"
                class="w-full sm:w-auto px-6 py-3 bg-red-50 hover:bg-red-100 text-red-600 rounded-xl transition-colors font-medium"
              >
                Delete
              </button>
            )}
          </div>
        </div>
      </AdminCard>

      <div id="loading" class="hidden fixed inset-0 bg-slate-900/40 backdrop-blur-sm flex items-center justify-center z-50">
        <div class="bg-white rounded-xl p-6 text-center border border-slate-200 shadow-xl">
          <div class="w-8 h-8 border-2 border-t-transparent rounded-full animate-spin mx-auto mb-3" style="border-color: var(--admin-accent); border-top-color: transparent;"></div>
          <p class="text-slate-700">Saving...</p>
        </div>
      </div>
    </form>

    <div id="delete-modal" class="hidden fixed inset-0 bg-slate-900/40 backdrop-blur-sm flex items-center justify-center z-50">
      <div class="bg-white rounded-xl p-6 max-w-md mx-4 border border-slate-200 shadow-xl">
        <h3 class="text-lg font-bold text-slate-900 mb-2">Delete Page</h3>
        <p class="text-slate-500 mb-6">Are you sure you want to delete "{page.title}"?</p>
        <div class="flex items-center gap-3 justify-end">
          <button id="cancel-delete" class="px-4 py-2 text-slate-600 hover:text-slate-900 transition-colors">Cancel</button>
          <button id="confirm-delete" class="px-4 py-2 bg-red-500 hover:bg-red-600 text-white rounded-lg transition-colors">Delete</button>
        </div>
      </div>
    </div>
  </AdminPageTemplate>
</AdminLayout>

<style>
  .input-themed:focus {
    border-color: var(--admin-accent, #14b8a6);
    box-shadow: 0 0 0 2px var(--admin-ring, rgba(20, 184, 166, 0.2));
  }
</style>

<script define:vars={{ clubId: club.id, pageId, slug }}>
  const form = document.getElementById('page-form');
  const loading = document.getElementById('loading');
  const deleteBtn = document.getElementById('delete-btn');
  const deleteModal = document.getElementById('delete-modal');
  const cancelDelete = document.getElementById('cancel-delete');
  const confirmDelete = document.getElementById('confirm-delete');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const action = e.submitter?.value || 'save';

    const data = {
      title: formData.get('title'),
      metaDescription: formData.get('metaDescription') || null,
      content: formData.get('content') || null,
    };

    if (action === 'publish') {
      data.isPublished = true;
    } else if (action === 'unpublish') {
      data.isPublished = false;
    }

    if (!data.title?.trim()) {
      alert('Title is required');
      return;
    }

    loading?.classList.remove('hidden');

    try {
      const response = await fetch(`/api/clubs/${clubId}/pages/${pageId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.error || 'Failed to update page');
      }

      window.location.reload();
    } catch (error) {
      alert(error.message || 'Failed to update page');
      loading?.classList.add('hidden');
    }
  });

  deleteBtn?.addEventListener('click', () => deleteModal?.classList.remove('hidden'));
  cancelDelete?.addEventListener('click', () => deleteModal?.classList.add('hidden'));

  confirmDelete?.addEventListener('click', async () => {
    loading?.classList.remove('hidden');
    deleteModal?.classList.add('hidden');

    try {
      const response = await fetch(`/api/clubs/${clubId}/pages/${pageId}`, {
        method: 'DELETE',
      });

      if (!response.ok) {
        const result = await response.json();
        throw new Error(result.error || 'Failed to delete page');
      }

      window.location.href = `/${slug}/admin-portal/pages`;
    } catch (error) {
      alert(error.message || 'Failed to delete page');
      loading?.classList.add('hidden');
    }
  });
</script>
