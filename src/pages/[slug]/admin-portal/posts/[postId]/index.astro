---
import AdminLayout from '../../../../../components/admin/AdminLayout.astro';
import { DatabaseService } from '../../../../../lib/db';
import { getAuthContext } from '../../../../../lib/auth';

const { slug, postId } = Astro.params;

if (!Astro.locals.runtime.env.DB) {
  return Astro.redirect('/admin?error=db_not_configured');
}

const db = new DatabaseService(Astro.locals.runtime.env.DB);
const { user } = await getAuthContext(Astro.cookies, db);

if (!user) {
  return Astro.redirect('/admin/login');
}

const club = await db.getClubBySlug(slug!);
if (!club) {
  return Astro.redirect('/admin');
}

const member = await db.getClubMember(club.id, user.id);
if (!member) {
  return Astro.redirect('/admin');
}

// Check permissions
if (!['admin', 'pro', 'editor'].includes(member.role)) {
  return Astro.redirect(`/${slug}/admin-portal/posts`);
}

// Get post
const post = await Astro.locals.runtime.env.DB.prepare(`
  SELECT * FROM posts WHERE id = ? AND club_id = ?
`).bind(postId, club.id).first();

if (!post) {
  return Astro.redirect(`/${slug}/admin-portal/posts`);
}

const canPublish = ['admin', 'pro'].includes(member.role);
const canDelete = ['admin', 'pro'].includes(member.role);
---

<AdminLayout
  title="Edit Post"
  club={club}
  user={user}
  member={member}
  currentPage="posts"
>
  <Fragment slot="header-left">
    <div class="flex items-center gap-4">
      <a href={`/${slug}/admin-portal/posts`} class="p-2 text-slate-400 hover:text-white transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
      </a>
      <h1 class="text-xl font-bold text-white">Edit Post</h1>
      {post.status === 'published' && (
        <span class="px-2 py-1 bg-green-500/20 text-green-400 rounded-full text-xs font-medium">Published</span>
      )}
    </div>
  </Fragment>

  <Fragment slot="header-actions">
    {post.status === 'published' && (
      <a
        href={`/${slug}/news/${post.slug}`}
        target="_blank"
        class="flex items-center gap-2 px-4 py-2 border border-slate-600 text-slate-300 rounded-lg hover:bg-slate-800 transition-colors text-sm"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
        </svg>
        View post
      </a>
    )}
  </Fragment>

  <form id="post-form" class="max-w-4xl">
    <div class="space-y-6">
      <!-- Title -->
      <div>
        <label for="title" class="block text-sm font-medium text-slate-300 mb-2">Title *</label>
        <input
          type="text"
          id="title"
          name="title"
          required
          maxlength="200"
          value={post.title}
          class="w-full px-4 py-3 bg-slate-800/50 border border-slate-700 rounded-lg text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent"
          placeholder="Enter post title..."
        />
      </div>

      <!-- Summary -->
      <div>
        <label for="summary" class="block text-sm font-medium text-slate-300 mb-2">Summary</label>
        <textarea
          id="summary"
          name="summary"
          rows="2"
          maxlength="300"
          class="w-full px-4 py-3 bg-slate-800/50 border border-slate-700 rounded-lg text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent resize-none"
          placeholder="Brief summary for previews..."
        >{post.summary || ''}</textarea>
        <p class="text-slate-500 text-xs mt-1">Max 300 characters. Shows in news listings.</p>
      </div>

      <!-- Category -->
      <div>
        <label for="category" class="block text-sm font-medium text-slate-300 mb-2">Category</label>
        <select
          id="category"
          name="category"
          class="w-full px-4 py-3 bg-slate-800/50 border border-slate-700 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent"
        >
          <option value="news" selected={post.category === 'news'}>News</option>
          <option value="match-report" selected={post.category === 'match-report'}>Match Report</option>
          <option value="fundraiser" selected={post.category === 'fundraiser'}>Fundraiser</option>
          <option value="notice" selected={post.category === 'notice'}>Notice</option>
        </select>
      </div>

      <!-- Featured Image URL -->
      <div>
        <label for="featuredImage" class="block text-sm font-medium text-slate-300 mb-2">Featured Image URL</label>
        <input
          type="url"
          id="featuredImage"
          name="featuredImage"
          value={post.featured_image || ''}
          class="w-full px-4 py-3 bg-slate-800/50 border border-slate-700 rounded-lg text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent"
          placeholder="https://..."
        />
        {post.featured_image && (
          <div class="mt-3">
            <img src={post.featured_image} alt="Preview" class="max-w-xs rounded-lg" />
          </div>
        )}
      </div>

      <!-- Content -->
      <div>
        <label for="content" class="block text-sm font-medium text-slate-300 mb-2">Content</label>
        <textarea
          id="content"
          name="content"
          rows="15"
          class="w-full px-4 py-3 bg-slate-800/50 border border-slate-700 rounded-lg text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent font-mono text-sm"
          placeholder="Write your post content here..."
        >{post.content || ''}</textarea>
        <p class="text-slate-500 text-xs mt-1">Supports Markdown: **bold**, *italic*, [links](url), # headings</p>
      </div>

      <!-- Actions -->
      <div class="flex items-center justify-between pt-4 border-t border-slate-700">
        <div class="flex items-center gap-4">
          <button
            type="submit"
            name="action"
            value="save"
            class="px-6 py-3 bg-green-500 hover:bg-green-600 text-white rounded-lg transition-colors font-medium"
          >
            Save Changes
          </button>

          {post.status === 'draft' && canPublish && (
            <button
              type="submit"
              name="action"
              value="publish"
              class="px-6 py-3 bg-slate-700 hover:bg-slate-600 text-white rounded-lg transition-colors font-medium"
            >
              Publish
            </button>
          )}

          {post.status === 'published' && canPublish && (
            <button
              type="submit"
              name="action"
              value="unpublish"
              class="px-6 py-3 bg-slate-700 hover:bg-slate-600 text-white rounded-lg transition-colors font-medium"
            >
              Unpublish
            </button>
          )}
        </div>

        {canDelete && (
          <button
            type="button"
            id="delete-btn"
            class="px-6 py-3 bg-red-500/10 hover:bg-red-500/20 text-red-400 rounded-lg transition-colors font-medium"
          >
            Delete
          </button>
        )}
      </div>
    </div>

    <!-- Loading state -->
    <div id="loading" class="hidden fixed inset-0 bg-slate-950/80 flex items-center justify-center z-50">
      <div class="bg-slate-800 rounded-xl p-6 text-center">
        <div class="w-8 h-8 border-2 border-green-500 border-t-transparent rounded-full animate-spin mx-auto mb-3"></div>
        <p class="text-white">Saving...</p>
      </div>
    </div>
  </form>

  <!-- Delete confirmation modal -->
  <div id="delete-modal" class="hidden fixed inset-0 bg-slate-950/80 flex items-center justify-center z-50">
    <div class="bg-slate-800 rounded-xl p-6 max-w-md mx-4">
      <h3 class="text-lg font-bold text-white mb-2">Delete Post</h3>
      <p class="text-slate-400 mb-6">Are you sure you want to delete "{post.title}"? This action cannot be undone.</p>
      <div class="flex items-center gap-3 justify-end">
        <button id="cancel-delete" class="px-4 py-2 text-slate-300 hover:text-white transition-colors">Cancel</button>
        <button id="confirm-delete" class="px-4 py-2 bg-red-500 hover:bg-red-600 text-white rounded-lg transition-colors">Delete</button>
      </div>
    </div>
  </div>
</AdminLayout>

<script define:vars={{ clubId: club.id, postId, slug, currentStatus: post.status }}>
  const form = document.getElementById('post-form');
  const loading = document.getElementById('loading');
  const deleteBtn = document.getElementById('delete-btn');
  const deleteModal = document.getElementById('delete-modal');
  const cancelDelete = document.getElementById('cancel-delete');
  const confirmDelete = document.getElementById('confirm-delete');

  // Form submission
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const action = e.submitter?.value || 'save';

    const data = {
      title: formData.get('title'),
      summary: formData.get('summary') || null,
      category: formData.get('category'),
      featuredImage: formData.get('featuredImage') || null,
      content: formData.get('content') || null,
    };

    if (action === 'publish') {
      data.status = 'published';
    } else if (action === 'unpublish') {
      data.status = 'draft';
    }

    if (!data.title?.trim()) {
      alert('Title is required');
      return;
    }

    loading?.classList.remove('hidden');

    try {
      const response = await fetch(`/api/clubs/${clubId}/posts/${postId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.error || 'Failed to update post');
      }

      // Reload page to show updated status
      window.location.reload();
    } catch (error) {
      alert(error.message || 'Failed to update post');
      loading?.classList.add('hidden');
    }
  });

  // Delete functionality
  deleteBtn?.addEventListener('click', () => {
    deleteModal?.classList.remove('hidden');
  });

  cancelDelete?.addEventListener('click', () => {
    deleteModal?.classList.add('hidden');
  });

  confirmDelete?.addEventListener('click', async () => {
    loading?.classList.remove('hidden');
    deleteModal?.classList.add('hidden');

    try {
      const response = await fetch(`/api/clubs/${clubId}/posts/${postId}`, {
        method: 'DELETE',
      });

      if (!response.ok) {
        const result = await response.json();
        throw new Error(result.error || 'Failed to delete post');
      }

      window.location.href = `/${slug}/admin-portal/posts`;
    } catch (error) {
      alert(error.message || 'Failed to delete post');
      loading?.classList.add('hidden');
    }
  });
</script>
