---
import AdminLayout from '../../../../components/admin/AdminLayout.astro';
import { DatabaseService } from '../../../../lib/db';
import { getAuthContext } from '../../../../lib/auth';
import { hasPermission, type Role } from '../../../../lib/permissions';
import { IRISH_COUNTIES } from '../../../../lib/utils';

const { slug } = Astro.params;

if (!Astro.locals.runtime.env.DB) {
  return Astro.redirect('/admin?error=db_not_configured');
}

const db = new DatabaseService(Astro.locals.runtime.env.DB);
const { user } = await getAuthContext(Astro.cookies, db);

if (!user) {
  return Astro.redirect('/admin/login');
}

const club = await db.getClubBySlug(slug!);
if (!club) {
  return Astro.redirect('/admin');
}

const member = await db.getClubMember(club.id, user.id);
if (!member) {
  return Astro.redirect('/admin');
}

const canEdit = hasPermission(member.role as Role, 'club.edit');
---

<AdminLayout
  title="Club Details"
  club={club}
  user={user}
  member={member}
  currentPage="settings"
>
  <div class="max-w-2xl">
    <div class="flex items-center gap-4 mb-6">
      <a href={`/${slug}/admin-portal/settings`} class="p-2 text-slate-400 hover:text-slate-600 transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
      </a>
      <div>
        <h2 class="text-xl font-bold text-slate-900">Club Details</h2>
        <p class="text-slate-500 text-sm">Manage your club's information and branding</p>
      </div>
    </div>

    {!canEdit && (
      <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 mb-6">
        <p class="text-amber-700 text-sm">You don't have permission to edit club settings.</p>
      </div>
    )}

    <form id="club-form" class="space-y-6">
      <!-- Basic Info -->
      <div class="bg-white rounded-xl border border-slate-200 p-6 shadow-sm">
        <h3 class="text-lg font-semibold text-slate-900 mb-4">Basic Information</h3>

        <div class="space-y-4">
          <div>
            <label for="name" class="block text-sm font-medium text-slate-700 mb-2">Club Name</label>
            <input
              type="text"
              id="name"
              name="name"
              value={club.name}
              disabled={!canEdit}
              class="w-full px-4 py-3 bg-white border border-slate-300 rounded-lg text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-green-500 disabled:bg-slate-50 disabled:opacity-60 disabled:cursor-not-allowed"
            />
          </div>

          <div>
            <label for="tagline" class="block text-sm font-medium text-slate-700 mb-2">Tagline</label>
            <input
              type="text"
              id="tagline"
              name="tagline"
              value={club.tagline || ''}
              placeholder="e.g., Proud GAA Club since 1920"
              disabled={!canEdit}
              class="w-full px-4 py-3 bg-white border border-slate-300 rounded-lg text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-green-500 disabled:bg-slate-50 disabled:opacity-60 disabled:cursor-not-allowed"
            />
          </div>

          <div>
            <label for="county" class="block text-sm font-medium text-slate-700 mb-2">County</label>
            <div class="relative">
              <select
                id="county"
                name="county"
                disabled={!canEdit}
                class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 appearance-none focus:outline-none focus:ring-2 focus:ring-green-500 focus:bg-white disabled:bg-slate-100 disabled:opacity-60 disabled:cursor-not-allowed transition-colors"
              >
                <option value="" disabled>Select a county</option>
                {IRISH_COUNTIES.map((county) => (
                  <option value={county} selected={club.county === county}>{county}</option>
                ))}
              </select>
              <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3">
                <svg class="h-5 w-5 text-slate-400" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Branding -->
      <div class="bg-white rounded-xl border border-slate-200 p-6 shadow-sm">
        <h3 class="text-lg font-semibold text-slate-900 mb-4">Branding</h3>

        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-2">Club Crest</label>
            <div class="flex items-center gap-4">
              {club.crest_url ? (
                <img src={club.crest_url} alt={club.name} class="w-20 h-20 rounded-lg object-contain bg-slate-100 border border-slate-200" />
              ) : (
                <div class="w-20 h-20 rounded-lg bg-slate-100 border border-slate-200 flex items-center justify-center text-slate-400">
                  <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                  </svg>
                </div>
              )}
              <div class="text-slate-500 text-sm">
                <p>To update your crest, upload it in the Media library and contact support.</p>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-3 gap-4">
            <div>
              <label for="primary_color" class="block text-sm font-medium text-slate-700 mb-2">Primary Color</label>
              <div class="flex items-center gap-2">
                <input
                  type="color"
                  id="primary_color"
                  name="primary_color"
                  value={club.primary_color}
                  disabled={!canEdit}
                  class="w-12 h-12 rounded-lg cursor-pointer border border-slate-300 disabled:opacity-50 disabled:cursor-not-allowed"
                />
                <input
                  type="text"
                  value={club.primary_color}
                  id="primary_color_text"
                  class="flex-1 px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-slate-900 text-sm font-mono"
                  readonly
                />
              </div>
            </div>

            <div>
              <label for="secondary_color" class="block text-sm font-medium text-slate-700 mb-2">Secondary</label>
              <div class="flex items-center gap-2">
                <input
                  type="color"
                  id="secondary_color"
                  name="secondary_color"
                  value={club.secondary_color}
                  disabled={!canEdit}
                  class="w-12 h-12 rounded-lg cursor-pointer border border-slate-300 disabled:opacity-50 disabled:cursor-not-allowed"
                />
                <input
                  type="text"
                  value={club.secondary_color}
                  id="secondary_color_text"
                  class="flex-1 px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-slate-900 text-sm font-mono"
                  readonly
                />
              </div>
            </div>

            <div>
              <label for="accent_color" class="block text-sm font-medium text-slate-700 mb-2">Accent</label>
              <div class="flex items-center gap-2">
                <input
                  type="color"
                  id="accent_color"
                  name="accent_color"
                  value={club.accent_color}
                  disabled={!canEdit}
                  class="w-12 h-12 rounded-lg cursor-pointer border border-slate-300 disabled:opacity-50 disabled:cursor-not-allowed"
                />
                <input
                  type="text"
                  value={club.accent_color}
                  id="accent_color_text"
                  class="flex-1 px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-slate-900 text-sm font-mono"
                  readonly
                />
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Contact -->
      <div class="bg-white rounded-xl border border-slate-200 p-6 shadow-sm">
        <h3 class="text-lg font-semibold text-slate-900 mb-4">Contact Information</h3>

        <div class="space-y-4">
          <div>
            <label for="contact_email" class="block text-sm font-medium text-slate-700 mb-2">Email</label>
            <input
              type="email"
              id="contact_email"
              name="contact_email"
              value={club.contact_email || ''}
              placeholder="info@yourclub.ie"
              disabled={!canEdit}
              class="w-full px-4 py-3 bg-white border border-slate-300 rounded-lg text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-green-500 disabled:bg-slate-50 disabled:opacity-60 disabled:cursor-not-allowed"
            />
          </div>

          <div>
            <label for="contact_phone" class="block text-sm font-medium text-slate-700 mb-2">Phone</label>
            <input
              type="tel"
              id="contact_phone"
              name="contact_phone"
              value={club.contact_phone || ''}
              placeholder="01 234 5678"
              disabled={!canEdit}
              class="w-full px-4 py-3 bg-white border border-slate-300 rounded-lg text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-green-500 disabled:bg-slate-50 disabled:opacity-60 disabled:cursor-not-allowed"
            />
          </div>

          <div>
            <label for="address" class="block text-sm font-medium text-slate-700 mb-2">Address</label>
            <textarea
              id="address"
              name="address"
              rows="2"
              disabled={!canEdit}
              class="w-full px-4 py-3 bg-white border border-slate-300 rounded-lg text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-green-500 disabled:bg-slate-50 disabled:opacity-60 disabled:cursor-not-allowed resize-none"
              placeholder="Club grounds address..."
            >{club.address || ''}</textarea>
          </div>
        </div>
      </div>

      <!-- Social Links -->
      <div class="bg-white rounded-xl border border-slate-200 p-6 shadow-sm">
        <h3 class="text-lg font-semibold text-slate-900 mb-4">Social Media</h3>

        <div class="space-y-4">
          <div>
            <label for="facebook_url" class="block text-sm font-medium text-slate-700 mb-2">Facebook Page URL</label>
            <input
              type="url"
              id="facebook_url"
              name="facebook_url"
              value={club.facebook_url || ''}
              placeholder="https://facebook.com/yourclub"
              disabled={!canEdit}
              class="w-full px-4 py-3 bg-white border border-slate-300 rounded-lg text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-green-500 disabled:bg-slate-50 disabled:opacity-60 disabled:cursor-not-allowed"
            />
          </div>

          <div>
            <label for="twitter_url" class="block text-sm font-medium text-slate-700 mb-2">Twitter/X URL</label>
            <input
              type="url"
              id="twitter_url"
              name="twitter_url"
              value={club.twitter_url || ''}
              placeholder="https://twitter.com/yourclub"
              disabled={!canEdit}
              class="w-full px-4 py-3 bg-white border border-slate-300 rounded-lg text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-green-500 disabled:bg-slate-50 disabled:opacity-60 disabled:cursor-not-allowed"
            />
          </div>

          <div>
            <label for="instagram_url" class="block text-sm font-medium text-slate-700 mb-2">Instagram URL</label>
            <input
              type="url"
              id="instagram_url"
              name="instagram_url"
              value={club.instagram_url || ''}
              placeholder="https://instagram.com/yourclub"
              disabled={!canEdit}
              class="w-full px-4 py-3 bg-white border border-slate-300 rounded-lg text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-green-500 disabled:bg-slate-50 disabled:opacity-60 disabled:cursor-not-allowed"
            />
          </div>
        </div>
      </div>

      {canEdit && (
        <div class="flex items-center justify-end gap-4">
          <button
            type="submit"
            class="px-6 py-3 bg-green-500 hover:bg-green-600 text-white font-medium rounded-lg transition-colors shadow-lg shadow-green-500/25"
          >
            Save Changes
          </button>
        </div>
      )}
    </form>
  </div>

  <div id="loading" class="hidden fixed inset-0 bg-white/80 backdrop-blur-sm flex items-center justify-center z-50">
    <div class="bg-white rounded-xl p-6 text-center shadow-xl border border-slate-200">
      <div class="w-8 h-8 border-2 border-green-500 border-t-transparent rounded-full animate-spin mx-auto mb-3"></div>
      <p class="text-slate-700">Saving...</p>
    </div>
  </div>
</AdminLayout>

<script define:vars={{ clubId: club.id, slug }}>
  const form = document.getElementById('club-form');
  const loading = document.getElementById('loading');

  // Sync color pickers with text inputs
  ['primary', 'secondary', 'accent'].forEach(color => {
    const picker = document.getElementById(`${color}_color`);
    const text = document.getElementById(`${color}_color_text`);
    picker?.addEventListener('input', (e) => {
      if (text) text.value = e.target.value;
    });
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(form);

    const data = {
      name: formData.get('name'),
      tagline: formData.get('tagline') || null,
      county: formData.get('county'),
      primary_color: formData.get('primary_color'),
      secondary_color: formData.get('secondary_color'),
      accent_color: formData.get('accent_color'),
      contact_email: formData.get('contact_email') || null,
      contact_phone: formData.get('contact_phone') || null,
      address: formData.get('address') || null,
      facebook_url: formData.get('facebook_url') || null,
      twitter_url: formData.get('twitter_url') || null,
      instagram_url: formData.get('instagram_url') || null,
    };

    loading?.classList.remove('hidden');

    try {
      const response = await fetch(`/api/clubs/${clubId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.error || 'Failed to save');
      }

      // Reload to show changes
      window.location.reload();
    } catch (error) {
      alert(error.message || 'Failed to save changes');
      loading?.classList.add('hidden');
    }
  });
</script>
