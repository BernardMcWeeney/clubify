---
import AdminLayout from '../../../../components/admin/AdminLayout.astro';
import { DatabaseService } from '../../../../lib/db';
import { getAuthContext } from '../../../../lib/auth';
import { hasPermission, type Role } from '../../../../lib/permissions';

const { slug } = Astro.params;

if (!Astro.locals.runtime.env.DB) {
  return Astro.redirect('/admin?error=db_not_configured');
}

const db = new DatabaseService(Astro.locals.runtime.env.DB);
const { user } = await getAuthContext(Astro.cookies, db);

if (!user) {
  return Astro.redirect('/admin/login');
}

const club = await db.getClubBySlug(slug!);
if (!club) {
  return Astro.redirect('/admin');
}

const member = await db.getClubMember(club.id, user.id);
if (!member) {
  return Astro.redirect('/admin');
}

const canEdit = hasPermission(member.role as Role, 'settings.edit');

// Get current module configuration
const moduleConfig = await db.getModuleConfig(club.id);

const modules = [
  {
    id: 'posts',
    name: 'News & Posts',
    description: 'Create and publish news articles, match reports, and announcements',
    icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>',
  },
  {
    id: 'fixtures',
    name: 'Fixtures & Results',
    description: 'Manage match fixtures, record results, and display GAA scores',
    icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>',
  },
  {
    id: 'sponsors',
    name: 'Sponsors',
    description: 'Manage club sponsors with logos, tiers, and placements',
    icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>',
  },
  {
    id: 'forms',
    name: 'Custom Forms',
    description: 'Build custom forms for registrations, enquiries, and data collection',
    icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>',
  },
  {
    id: 'inbox',
    name: 'Inbox',
    description: 'Receive and manage contact form submissions and form responses',
    icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>',
  },
  {
    id: 'media',
    name: 'Media Library',
    description: 'Upload and manage images, photos, and media assets',
    icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>',
  },
];
---

<AdminLayout
  title="Module Settings"
  club={club}
  user={user}
  member={member}
  currentPage="settings"
>
  <div class="max-w-4xl">
    <div class="flex items-center gap-4 mb-6">
      <a href={`/${slug}/admin-portal/settings`} class="p-2 text-slate-400 hover:text-slate-600 transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
      </a>
      <div>
        <h2 class="text-xl font-bold text-slate-900">Module Settings</h2>
        <p class="text-slate-500 text-sm">Enable or disable features for your club</p>
      </div>
    </div>

    {!canEdit && (
      <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 mb-6">
        <p class="text-amber-700 text-sm">You don't have permission to edit module settings.</p>
      </div>
    )}

    <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 mb-6">
      <div class="flex gap-3">
        <svg class="w-5 h-5 text-blue-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <div>
          <p class="text-blue-900 text-sm font-medium">About Module Settings</p>
          <p class="text-blue-700 text-sm mt-1">Disabled modules will be hidden from your admin navigation and inaccessible to all users. This helps keep your dashboard clean and focused on the features you actually use.</p>
        </div>
      </div>
    </div>

    <form id="modules-form" class="space-y-4">
      {modules.map((module) => (
        <div class="bg-white rounded-xl border border-slate-200 p-6 shadow-sm">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0">
              <div class="w-12 h-12 rounded-lg bg-slate-100 flex items-center justify-center text-slate-600">
                <Fragment set:html={module.icon} />
              </div>
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-lg font-semibold text-slate-900 mb-1">{module.name}</h3>
              <p class="text-slate-500 text-sm">{module.description}</p>
            </div>
            <div class="flex-shrink-0">
              <label class="relative inline-flex items-center cursor-pointer">
                <input
                  type="checkbox"
                  name={module.id}
                  checked={moduleConfig[module.id] !== false}
                  disabled={!canEdit}
                  class="sr-only peer"
                />
                <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-green-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-green-500 peer-disabled:opacity-50 peer-disabled:cursor-not-allowed"></div>
              </label>
            </div>
          </div>
        </div>
      ))}
    </form>

    {canEdit && (
      <div class="flex items-center gap-4 mt-6">
        <button
          type="button"
          id="save-button"
          class="px-6 py-3 bg-green-500 hover:bg-green-600 text-white font-medium rounded-lg transition-colors shadow-lg shadow-green-500/25"
        >
          Save Changes
        </button>
        <a
          href={`/${slug}/admin-portal/settings`}
          class="px-6 py-3 text-slate-600 hover:text-slate-900 transition-colors font-medium"
        >
          Cancel
        </a>
      </div>
    )}

    <div id="loading" class="hidden fixed inset-0 bg-white/80 backdrop-blur-sm flex items-center justify-center z-50">
      <div class="bg-white rounded-xl p-6 text-center shadow-xl border border-slate-200">
        <div class="w-8 h-8 border-2 border-green-500 border-t-transparent rounded-full animate-spin mx-auto mb-3"></div>
        <p class="text-slate-700">Saving...</p>
      </div>
    </div>
  </div>
</AdminLayout>

<script define:vars={{ clubId: club.id, slug }}>
  const form = document.getElementById('modules-form');
  const saveButton = document.getElementById('save-button');
  const loading = document.getElementById('loading');

  saveButton?.addEventListener('click', async () => {
    const formData = new FormData(form);

    // Build config object - unchecked checkboxes won't be in formData
    const config = {
      posts: formData.has('posts'),
      fixtures: formData.has('fixtures'),
      sponsors: formData.has('sponsors'),
      forms: formData.has('forms'),
      inbox: formData.has('inbox'),
      media: formData.has('media'),
    };

    loading?.classList.remove('hidden');

    try {
      const response = await fetch(`/api/clubs/${clubId}/modules`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ config }),
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.error || 'Failed to save');
      }

      // Reload to update navigation
      window.location.reload();
    } catch (error) {
      alert(error.message || 'Failed to save changes');
      loading?.classList.add('hidden');
    }
  });
</script>
