---
import AdminLayout from '../../../../components/admin/AdminLayout.astro';
import { DatabaseService } from '../../../../lib/db';
import { getAuthContext } from '../../../../lib/auth';
import { hasPermission, type Role } from '../../../../lib/permissions';

const { slug } = Astro.params;

if (!Astro.locals.runtime.env.DB) {
  return Astro.redirect('/admin?error=db_not_configured');
}

const db = new DatabaseService(Astro.locals.runtime.env.DB);
const { user } = await getAuthContext(Astro.cookies, db);

if (!user) {
  return Astro.redirect('/admin/login');
}

const club = await db.getClubBySlug(slug!);
if (!club) {
  return Astro.redirect('/admin');
}

const member = await db.getClubMember(club.id, user.id);
if (!member) {
  return Astro.redirect('/admin');
}

const canEdit = hasPermission(member.role as Role, 'settings.edit');

// Get current module configuration
const moduleConfig = await db.getModuleConfig(club.id);

const modules = [
  {
    id: 'posts',
    name: 'News & Posts',
    description: 'Publish news, match reports, and announcements',
  },
  {
    id: 'fixtures',
    name: 'Fixtures & Results',
    description: 'Manage fixtures, results, and matchday updates',
  },
  {
    id: 'sponsors',
    name: 'Sponsors',
    description: 'Manage sponsor profiles and placements',
  },
  {
    id: 'forms',
    name: 'Forms',
    description: 'Create custom forms for registrations and enquiries',
  },
  {
    id: 'inbox',
    name: 'Inbox',
    description: 'View contact submissions and form responses',
  },
  {
    id: 'media',
    name: 'Media Library',
    description: 'Upload and organize photos and assets',
  },
];

const comingSoon = [
  { name: 'Membership', description: 'Subscriptions, renewals, and member profiles' },
  { name: 'Fundraising', description: 'Campaigns, donations, and sponsorship drives' },
  { name: 'Payments', description: 'Track payments across modules' },
  { name: 'Policy & GDPR', description: 'Document hub and compliance workflows' },
  { name: 'Ticketing', description: 'Matchday and event ticket sales' },
  { name: 'Merch', description: 'Online shop for club merchandise' },
];
---

<AdminLayout
  title="Module Settings"
  club={club}
  user={user}
  member={member}
  currentPage="settings"
>
  <div class="max-w-4xl space-y-6">
    <header class="flex items-start gap-3">
      <a href={`/${slug}/admin-portal/settings`} class="p-2 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-100">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
      </a>
      <div>
        <p class="text-sm text-slate-500">Modules</p>
        <h1 class="text-3xl font-semibold text-slate-900 admin-display">Enable the features you need</h1>
        <p class="text-slate-600 mt-2">Hide unused modules to keep the hub focused for your team.</p>
      </div>
    </header>

    {!canEdit && (
      <div class="admin-panel-soft p-4 text-sm text-amber-700">
        You don't have permission to edit module settings.
      </div>
    )}

    <div class="admin-panel-soft p-4 text-sm text-slate-600">
      Disabled modules are hidden from the sidebar and inaccessible to all users.
    </div>

    <form id="modules-form" class="space-y-4">
      {modules.map((module) => (
        <div class="admin-panel p-5 flex items-start justify-between gap-4">
          <div>
            <h3 class="text-lg font-semibold text-slate-900">{module.name}</h3>
            <p class="text-sm text-slate-600 mt-1">{module.description}</p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input
              type="checkbox"
              name={module.id}
              checked={moduleConfig[module.id] !== false}
              disabled={!canEdit}
              class="sr-only peer"
            />
            <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-emerald-200 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-500 peer-disabled:opacity-50 peer-disabled:cursor-not-allowed"></div>
          </label>
        </div>
      ))}
    </form>

    <section class="admin-panel-soft p-5">
      <h2 class="text-lg font-semibold text-slate-900 admin-display">Coming soon modules</h2>
      <div class="grid gap-3 mt-4 sm:grid-cols-2">
        {comingSoon.map((module) => (
          <div class="rounded-xl border border-slate-200 bg-white/70 p-4">
            <p class="text-sm font-semibold text-slate-900">{module.name}</p>
            <p class="text-xs text-slate-500 mt-1">{module.description}</p>
            <span class="admin-nav-badge mt-3 inline-flex">Soon</span>
          </div>
        ))}
      </div>
    </section>

    {canEdit && (
      <div class="flex items-center gap-4">
        <button type="button" id="save-button" class="admin-btn-primary">Save changes</button>
        <a href={`/${slug}/admin-portal/settings`} class="text-sm font-semibold text-slate-500 hover:text-slate-900">Cancel</a>
      </div>
    )}

    <div id="loading" class="hidden fixed inset-0 bg-white/80 backdrop-blur-sm flex items-center justify-center z-50">
      <div class="admin-panel p-6 text-center">
        <div class="w-8 h-8 border-2 border-slate-300 border-t-transparent rounded-full animate-spin mx-auto mb-3"></div>
        <p class="text-slate-700">Saving...</p>
      </div>
    </div>
  </div>
</AdminLayout>

<script define:vars={{ clubId: club.id, slug }}>
  const form = document.getElementById('modules-form');
  const saveButton = document.getElementById('save-button');
  const loading = document.getElementById('loading');

  saveButton?.addEventListener('click', async () => {
    const formData = new FormData(form);

    const config = {
      posts: formData.has('posts'),
      fixtures: formData.has('fixtures'),
      sponsors: formData.has('sponsors'),
      forms: formData.has('forms'),
      inbox: formData.has('inbox'),
      media: formData.has('media'),
    };

    loading?.classList.remove('hidden');

    try {
      const response = await fetch(`/api/clubs/${clubId}/modules`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ config }),
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.error || 'Failed to save');
      }

      window.location.reload();
    } catch (error) {
      alert(error.message || 'Failed to save changes');
      loading?.classList.add('hidden');
    }
  });
</script>
