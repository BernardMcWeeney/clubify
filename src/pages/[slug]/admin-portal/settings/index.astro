---
import AdminLayout from '../../../../components/admin/AdminLayout.astro';
import { DatabaseService } from '../../../../lib/db';
import { getAuthContext } from '../../../../lib/auth';
import { hasPermission, type Role } from '../../../../lib/permissions';

const { slug } = Astro.params;

if (!Astro.locals.runtime.env.DB) {
  return Astro.redirect('/admin?error=db_not_configured');
}

const db = new DatabaseService(Astro.locals.runtime.env.DB);
const { user } = await getAuthContext(Astro.cookies, db);

if (!user) {
  return Astro.redirect('/admin/login');
}

const club = await db.getClubBySlug(slug!);
if (!club) {
  return Astro.redirect('/admin');
}

const member = await db.getClubMember(club.id, user.id);
if (!member) {
  return Astro.redirect('/admin');
}

const isAdmin = member.role === 'admin';
const canViewAudit = hasPermission(member.role as Role, 'audit.view');

// Get social connections for status
const connections = await db.getSocialConnections(club.id);
const facebookConnected = connections.some(c => c.platform === 'facebook');
---

<AdminLayout
  title="Settings"
  club={club}
  user={user}
  member={member}
  currentPage="settings"
>
  <div class="max-w-5xl space-y-6">
    <header>
      <p class="text-sm text-slate-500">Settings</p>
      <h1 class="text-3xl sm:text-4xl font-semibold text-slate-900 admin-display">Manage your club hub</h1>
      <p class="text-slate-600 mt-2">Branding, modules, people, and publishing settings live here.</p>
    </header>

    <section class="grid gap-4 md:grid-cols-2">
      <a href={`/${slug}/admin-portal/settings/club`} class="admin-panel p-5 hover:shadow-lg transition-shadow">
        <div class="flex items-start justify-between">
          <div>
            <p class="text-xs uppercase tracking-[0.2em] text-slate-400">Brand & Club</p>
            <h3 class="text-lg font-semibold text-slate-900 admin-display mt-2">Club identity</h3>
            <p class="text-sm text-slate-600 mt-2">Name, crest, colours, contact info, and sport-specific settings.</p>
          </div>
          <span class="admin-accent-pill">Primary</span>
        </div>
      </a>

      <a href={`/${slug}/admin-portal/settings/social`} class="admin-panel p-5 hover:shadow-lg transition-shadow">
        <div class="flex items-start justify-between">
          <div>
            <p class="text-xs uppercase tracking-[0.2em] text-slate-400">Publishing</p>
            <h3 class="text-lg font-semibold text-slate-900 admin-display mt-2">Social connections</h3>
            <p class="text-sm text-slate-600 mt-2">Connect Facebook, Twitter, and Instagram for one-click publishing.</p>
          </div>
          <span class={`text-xs font-semibold px-2.5 py-1 rounded-full ${facebookConnected ? 'bg-emerald-100 text-emerald-700' : 'bg-slate-100 text-slate-500'}`}>
            {facebookConnected ? 'Connected' : 'Not connected'}
          </span>
        </div>
      </a>

      {isAdmin && (
        <a href={`/${slug}/admin-portal/settings/modules`} class="admin-panel p-5 hover:shadow-lg transition-shadow">
          <div>
            <p class="text-xs uppercase tracking-[0.2em] text-slate-400">Modules</p>
            <h3 class="text-lg font-semibold text-slate-900 admin-display mt-2">Feature access</h3>
            <p class="text-sm text-slate-600 mt-2">Enable or disable features to keep your hub focused.</p>
          </div>
        </a>
      )}

      {canViewAudit && (
        <a href={`/${slug}/admin-portal/audit`} class="admin-panel p-5 hover:shadow-lg transition-shadow">
          <div>
            <p class="text-xs uppercase tracking-[0.2em] text-slate-400">Compliance</p>
            <h3 class="text-lg font-semibold text-slate-900 admin-display mt-2">Audit log</h3>
            <p class="text-sm text-slate-600 mt-2">See every action taken across your club hub.</p>
          </div>
        </a>
      )}

      <div class="admin-panel-soft p-5">
        <p class="text-xs uppercase tracking-[0.2em] text-slate-400">Custom domain</p>
        <h3 class="text-lg font-semibold text-slate-900 admin-display mt-2">Bring your own domain</h3>
        <p class="text-sm text-slate-600 mt-2">Automated DNS and SSL setup is coming soon.</p>
        <span class="admin-nav-badge mt-3 inline-flex">Coming soon</span>
      </div>

      <div class="admin-panel-soft p-5">
        <p class="text-xs uppercase tracking-[0.2em] text-slate-400">Billing</p>
        <h3 class="text-lg font-semibold text-slate-900 admin-display mt-2">Subscription & payments</h3>
        <p class="text-sm text-slate-600 mt-2">Manage plans and billing details in one place.</p>
        <span class="admin-nav-badge mt-3 inline-flex">Coming soon</span>
      </div>
    </section>

    {isAdmin && (
      <section class="admin-panel-soft p-5">
        <h2 class="text-lg font-semibold text-slate-900 admin-display">Danger zone</h2>
        <p class="text-sm text-slate-600 mt-2">Club deletion will permanently remove all data. Reach out to support before proceeding.</p>
        <button class="admin-btn-secondary text-sm mt-4" disabled>Delete club</button>
      </section>
    )}
  </div>
</AdminLayout>
