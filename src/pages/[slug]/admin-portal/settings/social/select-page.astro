---
import AdminLayout from '../../../../../components/admin/AdminLayout.astro';
import { DatabaseService } from '../../../../../lib/db';
import { getAuthContext } from '../../../../../lib/auth';

const { slug } = Astro.params;

if (!Astro.locals.runtime.env.DB) {
  return Astro.redirect('/admin?error=db_not_configured');
}

const db = new DatabaseService(Astro.locals.runtime.env.DB);
const { user } = await getAuthContext(Astro.cookies, db);

if (!user) {
  return Astro.redirect('/admin/login');
}

const club = await db.getClubBySlug(slug!);
if (!club) {
  return Astro.redirect('/admin');
}

const member = await db.getClubMember(club.id, user.id);
if (!member || member.role !== 'admin') {
  return Astro.redirect(`/${slug}/admin-portal/settings/social`);
}

// Get pages from URL params
const pagesParam = Astro.url.searchParams.get('pages');
let pages: Array<{ id: string; name: string; token: string }> = [];

if (pagesParam) {
  try {
    pages = JSON.parse(atob(pagesParam));
  } catch {
    return Astro.redirect(`/${slug}/admin-portal/settings/social?error=invalid_pages`);
  }
}

if (pages.length === 0) {
  return Astro.redirect(`/${slug}/admin-portal/settings/social?error=no_pages_found`);
}
---

<AdminLayout
  title="Select Facebook Page"
  club={club}
  user={user}
  member={member}
  currentPage="settings"
>
  <Fragment slot="header-left">
    <div class="flex items-center gap-4">
      <a href={`/${slug}/admin-portal/settings/social`} class="p-2 text-slate-400 hover:text-white transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
      </a>
      <h1 class="text-xl font-bold text-white">Select Facebook Page</h1>
    </div>
  </Fragment>

  <div class="max-w-2xl">
    <p class="text-slate-400 mb-8">
      You manage multiple Facebook Pages. Select the page you want to connect to {club.name}.
    </p>

    <div class="space-y-4">
      {pages.map((page) => (
        <button
          class="page-option w-full flex items-center gap-4 p-4 bg-slate-800/50 hover:bg-slate-800 rounded-xl border border-slate-700/50 hover:border-slate-600 transition-colors text-left"
          data-page-id={page.id}
          data-page-name={page.name}
          data-page-token={page.token}
        >
          <div class="w-12 h-12 rounded-xl bg-[#1877F2] flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd"/>
            </svg>
          </div>
          <div class="flex-1">
            <h3 class="text-lg font-semibold text-white">{page.name}</h3>
            <p class="text-slate-400 text-sm">Page ID: {page.id}</p>
          </div>
          <svg class="w-5 h-5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </button>
      ))}
    </div>

    <div class="mt-6 text-center">
      <a href={`/${slug}/admin-portal/settings/social`} class="text-slate-400 hover:text-white text-sm">
        Cancel and go back
      </a>
    </div>

    <!-- Loading overlay -->
    <div id="loading" class="hidden fixed inset-0 bg-slate-950/80 flex items-center justify-center z-50">
      <div class="bg-slate-800 rounded-xl p-6 text-center">
        <div class="w-8 h-8 border-2 border-green-500 border-t-transparent rounded-full animate-spin mx-auto mb-3"></div>
        <p class="text-white">Connecting page...</p>
      </div>
    </div>
  </div>
</AdminLayout>

<script define:vars={{ clubId: club.id, slug }}>
  const buttons = document.querySelectorAll('.page-option');
  const loading = document.getElementById('loading');

  buttons.forEach(btn => {
    btn.addEventListener('click', async () => {
      const pageId = btn.getAttribute('data-page-id');
      const pageName = btn.getAttribute('data-page-name');
      const pageToken = btn.getAttribute('data-page-token');

      if (!pageId || !pageToken) return;

      loading?.classList.remove('hidden');

      try {
        const response = await fetch(`/api/clubs/${clubId}/social/select-page`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            pageId,
            pageName,
            accessToken: pageToken,
          }),
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.error || 'Failed to connect page');
        }

        window.location.href = `/${slug}/admin-portal/settings/social?success=facebook_connected`;
      } catch (error) {
        alert(error.message || 'Failed to connect page');
        loading?.classList.add('hidden');
      }
    });
  });
</script>
