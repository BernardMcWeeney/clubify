---
import AdminLayout from '../../../../components/admin/AdminLayout.astro';
import { DatabaseService } from '../../../../lib/db';
import { getAuthContext } from '../../../../lib/auth';
import { hasPermission, type Role } from '../../../../lib/permissions';

const { slug } = Astro.params;

if (!Astro.locals.runtime.env.DB) {
  return Astro.redirect('/admin?error=db_not_configured');
}

const db = new DatabaseService(Astro.locals.runtime.env.DB);
const { user } = await getAuthContext(Astro.cookies, db);

if (!user) {
  return Astro.redirect('/admin/login');
}

const club = await db.getClubBySlug(slug!);
if (!club) {
  return Astro.redirect('/admin');
}

const member = await db.getClubMember(club.id, user.id);
if (!member) {
  return Astro.redirect('/admin');
}

const canEdit = hasPermission(member.role as Role, 'settings.edit');
const templateId = club.template as 'classic' | 'matchday' | 'community';

const templates = [
  {
    id: 'classic',
    name: 'Classic',
    description: 'Traditional GAA club layout perfect for established clubs',
    features: ['Hero banner with crest', 'Latest news feed', 'Next fixture countdown', 'Sponsor showcase'],
    color: 'from-green-500 to-emerald-600',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>',
  },
  {
    id: 'matchday',
    name: 'Matchday',
    description: 'Results-focused design for competitive clubs',
    features: ['Next match countdown', 'Latest result banner', 'Results ticker', 'Fixture calendar'],
    color: 'from-blue-500 to-indigo-600',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>',
  },
  {
    id: 'community',
    name: 'Community',
    description: 'Engagement-focused for community-driven clubs',
    features: ['Volunteer spotlight', 'Community highlights', 'Sponsor emphasis', 'Notice board'],
    color: 'from-purple-500 to-pink-600',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>',
  },
];
---

<AdminLayout
  title="Choose Template"
  club={club}
  user={user}
  member={member}
  currentPage="website"
>
  <div class="max-w-5xl mx-auto">
    <!-- Back Button & Header -->
    <div class="mb-8">
      <a href={`/${slug}/admin-portal/website`} class="inline-flex items-center gap-2 text-slate-600 hover:text-slate-900 mb-4 group">
        <svg class="w-4 h-4 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        Back to Website
      </a>
      <h1 class="text-3xl font-bold text-slate-900 mb-2">Choose Your Template</h1>
      <p class="text-slate-600">Select a design that best fits your club's style and goals. You can switch templates anytime.</p>
    </div>

    <!-- Current Template Badge -->
    <div class="mb-8 inline-flex items-center gap-2 px-4 py-2 bg-green-100 text-green-800 rounded-full font-medium">
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
      </svg>
      Currently using: {templateId.charAt(0).toUpperCase() + templateId.slice(1)}
    </div>

    <!-- Templates Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
      {templates.map((template) => (
        <div class={`relative bg-white rounded-2xl border-2 ${templateId === template.id ? 'border-green-500 shadow-xl' : 'border-slate-200'} overflow-hidden transition-all duration-300 hover:shadow-lg`}>
          <!-- Header -->
          <div class={`bg-gradient-to-br ${template.color} p-6 text-white`}>
            <div class="flex items-center justify-between mb-4">
              <div class="w-14 h-14 bg-white bg-opacity-20 backdrop-blur-sm rounded-2xl flex items-center justify-center">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={template.icon} />
              </div>
              {templateId === template.id && (
                <div class="bg-white bg-opacity-20 backdrop-blur-sm px-3 py-1 rounded-full text-xs font-semibold flex items-center gap-1">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  Active
                </div>
              )}
            </div>
            <h3 class="text-2xl font-bold mb-2">{template.name}</h3>
            <p class="text-white text-opacity-90 text-sm">{template.description}</p>
          </div>

          <!-- Content -->
          <div class="p-6">
            <h4 class="font-semibold text-slate-900 mb-3">Key Features:</h4>
            <ul class="space-y-2 mb-6">
              {template.features.map((feature) => (
                <li class="flex items-start gap-2 text-sm text-slate-600">
                  <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>

            {canEdit && templateId !== template.id ? (
              <button
                type="button"
                class="template-switch-btn w-full px-4 py-3 bg-gradient-to-r from-slate-900 to-slate-800 text-white rounded-xl font-semibold hover:from-slate-800 hover:to-slate-700 transition-all shadow-lg hover:shadow-xl"
                data-template={template.id}
                data-template-name={template.name}
                data-club-id={club.id}
              >
                Switch to {template.name}
              </button>
            ) : templateId === template.id ? (
              <div class="w-full px-4 py-3 bg-green-100 text-green-800 rounded-xl font-semibold text-center flex items-center justify-center gap-2">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                Current Template
              </div>
            ) : (
              <div class="w-full px-4 py-3 bg-slate-100 text-slate-400 rounded-xl font-semibold text-center">
                Admin Only
              </div>
            )}
          </div>
        </div>
      ))}
    </div>

    <!-- Info Box -->
    <div class="bg-blue-50 border border-blue-200 rounded-2xl p-6">
      <div class="flex items-start gap-4">
        <div class="w-10 h-10 bg-blue-500 rounded-xl flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <div class="flex-1">
          <h3 class="font-semibold text-blue-900 mb-1">What happens when I switch templates?</h3>
          <p class="text-sm text-blue-800">Your homepage layout will reset to the default blocks for the new template. Your content, navigation, and settings will remain unchanged. You can always customize the layout after switching.</p>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<script define:vars={{ clubId: club.id, slug }}>
  document.querySelectorAll('.template-switch-btn')?.forEach((btn) => {
    btn.addEventListener('click', async () => {
      const template = btn.dataset.template;
      const templateName = btn.dataset.templateName;

      if (!confirm(`Switch to ${templateName} template?\n\nThis will reset your homepage layout to the default ${templateName} blocks. Your content and settings will be preserved.`)) {
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Switching...';

      try {
        const res = await fetch(`/api/clubs/${clubId}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ template }),
        });

        if (!res.ok) {
          const data = await res.json();
          throw new Error(data.error || 'Failed to change template');
        }

        // Delete homepage config to reset to template defaults
        await fetch(`/api/clubs/${clubId}/homepage-config`, {
          method: 'DELETE',
        });

        window.location.reload();
      } catch (error) {
        console.error('Template switch error:', error);
        alert(error.message || 'Failed to switch template');
        btn.disabled = false;
        btn.textContent = `Switch to ${templateName}`;
      }
    });
  });
</script>

<style>
  @import "../../../../styles/global.css";
</style>
