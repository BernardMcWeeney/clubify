---
import AdminLayout from '../../../../components/admin/AdminLayout.astro';
import { DatabaseService } from '../../../../lib/db';
import { getAuthContext } from '../../../../lib/auth';
import { hasPermission, type Role } from '../../../../lib/permissions';

const { slug } = Astro.params;

if (!Astro.locals.runtime.env.DB) {
  return Astro.redirect('/admin?error=db_not_configured');
}

const db = new DatabaseService(Astro.locals.runtime.env.DB);
const { user } = await getAuthContext(Astro.cookies, db);

if (!user) {
  return Astro.redirect('/admin/login');
}

const club = await db.getClubBySlug(slug!);
if (!club) {
  return Astro.redirect('/admin');
}

const member = await db.getClubMember(club.id, user.id);
if (!member) {
  return Astro.redirect('/admin');
}

const canEdit = hasPermission(member.role as Role, 'homepage.edit');
const contactSettings = await db.getContactSettings(club.id);

const contactFormSettings = {
  notify_email: contactSettings?.notify_email || club.contact_email || user.email,
  retention_days: contactSettings?.retention_days ?? 30,
  form_title: contactSettings?.form_title || `Contact ${club.name}`,
  form_intro: contactSettings?.form_intro || `Have a question for ${club.name}? Send us a message and we will get back to you soon.`,
  success_message: contactSettings?.success_message || 'Thanks! We will get back to you shortly.',
  is_enabled: contactSettings?.is_enabled ?? 1,
};
---

<AdminLayout
  title="Contact Form"
  club={club}
  user={user}
  member={member}
  currentPage="website"
>
  <div class="max-w-4xl mx-auto">
    <!-- Header -->
    <div class="mb-8">
      <a href={`/${slug}/admin-portal/website`} class="inline-flex items-center gap-2 text-slate-600 hover:text-slate-900 mb-4 group">
        <svg class="w-4 h-4 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        Back to Website
      </a>
      <div class="flex items-start justify-between gap-4 flex-wrap">
        <div>
          <h1 class="text-3xl font-bold text-slate-900 mb-2">Contact Form Settings</h1>
          <p class="text-slate-600">Configure your contact form, GDPR compliance, and email notifications</p>
        </div>
        <span class="px-4 py-2 bg-gradient-to-r from-green-100 to-emerald-100 border-2 border-green-300 text-green-800 rounded-xl font-bold text-sm flex items-center gap-2 shadow-sm">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
          </svg>
          GDPR Compliant
        </span>
      </div>
    </div>

    <!-- Form Status -->
    <div class="bg-white rounded-2xl border-2 border-slate-200 p-6 shadow-sm mb-6">
      <div class="flex items-start justify-between gap-4 mb-6">
        <div>
          <h2 class="text-xl font-bold text-slate-900 flex items-center gap-2">
            <svg class="w-6 h-6 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
            Form Status
          </h2>
          <p class="text-sm text-slate-500 mt-1">Enable or disable the contact form on your website</p>
        </div>
      </div>

      <label class="flex items-center gap-4 p-4 rounded-xl border-2 border-slate-200 cursor-pointer hover:bg-slate-50 transition-all">
        <input type="checkbox" id="contact-enabled" class="w-6 h-6 rounded-lg border-slate-300 text-green-600 focus:ring-2 focus:ring-green-500" checked={contactFormSettings.is_enabled === 1} disabled={!canEdit} />
        <div class="flex-1">
          <span class="text-lg font-semibold text-slate-900 block">Contact Form Enabled</span>
          <span class="text-sm text-slate-600">When enabled, visitors can submit enquiries through your contact page</span>
        </div>
        <div class={`px-4 py-2 rounded-xl font-bold text-sm ${contactFormSettings.is_enabled === 1 ? 'bg-green-100 text-green-700' : 'bg-slate-100 text-slate-600'}`}>
          {contactFormSettings.is_enabled === 1 ? '✓ Active' : '✕ Disabled'}
        </div>
      </label>
    </div>

    <!-- Email Notifications -->
    <div class="bg-white rounded-2xl border-2 border-slate-200 p-6 shadow-sm mb-6">
      <div class="flex items-start justify-between gap-4 mb-6">
        <div>
          <h2 class="text-xl font-bold text-slate-900 flex items-center gap-2">
            <svg class="w-6 h-6 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            Email Notifications
          </h2>
          <p class="text-sm text-slate-500 mt-1">Get notified when someone submits the contact form</p>
        </div>
      </div>

      <div>
        <label class="text-sm font-semibold text-slate-700 mb-2 block">Notification Email Address</label>
        <input type="email" id="contact-email" class="w-full px-4 py-3 rounded-xl border-2 border-slate-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 transition-all font-medium" value={contactFormSettings.notify_email} disabled={!canEdit} placeholder="club@example.com" />
        <p class="text-xs text-slate-500 mt-2 flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          Leave blank to disable email notifications (submissions still saved in inbox)
        </p>
      </div>
    </div>

    <!-- GDPR & Data Retention -->
    <div class="bg-gradient-to-br from-green-50 to-emerald-50 rounded-2xl border-2 border-green-200 p-6 shadow-sm mb-6">
      <div class="flex items-start justify-between gap-4 mb-6">
        <div>
          <h2 class="text-xl font-bold text-slate-900 flex items-center gap-2">
            <svg class="w-6 h-6 text-green-600" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            GDPR Data Retention
          </h2>
          <p class="text-sm text-green-700 mt-1 font-medium">Automatic data deletion for privacy compliance</p>
        </div>
      </div>

      <div class="bg-white rounded-xl p-5 border-2 border-green-200">
        <label class="text-sm font-semibold text-slate-700 mb-3 block">Auto-Delete After (Days)</label>
        <div class="flex items-center gap-4">
          <input type="number" min="1" max="90" id="contact-retention" class="w-32 px-4 py-3 rounded-xl border-2 border-green-300 focus:border-green-500 focus:ring-2 focus:ring-green-200 transition-all font-bold text-lg text-green-700" value={contactFormSettings.retention_days} disabled={!canEdit} />
          <span class="text-slate-600 font-medium">days</span>
        </div>
        <div class="mt-4 bg-green-100 rounded-lg p-4">
          <p class="text-sm text-green-800 font-medium flex items-start gap-2">
            <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
            </svg>
            Submissions older than {contactFormSettings.retention_days} days are automatically deleted at 2am UTC daily. Default: 30 days.
          </p>
        </div>
      </div>
    </div>

    <!-- Form Content -->
    <div class="bg-white rounded-2xl border-2 border-slate-200 p-6 shadow-sm mb-6">
      <div class="flex items-start justify-between gap-4 mb-6">
        <div>
          <h2 class="text-xl font-bold text-slate-900 flex items-center gap-2">
            <svg class="w-6 h-6 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
            </svg>
            Form Text & Messages
          </h2>
          <p class="text-sm text-slate-500 mt-1">Customize the form heading and messages</p>
        </div>
      </div>

      <div class="space-y-5">
        <div>
          <label class="text-sm font-semibold text-slate-700 mb-2 block">Form Title</label>
          <input type="text" id="contact-title" class="w-full px-4 py-3 rounded-xl border-2 border-slate-200 focus:border-purple-500 focus:ring-2 focus:ring-purple-200 transition-all font-semibold text-lg" value={contactFormSettings.form_title} disabled={!canEdit} />
        </div>

        <div>
          <label class="text-sm font-semibold text-slate-700 mb-2 block">Introduction Text</label>
          <textarea id="contact-intro" rows="3" class="w-full px-4 py-3 rounded-xl border-2 border-slate-200 focus:border-purple-500 focus:ring-2 focus:ring-purple-200 transition-all" disabled={!canEdit}>{contactFormSettings.form_intro}</textarea>
          <p class="text-xs text-slate-500 mt-2">Appears above the contact form</p>
        </div>

        <div>
          <label class="text-sm font-semibold text-slate-700 mb-2 block">Success Message</label>
          <textarea id="contact-success" rows="2" class="w-full px-4 py-3 rounded-xl border-2 border-slate-200 focus:border-purple-500 focus:ring-2 focus:ring-purple-200 transition-all" disabled={!canEdit}>{contactFormSettings.success_message}</textarea>
          <p class="text-xs text-slate-500 mt-2">Shown after successful submission</p>
        </div>
      </div>
    </div>

    <!-- Actions -->
    {canEdit && (
      <div class="flex items-center justify-between gap-4 bg-white rounded-2xl border-2 border-slate-200 p-6 shadow-sm">
        <a href={`/${slug}/admin-portal/inbox`} class="text-blue-600 hover:text-blue-700 font-semibold flex items-center gap-2 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
          </svg>
          View Inbox →
        </a>
        <button type="button" id="save-contact" class="px-8 py-3 rounded-xl bg-gradient-to-r from-green-500 to-emerald-600 text-white font-bold hover:from-green-600 hover:to-emerald-700 transition-all shadow-lg hover:shadow-xl text-lg">
          💾 Save Settings
        </button>
      </div>
    )}

    <!-- Help -->
    <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border-2 border-blue-200 rounded-2xl p-6 mt-6">
      <div class="flex items-start gap-4">
        <div class="w-10 h-10 bg-blue-500 rounded-xl flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <div class="flex-1">
          <h3 class="font-semibold text-blue-900 mb-2">GDPR Compliance Features</h3>
          <ul class="text-sm text-blue-800 space-y-1">
            <li>✓ <strong>Automatic data deletion</strong> based on retention period</li>
            <li>✓ <strong>Consent checkbox</strong> included in every form</li>
            <li>✓ <strong>Data export</strong> available in Settings → GDPR</li>
            <li>✓ <strong>Audit trail</strong> of all form submissions</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<script define:vars={{ clubId: club.id, slug }}>
  document.getElementById('save-contact')?.addEventListener('click', async () => {
    if (!clubId) return;

    const payload = {
      notify_email: document.getElementById('contact-email')?.value?.trim() || null,
      retention_days: parseInt(document.getElementById('contact-retention')?.value || '30', 10),
      form_title: document.getElementById('contact-title')?.value?.trim() || null,
      form_intro: document.getElementById('contact-intro')?.value?.trim() || null,
      success_message: document.getElementById('contact-success')?.value?.trim() || null,
      is_enabled: document.getElementById('contact-enabled')?.checked ? 1 : 0,
    };

    try {
      const res = await fetch(`/api/clubs/${clubId}/contact/settings`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const data = await res.json();
      if (!res.ok) {
        throw new Error(data.error || 'Failed to save');
      }

      alert('✓ Contact form settings saved successfully!');
    } catch (error) {
      alert('Failed to save: ' + (error.message || 'Unknown error'));
    }
  });
</script>

<style>
  @import "../../../../styles/global.css";
</style>
