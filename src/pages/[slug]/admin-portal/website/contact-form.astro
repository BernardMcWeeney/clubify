---
import AdminLayout from '../../../../components/admin/AdminLayout.astro';
import AdminPageTemplate from '../../../../components/admin/AdminPageTemplate.astro';
import AdminCard from '../../../../components/admin/AdminCard.astro';
import Icon from '../../../../components/admin/Icon.astro';
import StatusChip from '../../../../components/admin/StatusChip.astro';
import { DatabaseService } from '../../../../lib/db';
import { getAuthContext } from '../../../../lib/auth';
import { hasPermission, type Role } from '../../../../lib/permissions';

const { slug } = Astro.params;

if (!Astro.locals.runtime.env.DB) {
  return Astro.redirect('/admin?error=db_not_configured');
}

const db = new DatabaseService(Astro.locals.runtime.env.DB);
const { user } = await getAuthContext(Astro.cookies, db);

if (!user) {
  return Astro.redirect('/admin/login');
}

const club = await db.getClubBySlug(slug!);
if (!club) {
  return Astro.redirect('/admin');
}

const member = await db.getClubMember(club.id, user.id);
if (!member) {
  return Astro.redirect('/admin');
}

const canEdit = hasPermission(member.role as Role, 'homepage.edit');
const contactSettings = await db.getContactSettings(club.id);

const contactFormSettings = {
  notify_email: contactSettings?.notify_email || club.contact_email || user.email,
  retention_days: contactSettings?.retention_days ?? 30,
  form_title: contactSettings?.form_title || `Contact ${club.name}`,
  form_intro: contactSettings?.form_intro || `Have a question for ${club.name}? Send us a message and we will get back to you soon.`,
  success_message: contactSettings?.success_message || 'Thanks! We will get back to you shortly.',
  is_enabled: contactSettings?.is_enabled ?? 1,
};

const breadcrumbs = [
  { label: 'Dashboard', href: `/${slug}/admin-portal` },
  { label: 'Website', href: `/${slug}/admin-portal/website` },
  { label: 'Contact Form' },
];
---

<AdminLayout
  title="Contact Form"
  club={club}
  user={user}
  member={member}
  currentPage="website"
>
  <AdminPageTemplate
    title="Contact Form Settings"
    subtitle="Configure your contact form, GDPR compliance, and email notifications"
    breadcrumbs={breadcrumbs}
  >
    <Fragment slot="actions">
      <StatusChip variant="success" size="sm">
        <Icon name="shield" size="sm" class="mr-1" />
        GDPR Compliant
      </StatusChip>
    </Fragment>

    <!-- Form Status -->
    <AdminCard class="mb-6" padding="lg">
      <div class="flex items-start justify-between gap-4 mb-6">
        <div>
          <h2 class="text-xl font-semibold text-slate-900 flex items-center gap-2">
            <div class="w-8 h-8 rounded-lg flex items-center justify-center" style="background: var(--admin-accent-soft)">
              <Icon name="zap" size="lg" class="icon-accent" />
            </div>
            Form Status
          </h2>
          <p class="text-sm text-slate-500 mt-1">Enable or disable the contact form on your website</p>
        </div>
      </div>

      <label class="flex items-center gap-4 p-4 rounded-xl border border-slate-200 cursor-pointer hover:bg-slate-50 transition-all">
        <input type="checkbox" id="contact-enabled" class="w-6 h-6 rounded-lg border-slate-300 focus:ring-2" style="accent-color: var(--admin-accent)" checked={contactFormSettings.is_enabled === 1} disabled={!canEdit} />
        <div class="flex-1">
          <span class="text-lg font-semibold text-slate-900 block">Contact Form Enabled</span>
          <span class="text-sm text-slate-600">When enabled, visitors can submit enquiries through your contact page</span>
        </div>
        <StatusChip variant={contactFormSettings.is_enabled === 1 ? 'success' : 'neutral'} size="sm">
          {contactFormSettings.is_enabled === 1 ? '✓ Active' : '✕ Disabled'}
        </StatusChip>
      </label>
    </AdminCard>

    <!-- Email Notifications -->
    <AdminCard class="mb-6" padding="lg">
      <div class="flex items-start justify-between gap-4 mb-6">
        <div>
          <h2 class="text-xl font-semibold text-slate-900 flex items-center gap-2">
            <div class="w-8 h-8 rounded-lg flex items-center justify-center" style="background: var(--admin-accent-soft)">
              <Icon name="mail" size="lg" class="icon-accent" />
            </div>
            Email Notifications
          </h2>
          <p class="text-sm text-slate-500 mt-1">Get notified when someone submits the contact form</p>
        </div>
      </div>

      <div>
        <label class="text-sm font-semibold text-slate-700 mb-2 block">Notification Email Address</label>
        <input type="email" id="contact-email" class="input-themed w-full" value={contactFormSettings.notify_email} disabled={!canEdit} placeholder="club@example.com" />
        <p class="text-xs text-slate-500 mt-2 flex items-center gap-2">
          <Icon name="info" size="sm" />
          Leave blank to disable email notifications (submissions still saved in inbox)
        </p>
      </div>
    </AdminCard>

    <!-- GDPR & Data Retention -->
    <AdminCard class="mb-6 bg-green-50 border-green-200" padding="lg">
      <div class="flex items-start justify-between gap-4 mb-6">
        <div>
          <h2 class="text-xl font-semibold text-slate-900 flex items-center gap-2">
            <div class="w-8 h-8 rounded-lg bg-green-100 flex items-center justify-center">
              <Icon name="shield" size="lg" class="text-green-600" />
            </div>
            GDPR Data Retention
          </h2>
          <p class="text-sm text-green-700 mt-1 font-medium">Automatic data deletion for privacy compliance</p>
        </div>
      </div>

      <div class="bg-white rounded-xl p-5 border border-green-200">
        <label class="text-sm font-semibold text-slate-700 mb-3 block">Auto-Delete After (Days)</label>
        <div class="flex items-center gap-4">
          <input type="number" min="1" max="90" id="contact-retention" class="w-32 px-4 py-3 rounded-xl border border-green-300 focus:border-green-500 focus:ring-2 focus:ring-green-200 transition-all font-bold text-lg text-green-700" value={contactFormSettings.retention_days} disabled={!canEdit} />
          <span class="text-slate-600 font-medium">days</span>
        </div>
        <div class="mt-4 bg-green-100 rounded-lg p-4">
          <p class="text-sm text-green-800 font-medium flex items-start gap-2">
            <Icon name="info" size="md" class="flex-shrink-0 mt-0.5" />
            Submissions older than {contactFormSettings.retention_days} days are automatically deleted at 2am UTC daily. Default: 30 days.
          </p>
        </div>
      </div>
    </AdminCard>

    <!-- Form Content -->
    <AdminCard class="mb-6" padding="lg">
      <div class="flex items-start justify-between gap-4 mb-6">
        <div>
          <h2 class="text-xl font-semibold text-slate-900 flex items-center gap-2">
            <div class="w-8 h-8 rounded-lg flex items-center justify-center" style="background: var(--admin-accent-soft)">
              <Icon name="edit" size="lg" class="icon-accent" />
            </div>
            Form Text & Messages
          </h2>
          <p class="text-sm text-slate-500 mt-1">Customize the form heading and messages</p>
        </div>
      </div>

      <div class="space-y-5">
        <div>
          <label class="text-sm font-semibold text-slate-700 mb-2 block">Form Title</label>
          <input type="text" id="contact-title" class="input-themed w-full font-semibold text-lg" value={contactFormSettings.form_title} disabled={!canEdit} />
        </div>

        <div>
          <label class="text-sm font-semibold text-slate-700 mb-2 block">Introduction Text</label>
          <textarea id="contact-intro" rows="3" class="input-themed w-full" disabled={!canEdit}>{contactFormSettings.form_intro}</textarea>
          <p class="text-xs text-slate-500 mt-2">Appears above the contact form</p>
        </div>

        <div>
          <label class="text-sm font-semibold text-slate-700 mb-2 block">Success Message</label>
          <textarea id="contact-success" rows="2" class="input-themed w-full" disabled={!canEdit}>{contactFormSettings.success_message}</textarea>
          <p class="text-xs text-slate-500 mt-2">Shown after successful submission</p>
        </div>
      </div>
    </AdminCard>

    <!-- Actions -->
    {canEdit && (
      <AdminCard class="mb-6">
        <div class="flex items-center justify-between gap-4">
          <a href={`/${slug}/admin-portal/inbox`} class="link font-semibold flex items-center gap-2">
            <Icon name="inbox" size="lg" />
            View Inbox →
          </a>
          <button type="button" id="save-contact" class="btn-primary">
            Save Settings
          </button>
        </div>
      </AdminCard>
    )}

    <!-- Help -->
    <AdminCard class="bg-slate-50">
      <div class="flex items-start gap-4">
        <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0" style="background: var(--admin-accent)">
          <Icon name="info" size="lg" class="text-white" />
        </div>
        <div class="flex-1">
          <h3 class="font-semibold text-slate-900 mb-2">GDPR Compliance Features</h3>
          <ul class="text-sm text-slate-600 space-y-1">
            <li class="flex items-start gap-2">
              <Icon name="check" size="md" class="text-slate-400 mt-0.5 flex-shrink-0" />
              <strong>Automatic data deletion</strong> based on retention period
            </li>
            <li class="flex items-start gap-2">
              <Icon name="check" size="md" class="text-slate-400 mt-0.5 flex-shrink-0" />
              <strong>Consent checkbox</strong> included in every form
            </li>
            <li class="flex items-start gap-2">
              <Icon name="check" size="md" class="text-slate-400 mt-0.5 flex-shrink-0" />
              <strong>Data export</strong> available in Settings → GDPR
            </li>
            <li class="flex items-start gap-2">
              <Icon name="check" size="md" class="text-slate-400 mt-0.5 flex-shrink-0" />
              <strong>Audit trail</strong> of all form submissions
            </li>
          </ul>
        </div>
      </div>
    </AdminCard>
  </AdminPageTemplate>
</AdminLayout>

<script define:vars={{ clubId: club.id, slug }}>
  document.getElementById('save-contact')?.addEventListener('click', async () => {
    if (!clubId) return;

    const payload = {
      notify_email: document.getElementById('contact-email')?.value?.trim() || null,
      retention_days: parseInt(document.getElementById('contact-retention')?.value || '30', 10),
      form_title: document.getElementById('contact-title')?.value?.trim() || null,
      form_intro: document.getElementById('contact-intro')?.value?.trim() || null,
      success_message: document.getElementById('contact-success')?.value?.trim() || null,
      is_enabled: document.getElementById('contact-enabled')?.checked ? 1 : 0,
    };

    try {
      const res = await fetch(`/api/clubs/${clubId}/contact/settings`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const data = await res.json();
      if (!res.ok) {
        throw new Error(data.error || 'Failed to save');
      }

      alert('✓ Contact form settings saved successfully!');
    } catch (error) {
      alert('Failed to save: ' + (error.message || 'Unknown error'));
    }
  });
</script>

<style>
  @import "../../../../styles/global.css";

  .icon-accent {
    color: var(--admin-accent, #14b8a6);
  }
</style>
