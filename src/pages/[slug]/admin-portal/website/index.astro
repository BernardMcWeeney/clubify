---
import AdminLayout from '../../../../components/admin/AdminLayout.astro';
import { DatabaseService } from '../../../../lib/db';
import { getAuthContext } from '../../../../lib/auth';
import { hasPermission, type Role } from '../../../../lib/permissions';

const { slug } = Astro.params;

if (!Astro.locals.runtime.env.DB) {
  return Astro.redirect('/admin?error=db_not_configured');
}

const db = new DatabaseService(Astro.locals.runtime.env.DB);
const { user } = await getAuthContext(Astro.cookies, db);

if (!user) {
  return Astro.redirect('/admin/login');
}

const club = await db.getClubBySlug(slug!);
if (!club) {
  return Astro.redirect('/admin');
}

const member = await db.getClubMember(club.id, user.id);
if (!member) {
  return Astro.redirect('/admin');
}

const canEdit = hasPermission(member.role as Role, 'homepage.edit');
const templateId = club.template as 'classic' | 'matchday' | 'community';

const homepageConfig = await db.getHomepageConfig(club.id);
const siteSettings = await db.getSiteSettings(club.id);
const navItems = siteSettings?.nav_items ? JSON.parse(siteSettings.nav_items) : [];
---

<AdminLayout
  title="Website"
  club={club}
  user={user}
  member={member}
  currentPage="website"
>
  <Fragment slot="header-actions">
    <a href={`/${slug}`} target="_blank" class="admin-btn-secondary text-sm">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
      </svg>
      Preview site
    </a>
  </Fragment>

  <div class="max-w-5xl space-y-6">
    <header>
      <p class="text-sm text-slate-500">Website</p>
      <h1 class="text-3xl font-semibold text-slate-900 admin-display">Website builder</h1>
      <p class="text-slate-600 mt-2">Control templates, homepage layout, and navigation for your club site.</p>
    </header>

    {!canEdit && (
      <div class="admin-panel-soft p-4 text-sm text-amber-700">
        You need Admin or PRO role to edit the website builder.
      </div>
    )}

    <section class="grid gap-4 md:grid-cols-3">
      <div class="admin-panel-soft p-4">
        <p class="text-xs uppercase tracking-[0.2em] text-slate-400">Template</p>
        <p class="text-2xl font-semibold text-slate-900 mt-2">{templateId.charAt(0).toUpperCase() + templateId.slice(1)}</p>
      </div>
      <div class="admin-panel-soft p-4">
        <p class="text-xs uppercase tracking-[0.2em] text-slate-400">Menu items</p>
        <p class="text-2xl font-semibold text-slate-900 mt-2">{navItems.length}</p>
      </div>
      <div class="admin-panel-soft p-4">
        <p class="text-xs uppercase tracking-[0.2em] text-slate-400">Homepage blocks</p>
        <p class="text-2xl font-semibold text-slate-900 mt-2">{homepageConfig?.layout ? JSON.parse(homepageConfig.layout).length : 0}</p>
      </div>
    </section>

    <section class="grid gap-4 md:grid-cols-2">
      <a href={`/${slug}/admin-portal/website/template`} class="admin-panel p-5 hover:shadow-lg transition-shadow">
        <h3 class="text-lg font-semibold text-slate-900 admin-display">Choose template</h3>
        <p class="text-sm text-slate-600 mt-2">Pick from Classic, Matchday, or Community layouts.</p>
        <span class="admin-accent-pill mt-4 inline-flex">{templateId.charAt(0).toUpperCase() + templateId.slice(1)} active</span>
      </a>

      <a href={`/${slug}/admin-portal/website/layout`} class="admin-panel p-5 hover:shadow-lg transition-shadow">
        <h3 class="text-lg font-semibold text-slate-900 admin-display">Homepage layout</h3>
        <p class="text-sm text-slate-600 mt-2">Drag and drop blocks to curate your homepage.</p>
        <span class="admin-nav-badge mt-4 inline-flex">Drag & drop</span>
      </a>

      <a href={`/${slug}/admin-portal/website/navigation`} class="admin-panel p-5 hover:shadow-lg transition-shadow">
        <h3 class="text-lg font-semibold text-slate-900 admin-display">Navigation & menus</h3>
        <p class="text-sm text-slate-600 mt-2">Manage menus, header CTA, and footer links.</p>
        <span class="admin-nav-badge mt-4 inline-flex">{navItems.length} items</span>
      </a>

      <a href={`/${slug}/admin-portal/website/contact-form`} class="admin-panel p-5 hover:shadow-lg transition-shadow">
        <h3 class="text-lg font-semibold text-slate-900 admin-display">Contact form</h3>
        <p class="text-sm text-slate-600 mt-2">Configure form settings, GDPR, and inbox routing.</p>
        <span class="admin-nav-badge mt-4 inline-flex">GDPR ready</span>
      </a>
    </section>

    <section class="admin-panel-soft p-5">
      <h2 class="text-lg font-semibold text-slate-900 admin-display">Editor tips</h2>
      <p class="text-sm text-slate-600 mt-2">Start with a template, refine your homepage blocks, then update menus and your contact form. Keep key updates in Posts so supporters see them instantly.</p>
    </section>
  </div>
</AdminLayout>
