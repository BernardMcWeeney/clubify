---
import AdminLayout from '../../../../components/admin/AdminLayout.astro';
import { DatabaseService } from '../../../../lib/db';
import { getAuthContext } from '../../../../lib/auth';
import { hasPermission, type Role } from '../../../../lib/permissions';

const { slug } = Astro.params;

if (!Astro.locals.runtime.env.DB) {
  return Astro.redirect('/admin?error=db_not_configured');
}

const db = new DatabaseService(Astro.locals.runtime.env.DB);
const { user } = await getAuthContext(Astro.cookies, db);

if (!user) {
  return Astro.redirect('/admin/login');
}

const club = await db.getClubBySlug(slug!);
if (!club) {
  return Astro.redirect('/admin');
}

const member = await db.getClubMember(club.id, user.id);
if (!member) {
  return Astro.redirect('/admin');
}

const canEdit = hasPermission(member.role as Role, 'homepage.edit');
const templateId = club.template as 'classic' | 'matchday' | 'community';

// Get stats
const homepageConfig = await db.getHomepageConfig(club.id);
const siteSettings = await db.getSiteSettings(club.id);
const navItems = siteSettings?.nav_items ? JSON.parse(siteSettings.nav_items) : [];
---

<AdminLayout
  title="Website"
  club={club}
  user={user}
  member={member}
  currentPage="website"
>
  <Fragment slot="header-actions">
    <a href={`/${slug}`} target="_blank" class="flex items-center gap-2 px-4 py-2.5 bg-white border border-slate-200 text-slate-700 rounded-xl hover:bg-slate-50 hover:border-slate-300 transition-all text-sm font-medium shadow-sm">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
      </svg>
      Preview Site
    </a>
  </Fragment>

  <div class="max-w-5xl mx-auto">
    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-slate-900 mb-2">Website Builder</h1>
      <p class="text-slate-600">Customize your club's website design, layout, and content</p>
    </div>

    <!-- Quick Stats -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
      <div class="bg-gradient-to-br from-green-50 to-emerald-50 rounded-2xl p-6 border border-green-100">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-green-700 mb-1">Template</p>
            <p class="text-2xl font-bold text-green-900">{templateId.charAt(0).toUpperCase() + templateId.slice(1)}</p>
          </div>
          <div class="w-12 h-12 bg-green-500 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/>
            </svg>
          </div>
        </div>
      </div>

      <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-2xl p-6 border border-blue-100">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-blue-700 mb-1">Menu Items</p>
            <p class="text-2xl font-bold text-blue-900">{navItems.length}</p>
          </div>
          <div class="w-12 h-12 bg-blue-500 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </div>
        </div>
      </div>

      <div class="bg-gradient-to-br from-purple-50 to-pink-50 rounded-2xl p-6 border border-purple-100">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-purple-700 mb-1">Status</p>
            <p class="text-2xl font-bold text-purple-900">{club.is_live ? 'Live' : 'Draft'}</p>
          </div>
          <div class={`w-12 h-12 ${club.is_live ? 'bg-purple-500' : 'bg-slate-400'} rounded-xl flex items-center justify-center`}>
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
            </svg>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Sections -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Template -->
      <a href={`/${slug}/admin-portal/website/template`} class="group bg-white rounded-2xl border-2 border-slate-200 p-8 hover:border-green-400 hover:shadow-xl transition-all duration-300">
        <div class="flex items-start justify-between mb-4">
          <div class="w-14 h-14 bg-gradient-to-br from-green-500 to-emerald-600 rounded-2xl flex items-center justify-center transform group-hover:scale-110 transition-transform duration-300">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/>
            </svg>
          </div>
          <svg class="w-6 h-6 text-slate-400 group-hover:text-green-500 transform group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-slate-900 mb-2">Choose Template</h3>
        <p class="text-slate-600 mb-4">Select from Classic, Matchday, or Community designs</p>
        <div class="flex items-center gap-2 text-sm">
          <span class="px-3 py-1 bg-green-100 text-green-700 rounded-full font-medium">
            {templateId.charAt(0).toUpperCase() + templateId.slice(1)} Active
          </span>
        </div>
      </a>

      <!-- Homepage Layout -->
      <a href={`/${slug}/admin-portal/website/layout`} class="group bg-white rounded-2xl border-2 border-slate-200 p-8 hover:border-blue-400 hover:shadow-xl transition-all duration-300">
        <div class="flex items-start justify-between mb-4">
          <div class="w-14 h-14 bg-gradient-to-br from-blue-500 to-indigo-600 rounded-2xl flex items-center justify-center transform group-hover:scale-110 transition-transform duration-300">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h4a1 1 0 011 1v7a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM14 5a1 1 0 011-1h4a1 1 0 011 1v7a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 16a1 1 0 011-1h4a1 1 0 011 1v3a1 1 0 01-1 1H5a1 1 0 01-1-1v-3zM14 16a1 1 0 011-1h4a1 1 0 011 1v3a1 1 0 01-1 1h-4a1 1 0 01-1-1v-3z"/>
            </svg>
          </div>
          <svg class="w-6 h-6 text-slate-400 group-hover:text-blue-500 transform group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-slate-900 mb-2">Homepage Layout</h3>
        <p class="text-slate-600 mb-4">Drag and drop blocks to customize your homepage</p>
        <div class="flex items-center gap-2 text-sm">
          <span class="px-3 py-1 bg-blue-100 text-blue-700 rounded-full font-medium">
            Drag & Drop
          </span>
        </div>
      </a>

      <!-- Navigation -->
      <a href={`/${slug}/admin-portal/website/navigation`} class="group bg-white rounded-2xl border-2 border-slate-200 p-8 hover:border-purple-400 hover:shadow-xl transition-all duration-300">
        <div class="flex items-start justify-between mb-4">
          <div class="w-14 h-14 bg-gradient-to-br from-purple-500 to-pink-600 rounded-2xl flex items-center justify-center transform group-hover:scale-110 transition-transform duration-300">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </div>
          <svg class="w-6 h-6 text-slate-400 group-hover:text-purple-500 transform group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-slate-900 mb-2">Navigation & Menus</h3>
        <p class="text-slate-600 mb-4">Manage menu items, header button, and footer links</p>
        <div class="flex items-center gap-2 text-sm">
          <span class="px-3 py-1 bg-purple-100 text-purple-700 rounded-full font-medium">
            {navItems.length} Menu Items
          </span>
        </div>
      </a>

      <!-- Contact Form -->
      <a href={`/${slug}/admin-portal/website/contact-form`} class="group bg-white rounded-2xl border-2 border-slate-200 p-8 hover:border-amber-400 hover:shadow-xl transition-all duration-300">
        <div class="flex items-start justify-between mb-4">
          <div class="w-14 h-14 bg-gradient-to-br from-amber-500 to-orange-600 rounded-2xl flex items-center justify-center transform group-hover:scale-110 transition-transform duration-300">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <svg class="w-6 h-6 text-slate-400 group-hover:text-amber-500 transform group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-slate-900 mb-2">Contact Form</h3>
        <p class="text-slate-600 mb-4">Configure form settings, GDPR, and email notifications</p>
        <div class="flex items-center gap-2 text-sm">
          <span class="px-3 py-1 bg-green-100 text-green-700 rounded-full font-medium flex items-center gap-1">
            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            GDPR Ready
          </span>
        </div>
      </a>
    </div>

    <!-- Help Section -->
    <div class="mt-8 bg-gradient-to-r from-slate-50 to-slate-100 rounded-2xl border border-slate-200 p-6">
      <div class="flex items-start gap-4">
        <div class="w-10 h-10 bg-slate-900 rounded-xl flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <div class="flex-1">
          <h3 class="font-semibold text-slate-900 mb-1">Website Builder Tips</h3>
          <p class="text-sm text-slate-600">Start with a template, customize your homepage layout, then add your navigation menus. Don't forget to configure your contact form for GDPR compliance!</p>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<style>
  @import "../../../../styles/global.css";
</style>
