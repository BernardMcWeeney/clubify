---
import AdminLayout from '../../../../components/admin/AdminLayout.astro';
import { DatabaseService } from '../../../../lib/db';
import { getAuthContext } from '../../../../lib/auth';
import { getDefaultConfig, type BlockConfig } from '../../../../lib/templates';
import { hasPermission, type Role } from '../../../../lib/permissions';

const { slug } = Astro.params;

if (!Astro.locals.runtime.env.DB) {
  return Astro.redirect('/admin?error=db_not_configured');
}

const db = new DatabaseService(Astro.locals.runtime.env.DB);
const { user } = await getAuthContext(Astro.cookies, db);

if (!user) {
  return Astro.redirect('/admin/login');
}

const club = await db.getClubBySlug(slug!);
if (!club) {
  return Astro.redirect('/admin');
}

const member = await db.getClubMember(club.id, user.id);
if (!member) {
  return Astro.redirect('/admin');
}

const canEdit = hasPermission(member.role as Role, 'homepage.edit');

const homepageConfig = await db.getHomepageConfig(club.id);
const templateId = club.template as 'classic' | 'matchday' | 'community';
const defaultBlocks = getDefaultConfig(templateId);

let blocks: BlockConfig[];
if (homepageConfig) {
  const config = JSON.parse(homepageConfig.config);
  blocks = config.blocks;
} else {
  blocks = defaultBlocks;
}

const blockInfo: Record<string, { name: string; description: string; icon: string }> = {
  'hero': {
    name: 'Hero Banner',
    description: 'Main welcome section with crest, headline, and CTA',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>'
  },
  'next-fixture': {
    name: 'Next Fixture',
    description: 'Countdown to the next match',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>'
  },
  'latest-news': {
    name: 'Latest News',
    description: 'Recent posts and announcements',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>'
  },
  'latest-result': {
    name: 'Latest Result',
    description: 'Most recent match result',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>'
  },
  'results-ticker': {
    name: 'Results Ticker',
    description: 'Scrolling recent results banner',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>'
  },
  'notices': {
    name: 'Notices',
    description: 'Important club announcements',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"/>'
  },
  'highlight-cards': {
    name: 'Highlight Cards',
    description: 'Feature three key links or CTAs',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>'
  },
  'volunteer-spotlight': {
    name: 'Volunteer Spotlight',
    description: 'Showcase a volunteer or committee member',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>'
  },
  'sponsors': {
    name: 'Sponsors',
    description: 'Showcase sponsor logos and tiers',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/>'
  },
  'contact': {
    name: 'Contact',
    description: 'Club contact information and social links',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>'
  },
};

const siteSettings = await db.getSiteSettings(club.id);
const contactSettings = await db.getContactSettings(club.id);

const defaultNavItems = [
  { label: 'Home', href: `/${slug}` },
  { label: 'News', href: `/${slug}/news` },
  { label: 'Fixtures', href: `/${slug}/fixtures` },
  { label: 'About', href: `/${slug}/about` },
  { label: 'Contact', href: `/${slug}/contact` },
];

const defaultHeader = {
  show_cta: true,
  cta_label: 'Join the Club',
  cta_url: `/${slug}/contact`,
};

const defaultFooterLinks = [
  { label: 'Fixtures', href: `/${slug}/fixtures` },
  { label: 'News', href: `/${slug}/news` },
  { label: 'Contact', href: `/${slug}/contact` },
];

const navItems = siteSettings?.nav_items ? JSON.parse(siteSettings.nav_items) : defaultNavItems;
const headerSettings = siteSettings?.header_settings ? JSON.parse(siteSettings.header_settings) : defaultHeader;
const footerLinks = siteSettings?.footer_links ? JSON.parse(siteSettings.footer_links) : defaultFooterLinks;

const contactFormSettings = {
  notify_email: contactSettings?.notify_email || club.contact_email || user.email,
  retention_days: contactSettings?.retention_days ?? 30,
  form_title: contactSettings?.form_title || `Contact ${club.name}`,
  form_intro: contactSettings?.form_intro || `Have a question for ${club.name}? Send us a message and we will get back to you soon.`,
  success_message: contactSettings?.success_message || 'Thanks! We will get back to you shortly.',
  is_enabled: contactSettings?.is_enabled ?? 1,
};
---

<AdminLayout
  title="Website Editor"
  club={club}
  user={user}
  member={member}
  currentPage="website"
>
  <Fragment slot="header-actions">
    <a href={`/${slug}`} target="_blank" class="flex items-center gap-2 px-4 py-2 border border-slate-200 text-slate-600 rounded-xl hover:bg-slate-100 transition-colors text-sm font-medium">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
      </svg>
      Preview site
    </a>
  </Fragment>

  <!-- Template Selector -->
  <div class="bg-gradient-to-r from-green-50 to-blue-50 rounded-2xl border border-green-200 p-6 mb-6">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h2 class="text-lg font-semibold text-slate-900 flex items-center gap-2">
          <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/>
          </svg>
          Website Template
        </h2>
        <p class="text-sm text-slate-600 mt-1">Choose the overall design style for your website</p>
      </div>
      <span class="px-3 py-1 rounded-full text-xs font-semibold bg-white text-green-700 border border-green-300">
        Current: {templateId.charAt(0).toUpperCase() + templateId.slice(1)}
      </span>
    </div>

    <div class="grid md:grid-cols-3 gap-4 mt-6">
      <button type="button" class={`template-option text-left p-4 rounded-xl border-2 transition-all ${templateId === 'classic' ? 'border-green-500 bg-white shadow-md' : 'border-slate-200 bg-white hover:border-slate-300'}`} data-template="classic">
        <div class="flex items-center justify-between mb-2">
          <h3 class="font-semibold text-slate-900">Classic</h3>
          {templateId === 'classic' && (
            <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
          )}
        </div>
        <p class="text-sm text-slate-600">Traditional GAA club layout with hero banner and latest news</p>
      </button>

      <button type="button" class={`template-option text-left p-4 rounded-xl border-2 transition-all ${templateId === 'matchday' ? 'border-green-500 bg-white shadow-md' : 'border-slate-200 bg-white hover:border-slate-300'}`} data-template="matchday">
        <div class="flex items-center justify-between mb-2">
          <h3 class="font-semibold text-slate-900">Matchday</h3>
          {templateId === 'matchday' && (
            <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
          )}
        </div>
        <p class="text-sm text-slate-600">Fixtures and results focused with countdown to next match</p>
      </button>

      <button type="button" class={`template-option text-left p-4 rounded-xl border-2 transition-all ${templateId === 'community' ? 'border-green-500 bg-white shadow-md' : 'border-slate-200 bg-white hover:border-slate-300'}`} data-template="community">
        <div class="flex items-center justify-between mb-2">
          <h3 class="font-semibold text-slate-900">Community</h3>
          {templateId === 'community' && (
            <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
          )}
        </div>
        <p class="text-sm text-slate-600">Highlights volunteers, sponsors, and community engagement</p>
      </button>
    </div>
  </div>

  <div class="grid gap-6 xl:grid-cols-[1.1fr_0.9fr]">
    <div class="space-y-6">
      <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
        <div class="flex items-start justify-between gap-4">
          <div>
            <h2 class="text-lg font-semibold text-slate-900">Navigation + Header</h2>
            <p class="text-sm text-slate-500 mt-1">Control your menu order and the header call-to-action.</p>
          </div>
          <span class="px-2.5 py-1 rounded-full text-xs font-medium bg-slate-100 text-slate-600">Live menu</span>
        </div>

        <div class="mt-6 space-y-4" id="nav-list" data-club-id={club.id}>
          {navItems.map((item: any, index: number) => (
            <div class="nav-row flex flex-col gap-3 rounded-xl border border-slate-200 p-4" data-index={index}>
              <div class="flex flex-wrap gap-3">
                <input
                  type="text"
                  class="nav-label flex-1 min-w-[180px] px-3 py-2 rounded-lg border border-slate-200 text-sm text-slate-700"
                  placeholder="Label"
                  value={item.label}
                  disabled={!canEdit}
                />
                <input
                  type="text"
                  class="nav-href flex-1 min-w-[200px] px-3 py-2 rounded-lg border border-slate-200 text-sm text-slate-700"
                  placeholder="/your-page or https://"
                  value={item.href}
                  disabled={!canEdit}
                />
                {canEdit && (
                  <div class="flex items-center gap-2">
                    <button type="button" class="nav-up p-2 rounded-lg border border-slate-200 text-slate-500 hover:text-slate-900" title="Move up">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/>
                      </svg>
                    </button>
                    <button type="button" class="nav-down p-2 rounded-lg border border-slate-200 text-slate-500 hover:text-slate-900" title="Move down">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                      </svg>
                    </button>
                    <button type="button" class="nav-remove p-2 rounded-lg border border-slate-200 text-slate-500 hover:text-red-600" title="Remove">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                      </svg>
                    </button>
                  </div>
                )}
              </div>
              <p class="text-xs text-slate-400">Tip: Use internal routes like <span class="text-slate-600">/{slug}/news</span> or external links.</p>
            </div>
          ))}
        </div>

        {canEdit && (
          <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
            <button type="button" id="add-nav" class="px-4 py-2 rounded-lg border border-slate-200 text-slate-600 text-sm font-medium hover:bg-slate-50">
              Add menu item
            </button>
            <button type="button" id="save-nav" class="px-5 py-2 rounded-lg bg-green-500 text-white text-sm font-semibold hover:bg-green-600">
              Save navigation
            </button>
          </div>
        )}
      </div>

      <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-slate-900">Header Call-to-Action</h2>
        <p class="text-sm text-slate-500 mt-1">Highlight a key action like “Join the Club” or “Buy Tickets”.</p>

        <div class="mt-5 grid gap-4 md:grid-cols-2">
          <label class="flex items-center gap-3">
            <input type="checkbox" id="cta-enabled" class="rounded border-slate-300 text-green-600" checked={headerSettings.show_cta} disabled={!canEdit} />
            <span class="text-sm text-slate-700">Show header CTA button</span>
          </label>
          <div></div>
          <div>
            <label class="text-xs font-semibold text-slate-500">Button label</label>
            <input type="text" id="cta-label" class="mt-2 w-full px-3 py-2 rounded-lg border border-slate-200 text-sm" value={headerSettings.cta_label} disabled={!canEdit} />
          </div>
          <div>
            <label class="text-xs font-semibold text-slate-500">Button link</label>
            <input type="text" id="cta-url" class="mt-2 w-full px-3 py-2 rounded-lg border border-slate-200 text-sm" value={headerSettings.cta_url} disabled={!canEdit} />
          </div>
        </div>

        {canEdit && (
          <div class="mt-4 flex justify-end">
            <button type="button" id="save-header" class="px-5 py-2 rounded-lg bg-slate-900 text-white text-sm font-semibold hover:bg-slate-800">
              Save header
            </button>
          </div>
        )}
      </div>

      <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-slate-900">Footer Links</h2>
        <p class="text-sm text-slate-500 mt-1">Add quick links that appear in the footer and app menus.</p>

        <div class="mt-6 space-y-4" id="footer-list">
          {footerLinks.map((item: any, index: number) => (
            <div class="footer-row flex flex-col gap-3 rounded-xl border border-slate-200 p-4" data-index={index}>
              <div class="flex flex-wrap gap-3">
                <input
                  type="text"
                  class="footer-label flex-1 min-w-[180px] px-3 py-2 rounded-lg border border-slate-200 text-sm text-slate-700"
                  placeholder="Label"
                  value={item.label}
                  disabled={!canEdit}
                />
                <input
                  type="text"
                  class="footer-href flex-1 min-w-[200px] px-3 py-2 rounded-lg border border-slate-200 text-sm text-slate-700"
                  placeholder="/your-page or https://"
                  value={item.href}
                  disabled={!canEdit}
                />
                {canEdit && (
                  <div class="flex items-center gap-2">
                    <button type="button" class="footer-up p-2 rounded-lg border border-slate-200 text-slate-500 hover:text-slate-900" title="Move up">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/>
                      </svg>
                    </button>
                    <button type="button" class="footer-down p-2 rounded-lg border border-slate-200 text-slate-500 hover:text-slate-900" title="Move down">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                      </svg>
                    </button>
                    <button type="button" class="footer-remove p-2 rounded-lg border border-slate-200 text-slate-500 hover:text-red-600" title="Remove">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                      </svg>
                    </button>
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>

        {canEdit && (
          <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
            <button type="button" id="add-footer" class="px-4 py-2 rounded-lg border border-slate-200 text-slate-600 text-sm font-medium hover:bg-slate-50">
              Add footer link
            </button>
            <button type="button" id="save-footer" class="px-5 py-2 rounded-lg bg-green-500 text-white text-sm font-semibold hover:bg-green-600">
              Save footer
            </button>
          </div>
        )}
      </div>

      <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-lg font-semibold text-slate-900">Homepage Layout</h2>
            <p class="text-sm text-slate-500">Reorder sections and toggle visibility.</p>
          </div>
        </div>

        {!canEdit && (
          <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 mt-4">
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
              </svg>
              <p class="text-amber-700 text-sm">You need Admin or PRO role to edit the homepage layout.</p>
            </div>
          </div>
        )}

        <div class="space-y-3 mt-6" id="blocks-container" data-club-id={club.id}>
          {blocks.sort((a, b) => a.order - b.order).map((block, index) => {
            const info = blockInfo[block.type] || { name: block.type, description: '', icon: '' };
            return (
              <div
                class={`block-item bg-white rounded-xl border ${block.visible ? 'border-slate-200' : 'border-slate-200 opacity-50'} p-4 transition-all shadow-sm hover:shadow-md`}
                data-block-id={block.id}
                data-order={block.order}
                data-required={block.required}
                data-locked={block.locked}
                draggable={canEdit && !block.locked ? 'true' : 'false'}
              >
                <div class="flex items-center gap-4">
                  <div class="flex flex-col gap-1">
                    {canEdit && !block.locked && (
                      <>
                        <button
                          class="move-up p-1 text-slate-400 hover:text-green-600 disabled:opacity-30 disabled:cursor-not-allowed transition-colors rounded hover:bg-green-50"
                          disabled={index === 0}
                          title="Move up"
                        >
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/>
                          </svg>
                        </button>
                        <button
                          class="move-down p-1 text-slate-400 hover:text-green-600 disabled:opacity-30 disabled:cursor-not-allowed transition-colors rounded hover:bg-green-50"
                          disabled={index === blocks.length - 1}
                          title="Move down"
                        >
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                          </svg>
                        </button>
                      </>
                    )}
                    {block.locked && (
                      <div class="p-1 text-slate-300" title="This block is locked">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                        </svg>
                      </div>
                    )}
                  </div>

                  <div class="w-10 h-10 rounded-lg bg-slate-100 flex items-center justify-center">
                    <svg class="w-5 h-5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={info.icon} />
                  </div>

                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2">
                      <h3 class="text-slate-900 font-medium">{info.name}</h3>
                      {block.required && (
                        <span class="px-2 py-0.5 bg-blue-100 text-blue-700 rounded text-xs font-medium">Required</span>
                      )}
                      {block.locked && (
                        <span class="px-2 py-0.5 bg-slate-100 text-slate-500 rounded text-xs font-medium">Locked</span>
                      )}
                    </div>
                    <p class="text-slate-500 text-sm truncate">{info.description}</p>
                  </div>

                  {canEdit && !block.required && (
                    <label class="relative inline-flex items-center cursor-pointer">
                      <input
                        type="checkbox"
                        class="sr-only peer visibility-toggle"
                        checked={block.visible}
                        data-block-id={block.id}
                      />
                      <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-green-500/50 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all after:shadow-sm peer-checked:bg-green-500"></div>
                    </label>
                  )}
                  {block.required && (
                    <div class="text-slate-400 text-sm">Always visible</div>
                  )}
                </div>
              </div>
            );
          })}
        </div>

        {canEdit && (
          <div class="flex flex-wrap items-center justify-between gap-3 mt-6 pt-6 border-t border-slate-200">
            <button
              id="homepage-reset-btn"
              class="px-4 py-2 text-slate-500 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors text-sm font-medium"
            >
              Reset to default
            </button>
            <div class="flex items-center gap-3">
              <span id="homepage-save-status" class="text-green-600 text-sm hidden">Saved</span>
              <button
                id="homepage-save-btn"
                class="px-6 py-2 bg-green-500 hover:bg-green-600 text-white font-medium rounded-xl transition-colors text-sm disabled:opacity-50 disabled:cursor-not-allowed shadow-lg shadow-green-500/25"
              >
                Save layout
              </button>
            </div>
          </div>
        )}
      </div>
    </div>

    <div class="space-y-6">
      <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
        <div class="flex items-start justify-between gap-4">
          <div>
            <h2 class="text-lg font-semibold text-slate-900">Contact Form</h2>
            <p class="text-sm text-slate-500 mt-1">Control submissions, retention, and email notifications.</p>
          </div>
          <span class="px-2.5 py-1 rounded-full text-xs font-medium bg-green-100 text-green-700">GDPR-ready</span>
        </div>

        <div class="mt-6 grid gap-4">
          <label class="flex items-center gap-3">
            <input type="checkbox" id="contact-enabled" class="rounded border-slate-300 text-green-600" checked={contactFormSettings.is_enabled === 1} disabled={!canEdit} />
            <span class="text-sm text-slate-700">Enable contact form on site</span>
          </label>

          <div>
            <label class="text-xs font-semibold text-slate-500">Notification email</label>
            <input type="email" id="contact-email" class="mt-2 w-full px-3 py-2 rounded-lg border border-slate-200 text-sm" value={contactFormSettings.notify_email} disabled={!canEdit} />
            <p class="text-xs text-slate-400 mt-2">Leave blank to disable email notifications (submissions still saved).</p>
          </div>

          <div>
            <label class="text-xs font-semibold text-slate-500">Retention period (days)</label>
            <input type="number" min="1" max="90" id="contact-retention" class="mt-2 w-full px-3 py-2 rounded-lg border border-slate-200 text-sm" value={contactFormSettings.retention_days} disabled={!canEdit} />
            <p class="text-xs text-slate-400 mt-2">Submissions auto-delete after this period. Default: 30 days.</p>
          </div>

          <div>
            <label class="text-xs font-semibold text-slate-500">Form title</label>
            <input type="text" id="contact-title" class="mt-2 w-full px-3 py-2 rounded-lg border border-slate-200 text-sm" value={contactFormSettings.form_title} disabled={!canEdit} />
          </div>

          <div>
            <label class="text-xs font-semibold text-slate-500">Intro text</label>
            <textarea id="contact-intro" rows="3" class="mt-2 w-full px-3 py-2 rounded-lg border border-slate-200 text-sm" disabled={!canEdit}>{contactFormSettings.form_intro}</textarea>
          </div>

          <div>
            <label class="text-xs font-semibold text-slate-500">Success message</label>
            <textarea id="contact-success" rows="2" class="mt-2 w-full px-3 py-2 rounded-lg border border-slate-200 text-sm" disabled={!canEdit}>{contactFormSettings.success_message}</textarea>
          </div>
        </div>

        {canEdit && (
          <div class="mt-5 flex items-center justify-between">
            <a href={`/${slug}/admin-portal/inbox`} class="text-sm text-green-600 hover:text-green-700 font-medium">View submissions</a>
            <button type="button" id="save-contact" class="px-5 py-2 rounded-lg bg-slate-900 text-white text-sm font-semibold hover:bg-slate-800">
              Save contact settings
            </button>
          </div>
        )}
      </div>

      <div class="bg-gradient-to-br from-slate-900 to-slate-800 rounded-2xl p-6 text-white shadow-lg">
        <h3 class="text-lg font-semibold">Website health check</h3>
        <p class="text-sm text-white/70 mt-1">Keep the essentials up to date for members and supporters.</p>
        <ul class="mt-4 space-y-2 text-sm text-white/80">
          <li class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-green-400"></span>
            Publish weekly news updates
          </li>
          <li class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-amber-300"></span>
            Keep fixtures current and results posted
          </li>
          <li class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-blue-300"></span>
            Add sponsor logos to boost visibility
          </li>
        </ul>
        <a href={`/${slug}/admin-portal/posts/new`} class="inline-flex items-center gap-2 mt-4 px-4 py-2 bg-white text-slate-900 rounded-lg text-sm font-semibold hover:bg-slate-100">
          Create a post
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</AdminLayout>

<script define:vars={{ canEdit, clubId: club.id }}>
  function collectRows(containerId, rowSelector, labelSelector, hrefSelector) {
    const container = document.getElementById(containerId);
    if (!container) return [];
    return Array.from(container.querySelectorAll(rowSelector))
      .map((row) => {
        const label = row.querySelector(labelSelector)?.value?.trim();
        const href = row.querySelector(hrefSelector)?.value?.trim();
        return label && href ? { label, href } : null;
      })
      .filter(Boolean);
  }

  function addRow(containerId, className) {
    const container = document.getElementById(containerId);
    if (!container) return;

    const row = document.createElement('div');
    row.className = `${className}-row flex flex-col gap-3 rounded-xl border border-slate-200 p-4`;
    row.innerHTML = `
      <div class="flex flex-wrap gap-3">
        <input type="text" class="${className}-label flex-1 min-w-[180px] px-3 py-2 rounded-lg border border-slate-200 text-sm text-slate-700" placeholder="Label" />
        <input type="text" class="${className}-href flex-1 min-w-[200px] px-3 py-2 rounded-lg border border-slate-200 text-sm text-slate-700" placeholder="/your-page or https://" />
        <div class="flex items-center gap-2">
          <button type="button" class="${className}-up p-2 rounded-lg border border-slate-200 text-slate-500 hover:text-slate-900" title="Move up">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/></svg>
          </button>
          <button type="button" class="${className}-down p-2 rounded-lg border border-slate-200 text-slate-500 hover:text-slate-900" title="Move down">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </button>
          <button type="button" class="${className}-remove p-2 rounded-lg border border-slate-200 text-slate-500 hover:text-red-600" title="Remove">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
      </div>
    `;
    container.appendChild(row);
  }

  function wireRowControls(containerId, className) {
    const container = document.getElementById(containerId);
    if (!container) return;

    container.addEventListener('click', (event) => {
      const target = event.target.closest(`.${className}-up, .${className}-down, .${className}-remove`);
      if (!target) return;

      const row = target.closest(`.${className}-row`);
      if (!row) return;

      if (target.classList.contains(`${className}-remove`)) {
        row.remove();
        return;
      }

      const rows = Array.from(container.querySelectorAll(`.${className}-row`));
      const index = rows.indexOf(row);

      if (target.classList.contains(`${className}-up`) && index > 0) {
        container.insertBefore(row, rows[index - 1]);
      }

      if (target.classList.contains(`${className}-down`) && index < rows.length - 1) {
        container.insertBefore(rows[index + 1], row);
      }
    });
  }

  if (canEdit) {
    document.getElementById('add-nav')?.addEventListener('click', () => addRow('nav-list', 'nav'));
    document.getElementById('add-footer')?.addEventListener('click', () => addRow('footer-list', 'footer'));
  }

  wireRowControls('nav-list', 'nav');
  wireRowControls('footer-list', 'footer');

  async function saveSiteSettings() {
    if (!clubId) return;

    const navItems = collectRows('nav-list', '.nav-row', '.nav-label', '.nav-href');
    const footerLinks = collectRows('footer-list', '.footer-row', '.footer-label', '.footer-href');

    const headerSettings = {
      show_cta: document.getElementById('cta-enabled')?.checked ?? true,
      cta_label: document.getElementById('cta-label')?.value?.trim() || 'Join the Club',
      cta_url: document.getElementById('cta-url')?.value?.trim() || '/contact',
    };

    const res = await fetch(`/api/clubs/${clubId}/site-settings`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ nav_items: navItems, header_settings: headerSettings, footer_links: footerLinks }),
    });

    if (!res.ok) {
      const data = await res.json();
      throw new Error(data.error || 'Failed to save');
    }
  }

  document.getElementById('save-nav')?.addEventListener('click', async () => {
    try {
      await saveSiteSettings();
      alert('Navigation saved');
    } catch (error) {
      alert(error.message || 'Failed to save navigation');
    }
  });

  document.getElementById('save-header')?.addEventListener('click', async () => {
    try {
      await saveSiteSettings();
      alert('Header saved');
    } catch (error) {
      alert(error.message || 'Failed to save header');
    }
  });

  document.getElementById('save-footer')?.addEventListener('click', async () => {
    try {
      await saveSiteSettings();
      alert('Footer saved');
    } catch (error) {
      alert(error.message || 'Failed to save footer');
    }
  });

  document.getElementById('save-contact')?.addEventListener('click', async () => {
    if (!clubId) return;

    const payload = {
      notify_email: document.getElementById('contact-email')?.value?.trim() || null,
      retention_days: parseInt(document.getElementById('contact-retention')?.value || '30', 10),
      form_title: document.getElementById('contact-title')?.value?.trim() || null,
      form_intro: document.getElementById('contact-intro')?.value?.trim() || null,
      success_message: document.getElementById('contact-success')?.value?.trim() || null,
      is_enabled: document.getElementById('contact-enabled')?.checked ? 1 : 0,
    };

    const res = await fetch(`/api/clubs/${clubId}/contact/settings`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });

    const data = await res.json();
    if (!res.ok) {
      alert(data.error || 'Failed to save contact settings');
      return;
    }

    alert('Contact settings saved');
  });

  const blocksContainer = document.getElementById('blocks-container');
  const saveBtn = document.getElementById('homepage-save-btn');
  const resetBtn = document.getElementById('homepage-reset-btn');
  const saveStatus = document.getElementById('homepage-save-status');

  let hasChanges = false;

  function markChanged() {
    hasChanges = true;
    if (saveBtn) saveBtn.disabled = false;
    saveStatus?.classList.add('hidden');
  }

  function getBlocksData() {
    const blockElements = blocksContainer?.querySelectorAll('.block-item') || [];
    const blocks = [];

    blockElements.forEach((el, index) => {
      const blockId = el.dataset.blockId;
      const isRequired = el.dataset.required === 'true';
      const isLocked = el.dataset.locked === 'true';
      const toggle = el.querySelector('.visibility-toggle');
      const isVisible = isRequired || toggle?.checked || false;

      blocks.push({
        id: blockId,
        type: blockId,
        required: isRequired,
        locked: isLocked,
        visible: isVisible,
        order: index,
        settings: {},
      });
    });

    return blocks;
  }

  function swapBlocks(index1, index2) {
    const blocks = blocksContainer?.querySelectorAll('.block-item') || [];
    if (index2 < 0 || index2 >= blocks.length) return;

    const block1 = blocks[index1];
    const block2 = blocks[index2];

    if (block1.dataset.locked === 'true' || block2.dataset.locked === 'true') return;

    if (index1 < index2) {
      blocksContainer?.insertBefore(block2, block1);
    } else {
      blocksContainer?.insertBefore(block1, block2);
    }

    blocksContainer?.querySelectorAll('.block-item')?.forEach((el, i) => {
      el.dataset.order = String(i);
    });

    updateButtonStates();
    markChanged();
  }

  function updateButtonStates() {
    const blocks = blocksContainer?.querySelectorAll('.block-item') || [];
    blocks.forEach((block, index) => {
      const upBtn = block.querySelector('.move-up');
      const downBtn = block.querySelector('.move-down');

      if (upBtn) upBtn.disabled = index === 0;
      if (downBtn) downBtn.disabled = index === blocks.length - 1;
    });
  }

  blocksContainer?.addEventListener('click', (event) => {
    const btn = event.target.closest('.move-up, .move-down');
    if (!btn) return;

    const blockItem = btn.closest('.block-item');
    const blocks = Array.from(blocksContainer.querySelectorAll('.block-item'));
    const currentIndex = blocks.indexOf(blockItem);

    if (btn.classList.contains('move-up')) {
      swapBlocks(currentIndex, currentIndex - 1);
    } else {
      swapBlocks(currentIndex, currentIndex + 1);
    }
  });

  blocksContainer?.querySelectorAll('.visibility-toggle')?.forEach((toggle) => {
    toggle.addEventListener('change', () => {
      const blockItem = toggle.closest('.block-item');
      if (!blockItem) return;
      if (toggle.checked) {
        blockItem.classList.remove('opacity-50');
      } else {
        blockItem.classList.add('opacity-50');
      }
      markChanged();
    });
  });

  // Drag and drop functionality
  let draggedElement = null;
  let draggedIndex = null;

  blocksContainer?.addEventListener('dragstart', (event) => {
    const blockItem = event.target.closest('.block-item');
    if (!blockItem || blockItem.dataset.locked === 'true') {
      event.preventDefault();
      return;
    }

    draggedElement = blockItem;
    const blocks = Array.from(blocksContainer.querySelectorAll('.block-item'));
    draggedIndex = blocks.indexOf(blockItem);

    blockItem.classList.add('dragging');
    event.dataTransfer.effectAllowed = 'move';
    event.dataTransfer.setData('text/html', blockItem.innerHTML);
  });

  blocksContainer?.addEventListener('dragover', (event) => {
    event.preventDefault();
    event.dataTransfer.dropEffect = 'move';

    const blockItem = event.target.closest('.block-item');

    if (blockItem && blockItem !== draggedElement && blockItem.dataset.locked !== 'true') {
      blockItem.classList.add('drag-over');
    }
  });

  blocksContainer?.addEventListener('dragenter', (event) => {
    const blockItem = event.target.closest('.block-item');
    if (blockItem && blockItem !== draggedElement && blockItem.dataset.locked !== 'true') {
      blockItem.classList.add('drag-over');
    }
  });

  blocksContainer?.addEventListener('dragleave', (event) => {
    const blockItem = event.target.closest('.block-item');
    if (blockItem && !blockItem.contains(event.relatedTarget)) {
      blockItem.classList.remove('drag-over');
    }
  });

  blocksContainer?.addEventListener('drop', (event) => {
    event.preventDefault();

    const dropTarget = event.target.closest('.block-item');
    if (!dropTarget || dropTarget === draggedElement || dropTarget.dataset.locked === 'true') {
      return;
    }

    const blocks = Array.from(blocksContainer.querySelectorAll('.block-item'));
    const dropIndex = blocks.indexOf(dropTarget);

    // Remove all drag-over classes
    blocks.forEach(block => block.classList.remove('drag-over'));

    // Perform the reorder
    if (draggedIndex < dropIndex) {
      blocksContainer?.insertBefore(draggedElement, dropTarget.nextSibling);
    } else {
      blocksContainer?.insertBefore(draggedElement, dropTarget);
    }

    // Update order data attributes
    blocksContainer?.querySelectorAll('.block-item')?.forEach((el, i) => {
      el.dataset.order = String(i);
    });

    updateButtonStates();
    markChanged();
  });

  blocksContainer?.addEventListener('dragend', (event) => {
    const blockItem = event.target.closest('.block-item');
    if (blockItem) {
      blockItem.classList.remove('dragging');
    }

    // Clean up all drag-related classes
    blocksContainer?.querySelectorAll('.block-item')?.forEach((el) => {
      el.classList.remove('drag-over', 'dragging');
    });

    draggedElement = null;
    draggedIndex = null;
  });

  saveBtn?.addEventListener('click', async () => {
    saveBtn.disabled = true;
    saveBtn.textContent = 'Saving...';

    try {
      const blocks = getBlocksData();
      const res = await fetch(`/api/clubs/${clubId}/homepage-config`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ blocks, overrides: {} }),
      });

      const data = await res.json();

      if (!res.ok) {
        throw new Error(data.error || 'Failed to save');
      }

      hasChanges = false;
      saveStatus.textContent = 'Saved!';
      saveStatus.classList.remove('hidden');
      saveBtn.textContent = 'Save layout';

      setTimeout(() => {
        saveStatus.classList.add('hidden');
      }, 3000);
    } catch (error) {
      console.error('Save error:', error);
      alert(error.message || 'Failed to save changes');
      saveBtn.disabled = false;
      saveBtn.textContent = 'Save layout';
    }
  });

  resetBtn?.addEventListener('click', async () => {
    if (!confirm('Reset to default layout? This will remove all your customizations.')) {
      return;
    }

    try {
      const res = await fetch(`/api/clubs/${clubId}/homepage-config`, {
        method: 'DELETE',
      });

      if (!res.ok) {
        throw new Error('Failed to reset');
      }

      window.location.reload();
    } catch (error) {
      console.error('Reset error:', error);
      alert(error.message || 'Failed to reset');
    }
  });

  window.addEventListener('beforeunload', (e) => {
    if (hasChanges) {
      e.preventDefault();
      e.returnValue = '';
    }
  });

  // Template switching
  document.querySelectorAll('.template-option')?.forEach((btn) => {
    btn.addEventListener('click', async () => {
      const template = btn.dataset.template;

      if (!confirm(`Switch to ${template} template? This will reset your homepage layout to the default ${template} blocks.`)) {
        return;
      }

      try {
        const res = await fetch(`/api/clubs/${clubId}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ template }),
        });

        if (!res.ok) {
          const data = await res.json();
          throw new Error(data.error || 'Failed to change template');
        }

        // Delete homepage config to reset to template defaults
        await fetch(`/api/clubs/${clubId}/homepage-config`, {
          method: 'DELETE',
        });

        window.location.reload();
      } catch (error) {
        console.error('Template switch error:', error);
        alert(error.message || 'Failed to switch template');
      }
    });
  });
</script>

<style>
  @import "../../../../styles/global.css";

  .block-item[draggable="true"] {
    cursor: move;
  }

  .block-item.dragging {
    opacity: 0.5;
    transform: scale(0.95);
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
  }

  .block-item.drag-over {
    border-color: #10b981 !important;
    background-color: #f0fdf4;
    transform: translateY(-2px);
  }

  .block-item[draggable="true"]:hover {
    cursor: grab;
  }

  .block-item[draggable="true"]:active {
    cursor: grabbing;
  }
</style>
