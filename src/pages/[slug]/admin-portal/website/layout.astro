---
import AdminLayout from '../../../../components/admin/AdminLayout.astro';
import { DatabaseService } from '../../../../lib/db';
import { getAuthContext } from '../../../../lib/auth';
import { getDefaultConfig, type BlockConfig } from '../../../../lib/templates';
import { hasPermission, type Role } from '../../../../lib/permissions';

const { slug } = Astro.params;

if (!Astro.locals.runtime.env.DB) {
  return Astro.redirect('/admin?error=db_not_configured');
}

const db = new DatabaseService(Astro.locals.runtime.env.DB);
const { user } = await getAuthContext(Astro.cookies, db);

if (!user) {
  return Astro.redirect('/admin/login');
}

const club = await db.getClubBySlug(slug!);
if (!club) {
  return Astro.redirect('/admin');
}

const member = await db.getClubMember(club.id, user.id);
if (!member) {
  return Astro.redirect('/admin');
}

const canEdit = hasPermission(member.role as Role, 'homepage.edit');

const homepageConfig = await db.getHomepageConfig(club.id);
const templateId = club.template as 'classic' | 'matchday' | 'community';
const defaultBlocks = getDefaultConfig(templateId);

let blocks: BlockConfig[];
if (homepageConfig) {
  const config = JSON.parse(homepageConfig.config);
  blocks = config.blocks;
} else {
  blocks = defaultBlocks;
}

const blockInfo: Record<string, { name: string; description: string; icon: string }> = {
  'hero': {
    name: 'Hero Banner',
    description: 'Main welcome section with crest, headline, and CTA',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>'
  },
  'next-fixture': {
    name: 'Next Fixture',
    description: 'Countdown to the next match',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>'
  },
  'latest-news': {
    name: 'Latest News',
    description: 'Recent posts and announcements',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>'
  },
  'latest-result': {
    name: 'Latest Result',
    description: 'Most recent match result',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>'
  },
  'results-ticker': {
    name: 'Results Ticker',
    description: 'Scrolling recent results banner',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>'
  },
  'notices': {
    name: 'Notices',
    description: 'Important club announcements',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"/>'
  },
  'highlight-cards': {
    name: 'Highlight Cards',
    description: 'Feature three key links or CTAs',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>'
  },
  'volunteer-spotlight': {
    name: 'Volunteer Spotlight',
    description: 'Showcase a volunteer or committee member',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>'
  },
  'sponsors': {
    name: 'Sponsors',
    description: 'Showcase sponsor logos and tiers',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/>'
  },
  'contact': {
    name: 'Contact',
    description: 'Club contact information and social links',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>'
  },
};
---

<AdminLayout
  title="Homepage Layout"
  club={club}
  user={user}
  member={member}
  currentPage="website"
>
  <div class="max-w-4xl mx-auto">
    <!-- Header -->
    <div class="mb-8">
      <a href={`/${slug}/admin-portal/website`} class="inline-flex items-center gap-2 text-slate-600 hover:text-slate-900 mb-4 group">
        <svg class="w-4 h-4 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        Back to Website
      </a>
      <div class="flex items-start justify-between gap-4 flex-wrap">
        <div>
          <h1 class="text-3xl font-bold text-slate-900 mb-2">Homepage Layout</h1>
          <p class="text-slate-600">Drag and drop blocks to customize your homepage. Locked blocks cannot be moved.</p>
        </div>
        <a href={`/${slug}`} target="_blank" class="flex items-center gap-2 px-4 py-2.5 bg-white border border-slate-200 text-slate-700 rounded-xl hover:bg-slate-50 transition-all text-sm font-medium shadow-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
          Preview
        </a>
      </div>
    </div>

    {!canEdit && (
      <div class="bg-amber-50 border-2 border-amber-200 rounded-2xl p-6 mb-8">
        <div class="flex items-center gap-3">
          <svg class="w-6 h-6 text-amber-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
          </svg>
          <p class="text-amber-800 font-medium">You need Admin or PRO role to edit the homepage layout.</p>
        </div>
      </div>
    )}

    <!-- Blocks Container -->
    <div class="bg-white rounded-2xl border-2 border-slate-200 p-6 mb-6">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-bold text-slate-900">Page Blocks</h2>
        <div class="flex items-center gap-3">
          <span id="save-status" class="text-green-600 text-sm font-medium hidden">✓ Saved</span>
          {canEdit && (
            <button
              id="save-btn"
              class="px-5 py-2.5 bg-gradient-to-r from-green-500 to-emerald-600 hover:from-green-600 hover:to-emerald-700 text-white font-semibold rounded-xl transition-all shadow-lg hover:shadow-xl disabled:opacity-50 disabled:cursor-not-allowed"
            >
              Save Layout
            </button>
          )}
        </div>
      </div>

      <div id="blocks-container" class="space-y-3" data-club-id={club.id}>
        {blocks.sort((a, b) => a.order - b.order).map((block, index) => {
          const info = blockInfo[block.type] || { name: block.type, description: '', icon: '' };
          return (
            <div
              class={`block-item group bg-gradient-to-r ${block.visible ? 'from-white to-slate-50' : 'from-slate-50 to-slate-100 opacity-60'} rounded-xl border-2 ${block.visible ? 'border-slate-200' : 'border-slate-300'} p-5 transition-all hover:shadow-lg ${canEdit && !block.locked ? 'cursor-grab active:cursor-grabbing' : ''}`}
              data-block-id={block.id}
              data-order={block.order}
              data-required={block.required}
              data-locked={block.locked}
              draggable={canEdit && !block.locked ? 'true' : 'false'}
            >
              <div class="flex items-center gap-4">
                <!-- Drag Handle -->
                {canEdit && !block.locked ? (
                  <div class="flex flex-col gap-0.5 text-slate-400 group-hover:text-slate-600 transition-colors">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M7 2a2 2 0 1 0 .001 4.001A2 2 0 0 0 7 2zm0 6a2 2 0 1 0 .001 4.001A2 2 0 0 0 7 8zm0 6a2 2 0 1 0 .001 4.001A2 2 0 0 0 7 14zm6-8a2 2 0 1 0-.001-4.001A2 2 0 0 0 13 6zm0 2a2 2 0 1 0 .001 4.001A2 2 0 0 0 13 8zm0 6a2 2 0 1 0 .001 4.001A2 2 0 0 0 13 14z"></path>
                    </svg>
                  </div>
                ) : block.locked && (
                  <div class="flex flex-col gap-0.5 text-slate-300">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                    </svg>
                  </div>
                )}

                <!-- Icon -->
                <div class={`w-12 h-12 rounded-xl ${block.visible ? 'bg-gradient-to-br from-blue-500 to-indigo-600' : 'bg-slate-400'} flex items-center justify-center flex-shrink-0 shadow-md`}>
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={info.icon} />
                </div>

                <!-- Info -->
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-1">
                    <h3 class="text-slate-900 font-semibold">{info.name}</h3>
                    {block.required && (
                      <span class="px-2 py-0.5 bg-blue-100 text-blue-700 rounded-md text-xs font-semibold">Required</span>
                    )}
                    {block.locked && (
                      <span class="px-2 py-0.5 bg-slate-100 text-slate-600 rounded-md text-xs font-semibold">Locked</span>
                    )}
                  </div>
                  <p class="text-slate-600 text-sm">{info.description}</p>
                </div>

                <!-- Toggle -->
                {canEdit && !block.required ? (
                  <label class="relative inline-flex items-center cursor-pointer">
                    <input
                      type="checkbox"
                      class="sr-only peer visibility-toggle"
                      checked={block.visible}
                      data-block-id={block.id}
                    />
                    <div class="w-14 h-7 bg-slate-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-green-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-6 after:w-6 after:transition-all peer-checked:bg-gradient-to-r peer-checked:from-green-500 peer-checked:to-emerald-600 shadow-inner"></div>
                    <span class="ml-3 text-sm font-medium text-slate-700">{block.visible ? 'Visible' : 'Hidden'}</span>
                  </label>
                ) : block.required && (
                  <div class="text-slate-500 text-sm font-medium">Always visible</div>
                )}
              </div>
            </div>
          );
        })}
      </div>

      {canEdit && (
        <div class="flex items-center justify-between gap-3 mt-6 pt-6 border-t-2 border-slate-200">
          <button
            id="reset-btn"
            class="px-4 py-2 text-slate-600 hover:text-red-600 hover:bg-red-50 rounded-xl transition-colors text-sm font-medium"
          >
            Reset to Template Default
          </button>
        </div>
      )}
    </div>

    <!-- Help Box -->
    <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border-2 border-blue-200 rounded-2xl p-6">
      <div class="flex items-start gap-4">
        <div class="w-10 h-10 bg-blue-500 rounded-xl flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <div class="flex-1">
          <h3 class="font-semibold text-blue-900 mb-1">Drag & Drop Tips</h3>
          <ul class="text-sm text-blue-800 space-y-1">
            <li>• <strong>Click and drag</strong> blocks to reorder them</li>
            <li>• <strong>Toggle switches</strong> to show/hide optional blocks</li>
            <li>• <strong>Locked blocks</strong> are fixed by your template and cannot be moved</li>
            <li>• <strong>Required blocks</strong> must always stay visible</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<script define:vars={{ canEdit, clubId: club.id }}>
  const blocksContainer = document.getElementById('blocks-container');
  const saveBtn = document.getElementById('save-btn');
  const resetBtn = document.getElementById('reset-btn');
  const saveStatus = document.getElementById('save-status');

  let hasChanges = false;
  let draggedElement = null;

  function markChanged() {
    hasChanges = true;
    if (saveBtn) saveBtn.disabled = false;
    saveStatus?.classList.add('hidden');
  }

  function getBlocksData() {
    const blockElements = blocksContainer?.querySelectorAll('.block-item') || [];
    const blocks = [];

    blockElements.forEach((el, index) => {
      const blockId = el.dataset.blockId;
      const isRequired = el.dataset.required === 'true';
      const isLocked = el.dataset.locked === 'true';
      const toggle = el.querySelector('.visibility-toggle');
      const isVisible = isRequired || toggle?.checked || false;

      blocks.push({
        id: blockId,
        type: blockId,
        required: isRequired,
        locked: isLocked,
        visible: isVisible,
        order: index,
        settings: {},
      });
    });

    return blocks;
  }

  // Drag and drop
  if (canEdit) {
    blocksContainer?.addEventListener('dragstart', (event) => {
      const blockItem = event.target.closest('.block-item');
      if (!blockItem || blockItem.dataset.locked === 'true') {
        event.preventDefault();
        return;
      }

      draggedElement = blockItem;
      blockItem.classList.add('opacity-50', 'scale-95');
      event.dataTransfer.effectAllowed = 'move';
    });

    blocksContainer?.addEventListener('dragover', (event) => {
      event.preventDefault();
      event.dataTransfer.dropEffect = 'move';

      const blockItem = event.target.closest('.block-item');
      if (blockItem && blockItem !== draggedElement && blockItem.dataset.locked !== 'true') {
        blockItem.classList.add('ring-2', 'ring-green-500', 'ring-offset-2');
      }
    });

    blocksContainer?.addEventListener('dragleave', (event) => {
      const blockItem = event.target.closest('.block-item');
      if (blockItem && !blockItem.contains(event.relatedTarget)) {
        blockItem.classList.remove('ring-2', 'ring-green-500', 'ring-offset-2');
      }
    });

    blocksContainer?.addEventListener('drop', (event) => {
      event.preventDefault();

      const dropTarget = event.target.closest('.block-item');
      if (!dropTarget || dropTarget === draggedElement || dropTarget.dataset.locked === 'true') {
        return;
      }

      const blocks = Array.from(blocksContainer.querySelectorAll('.block-item'));
      const draggedIndex = blocks.indexOf(draggedElement);
      const dropIndex = blocks.indexOf(dropTarget);

      blocks.forEach(block => block.classList.remove('ring-2', 'ring-green-500', 'ring-offset-2'));

      if (draggedIndex < dropIndex) {
        blocksContainer?.insertBefore(draggedElement, dropTarget.nextSibling);
      } else {
        blocksContainer?.insertBefore(draggedElement, dropTarget);
      }

      blocksContainer?.querySelectorAll('.block-item')?.forEach((el, i) => {
        el.dataset.order = String(i);
      });

      markChanged();
    });

    blocksContainer?.addEventListener('dragend', (event) => {
      const blockItem = event.target.closest('.block-item');
      if (blockItem) {
        blockItem.classList.remove('opacity-50', 'scale-95');
      }

      blocksContainer?.querySelectorAll('.block-item')?.forEach((el) => {
        el.classList.remove('ring-2', 'ring-green-500', 'ring-offset-2');
      });

      draggedElement = null;
    });
  }

  // Visibility toggles
  blocksContainer?.querySelectorAll('.visibility-toggle')?.forEach((toggle) => {
    toggle.addEventListener('change', () => {
      const blockItem = toggle.closest('.block-item');
      if (!blockItem) return;

      if (toggle.checked) {
        blockItem.classList.remove('from-slate-50', 'to-slate-100', 'opacity-60');
        blockItem.classList.add('from-white', 'to-slate-50');
      } else {
        blockItem.classList.remove('from-white', 'to-slate-50');
        blockItem.classList.add('from-slate-50', 'to-slate-100', 'opacity-60');
      }
      markChanged();
    });
  });

  // Save
  saveBtn?.addEventListener('click', async () => {
    saveBtn.disabled = true;
    saveBtn.textContent = 'Saving...';

    try {
      const blocks = getBlocksData();
      const res = await fetch(`/api/clubs/${clubId}/homepage-config`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ blocks, overrides: {} }),
      });

      const data = await res.json();

      if (!res.ok) {
        throw new Error(data.error || 'Failed to save');
      }

      hasChanges = false;
      saveStatus.textContent = '✓ Saved!';
      saveStatus.classList.remove('hidden');
      saveBtn.textContent = 'Save Layout';

      setTimeout(() => {
        saveStatus.classList.add('hidden');
      }, 3000);
    } catch (error) {
      console.error('Save error:', error);
      alert(error.message || 'Failed to save changes');
      saveBtn.disabled = false;
      saveBtn.textContent = 'Save Layout';
    }
  });

  // Reset
  resetBtn?.addEventListener('click', async () => {
    if (!confirm('Reset to default layout? This will remove all your customizations.')) {
      return;
    }

    try {
      const res = await fetch(`/api/clubs/${clubId}/homepage-config`, {
        method: 'DELETE',
      });

      if (!res.ok) {
        throw new Error('Failed to reset');
      }

      window.location.reload();
    } catch (error) {
      console.error('Reset error:', error);
      alert(error.message || 'Failed to reset');
    }
  });

  window.addEventListener('beforeunload', (e) => {
    if (hasChanges) {
      e.preventDefault();
      e.returnValue = '';
    }
  });
</script>

<style>
  @import "../../../../styles/global.css";

  .block-item.dragging {
    opacity: 0.5;
    transform: scale(0.95);
  }
</style>
