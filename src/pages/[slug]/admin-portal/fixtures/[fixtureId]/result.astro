---
import AdminLayout from '../../../../../components/admin/AdminLayout.astro';
import AdminPageTemplate from '../../../../../components/admin/AdminPageTemplate.astro';
import AdminCard from '../../../../../components/admin/AdminCard.astro';
import StatusChip from '../../../../../components/admin/StatusChip.astro';
import Button from '../../../../../components/ui/Button.astro';
import { DatabaseService } from '../../../../../lib/db';
import { getAuthContext } from '../../../../../lib/auth';

const { slug, fixtureId } = Astro.params;

if (!Astro.locals.runtime.env.DB) {
  return Astro.redirect('/admin?error=db_not_configured');
}

const db = new DatabaseService(Astro.locals.runtime.env.DB);
const { user } = await getAuthContext(Astro.cookies, db);

if (!user) {
  return Astro.redirect('/admin/login');
}

const club = await db.getClubBySlug(slug!);
if (!club) {
  return Astro.redirect('/admin');
}

const member = await db.getClubMember(club.id, user.id);
if (!member) {
  return Astro.redirect('/admin');
}

// Only admin and pro can manage fixtures
if (!['admin', 'pro'].includes(member.role)) {
  return Astro.redirect(`/${slug}/admin-portal/fixtures`);
}

// Get fixture
const fixture = await Astro.locals.runtime.env.DB.prepare(`
  SELECT * FROM fixtures WHERE id = ? AND club_id = ?
`).bind(fixtureId, club.id).first();

if (!fixture) {
  return Astro.redirect(`/${slug}/admin-portal/fixtures`);
}

function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString('en-IE', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
}

const isPlayed = fixture.status === 'played';
const homeLabel = fixture.is_home ? club.name : fixture.opponent;
const awayLabel = fixture.is_home ? fixture.opponent : club.name;

const breadcrumbs = [
  { label: 'Dashboard', href: `/${slug}/admin-portal` },
  { label: 'Fixtures', href: `/${slug}/admin-portal/fixtures` },
  { label: isPlayed ? 'Edit Result' : 'Enter Result' },
];
---

<AdminLayout
  title={isPlayed ? 'Edit Result' : 'Enter Result'}
  club={club}
  user={user}
  member={member}
  currentPage="fixtures"
>
  <AdminPageTemplate
    title={isPlayed ? 'Edit Result' : 'Enter Result'}
    subtitle={`vs ${fixture.opponent}`}
    breadcrumbs={breadcrumbs}
  >
    <!-- Match Info -->
    <AdminCard>
      <div class="flex flex-wrap items-center gap-3 mb-3">
        <StatusChip variant={fixture.is_home ? 'info' : 'neutral'} size="sm">
          {fixture.is_home ? 'Home' : 'Away'}
        </StatusChip>
        {fixture.competition && (
          <span class="text-slate-600 text-sm">{fixture.competition}</span>
        )}
      </div>
      <h2 class="text-2xl font-bold text-slate-900 mb-2">vs {fixture.opponent}</h2>
      <div class="flex flex-wrap items-center gap-4 text-sm text-slate-500">
        <span>{formatDate(fixture.match_date)}</span>
        {fixture.venue && (
          <>
            <span class="text-slate-300">•</span>
            <span>{fixture.venue}</span>
          </>
        )}
      </div>
    </AdminCard>

    <form id="result-form" class="space-y-6 mt-6">
      <!-- Score Entry -->
      <AdminCard>
        <h3 class="text-lg font-semibold text-slate-900 mb-6">Score</h3>

        <!-- GAA Score Format: Goals-Points -->
        <div class="space-y-6">
          <!-- Home Team -->
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-3">{homeLabel}</label>
            <div class="flex items-center gap-4">
              <div class="flex-1">
                <label class="block text-xs text-slate-500 mb-1">Goals</label>
                <input
                  type="number"
                  id="homeGoals"
                  name="homeGoals"
                  min="0"
                  max="99"
                  required
                  value={fixture.home_goals ?? ''}
                  class="input-themed w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 text-2xl font-bold text-center focus:outline-none focus:bg-white transition-colors"
                  placeholder="0"
                />
              </div>
              <span class="text-3xl text-slate-400 font-bold mt-5">-</span>
              <div class="flex-1">
                <label class="block text-xs text-slate-500 mb-1">Points</label>
                <input
                  type="number"
                  id="homePoints"
                  name="homePoints"
                  min="0"
                  max="99"
                  required
                  value={fixture.home_points ?? ''}
                  class="input-themed w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 text-2xl font-bold text-center focus:outline-none focus:bg-white transition-colors"
                  placeholder="0"
                />
              </div>
              <div class="w-20 text-center mt-5">
                <span id="homeTotal" class="text-lg text-slate-500 font-mono">= 0</span>
              </div>
            </div>
          </div>

          <div class="border-t border-slate-200"></div>

          <!-- Away Team -->
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-3">{awayLabel}</label>
            <div class="flex items-center gap-4">
              <div class="flex-1">
                <label class="block text-xs text-slate-500 mb-1">Goals</label>
                <input
                  type="number"
                  id="awayGoals"
                  name="awayGoals"
                  min="0"
                  max="99"
                  required
                  value={fixture.away_goals ?? ''}
                  class="input-themed w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 text-2xl font-bold text-center focus:outline-none focus:bg-white transition-colors"
                  placeholder="0"
                />
              </div>
              <span class="text-3xl text-slate-400 font-bold mt-5">-</span>
              <div class="flex-1">
                <label class="block text-xs text-slate-500 mb-1">Points</label>
                <input
                  type="number"
                  id="awayPoints"
                  name="awayPoints"
                  min="0"
                  max="99"
                  required
                  value={fixture.away_points ?? ''}
                  class="input-themed w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 text-2xl font-bold text-center focus:outline-none focus:bg-white transition-colors"
                  placeholder="0"
                />
              </div>
              <div class="w-20 text-center mt-5">
                <span id="awayTotal" class="text-lg text-slate-500 font-mono">= 0</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Result Preview -->
        <div id="result-preview" class="mt-6 p-4 bg-slate-50 rounded-xl text-center hidden border border-slate-200">
          <span id="result-text" class="text-lg font-bold"></span>
        </div>
      </AdminCard>

      <!-- Match Report (Optional) -->
      <AdminCard>
        <h3 class="text-lg font-semibold text-slate-900 mb-4">Match Report (Optional)</h3>
        <textarea
          id="matchReport"
          name="matchReport"
          rows="6"
          class="input-themed w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 placeholder-slate-400 focus:outline-none focus:bg-white transition-colors resize-none"
          placeholder="Write a brief match report..."
        >{fixture.match_report || ''}</textarea>
        <p class="text-slate-500 text-xs mt-2">This will be displayed with the result on your website.</p>
      </AdminCard>

      <!-- Actions -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3">
        <Button type="submit" variant="primary">
          {isPlayed ? 'Update Result' : 'Save Result'}
        </Button>
        <a
          href={`/${slug}/admin-portal/fixtures`}
          class="px-6 py-3 text-slate-600 hover:text-slate-900 transition-colors font-medium"
        >
          Cancel
        </a>
      </div>

      <div id="loading" class="hidden fixed inset-0 bg-slate-900/40 backdrop-blur-sm flex items-center justify-center z-50">
        <div class="bg-white rounded-xl p-6 text-center border border-slate-200 shadow-xl">
          <div class="w-8 h-8 border-2 border-t-transparent rounded-full animate-spin mx-auto mb-3" style="border-color: var(--admin-accent); border-top-color: transparent;"></div>
          <p class="text-slate-700">Saving...</p>
        </div>
      </div>
    </form>
  </AdminPageTemplate>
</AdminLayout>

<style>
  .input-themed:focus {
    border-color: var(--admin-accent, #14b8a6);
    box-shadow: 0 0 0 2px var(--admin-ring, rgba(20, 184, 166, 0.2));
  }
</style>

<script define:vars={{ clubId: club.id, fixtureId, slug, isHome: fixture.is_home }}>
  const form = document.getElementById('result-form');
  const loading = document.getElementById('loading');

  const homeGoalsInput = document.getElementById('homeGoals');
  const homePointsInput = document.getElementById('homePoints');
  const awayGoalsInput = document.getElementById('awayGoals');
  const awayPointsInput = document.getElementById('awayPoints');
  const homeTotalSpan = document.getElementById('homeTotal');
  const awayTotalSpan = document.getElementById('awayTotal');
  const resultPreview = document.getElementById('result-preview');
  const resultText = document.getElementById('result-text');

  function calculateTotals() {
    const homeGoals = parseInt(homeGoalsInput.value) || 0;
    const homePoints = parseInt(homePointsInput.value) || 0;
    const awayGoals = parseInt(awayGoalsInput.value) || 0;
    const awayPoints = parseInt(awayPointsInput.value) || 0;

    const homeTotal = (homeGoals * 3) + homePoints;
    const awayTotal = (awayGoals * 3) + awayPoints;

    homeTotalSpan.textContent = `= ${homeTotal}`;
    awayTotalSpan.textContent = `= ${awayTotal}`;

    // Show result preview
    if (homeGoalsInput.value !== '' || awayGoalsInput.value !== '') {
      resultPreview.classList.remove('hidden');

      let result, resultClass;
      if (isHome) {
        if (homeTotal > awayTotal) {
          result = 'Win';
          resultClass = 'text-emerald-600';
        } else if (homeTotal < awayTotal) {
          result = 'Loss';
          resultClass = 'text-red-600';
        } else {
          result = 'Draw';
          resultClass = 'text-amber-600';
        }
      } else {
        if (awayTotal > homeTotal) {
          result = 'Win';
          resultClass = 'text-emerald-600';
        } else if (awayTotal < homeTotal) {
          result = 'Loss';
          resultClass = 'text-red-600';
        } else {
          result = 'Draw';
          resultClass = 'text-amber-600';
        }
      }

      resultText.textContent = result;
      resultText.className = `text-lg font-bold ${resultClass}`;
    } else {
      resultPreview.classList.add('hidden');
    }
  }

  homeGoalsInput?.addEventListener('input', calculateTotals);
  homePointsInput?.addEventListener('input', calculateTotals);
  awayGoalsInput?.addEventListener('input', calculateTotals);
  awayPointsInput?.addEventListener('input', calculateTotals);

  // Calculate on load
  calculateTotals();

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(form);

    const data = {
      homeGoals: parseInt(formData.get('homeGoals')) || 0,
      homePoints: parseInt(formData.get('homePoints')) || 0,
      awayGoals: parseInt(formData.get('awayGoals')) || 0,
      awayPoints: parseInt(formData.get('awayPoints')) || 0,
      matchReport: formData.get('matchReport') || null,
    };

    loading?.classList.remove('hidden');

    try {
      const response = await fetch(`/api/clubs/${clubId}/fixtures/${fixtureId}/result`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.error || 'Failed to save result');
      }

      window.location.href = `/${slug}/admin-portal/fixtures`;
    } catch (error) {
      alert(error.message || 'Failed to save result');
      loading?.classList.add('hidden');
    }
  });
</script>
