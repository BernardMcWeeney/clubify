---
import { DatabaseService } from '../../lib/db';

const { slug } = Astro.params;

// Helper function to adjust color brightness
function adjustColor(color: string, amount: number): string {
  const hex = color.replace('#', '');
  const r = Math.max(0, Math.min(255, parseInt(hex.slice(0, 2), 16) + amount));
  const g = Math.max(0, Math.min(255, parseInt(hex.slice(2, 4), 16) + amount));
  const b = Math.max(0, Math.min(255, parseInt(hex.slice(4, 6), 16) + amount));
  return `#${r.toString(16).padStart(2, '0')}${g.toString(16).padStart(2, '0')}${b.toString(16).padStart(2, '0')}`;
}

// Get club
const db = new DatabaseService(Astro.locals.runtime.env.DB);
const club = await db.getClubBySlug(slug!);

if (!club) {
  return Astro.redirect('/');
}

// Check if site is live
if (!club.is_live) {
  return Astro.redirect('/');
}
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={club.tagline || `Welcome to ${club.name} - ${club.county} GAA Club`} />
  <meta name="theme-color" content={club.primary_color} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{club.name} - {club.county} GAA</title>
  <style define:vars={{ primaryColor: club.primary_color, secondaryColor: club.secondary_color, accentColor: club.accent_color }}>
    :root {
      --club-primary: var(--primaryColor);
      --club-secondary: var(--secondaryColor);
      --club-accent: var(--accentColor);
    }
  </style>
</head>
<body class="bg-slate-950 text-white antialiased">
  <!-- Navigation -->
  <nav class="fixed top-0 left-0 right-0 z-50 bg-slate-900/80 backdrop-blur-xl border-b border-slate-800">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex h-16 items-center justify-between">
        <a href={`/${slug}`} class="flex items-center gap-3">
          {club.crest_url ? (
            <img src={club.crest_url} alt={club.name} class="w-10 h-10 object-contain"/>
          ) : (
            <div class="w-10 h-10 rounded-lg flex items-center justify-center text-white font-bold text-lg" style={`background-color: ${club.primary_color}`}>
              {club.name.charAt(0)}
            </div>
          )}
          <span class="text-lg font-bold text-white">{club.name}</span>
        </a>

        <div class="hidden md:flex items-center gap-6">
          <a href={`/${slug}`} class="text-white font-medium">Home</a>
          <a href={`/${slug}/news`} class="text-slate-300 hover:text-white transition-colors">News</a>
          <a href={`/${slug}/fixtures`} class="text-slate-300 hover:text-white transition-colors">Fixtures</a>
          <a href={`/${slug}/about`} class="text-slate-300 hover:text-white transition-colors">About</a>
          <a href={`/${slug}/contact`} class="text-slate-300 hover:text-white transition-colors">Contact</a>
        </div>
      </div>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="relative min-h-[80vh] flex items-center justify-center overflow-hidden">
    <!-- Background -->
    <div class="absolute inset-0" style={`background: linear-gradient(135deg, ${club.primary_color}, ${adjustColor(club.primary_color, -30)})`}></div>
    <div class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg%20width%3D%2260%22%20height%3D%2260%22%20viewBox%3D%220%200%2060%2060%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cg%20fill%3D%22none%22%20fill-rule%3D%22evenodd%22%3E%3Cg%20fill%3D%22%23ffffff%22%20fill-opacity%3D%220.05%22%3E%3Cpath%20d%3D%22M36%2034v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6%2034v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6%204V0H4v4H0v2h4v4h2V6h4V4H6z%22%2F%3E%3C%2Fg%3E%3C%2Fg%3E%3C%2Fsvg%3E')] opacity-50"></div>

    <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-32 text-center">
      {club.crest_url && (
        <img src={club.crest_url} alt={club.name} class="w-32 h-32 mx-auto mb-8 object-contain drop-shadow-2xl"/>
      )}

      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold text-white mb-4 drop-shadow-lg">
        {club.name}
      </h1>

      <p class="text-xl text-white/80 mb-2">{club.county} GAA</p>

      {club.tagline && (
        <p class="text-lg text-white/70 max-w-2xl mx-auto mb-8">{club.tagline}</p>
      )}

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href={`/${slug}/fixtures`} class="px-8 py-3 bg-white text-slate-900 font-semibold rounded-full hover:bg-white/90 transition-colors shadow-lg">
          View Fixtures
        </a>
        <a href={`/${slug}/news`} class="px-8 py-3 bg-white/10 text-white font-semibold rounded-full hover:bg-white/20 transition-colors border border-white/20">
          Latest News
        </a>
      </div>
    </div>
  </section>

  <!-- Content Sections based on template -->
  <main>
    <!-- Next Fixture -->
    <section class="py-16 bg-slate-900">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-bold text-white mb-8 text-center">Next Fixture</h2>
        <div class="max-w-2xl mx-auto bg-slate-800/50 rounded-2xl p-8 border border-slate-700/50 text-center">
          <p class="text-slate-400 mb-2">No upcoming fixtures</p>
          <p class="text-slate-500 text-sm">Check back soon for match updates</p>
        </div>
      </div>
    </section>

    <!-- Latest News -->
    <section class="py-16 bg-slate-950">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between mb-8">
          <h2 class="text-2xl font-bold text-white">Latest News</h2>
          <a href={`/${slug}/news`} class="text-sm font-medium hover:underline" style={`color: ${club.primary_color}`}>View all</a>
        </div>
        <div class="grid md:grid-cols-3 gap-6">
          <div class="bg-slate-800/50 rounded-xl p-6 border border-slate-700/50">
            <p class="text-slate-400 text-center py-8">No news posts yet</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section class="py-16 bg-slate-900">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-2xl font-bold text-white mb-4">Get in Touch</h2>
        <p class="text-slate-400 mb-8 max-w-2xl mx-auto">
          {club.description || `Want to get involved with ${club.name}? Contact us today.`}
        </p>

        <div class="flex flex-wrap items-center justify-center gap-6">
          {club.contact_email && (
            <a href={`mailto:${club.contact_email}`} class="flex items-center gap-2 text-slate-300 hover:text-white transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              {club.contact_email}
            </a>
          )}
          {club.contact_phone && (
            <a href={`tel:${club.contact_phone}`} class="flex items-center gap-2 text-slate-300 hover:text-white transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              {club.contact_phone}
            </a>
          )}
        </div>

        <!-- Social links -->
        <div class="flex items-center justify-center gap-4 mt-8">
          {club.facebook_url && (
            <a href={club.facebook_url} target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-slate-800 flex items-center justify-center text-slate-400 hover:text-white hover:bg-slate-700 transition-colors">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd"/>
              </svg>
            </a>
          )}
          {club.twitter_url && (
            <a href={club.twitter_url} target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-slate-800 flex items-center justify-center text-slate-400 hover:text-white hover:bg-slate-700 transition-colors">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84"/>
              </svg>
            </a>
          )}
          {club.instagram_url && (
            <a href={club.instagram_url} target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-slate-800 flex items-center justify-center text-slate-400 hover:text-white hover:bg-slate-700 transition-colors">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd"/>
              </svg>
            </a>
          )}
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="bg-slate-950 border-t border-slate-800 py-8">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          {club.crest_url ? (
            <img src={club.crest_url} alt={club.name} class="w-8 h-8 object-contain"/>
          ) : (
            <div class="w-8 h-8 rounded flex items-center justify-center text-white font-bold text-sm" style={`background-color: ${club.primary_color}`}>
              {club.name.charAt(0)}
            </div>
          )}
          <span class="text-slate-400 text-sm">&copy; {new Date().getFullYear()} {club.name}. All rights reserved.</span>
        </div>

        <div class="flex items-center gap-2 text-slate-500 text-sm">
          <span>Powered by</span>
          <a href="https://clubify.ie" class="text-primary-400 hover:text-primary-300 font-medium">Clubify</a>
        </div>
      </div>
    </div>
  </footer>
</body>
</html>

<style is:global>
  @import "../../styles/global.css";
</style>

<script is:inline define:vars={{ primaryColor: club.primary_color }}>
  function adjustColor(color, amount) {
    const hex = color.replace('#', '');
    const r = Math.max(0, Math.min(255, parseInt(hex.slice(0, 2), 16) + amount));
    const g = Math.max(0, Math.min(255, parseInt(hex.slice(2, 4), 16) + amount));
    const b = Math.max(0, Math.min(255, parseInt(hex.slice(4, 6), 16) + amount));
    return `#${r.toString(16).padStart(2, '0')}${g.toString(16).padStart(2, '0')}${b.toString(16).padStart(2, '0')}`;
  }
</script>
