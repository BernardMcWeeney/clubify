---
import { DatabaseService } from '../../../lib/db';
import { formatDate } from '../../../lib/utils';
import ClubNavigation from '../../../components/templates/ClubNavigation.astro';
import ClubFooter from '../../../components/templates/ClubFooter.astro';
import Sponsors from '../../../components/templates/blocks/Sponsors.astro';

const { slug } = Astro.params;

if (!Astro.locals.runtime.env.DB) {
  return Astro.redirect('/?error=db_not_configured');
}

const db = new DatabaseService(Astro.locals.runtime.env.DB);
const club = await db.getClubBySlug(slug!);

if (!club || !club.is_live) {
  return Astro.redirect('/');
}

const [posts, siteSettingsRecord, sponsors] = await Promise.all([
  db.getPublishedPosts(club.id, 50),
  db.getSiteSettings(club.id),
  db.getSponsorsForPlacement(club.id, 'news'),
]);
const notices = posts.filter((p) => p.category === 'notice');
const newsPosts = posts.filter((p) => p.category !== 'notice');

const navItems = siteSettingsRecord?.nav_items ? JSON.parse(siteSettingsRecord.nav_items) : null;
const headerSettings = siteSettingsRecord?.header_settings ? JSON.parse(siteSettingsRecord.header_settings) : null;
const footerLinks = siteSettingsRecord?.footer_links ? JSON.parse(siteSettingsRecord.footer_links) : null;

function formatCategory(category: string): string {
  return category.replace('-', ' ');
}
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={`Latest news from ${club.name}`} />
  <title>{club.name} News</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class="bg-white text-slate-900 antialiased">
  <ClubNavigation club={club} slug={slug!} currentPath={`/${slug}/news`} navItems={navItems} headerSettings={headerSettings} />

  <main class="pt-20">
    <section class="py-16 bg-slate-50 border-b border-slate-200">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <p class="text-sm uppercase tracking-wider text-slate-500">Club News</p>
        <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 mt-2">{club.name} Updates</h1>
        <p class="text-slate-600 mt-3 max-w-2xl">
          Match reports, announcements, and stories from around the club.
        </p>
      </div>
    </section>

    <section class="py-12">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        {newsPosts.length > 0 ? (
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {newsPosts.map((post) => (
              <a
                href={`/${slug}/news/${post.slug}`}
                class="group bg-white rounded-2xl border border-slate-200 overflow-hidden hover:border-slate-300 hover:shadow-xl hover:shadow-slate-200/60 transition-all"
              >
                {post.featured_image ? (
                  <div class="aspect-video overflow-hidden">
                    <img
                      src={post.featured_image}
                      alt={post.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    />
                  </div>
                ) : (
                  <div class="aspect-video bg-gradient-to-br from-slate-100 to-white flex items-center justify-center">
                    <svg class="w-10 h-10 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
                    </svg>
                  </div>
                )}

                <div class="p-6">
                  <div class="flex items-center gap-2 mb-3">
                    <span class="text-xs font-semibold uppercase tracking-wide text-slate-500">
                      {formatCategory(post.category)}
                    </span>
                    {post.published_at && (
                      <span class="text-xs text-slate-400">{formatDate(post.published_at)}</span>
                    )}
                  </div>
                  <h2 class="text-lg font-semibold text-slate-900 group-hover:text-slate-700 transition-colors">
                    {post.title}
                  </h2>
                  {post.summary && (
                    <p class="text-sm text-slate-600 mt-2 line-clamp-2">{post.summary}</p>
                  )}
                </div>
              </a>
            ))}
          </div>
        ) : (
          <div class="bg-slate-50 border border-slate-200 rounded-2xl p-10 text-center">
            <p class="text-slate-700 font-medium">No news posts yet</p>
            <p class="text-slate-500 text-sm mt-2">Check back soon for updates from {club.name}.</p>
          </div>
        )}
      </div>
    </section>

    {notices.length > 0 && (
      <section class="py-12 bg-slate-50 border-t border-slate-200">
        <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
          <h2 class="text-2xl font-bold text-slate-900 mb-6">Club Notices</h2>
          <div class="grid gap-4 md:grid-cols-2">
            {notices.map((notice) => (
              <div class="bg-white rounded-2xl border border-slate-200 p-5">
                <div class="flex items-start justify-between gap-3">
                  <div>
                    <h3 class="text-base font-semibold text-slate-900">{notice.title}</h3>
                    {notice.summary && (
                      <p class="text-sm text-slate-600 mt-2">{notice.summary}</p>
                    )}
                  </div>
                  {notice.published_at && (
                    <span class="text-xs text-slate-400">{formatDate(notice.published_at)}</span>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <Sponsors sponsors={sponsors} primaryColor={club.primary_color} variant="compact" />
  </main>

  <ClubFooter club={club} slug={slug!} footerLinks={footerLinks} />
</body>
</html>

<style is:global>
  @import "../../../styles/global.css";
</style>
