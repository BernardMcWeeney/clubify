---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import SportHero from '../../components/sports/SportHero.astro';
import SportFeatures from '../../components/sports/SportFeatures.astro';
import SportTemplates from '../../components/sports/SportTemplates.astro';
import WaitlistForm from '../../components/sports/WaitlistForm.astro';
import { getSport } from '../../lib/sports';

const sport = getSport('cycling');
---

<Layout title={`${sport.name} Club Websites - Clubify`} description={sport.description}>
  <Navigation />

  <SportHero sport={sport} />

  <SportFeatures sport={sport} />

  <SportTemplates sport={sport} />

  <!-- What to expect section -->
  <section class="py-20 md:py-28 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">
          What to expect when we launch
        </h2>
        <p class="text-lg text-slate-600">
          Dynamic features for cycling clubs and groups.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="p-6 rounded-2xl border border-slate-200 bg-white">
          <div class="w-12 h-12 rounded-xl bg-cyan-100 text-cyan-600 flex items-center justify-center mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-slate-900 mb-2">Club Spins</h3>
          <p class="text-slate-600">Schedule regular group rides and special events.</p>
        </div>

        <div class="p-6 rounded-2xl border border-slate-200 bg-white">
          <div class="w-12 h-12 rounded-xl bg-cyan-100 text-cyan-600 flex items-center justify-center mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-slate-900 mb-2">Route Library</h3>
          <p class="text-slate-600">Share club routes with maps and elevation profiles.</p>
        </div>

        <div class="p-6 rounded-2xl border border-slate-200 bg-white">
          <div class="w-12 h-12 rounded-xl bg-cyan-100 text-cyan-600 flex items-center justify-center mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-slate-900 mb-2">Group Rides</h3>
          <p class="text-slate-600">Organize rides by pace and ability level.</p>
        </div>

        <div class="p-6 rounded-2xl border border-slate-200 bg-white">
          <div class="w-12 h-12 rounded-xl bg-cyan-100 text-cyan-600 flex items-center justify-center mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-slate-900 mb-2">Race Results</h3>
          <p class="text-slate-600">Track racing results and member achievements.</p>
        </div>

        <div class="p-6 rounded-2xl border border-slate-200 bg-white">
          <div class="w-12 h-12 rounded-xl bg-cyan-100 text-cyan-600 flex items-center justify-center mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-slate-900 mb-2">Club News</h3>
          <p class="text-slate-600">Ride reports, cycling news, and club updates.</p>
        </div>

        <div class="p-6 rounded-2xl border border-slate-200 bg-white">
          <div class="w-12 h-12 rounded-xl bg-cyan-100 text-cyan-600 flex items-center justify-center mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-slate-900 mb-2">Mobile App</h3>
          <p class="text-slate-600">Route info and ride updates on the go.</p>
        </div>
      </div>
    </div>
  </section>

  <WaitlistForm sport={sport} />

  <Footer />
</Layout>
