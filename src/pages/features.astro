---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';

const features = [
  {
    title: "Website + Mobile App",
    description: "Your club gets both a beautiful website and a native mobile app. Same content, everywhere your members are.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>`,
    gradient: "from-blue-500 to-cyan-500",
    details: [
      "Responsive website that looks great on all devices",
      "Native iOS and Android app for your members",
      "Content syncs automatically between platforms",
      "Push notifications for important updates"
    ]
  },
  {
    title: "Fixtures & Results",
    description: "Keep your supporters updated with upcoming matches and results. Easy to manage, beautiful to view.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>`,
    gradient: "from-green-500 to-emerald-500",
    details: [
      "GAA-specific scoring (goals, points)",
      "Multiple team support",
      "Competition and league tracking",
      "Match reports and galleries"
    ]
  },
  {
    title: "News & Updates",
    description: "Share match reports, club news, and announcements. Rich editor with images and videos, no coding required.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>`,
    gradient: "from-violet-500 to-purple-500",
    details: [
      "Rich text editor with drag-and-drop images",
      "Scheduled publishing",
      "Categories and tags for organisation",
      "SEO-optimised for search engines"
    ]
  },
  {
    title: "Social Auto-Publish",
    description: "Publish once, share everywhere. Your content automatically posts to Facebook, Twitter, and more.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>`,
    gradient: "from-pink-500 to-rose-500",
    details: [
      "Connect Facebook, Twitter/X, Instagram",
      "Auto-publish posts and results",
      "Customise message per platform",
      "Track engagement and reach"
    ]
  },
  {
    title: "Push Notifications",
    description: "Reach members instantly with push notifications. Match day reminders, breaking news, and important updates.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>`,
    gradient: "from-amber-500 to-orange-500",
    details: [
      "Instant notifications to all members",
      "Segment by team or interest",
      "Match day reminders",
      "Breaking news alerts"
    ]
  },
  {
    title: "Team Roles & Permissions",
    description: "Admin, PRO, Treasurer, Editor — assign the right permissions to the right people. Full audit trail included.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>`,
    gradient: "from-teal-500 to-cyan-500",
    details: [
      "Multiple role types",
      "Granular permission controls",
      "Invite via email",
      "Complete audit log"
    ]
  }
];

const additionalFeatures = [
  { title: "Media Library", description: "Centralised storage for all your images and videos" },
  { title: "Sponsor Showcase", description: "Display sponsors with links and tiered visibility" },
  { title: "Custom Forms", description: "Build registration forms, surveys, and more" },
  { title: "Contact Inbox", description: "Receive and manage enquiries from your website" },
  { title: "Custom Pages", description: "Create about, history, or any custom page" },
  { title: "GDPR Compliant", description: "Built-in privacy controls and data export" }
];
---

<Layout title="Features - Clubify">
  <Navigation />
  <PageHeader
    title="Features"
    description="Everything your GAA club needs to connect with members, manage fixtures, and share your story."
    badge="Platform"
  />

  <section class="py-16 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Main features -->
      <div class="space-y-16">
        {features.map((feature, index) => (
          <div class={`flex flex-col lg:flex-row gap-8 lg:gap-16 items-center ${index % 2 === 1 ? 'lg:flex-row-reverse' : ''}`}>
            <!-- Visual -->
            <div class="w-full lg:w-1/2">
              <div class={`bg-gradient-to-br ${feature.gradient} rounded-2xl p-8 aspect-video flex items-center justify-center`}>
                <div class="w-24 h-24 bg-white/20 rounded-2xl flex items-center justify-center">
                  <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={feature.icon} />
                </div>
              </div>
            </div>

            <!-- Content -->
            <div class="w-full lg:w-1/2">
              <h2 class="text-2xl font-bold text-slate-900 mb-4">{feature.title}</h2>
              <p class="text-slate-600 mb-6">{feature.description}</p>
              <ul class="space-y-3">
                {feature.details.map((detail) => (
                  <li class="flex items-center gap-3">
                    <svg class="w-5 h-5 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                    </svg>
                    <span class="text-slate-700">{detail}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>

      <!-- Additional features grid -->
      <div class="mt-24">
        <h2 class="text-2xl font-bold text-slate-900 text-center mb-12">And much more...</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {additionalFeatures.map((feature) => (
            <div class="bg-slate-50 rounded-xl p-6 border border-slate-200">
              <h3 class="font-semibold text-slate-900 mb-2">{feature.title}</h3>
              <p class="text-slate-600 text-sm">{feature.description}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- CTA -->
      <div class="mt-24 text-center">
        <h2 class="text-2xl font-bold text-slate-900 mb-4">Ready to get started?</h2>
        <p class="text-slate-600 mb-8 max-w-lg mx-auto">
          Join clubs across Ireland already using Clubify to connect with their members.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <Button href="/admin/signup" variant="primary" size="lg">
            Create your club
          </Button>
          <Button href="/pricing" variant="secondary" size="lg">
            View pricing
          </Button>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
