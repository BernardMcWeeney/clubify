    highlights: ['Match fixtures', 'Results & tables', 'Team profiles', 'Club news'],
    popular: true,
  },
  {
    id: 'rugby-matchday',
    sport: 'rugby',
    name: 'Matchday Focus',
    description: 'Match-centric design for game day engagement.',
