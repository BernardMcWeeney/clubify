---
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost' | 'outline' | 'white' | 'dark';
  size?: 'sm' | 'md' | 'lg' | 'xl';
  href?: string;
  class?: string;
  type?: 'button' | 'submit' | 'reset';
  icon?: boolean;
}

const { variant = 'primary', size = 'md', href, class: className = '', type = 'button', icon = false } = Astro.props;

const baseStyles = 'inline-flex items-center justify-center gap-2 font-semibold rounded-xl transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2';

const variants = {
  primary: 'bg-primary-500 hover:bg-primary-600 text-white shadow-lg shadow-primary-500/20 hover:shadow-primary-600/25 hover:-translate-y-0.5 active:translate-y-0 focus-visible:ring-offset-white',
  secondary: 'bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200 hover:border-slate-300 focus-visible:ring-offset-white',
  ghost: 'text-slate-600 hover:text-primary-600 hover:bg-primary-50 focus-visible:ring-offset-white',
  outline: 'bg-transparent hover:bg-primary-50 text-primary-600 border-2 border-primary-500 hover:border-primary-600 focus-visible:ring-offset-white',
  white: 'bg-white hover:bg-slate-50 text-slate-900 shadow-lg hover:shadow-xl border border-slate-200 focus-visible:ring-offset-primary-600',
  dark: 'bg-slate-900 hover:bg-slate-800 text-white shadow-lg hover:shadow-xl focus-visible:ring-offset-white'
};

const sizes = {
  sm: 'px-4 py-2 text-sm',
  md: 'px-6 py-3 text-base',
  lg: 'px-8 py-4 text-lg',
  xl: 'px-10 py-5 text-lg'
};

const iconSizes = {
  sm: 'p-2',
  md: 'p-3',
  lg: 'p-4',
  xl: 'p-5'
};

const classes = `${baseStyles} ${variants[variant]} ${icon ? iconSizes[size] : sizes[size]} ${className}`;
---

{href ? (
  <a href={href} class={classes}>
    <slot />
  </a>
) : (
  <button type={type} class={classes}>
    <slot />
  </button>
)}
