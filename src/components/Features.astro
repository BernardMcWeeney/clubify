---
import Section from './Section.astro';
import Card from './Card.astro';

const features = [
  {
    title: "Website + Mobile App",
    description: "Your club gets both a beautiful website and a native mobile app. Same content, everywhere your members are.",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
    </svg>`,
    gradient: "from-blue-500 to-cyan-500"
  },
  {
    title: "Fixtures & Results",
    description: "Keep your supporters updated with upcoming matches and results. Easy to manage, beautiful to view.",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
    </svg>`,
    gradient: "from-primary-500 to-emerald-500"
  },
  {
    title: "News & Updates",
    description: "Share match reports, club news, and announcements. Rich editor with images and videos, no coding required.",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
    </svg>`,
    gradient: "from-violet-500 to-purple-500"
  },
  {
    title: "Social Auto-Publish",
    description: "Publish once, share everywhere. Your content automatically posts to Facebook, Twitter, and more.",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>
    </svg>`,
    gradient: "from-pink-500 to-rose-500"
  },
  {
    title: "Push Notifications",
    description: "Reach members instantly with push notifications. Match day reminders, breaking news, and important updates.",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
    </svg>`,
    gradient: "from-amber-500 to-orange-500"
  },
  {
    title: "Team Roles",
    description: "Admin, PRO, Treasurer, Editor — assign the right permissions to the right people. Full audit trail included.",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
    </svg>`,
    gradient: "from-teal-500 to-cyan-500"
  }
];
---

<Section id="features">
  <!-- Section header -->
  <div class="text-center mb-16">
    <span class="inline-block text-primary-600 font-semibold text-sm uppercase tracking-wider mb-4">Features</span>
    <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-slate-900 mb-6">
      Everything your club needs
    </h2>
    <p class="text-lg text-slate-600 max-w-2xl mx-auto">
      Built specifically for GAA clubs. All the features you need, none of the complexity you don't.
    </p>
  </div>

  <!-- Features grid -->
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {features.map((feature) => (
      <Card variant="default" padding="lg" class="group hover:shadow-lg hover:border-slate-300 transition-all duration-300">
        <!-- Icon -->
        <div class={`w-12 h-12 rounded-xl bg-gradient-to-br ${feature.gradient} flex items-center justify-center text-white mb-5 shadow-lg group-hover:scale-110 transition-transform duration-300`}>
          <Fragment set:html={feature.icon} />
        </div>

        <!-- Content -->
        <h3 class="text-lg font-bold text-slate-900 mb-2">{feature.title}</h3>
        <p class="text-slate-600 leading-relaxed text-sm">{feature.description}</p>
      </Card>
    ))}
  </div>

  <!-- Additional highlight -->
  <div class="mt-16 p-8 rounded-2xl bg-gradient-to-r from-primary-500/10 via-transparent to-accent-500/10 border border-primary-200">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-4">
        <div class="w-14 h-14 rounded-full bg-gradient-to-br from-primary-500 to-primary-600 flex items-center justify-center text-white shadow-lg shadow-primary-500/25">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
        </div>
        <div>
          <h3 class="text-xl font-bold text-slate-900">Foireann Integration Ready</h3>
          <p class="text-slate-600">Built to work seamlessly with GAA's official systems</p>
        </div>
      </div>
      <a href="#" class="text-primary-600 hover:text-primary-700 font-semibold flex items-center gap-2 group/link">
        Learn more
        <svg class="w-5 h-5 group-hover/link:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
        </svg>
      </a>
    </div>
  </div>
</Section>
