---
const mainFeatures = [
  {
    title: "Website + Mobile App",
    description: "Your club gets a professional website and native mobile app. Publish once, reach members everywhere — desktop, phone, or tablet.",
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
    </svg>`,
    color: "#14b8a6",
    highlight: "Web + iOS + Android"
  },
  {
    title: "Fixtures & Results",
    description: "Add matches in seconds. League tables update automatically. Supporters see upcoming games and latest scores at a glance.",
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
    </svg>`,
    color: "#0d9488",
    highlight: "Auto league tables"
  },
  {
    title: "News & Updates",
    description: "Share match reports, club news, and announcements with a simple editor. Add images, videos — no technical skills needed.",
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
    </svg>`,
    color: "#8b5cf6",
    highlight: "Rich editor"
  },
  {
    title: "Social Auto-Publish",
    description: "Post once and it appears on your website, app, Facebook, Twitter, and Instagram automatically. No copy-pasting required.",
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>
    </svg>`,
    color: "#ec4899",
    highlight: "One click, everywhere"
  },
  {
    title: "Push Notifications",
    description: "Send instant alerts to members. Match day reminders, breaking news, training updates — they'll never miss a thing.",
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
    </svg>`,
    color: "#f59e0b",
    highlight: "Instant reach"
  },
  {
    title: "Team Management",
    description: "Invite committee members with the right permissions. Admin, PRO, Editor — everyone has exactly the access they need.",
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
    </svg>`,
    color: "#14b8a6",
    highlight: "Role-based access"
  }
];

const benefits = [
  { stat: "15 min", label: "Setup time" },
  { stat: "0", label: "Technical skills needed" },
  { stat: "24/7", label: "Support available" }
];
---

<section id="features" class="py-20 md:py-32 bg-white relative overflow-hidden">
  <!-- Background decoration -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute top-1/4 -left-20 w-96 h-96 bg-primary-500/5 rounded-full blur-3xl"></div>
    <div class="absolute bottom-1/4 -right-20 w-96 h-96 bg-accent-500/5 rounded-full blur-3xl"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Section header with strong value prop -->
    <div class="text-center mb-20">
      <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-semibold bg-primary-100 text-primary-700 mb-6">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
        </svg>
        All-in-one platform
      </span>
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-slate-900 mb-6">
        Run your club, <span class="text-primary-600">not your website</span>
      </h2>
      <p class="text-xl text-slate-600 max-w-3xl mx-auto">
        Everything your club needs in one place. Fixtures, news, notifications, social media — all managed from a single dashboard. So you can focus on what matters: your club.
      </p>
    </div>

    <!-- Stats bar -->
    <div class="grid grid-cols-3 gap-4 md:gap-8 max-w-2xl mx-auto mb-20">
      {benefits.map((benefit) => (
        <div class="text-center p-4 rounded-2xl bg-slate-50 border border-slate-100">
          <div class="text-3xl md:text-4xl font-black text-slate-900">{benefit.stat}</div>
          <div class="text-sm text-slate-500 font-medium">{benefit.label}</div>
        </div>
      ))}
    </div>

    <!-- Features grid - bento style -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {mainFeatures.map((feature, index) => (
        <div class={`group relative bg-white rounded-2xl border border-slate-200 p-6 hover:shadow-xl hover:border-slate-300 transition-all duration-300 ${index === 0 || index === 3 ? 'lg:col-span-2' : ''}`}>
          <!-- Gradient accent on hover -->
          <div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300" style={`background: linear-gradient(135deg, ${feature.color}05, transparent)`}></div>

          <div class="relative">
            <!-- Icon + Badge -->
            <div class="flex items-start justify-between mb-4">
              <div class="w-14 h-14 rounded-2xl flex items-center justify-center shadow-lg" style={`background: linear-gradient(135deg, ${feature.color}, ${feature.color}dd)`}>
                <div class="text-white">
                  <Fragment set:html={feature.icon} />
                </div>
              </div>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold" style={`background-color: ${feature.color}15; color: ${feature.color}`}>
                {feature.highlight}
              </span>
            </div>

            <!-- Content -->
            <h3 class="text-xl font-bold text-slate-900 mb-2">{feature.title}</h3>
            <p class="text-slate-600 leading-relaxed">{feature.description}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom CTA block -->
    <div class="mt-20 relative">
      <div class="absolute inset-0 bg-gradient-to-r from-primary-600 to-primary-500 rounded-3xl"></div>
      <div class="absolute inset-0 opacity-10">
        <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <pattern id="features-pattern" x="0" y="0" width="32" height="32" patternUnits="userSpaceOnUse">
              <circle cx="16" cy="16" r="1.5" fill="white"/>
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#features-pattern)"/>
        </svg>
      </div>

      <div class="relative p-8 md:p-12">
        <div class="flex flex-col lg:flex-row items-center justify-between gap-8">
          <div class="text-center lg:text-left">
            <h3 class="text-2xl md:text-3xl font-bold text-white mb-3">Ready to simplify club management?</h3>
            <p class="text-white/80 text-lg">Join clubs already using Clubify to save time every week.</p>
          </div>
          <div class="flex flex-col sm:flex-row gap-4">
            <a
              href="/admin/signup"
              class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-white text-primary-600 font-bold rounded-xl hover:bg-slate-50 transition-all shadow-lg"
            >
              Start free trial
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
              </svg>
            </a>
            <a
              href="/contact"
              class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-white/10 text-white font-semibold rounded-xl hover:bg-white/20 transition-all border border-white/20"
            >
              Talk to us
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
