---
// LogoCloud - Social proof section showing club stats and trust indicators
---

<section class="py-16 bg-slate-50 border-y border-slate-100">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10">
      <p class="text-slate-500 text-sm font-medium">Trusted by clubs across Ireland</p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12">
      <!-- Stat 1 -->
      <div class="text-center">
        <div class="text-4xl md:text-5xl font-bold text-slate-900 mb-2">500+</div>
        <div class="text-sm text-slate-500">Active Clubs</div>
      </div>

      <!-- Stat 2 -->
      <div class="text-center">
        <div class="text-4xl md:text-5xl font-bold text-slate-900 mb-2">50k+</div>
        <div class="text-sm text-slate-500">Club Members</div>
      </div>

      <!-- Stat 3 -->
      <div class="text-center">
        <div class="text-4xl md:text-5xl font-bold text-slate-900 mb-2">7</div>
        <div class="text-sm text-slate-500">Sports Supported</div>
      </div>

      <!-- Stat 4 -->
      <div class="text-center">
        <div class="text-4xl md:text-5xl font-bold text-slate-900 mb-2">99.9%</div>
        <div class="text-sm text-slate-500">Uptime</div>
      </div>
    </div>

    <!-- Trust badges -->
    <div class="flex flex-wrap items-center justify-center gap-6 md:gap-10 mt-12 pt-10 border-t border-slate-200">
      <div class="flex items-center gap-2 text-slate-400">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
        </svg>
        <span class="text-sm font-medium">GDPR Compliant</span>
      </div>

      <div class="flex items-center gap-2 text-slate-400">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
        </svg>
        <span class="text-sm font-medium">SSL Secured</span>
      </div>

      <div class="flex items-center gap-2 text-slate-400">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/>
        </svg>
        <span class="text-sm font-medium">Irish Hosted</span>
      </div>

      <div class="flex items-center gap-2 text-slate-400">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/>
        </svg>
        <span class="text-sm font-medium">Priority Support</span>
      </div>
    </div>
  </div>
</section>
