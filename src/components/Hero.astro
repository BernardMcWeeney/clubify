---
import Button from './Button.astro';
import { getReadySports, getComingSoonSports } from '../lib/sports';

const readySports = getReadySports();
const comingSoonSports = getComingSoonSports();
const allSports = [...readySports, ...comingSoonSports];
---

<section class="relative min-h-screen flex items-center overflow-hidden bg-white">
  <!-- Subtle background -->
  <div class="absolute inset-0 mesh-gradient-light"></div>
  <div class="absolute inset-0 grid-pattern"></div>

  <!-- Content -->
  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-32 pb-20 lg:pt-40 lg:pb-32">
    <div class="grid lg:grid-cols-2 gap-16 lg:gap-20 items-center">
      <!-- Left side - Copy -->
      <div class="text-center lg:text-left">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary-50 border border-primary-100 text-primary-700 text-sm font-medium mb-8 animate-[fadeIn_0.5s_ease-out]">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
          </svg>
          Trusted by 500+ clubs across Ireland
        </div>

        <!-- Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold tracking-tight mb-6 animate-[slideUp_0.6s_ease-out_forwards]" style="animation-delay: 0.1s; opacity: 0;">
          <span class="text-slate-900">The all-in-one platform</span>
          <br />
          <span class="text-slate-900">for </span>
          <span class="bg-gradient-to-r from-primary-600 to-primary-500 bg-clip-text text-transparent">sports clubs</span>
        </h1>

        <!-- Subheadline -->
        <p class="text-lg sm:text-xl text-slate-600 mb-8 max-w-lg mx-auto lg:mx-0 leading-relaxed animate-[slideUp_0.6s_ease-out_forwards]" style="animation-delay: 0.2s; opacity: 0;">
          Website. App. Social. All managed from one dashboard. Launch your club's digital presence in minutes.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 mb-10 animate-[slideUp_0.6s_ease-out_forwards]" style="animation-delay: 0.3s; opacity: 0;">
          <Button href="/admin/signup" variant="primary" size="lg">
            Create your club
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
            </svg>
          </Button>
          <Button href="#demo" variant="secondary" size="lg">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"/>
            </svg>
            Watch demo
          </Button>
        </div>

        <!-- Sports pills with horizontal scroll on mobile -->
        <div class="animate-[slideUp_0.6s_ease-out_forwards]" style="animation-delay: 0.4s; opacity: 0;">
          <p class="text-sm text-slate-500 mb-3 font-medium">Available for all club types</p>
          <div class="flex flex-wrap items-center justify-center lg:justify-start gap-2">
            {allSports.slice(0, 5).map((sport) => (
              <a
                href={`/sports/${sport.slug}`}
                class="inline-flex items-center gap-2 px-3 py-2 rounded-full bg-white border border-slate-200 text-sm font-medium text-slate-700 hover:border-primary-300 hover:bg-primary-50 transition-all shadow-sm"
              >
                <div
                  class="w-5 h-5 rounded-md flex items-center justify-center text-white text-xs font-bold"
                  style={`background-color: ${sport.primaryColor}`}
                >
                  {sport.name.charAt(0)}
                </div>
                <span>{sport.name}</span>
              </a>
            ))}
            {allSports.length > 5 && (
              <a
                href="/sports"
                class="inline-flex items-center gap-1 px-3 py-2 rounded-full bg-slate-100 text-sm font-medium text-slate-600 hover:bg-slate-200 transition-colors"
              >
                +{allSports.length - 5} more
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </a>
            )}
          </div>
        </div>

        <!-- Trust indicators -->
        <div class="mt-12 pt-8 border-t border-slate-200 animate-[fadeIn_0.6s_ease-out_forwards]" style="animation-delay: 0.5s; opacity: 0;">
          <div class="flex flex-wrap items-center justify-center lg:justify-start gap-x-8 gap-y-4 text-sm text-slate-500">
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
              <span>GDPR Compliant</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
              </svg>
              <span>Setup in 5 minutes</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/>
              </svg>
              <span>Irish hosted</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right side - Hero visual -->
      <div class="relative animate-[slideUp_0.8s_ease-out_forwards]" style="animation-delay: 0.3s; opacity: 0;">
        <!-- Floating elements -->
        <div class="absolute -top-8 -left-8 w-20 h-20 bg-primary-100 rounded-2xl opacity-60 animate-[float_6s_ease-in-out_infinite]"></div>
        <div class="absolute -bottom-4 -right-4 w-16 h-16 bg-primary-200 rounded-xl opacity-40 animate-[float_8s_ease-in-out_infinite_reverse]"></div>

        <div class="relative">
          <!-- Main dashboard mockup -->
          <div class="relative rounded-2xl overflow-hidden shadow-2xl shadow-slate-900/10 border border-slate-200/80 bg-white">
            <!-- Browser chrome - minimal -->
            <div class="bg-slate-50 px-4 py-3 flex items-center gap-3 border-b border-slate-100">
              <div class="flex gap-1.5">
                <div class="w-3 h-3 rounded-full bg-slate-200"></div>
                <div class="w-3 h-3 rounded-full bg-slate-200"></div>
                <div class="w-3 h-3 rounded-full bg-slate-200"></div>
              </div>
              <div class="flex-1 ml-4">
                <div class="bg-white rounded-lg px-4 py-1.5 text-sm text-slate-400 max-w-xs border border-slate-200 flex items-center gap-2">
                  <svg class="w-3.5 h-3.5 text-primary-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/>
                  </svg>
                  yourclub.clubify.ie
                </div>
              </div>
            </div>

            <!-- Dashboard content -->
            <div class="bg-slate-50 p-4 lg:p-6">
              <div class="flex gap-4 lg:gap-6">
                <!-- Sidebar -->
                <div class="hidden sm:block w-48 bg-white rounded-xl p-4 border border-slate-200 shadow-sm">
                  <div class="flex items-center gap-3 mb-6">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-primary-500 to-primary-600 flex items-center justify-center">
                      <div class="w-5 h-5 rounded-full bg-white/90"></div>
                    </div>
                    <div>
                      <div class="h-2.5 w-20 bg-slate-800 rounded"></div>
                      <div class="h-2 w-14 bg-slate-300 rounded mt-1"></div>
                    </div>
                  </div>

                  <div class="space-y-2">
                    <div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-primary-50 text-primary-600">
                      <div class="w-4 h-4 rounded bg-primary-200"></div>
                      <div class="h-2 w-16 bg-primary-300 rounded"></div>
                    </div>
                    <div class="flex items-center gap-2 px-3 py-2 rounded-lg hover:bg-slate-50">
                      <div class="w-4 h-4 rounded bg-slate-200"></div>
                      <div class="h-2 w-14 bg-slate-200 rounded"></div>
                    </div>
                    <div class="flex items-center gap-2 px-3 py-2 rounded-lg hover:bg-slate-50">
                      <div class="w-4 h-4 rounded bg-slate-200"></div>
                      <div class="h-2 w-12 bg-slate-200 rounded"></div>
                    </div>
                    <div class="flex items-center gap-2 px-3 py-2 rounded-lg hover:bg-slate-50">
                      <div class="w-4 h-4 rounded bg-slate-200"></div>
                      <div class="h-2 w-16 bg-slate-200 rounded"></div>
                    </div>
                  </div>
                </div>

                <!-- Main content -->
                <div class="flex-1 space-y-4">
                  <!-- Stats row -->
                  <div class="grid grid-cols-3 gap-3">
                    <div class="bg-white rounded-xl p-4 border border-slate-200 shadow-sm">
                      <div class="text-xs text-slate-500 mb-1">Members</div>
                      <div class="text-2xl font-bold text-slate-900">847</div>
                      <div class="text-xs text-green-600 mt-1">+12% this month</div>
                    </div>
                    <div class="bg-white rounded-xl p-4 border border-slate-200 shadow-sm">
                      <div class="text-xs text-slate-500 mb-1">Page Views</div>
                      <div class="text-2xl font-bold text-slate-900">12.4k</div>
                      <div class="text-xs text-green-600 mt-1">+8% this week</div>
                    </div>
                    <div class="bg-white rounded-xl p-4 border border-slate-200 shadow-sm">
                      <div class="text-xs text-slate-500 mb-1">App Downloads</div>
                      <div class="text-2xl font-bold text-slate-900">234</div>
                      <div class="text-xs text-green-600 mt-1">+25% this month</div>
                    </div>
                  </div>

                  <!-- Content cards -->
                  <div class="grid grid-cols-2 gap-3">
                    <div class="bg-white rounded-xl p-4 border border-slate-200 shadow-sm">
                      <div class="flex items-center justify-between mb-3">
                        <div class="flex items-center gap-2">
                          <div class="w-6 h-6 rounded-lg bg-accent-100 flex items-center justify-center">
                            <svg class="w-3 h-3 text-accent-600" fill="currentColor" viewBox="0 0 20 20">
                              <path fill-rule="evenodd" d="M2 5a2 2 0 012-2h8a2 2 0 012 2v10a2 2 0 002 2H4a2 2 0 01-2-2V5zm3 1h6v4H5V6zm6 6H5v2h6v-2z" clip-rule="evenodd"/>
                            </svg>
                          </div>
                          <span class="text-sm font-medium text-slate-700">Latest News</span>
                        </div>
                        <div class="w-6 h-6 rounded-full bg-primary-100 flex items-center justify-center text-xs text-primary-600 font-medium">3</div>
                      </div>
                      <div class="space-y-2">
                        <div class="h-2 w-full bg-slate-100 rounded"></div>
                        <div class="h-2 w-4/5 bg-slate-100 rounded"></div>
                      </div>
                    </div>

                    <div class="bg-white rounded-xl p-4 border border-slate-200 shadow-sm">
                      <div class="flex items-center justify-between mb-3">
                        <div class="flex items-center gap-2">
                          <div class="w-6 h-6 rounded-lg bg-primary-100 flex items-center justify-center">
                            <svg class="w-3 h-3 text-primary-600" fill="currentColor" viewBox="0 0 20 20">
                              <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1z" clip-rule="evenodd"/>
                            </svg>
                          </div>
                          <span class="text-sm font-medium text-slate-700">Fixtures</span>
                        </div>
                        <span class="text-xs text-slate-400">This week</span>
                      </div>
                      <div class="space-y-2">
                        <div class="flex items-center justify-between py-1">
                          <span class="text-xs text-slate-600">vs Rivals FC</span>
                          <span class="text-xs font-medium text-primary-600">Sat 3pm</span>
                        </div>
                        <div class="flex items-center justify-between py-1">
                          <span class="text-xs text-slate-600">vs Town United</span>
                          <span class="text-xs font-medium text-slate-400">Next Tue</span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Mobile app mockup -->
          <div class="absolute -right-4 lg:right-8 -bottom-8 w-32 lg:w-40 z-10">
            <div class="bg-slate-900 rounded-[2rem] p-1.5 shadow-2xl shadow-slate-900/40">
              <div class="bg-white rounded-[1.75rem] aspect-[9/19] overflow-hidden">
                <!-- Phone notch -->
                <div class="h-7 bg-slate-900 flex items-end justify-center pb-1">
                  <div class="w-20 h-5 bg-slate-900 rounded-b-2xl"></div>
                </div>

                <!-- Phone content -->
                <div class="p-3 space-y-3">
                  <!-- Mini header -->
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                      <div class="w-7 h-7 rounded-lg bg-primary-500"></div>
                      <div class="h-2 w-14 bg-slate-800 rounded"></div>
                    </div>
                    <div class="w-6 h-6 rounded-full bg-slate-100"></div>
                  </div>

                  <!-- Mini hero -->
                  <div class="h-16 rounded-xl bg-gradient-to-r from-primary-500 to-primary-600 p-3 flex flex-col justify-end">
                    <div class="h-2 w-3/4 bg-white/80 rounded mb-1"></div>
                    <div class="h-1.5 w-1/2 bg-white/50 rounded"></div>
                  </div>

                  <!-- Quick actions -->
                  <div class="grid grid-cols-4 gap-2">
                    <div class="flex flex-col items-center gap-1">
                      <div class="w-8 h-8 rounded-lg bg-primary-50 flex items-center justify-center">
                        <div class="w-4 h-4 rounded bg-primary-200"></div>
                      </div>
                      <div class="h-1 w-6 bg-slate-200 rounded"></div>
                    </div>
                    <div class="flex flex-col items-center gap-1">
                      <div class="w-8 h-8 rounded-lg bg-accent-50 flex items-center justify-center">
                        <div class="w-4 h-4 rounded bg-accent-200"></div>
                      </div>
                      <div class="h-1 w-6 bg-slate-200 rounded"></div>
                    </div>
                    <div class="flex flex-col items-center gap-1">
                      <div class="w-8 h-8 rounded-lg bg-slate-50 flex items-center justify-center">
                        <div class="w-4 h-4 rounded bg-slate-200"></div>
                      </div>
                      <div class="h-1 w-6 bg-slate-200 rounded"></div>
                    </div>
                    <div class="flex flex-col items-center gap-1">
                      <div class="w-8 h-8 rounded-lg bg-slate-50 flex items-center justify-center">
                        <div class="w-4 h-4 rounded bg-slate-200"></div>
                      </div>
                      <div class="h-1 w-6 bg-slate-200 rounded"></div>
                    </div>
                  </div>

                  <!-- Mini cards -->
                  <div class="space-y-2">
                    <div class="h-10 bg-white rounded-lg border border-slate-100 p-2 flex items-center gap-2">
                      <div class="w-6 h-6 rounded bg-accent-100"></div>
                      <div class="flex-1">
                        <div class="h-1.5 w-16 bg-slate-300 rounded"></div>
                        <div class="h-1 w-10 bg-slate-200 rounded mt-1"></div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- App badge -->
            <div class="absolute -bottom-3 left-1/2 -translate-x-1/2 px-3 py-1.5 bg-slate-900 rounded-full text-xs font-semibold text-white shadow-lg flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
                <path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z"/>
              </svg>
              Mobile App
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 animate-bounce">
    <span class="text-xs text-slate-400 font-medium">Scroll to explore</span>
    <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
    </svg>
  </div>
</section>
