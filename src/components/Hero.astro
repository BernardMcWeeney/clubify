---
import Button from './Button.astro';
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Animated mesh gradient background -->
  <div class="absolute inset-0 mesh-gradient"></div>

  <!-- Animated gradient orbs -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute -top-1/4 -left-1/4 w-1/2 h-1/2 bg-primary-500/20 rounded-full blur-3xl animate-[float_8s_ease-in-out_infinite]"></div>
    <div class="absolute -bottom-1/4 -right-1/4 w-1/2 h-1/2 bg-accent-500/15 rounded-full blur-3xl animate-[float_10s_ease-in-out_infinite_reverse]"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-1/3 h-1/3 bg-primary-600/10 rounded-full blur-3xl animate-[float_12s_ease-in-out_infinite]"></div>
  </div>

  <!-- Grid pattern overlay -->
  <div class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg%20width%3D%2260%22%20height%3D%2260%22%20viewBox%3D%220%200%2060%2060%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cg%20fill%3D%22none%22%20fill-rule%3D%22evenodd%22%3E%3Cg%20fill%3D%22%23ffffff%22%20fill-opacity%3D%220.03%22%3E%3Cpath%20d%3D%22M36%2034v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6%2034v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6%204V0H4v4H0v2h4v4h2V6h4V4H6z%22%2F%3E%3C%2Fg%3E%3C%2Fg%3E%3C%2Fsvg%3E')] opacity-50"></div>

  <!-- Content -->
  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-32 text-center">
    <!-- Badge -->
    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary-500/10 border border-primary-500/20 text-primary-400 text-sm font-medium mb-8 animate-[fadeIn_0.6s_ease-out]">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-primary-500"></span>
      </span>
      Built for GAA clubs
    </div>

    <!-- Headline -->
    <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight mb-6 animate-[slideUp_0.6s_ease-out]" style="animation-delay: 0.1s; opacity: 0; animation-fill-mode: forwards;">
      <span class="text-white">All-in-one website + app</span>
      <br />
      <span class="bg-gradient-to-r from-primary-400 via-primary-300 to-accent-400 bg-clip-text text-transparent">for GAA clubs</span>
    </h1>

    <!-- Subheadline -->
    <p class="mx-auto max-w-2xl text-lg sm:text-xl text-slate-300 mb-10 animate-[slideUp_0.6s_ease-out]" style="animation-delay: 0.2s; opacity: 0; animation-fill-mode: forwards;">
      Launch your club's website in minutes. Publish once, reach everywhere &mdash; web, app, and social media. No technical skills required.
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16 animate-[slideUp_0.6s_ease-out]" style="animation-delay: 0.3s; opacity: 0; animation-fill-mode: forwards;">
      <Button href="/admin" variant="primary" size="lg">
        Create your club
        <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
        </svg>
      </Button>
      <Button href="#how-it-works" variant="secondary" size="lg">
        See how it works
      </Button>
    </div>

    <!-- Trust indicators -->
    <div class="flex flex-wrap items-center justify-center gap-6 text-sm text-slate-400 animate-[fadeIn_0.6s_ease-out]" style="animation-delay: 0.4s; opacity: 0; animation-fill-mode: forwards;">
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5 text-primary-500" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
        <span>Free to get started</span>
      </div>
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5 text-primary-500" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
        <span>Set up in minutes</span>
      </div>
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5 text-primary-500" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
        <span>GDPR compliant</span>
      </div>
    </div>

    <!-- Hero visual -->
    <div class="relative mt-16 animate-[slideUp_0.8s_ease-out]" style="animation-delay: 0.5s; opacity: 0; animation-fill-mode: forwards;">
      <div class="relative mx-auto max-w-5xl">
        <!-- Browser mockup -->
        <div class="relative rounded-2xl overflow-hidden shadow-2xl shadow-black/50 border border-slate-700/50">
          <!-- Browser chrome -->
          <div class="bg-slate-800 px-4 py-3 flex items-center gap-2">
            <div class="flex gap-1.5">
              <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
              <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
            </div>
            <div class="flex-1 ml-4">
              <div class="bg-slate-700/50 rounded-lg px-4 py-1.5 text-sm text-slate-400 max-w-md mx-auto">
                yourclub.clubify.ie
              </div>
            </div>
          </div>
          <!-- Screenshot placeholder -->
          <div class="bg-gradient-to-br from-slate-800 to-slate-900 aspect-[16/10]">
            <div class="p-8 h-full flex flex-col">
              <!-- Mockup header -->
              <div class="flex items-center justify-between mb-8">
                <div class="flex items-center gap-3">
                  <div class="w-12 h-12 rounded-full bg-gradient-to-br from-primary-500 to-primary-600"></div>
                  <div>
                    <div class="h-4 w-32 bg-slate-700 rounded"></div>
                    <div class="h-3 w-20 bg-slate-700/50 rounded mt-1"></div>
                  </div>
                </div>
                <div class="flex gap-4">
                  <div class="h-3 w-16 bg-slate-700/50 rounded"></div>
                  <div class="h-3 w-16 bg-slate-700/50 rounded"></div>
                  <div class="h-3 w-16 bg-slate-700/50 rounded"></div>
                </div>
              </div>
              <!-- Mockup hero -->
              <div class="flex-1 flex items-center">
                <div class="w-full">
                  <div class="h-8 w-3/4 bg-slate-700 rounded mb-4"></div>
                  <div class="h-4 w-1/2 bg-slate-700/50 rounded mb-6"></div>
                  <div class="flex gap-3">
                    <div class="h-10 w-32 bg-primary-500/30 rounded-full"></div>
                    <div class="h-10 w-28 bg-slate-700/30 rounded-full border border-slate-600/30"></div>
                  </div>
                </div>
              </div>
              <!-- Mockup cards -->
              <div class="grid grid-cols-3 gap-4 mt-8">
                <div class="bg-slate-700/30 rounded-xl p-4 border border-slate-600/20">
                  <div class="h-3 w-20 bg-slate-600/50 rounded mb-2"></div>
                  <div class="h-6 w-16 bg-accent-500/30 rounded"></div>
                </div>
                <div class="bg-slate-700/30 rounded-xl p-4 border border-slate-600/20">
                  <div class="h-3 w-24 bg-slate-600/50 rounded mb-2"></div>
                  <div class="h-6 w-20 bg-primary-500/30 rounded"></div>
                </div>
                <div class="bg-slate-700/30 rounded-xl p-4 border border-slate-600/20">
                  <div class="h-3 w-16 bg-slate-600/50 rounded mb-2"></div>
                  <div class="h-6 w-12 bg-slate-600/30 rounded"></div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Mobile mockup (positioned to overlap) -->
        <div class="absolute -right-4 md:right-8 bottom-0 translate-y-1/4 w-32 md:w-48">
          <div class="bg-slate-800 rounded-3xl p-2 shadow-2xl shadow-black/50 border border-slate-700/50">
            <div class="bg-gradient-to-br from-slate-800 to-slate-900 rounded-2xl aspect-[9/19] p-3">
              <div class="w-8 h-1 bg-slate-700 rounded-full mx-auto mb-4"></div>
              <div class="space-y-3">
                <div class="h-2 w-3/4 bg-slate-700 rounded"></div>
                <div class="h-2 w-1/2 bg-slate-700/50 rounded"></div>
                <div class="h-16 bg-slate-700/30 rounded-lg mt-4"></div>
                <div class="h-12 bg-primary-500/20 rounded-lg"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <svg class="w-6 h-6 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
    </svg>
  </div>
</section>
