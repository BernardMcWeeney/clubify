---
/**
 * ProductShowcase - Visual demonstration of the Clubify platform
 * Shows the admin dashboard and the output (website/app)
 */
---

<section class="py-20 md:py-32 bg-gradient-to-b from-white via-slate-50 to-white overflow-hidden">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="text-center mb-16">
      <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-semibold bg-accent-100 text-accent-700 mb-6">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
        </svg>
        See it in action
      </span>
      <h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-6">
        From dashboard to live website
      </h2>
      <p class="text-xl text-slate-600 max-w-2xl mx-auto">
        Manage everything from one simple admin. Your changes appear instantly on web and mobile.
      </p>
    </div>

    <!-- Dashboard visualization -->
    <div class="relative">
      <!-- Connection line -->
      <div class="hidden lg:block absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-32 h-0.5 bg-gradient-to-r from-primary-500 to-accent-500 z-10">
        <div class="absolute -left-2 top-1/2 -translate-y-1/2 w-4 h-4 rounded-full bg-primary-500 border-4 border-white shadow-lg"></div>
        <div class="absolute -right-2 top-1/2 -translate-y-1/2 w-4 h-4 rounded-full bg-accent-500 border-4 border-white shadow-lg"></div>
        <!-- Animated pulse -->
        <div class="absolute inset-0 bg-gradient-to-r from-primary-500 to-accent-500 animate-pulse opacity-50"></div>
      </div>

      <div class="grid lg:grid-cols-2 gap-8 lg:gap-16 items-center">
        <!-- Admin Dashboard Mockup -->
        <div class="relative">
          <div class="absolute -inset-4 bg-gradient-to-r from-primary-500/20 to-primary-600/20 rounded-3xl blur-2xl"></div>
          <div class="relative bg-white rounded-2xl shadow-2xl border border-slate-200 overflow-hidden">
            <!-- Window chrome -->
            <div class="bg-slate-100 px-4 py-3 flex items-center gap-2 border-b border-slate-200">
              <div class="flex gap-1.5">
                <div class="w-3 h-3 rounded-full bg-red-400"></div>
                <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
                <div class="w-3 h-3 rounded-full bg-green-400"></div>
              </div>
              <div class="flex-1 ml-4">
                <div class="bg-white rounded-lg px-4 py-1.5 text-sm text-slate-500 max-w-xs border border-slate-200">
                  admin.clubify.ie/dashboard
                </div>
              </div>
            </div>

            <!-- Dashboard content -->
            <div class="p-6 bg-slate-50">
              <div class="flex gap-4">
                <!-- Sidebar -->
                <div class="w-48 bg-slate-900 rounded-xl p-4 hidden sm:block">
                  <div class="flex items-center gap-2 mb-6">
                    <div class="w-8 h-8 rounded-lg bg-primary-500"></div>
                    <div class="h-2.5 w-20 bg-white rounded"></div>
                  </div>
                  <div class="space-y-2">
                    <div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-white/10">
                      <div class="w-4 h-4 rounded bg-primary-400"></div>
                      <div class="h-2 w-16 bg-white/60 rounded"></div>
                    </div>
                    <div class="flex items-center gap-2 px-3 py-2">
                      <div class="w-4 h-4 rounded bg-slate-600"></div>
                      <div class="h-2 w-14 bg-slate-600 rounded"></div>
                    </div>
                    <div class="flex items-center gap-2 px-3 py-2">
                      <div class="w-4 h-4 rounded bg-slate-600"></div>
                      <div class="h-2 w-12 bg-slate-600 rounded"></div>
                    </div>
                    <div class="flex items-center gap-2 px-3 py-2">
                      <div class="w-4 h-4 rounded bg-slate-600"></div>
                      <div class="h-2 w-16 bg-slate-600 rounded"></div>
                    </div>
                  </div>
                </div>

                <!-- Main content area -->
                <div class="flex-1 space-y-4">
                  <!-- Header -->
                  <div class="flex items-center justify-between">
                    <div>
                      <div class="h-3 w-24 bg-slate-800 rounded mb-2"></div>
                      <div class="h-2 w-32 bg-slate-400 rounded"></div>
                    </div>
                    <div class="h-8 w-24 bg-primary-500 rounded-lg"></div>
                  </div>

                  <!-- Stats cards -->
                  <div class="grid grid-cols-3 gap-3">
                    <div class="bg-white rounded-xl p-4 border border-slate-200">
                      <div class="h-2 w-12 bg-slate-300 rounded mb-2"></div>
                      <div class="h-4 w-8 bg-slate-800 rounded"></div>
                    </div>
                    <div class="bg-white rounded-xl p-4 border border-slate-200">
                      <div class="h-2 w-14 bg-slate-300 rounded mb-2"></div>
                      <div class="h-4 w-10 bg-primary-500 rounded"></div>
                    </div>
                    <div class="bg-white rounded-xl p-4 border border-slate-200">
                      <div class="h-2 w-10 bg-slate-300 rounded mb-2"></div>
                      <div class="h-4 w-12 bg-accent-500 rounded"></div>
                    </div>
                  </div>

                  <!-- Content editor mockup -->
                  <div class="bg-white rounded-xl p-4 border border-slate-200">
                    <div class="flex items-center gap-2 mb-4 pb-3 border-b border-slate-100">
                      <div class="h-6 w-6 rounded bg-slate-200"></div>
                      <div class="h-6 w-6 rounded bg-slate-200"></div>
                      <div class="h-6 w-6 rounded bg-slate-200"></div>
                      <div class="h-6 w-px bg-slate-200"></div>
                      <div class="h-6 w-6 rounded bg-slate-200"></div>
                      <div class="h-6 w-6 rounded bg-slate-200"></div>
                    </div>
                    <div class="space-y-2">
                      <div class="h-3 w-3/4 bg-slate-200 rounded"></div>
                      <div class="h-3 w-full bg-slate-200 rounded"></div>
                      <div class="h-3 w-2/3 bg-slate-200 rounded"></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Label -->
          <div class="mt-4 text-center">
            <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary-100 text-primary-700 font-semibold text-sm">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              Admin Dashboard
            </span>
          </div>
        </div>

        <!-- Output: Website + Mobile -->
        <div class="relative">
          <div class="absolute -inset-4 bg-gradient-to-r from-accent-500/20 to-accent-600/20 rounded-3xl blur-2xl"></div>

          <div class="relative flex gap-4 items-end justify-center">
            <!-- Website mockup -->
            <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 overflow-hidden flex-1 max-w-sm">
              <!-- Window chrome -->
              <div class="bg-slate-100 px-3 py-2 flex items-center gap-2 border-b border-slate-200">
                <div class="flex gap-1">
                  <div class="w-2 h-2 rounded-full bg-red-400"></div>
                  <div class="w-2 h-2 rounded-full bg-yellow-400"></div>
                  <div class="w-2 h-2 rounded-full bg-green-400"></div>
                </div>
                <div class="flex-1 ml-2">
                  <div class="bg-white rounded px-2 py-1 text-xs text-slate-400 border border-slate-200">
                    yourclub.clubify.ie
                  </div>
                </div>
              </div>

              <!-- Website content -->
              <div class="p-4 bg-white">
                <!-- Nav -->
                <div class="flex items-center justify-between mb-4">
                  <div class="flex items-center gap-2">
                    <div class="w-6 h-6 rounded-lg bg-primary-500"></div>
                    <div class="h-2 w-16 bg-slate-800 rounded"></div>
                  </div>
                  <div class="flex gap-2">
                    <div class="h-1.5 w-8 bg-slate-300 rounded"></div>
                    <div class="h-1.5 w-8 bg-slate-300 rounded"></div>
                  </div>
                </div>

                <!-- Hero -->
                <div class="h-20 rounded-lg bg-gradient-to-r from-primary-600 to-primary-500 mb-4 flex items-center justify-center">
                  <div class="text-center">
                    <div class="h-2.5 w-24 bg-white/90 rounded mx-auto mb-1.5"></div>
                    <div class="h-1.5 w-16 bg-white/60 rounded mx-auto"></div>
                  </div>
                </div>

                <!-- Content cards -->
                <div class="grid grid-cols-2 gap-2">
                  <div class="bg-slate-50 rounded-lg p-2 border border-slate-100">
                    <div class="h-1.5 w-8 bg-accent-500 rounded mb-1.5"></div>
                    <div class="h-1 w-full bg-slate-200 rounded mb-1"></div>
                    <div class="h-1 w-3/4 bg-slate-200 rounded"></div>
                  </div>
                  <div class="bg-slate-50 rounded-lg p-2 border border-slate-100">
                    <div class="h-1.5 w-8 bg-primary-500 rounded mb-1.5"></div>
                    <div class="h-1 w-full bg-slate-200 rounded mb-1"></div>
                    <div class="h-1 w-2/3 bg-slate-200 rounded"></div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Mobile mockup -->
            <div class="w-24 flex-shrink-0">
              <div class="bg-slate-900 rounded-2xl p-1.5 shadow-2xl">
                <div class="bg-white rounded-xl aspect-[9/16] p-2 overflow-hidden">
                  <div class="w-8 h-1 bg-slate-200 rounded-full mx-auto mb-2"></div>

                  <!-- Mini header -->
                  <div class="flex items-center gap-1 mb-2">
                    <div class="w-4 h-4 rounded bg-primary-500"></div>
                    <div class="h-1.5 w-10 bg-slate-800 rounded"></div>
                  </div>

                  <!-- Mini hero -->
                  <div class="h-10 rounded bg-gradient-to-r from-primary-600 to-primary-500 mb-2"></div>

                  <!-- Mini content -->
                  <div class="space-y-1.5">
                    <div class="h-1 w-full bg-slate-200 rounded"></div>
                    <div class="h-1 w-3/4 bg-slate-200 rounded"></div>
                    <div class="h-6 w-full bg-slate-100 rounded mt-2"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Label -->
          <div class="mt-4 text-center">
            <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-accent-100 text-accent-700 font-semibold text-sm">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
              </svg>
              Live Website + App
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Feature highlights -->
    <div class="mt-20 grid sm:grid-cols-3 gap-6 max-w-4xl mx-auto">
      <div class="text-center p-6">
        <div class="w-12 h-12 rounded-2xl bg-primary-100 flex items-center justify-center mx-auto mb-4">
          <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
        </div>
        <h3 class="font-bold text-slate-900 mb-2">Instant updates</h3>
        <p class="text-sm text-slate-600">Changes appear on your site and app in real-time. No waiting.</p>
      </div>
      <div class="text-center p-6">
        <div class="w-12 h-12 rounded-2xl bg-accent-100 flex items-center justify-center mx-auto mb-4">
          <svg class="w-6 h-6 text-accent-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"/>
          </svg>
        </div>
        <h3 class="font-bold text-slate-900 mb-2">No coding needed</h3>
        <p class="text-sm text-slate-600">Visual editor makes it easy. If you can send an email, you can use Clubify.</p>
      </div>
      <div class="text-center p-6">
        <div class="w-12 h-12 rounded-2xl bg-teal-100 flex items-center justify-center mx-auto mb-4">
          <svg class="w-6 h-6 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
        </div>
        <h3 class="font-bold text-slate-900 mb-2">Always secure</h3>
        <p class="text-sm text-slate-600">Automatic backups, SSL encryption, and GDPR compliance built in.</p>
      </div>
    </div>
  </div>
</section>
