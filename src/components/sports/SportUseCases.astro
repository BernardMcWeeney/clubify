---
import Section from '../Section.astro';
import type { SportConfig } from '../../lib/sports';

interface Props {
  sport: SportConfig;
}

const { sport } = Astro.props;

// Sport-specific use cases with rich content
const sportUseCases: Record<string, { title: string; description: string; highlights: { title: string; description: string }[] }> = {
  gaa: {
    title: 'Everything your GAA club needs',
    description: 'From tracking championship fixtures to celebrating club achievements, Clubify gives your GAA club the digital home it deserves.',
    highlights: [
      { title: 'GAA Scoring System', description: 'Native support for goals and points (2-14 format) across all codes' },
      { title: 'Multi-Code Support', description: 'Manage hurling, football, camogie, and ladies football in one place' },
      { title: 'County Integration', description: 'Designed with Irish county structures and competitions in mind' },
    ]
  },
  football: {
    title: 'Built for football clubs',
    description: 'Whether you\'re managing a Sunday league team or a semi-professional outfit, Clubify handles all your digital needs.',
    highlights: [
      { title: 'League Tables', description: 'Automatic standings with points, goal difference, and form guides' },
      { title: 'Squad Profiles', description: 'Player stats, appearances, and goals tracked automatically' },
      { title: 'Match Reports', description: 'Rich match day content with lineups, scorers, and highlights' },
    ]
  },
  rugby: {
    title: 'Perfect for rugby clubs',
    description: 'From minis to seniors, manage your entire rugby club with tools built for the unique needs of the sport.',
    highlights: [
      { title: 'Age Grade Teams', description: 'Organize minis, youth, colts, J1s, and senior squads seamlessly' },
      { title: 'Try Tracking', description: 'Record tries, conversions, penalties, and drop goals' },
      { title: 'Social Integration', description: 'Build club culture with social events and post-match gatherings' },
    ]
  },
  athletics: {
    title: 'Designed for athletics clubs',
    description: 'Track performances, celebrate PBs, and keep your running community connected year-round.',
    highlights: [
      { title: 'Personal Bests', description: 'Track times and distances across all events and age groups' },
      { title: 'Event Calendar', description: 'Cross country, track meets, road races, and training sessions' },
      { title: 'Club Records', description: 'Showcase historic performances and leaderboards' },
    ]
  },
  golf: {
    title: 'Elegant for golf clubs',
    description: 'Give your members a modern digital experience that matches your club\'s prestige.',
    highlights: [
      { title: 'Competition Results', description: 'Stableford, stroke play, and matchplay formats supported' },
      { title: 'Leaderboards', description: 'Live scoring during competitions and order of merit' },
      { title: 'Course Information', description: 'Hole-by-hole details, local rules, and tee times' },
    ]
  },
  tennis: {
    title: 'Smart for tennis clubs',
    description: 'Manage leagues, ladders, and tournaments while keeping members engaged with club news.',
    highlights: [
      { title: 'Club Leagues', description: 'Internal leagues, ladders, and box leagues made easy' },
      { title: 'Tournament Draws', description: 'Singles and doubles tournament management' },
      { title: 'Player Rankings', description: 'Track performance and rankings over time' },
    ]
  },
  cycling: {
    title: 'Dynamic for cycling clubs',
    description: 'From club spins to racing, build a community hub that keeps your riders connected.',
    highlights: [
      { title: 'Group Rides', description: 'Schedule spins by pace, distance, and ability level' },
      { title: 'Route Sharing', description: 'Share club routes with maps and elevation profiles' },
      { title: 'Race Results', description: 'Track racing achievements and club performances' },
    ]
  },
};

const useCase = sportUseCases[sport.id] || sportUseCases.gaa;
---

<Section size="md" class="bg-white">
  <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
    <!-- Content -->
    <div>
      <span class="section-badge" style={`color: ${sport.primaryColor}`}>
        Why Clubify
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-6">
        {useCase.title}
      </h2>
      <p class="text-lg text-slate-600 mb-8">
        {useCase.description}
      </p>

      <div class="space-y-6">
        {useCase.highlights.map((highlight) => (
          <div class="flex gap-4">
            <div class="flex-shrink-0 w-10 h-10 rounded-lg flex items-center justify-center" style={`background: ${sport.primaryColor}15`}>
              <svg class="w-5 h-5" style={`color: ${sport.primaryColor}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-slate-900 mb-1">{highlight.title}</h3>
              <p class="text-slate-600 text-sm">{highlight.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Visual mockup -->
    <div class="relative">
      <div class="relative rounded-2xl overflow-hidden shadow-2xl border border-slate-200">
        <!-- Browser chrome -->
        <div class="bg-slate-100 px-4 py-3 flex items-center gap-2 border-b border-slate-200">
          <div class="flex gap-1.5">
            <div class="w-3 h-3 rounded-full bg-red-400"></div>
            <div class="w-3 h-3 rounded-full bg-amber-400"></div>
            <div class="w-3 h-3 rounded-full bg-green-400"></div>
          </div>
          <div class="flex-1 mx-4">
            <div class="bg-white rounded-md px-3 py-1.5 text-xs text-slate-500 text-center">
              yourclub.clubify.ie
            </div>
          </div>
        </div>

        <!-- Mock content -->
        <div class="bg-white p-6">
          <!-- Header bar -->
          <div class="flex items-center justify-between mb-6">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-lg" style={`background: ${sport.primaryColor}`}></div>
              <div>
                <div class="h-3 w-24 bg-slate-200 rounded"></div>
                <div class="h-2 w-16 bg-slate-100 rounded mt-1"></div>
              </div>
            </div>
            <div class="flex gap-2">
              <div class="h-8 w-16 bg-slate-100 rounded-lg"></div>
              <div class="h-8 w-16 rounded-lg" style={`background: ${sport.primaryColor}`}></div>
            </div>
          </div>

          <!-- Content grid -->
          <div class="grid grid-cols-2 gap-4 mb-6">
            <div class="aspect-video rounded-lg" style={`background: ${sport.primaryColor}20`}>
              <div class="w-full h-full flex items-center justify-center">
                <svg class="w-8 h-8 opacity-30" style={`color: ${sport.primaryColor}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
              </div>
            </div>
            <div class="aspect-video rounded-lg bg-slate-100">
              <div class="w-full h-full flex items-center justify-center">
                <svg class="w-8 h-8 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
                </svg>
              </div>
            </div>
          </div>

          <!-- Stats row -->
          <div class="grid grid-cols-3 gap-3">
            <div class="bg-slate-50 rounded-lg p-3 text-center">
              <div class="text-lg font-bold" style={`color: ${sport.primaryColor}`}>24</div>
              <div class="text-xs text-slate-500">{sport.terminology.fixture}s</div>
            </div>
            <div class="bg-slate-50 rounded-lg p-3 text-center">
              <div class="text-lg font-bold" style={`color: ${sport.primaryColor}`}>156</div>
              <div class="text-xs text-slate-500">{sport.terminology.member}s</div>
            </div>
            <div class="bg-slate-50 rounded-lg p-3 text-center">
              <div class="text-lg font-bold" style={`color: ${sport.primaryColor}`}>12</div>
              <div class="text-xs text-slate-500">News</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Decorative elements -->
      <div class="absolute -z-10 -bottom-6 -right-6 w-72 h-72 rounded-full blur-3xl" style={`background: ${sport.primaryColor}10`}></div>
    </div>
  </div>
</Section>
