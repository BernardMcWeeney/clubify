---
import Section from '../Section.astro';
import type { SportConfig } from '../../lib/sports';

interface Props {
  sport: SportConfig;
}

const { sport } = Astro.props;

// Sport-specific use cases with rich content
const sportUseCases: Record<string, { title: string; description: string; highlights: { title: string; description: string }[] }> = {
  gaa: {
    title: 'Everything a GAA club needs, from fixtures to finals',
    description: 'Clubify speaks GAA. Goals and points scoring, multi-code teams, and matchday comms that keep the parish connected.',
    highlights: [
      { title: 'Goals + points scoring', description: 'Record scores in the 2-14 format with automatic points totals.' },
      { title: 'Multi-code club setup', description: 'Run football, hurling, camogie, and ladies teams from one site.' },
      { title: 'Championship-ready fixtures', description: 'Fixtures, results, and previews built for league and championship formats.' },
    ]
  },
  football: {
    title: 'Built for football clubs and academies',
    description: 'Manage tables, fixtures, and matchday content with a site built for football clubs at every level.',
    highlights: [
      { title: 'Automatic league tables', description: 'Standings with points, goal difference, and recent form.' },
      { title: 'Matchday lineups', description: 'Lineups, scorers, cards, and match reports in one hub.' },
      { title: 'Player stats', description: 'Profiles with appearances, goals, assists, and milestones.' },
    ]
  },
  rugby: {
    title: 'Perfect for rugby clubs of every age grade',
    description: 'From minis to seniors, keep squads, parents, and supporters in sync with fixtures, team sheets, and updates.',
    highlights: [
      { title: 'Try and conversion scoring', description: 'Capture tries, conversions, penalties, and drop goals.' },
      { title: 'Age-grade pathways', description: 'Organize minis, youth, colts, and senior squads clearly.' },
      { title: 'Training and availability', description: 'Share training times and keep availability up to date.' },
    ]
  },
  athletics: {
    title: 'Designed for athletics clubs',
    description: 'Celebrate performances, track PBs, and keep your running community engaged across the season.',
    highlights: [
      { title: 'PB tracking by event', description: 'Record times and distances with personal bests by discipline.' },
      { title: 'Race and meet calendar', description: 'Track meets, cross country, road races, and club events.' },
      { title: 'Club records and rankings', description: 'Showcase club records and age-group leaderboards.' },
    ]
  },
  golf: {
    title: 'Elegant for golf clubs and societies',
    description: 'Give members a digital clubhouse with competitions, handicaps, and course information.',
    highlights: [
      { title: 'Handicap index display', description: 'Show member handicaps with clear, accessible profiles.' },
      { title: 'Competition leaderboards', description: 'Stableford, stroke play, and matchplay formats supported.' },
      { title: 'Course guide and local rules', description: 'Hole-by-hole details, tees, and club rules in one place.' },
    ]
  },
  tennis: {
    title: 'Smart for tennis clubs',
    description: 'Keep leagues, ladders, and coaching organized with a site that players actually use.',
    highlights: [
      { title: 'Ladders and box leagues', description: 'Internal leagues and ladders with automatic standings.' },
      { title: 'Set scoring and results', description: 'Track matches with sets and games scoring.' },
      { title: 'Court booking info', description: 'Surface details, opening times, and court availability.' },
    ]
  },
  cycling: {
    title: 'Dynamic for cycling clubs',
    description: 'From club spins to races, build a hub for routes, ride updates, and results.',
    highlights: [
      { title: 'Route library with maps', description: 'Share club routes with distance and elevation.' },
      { title: 'Group ride scheduling', description: 'Organize spins by pace group, time, and distance.' },
      { title: 'Race results and rankings', description: 'Track results, achievements, and club standings.' },
    ]
  },
};

const useCase = sportUseCases[sport.id] || sportUseCases.gaa;
---

<Section size="md" class="bg-white">
  <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
    <!-- Content -->
    <div>
      <span class="section-badge" style={`color: ${sport.primaryColor}`}>
        Why Clubify
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-6">
        {useCase.title}
      </h2>
      <p class="text-lg text-slate-600 mb-8">
        {useCase.description}
      </p>

      <div class="space-y-6">
        {useCase.highlights.map((highlight) => (
          <div class="flex gap-4">
            <div class="flex-shrink-0 w-10 h-10 rounded-lg flex items-center justify-center" style={`background: ${sport.primaryColor}15`}>
              <svg class="w-5 h-5" style={`color: ${sport.primaryColor}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-slate-900 mb-1">{highlight.title}</h3>
              <p class="text-slate-600 text-sm">{highlight.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Visual mockup -->
    <div class="relative">
      <div class="relative rounded-2xl overflow-hidden shadow-2xl border border-slate-200">
        <!-- Browser chrome -->
        <div class="bg-slate-100 px-4 py-3 flex items-center gap-2 border-b border-slate-200">
          <div class="flex gap-1.5">
            <div class="w-3 h-3 rounded-full bg-red-400"></div>
            <div class="w-3 h-3 rounded-full bg-amber-400"></div>
            <div class="w-3 h-3 rounded-full bg-green-400"></div>
          </div>
          <div class="flex-1 mx-4">
            <div class="bg-white rounded-md px-3 py-1.5 text-xs text-slate-500 text-center">
              yourclub.clubify.ie
            </div>
          </div>
        </div>

        <!-- Mock content -->
        <div class="bg-white p-6">
          <!-- Header bar -->
          <div class="flex items-center justify-between mb-6">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-lg" style={`background: ${sport.primaryColor}`}></div>
              <div>
                <div class="h-3 w-24 bg-slate-200 rounded"></div>
                <div class="h-2 w-16 bg-slate-100 rounded mt-1"></div>
              </div>
            </div>
            <div class="flex gap-2">
              <div class="h-8 w-16 bg-slate-100 rounded-lg"></div>
              <div class="h-8 w-16 rounded-lg" style={`background: ${sport.primaryColor}`}></div>
            </div>
          </div>

          <!-- Content grid -->
          <div class="grid grid-cols-2 gap-4 mb-6">
            <div class="aspect-video rounded-lg" style={`background: ${sport.primaryColor}20`}>
              <div class="w-full h-full flex items-center justify-center">
                <svg class="w-8 h-8 opacity-30" style={`color: ${sport.primaryColor}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
              </div>
            </div>
            <div class="aspect-video rounded-lg bg-slate-100">
              <div class="w-full h-full flex items-center justify-center">
                <svg class="w-8 h-8 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
                </svg>
              </div>
            </div>
          </div>

          <!-- Stats row -->
          <div class="grid grid-cols-3 gap-3">
            <div class="bg-slate-50 rounded-lg p-3 text-center">
              <div class="text-lg font-bold" style={`color: ${sport.primaryColor}`}>24</div>
              <div class="text-xs text-slate-500">{sport.terminology.fixture}s</div>
            </div>
            <div class="bg-slate-50 rounded-lg p-3 text-center">
              <div class="text-lg font-bold" style={`color: ${sport.primaryColor}`}>156</div>
              <div class="text-xs text-slate-500">{sport.terminology.member}s</div>
            </div>
            <div class="bg-slate-50 rounded-lg p-3 text-center">
              <div class="text-lg font-bold" style={`color: ${sport.primaryColor}`}>12</div>
              <div class="text-xs text-slate-500">News</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Decorative elements -->
      <div class="absolute -z-10 -bottom-6 -right-6 w-72 h-72 rounded-full blur-3xl" style={`background: ${sport.primaryColor}10`}></div>
    </div>
  </div>
</Section>
