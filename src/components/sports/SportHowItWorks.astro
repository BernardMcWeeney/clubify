---
import type { SportConfig } from '../../lib/sports';

interface Props {
  sport: SportConfig;
}

const { sport } = Astro.props;

const steps = [
  {
    number: '01',
    title: 'Create your club',
    description: `Sign up and set up your ${sport.name.toLowerCase()} club in minutes. Choose a template that matches your club's style.`,
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>`
  },
  {
    number: '02',
    title: 'Add your content',
    description: `Upload your crest, add ${sport.terminology.fixture.toLowerCase()}s, news, and team information. Everything your members need in one place.`,
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>`
  },
  {
    number: '03',
    title: 'Go live',
    description: `Launch your website and mobile app. Keep ${sport.terminology.member.toLowerCase()}s and supporters connected with your club.`,
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>`
  }
];
---

<section class="py-20 md:py-28 bg-slate-50">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white text-slate-700 text-sm font-semibold border border-slate-200 mb-6">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
        </svg>
        How it works
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-slate-900 mb-4">
        Get your {sport.name.toLowerCase()} club online
      </h2>
      <p class="text-lg text-slate-600 max-w-2xl mx-auto">
        From signup to launch in three simple steps. No technical skills required.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8 lg:gap-12">
      {steps.map((step, index) => (
        <div class="relative">
          <!-- Connector line (hidden on mobile and last item) -->
          {index < steps.length - 1 && (
            <div class="hidden md:block absolute top-14 left-[calc(50%+2rem)] w-[calc(100%-4rem)] h-px bg-gradient-to-r from-primary-300 to-primary-100"></div>
          )}

          <div class="relative bg-white rounded-2xl p-8 border border-slate-200 hover:border-primary-200 hover:shadow-xl transition-all duration-300">
            <!-- Step number badge -->
            <div
              class="absolute -top-4 left-8 px-3 py-1 text-white text-sm font-bold rounded-full shadow-lg"
              style={`background: linear-gradient(135deg, ${sport.primaryColor}, ${sport.primaryColor}dd)`}
            >
              {step.number}
            </div>

            <!-- Icon -->
            <div
              class="w-14 h-14 rounded-xl flex items-center justify-center mb-6 mt-2"
              style={`background: ${sport.primaryColor}10; color: ${sport.primaryColor}`}
            >
              <Fragment set:html={step.icon} />
            </div>

            <!-- Content -->
            <h3 class="text-xl font-bold text-slate-900 mb-3">
              {step.title}
            </h3>
            <p class="text-slate-600 leading-relaxed">
              {step.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
