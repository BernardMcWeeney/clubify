---
import Button from '../Button.astro';
import type { SportConfig } from '../../lib/sports';

interface Props {
  sport: SportConfig;
}

const { sport } = Astro.props;
const isReady = sport.status === 'ready';
---

<section
  class="relative pt-32 pb-20 lg:pb-32 overflow-hidden"
  style={`--sport-primary: ${sport.primaryColor}; --sport-secondary: ${sport.secondaryColor}`}
>
  <!-- Background with gradient -->
  <div class="absolute inset-0 bg-gradient-to-br from-[var(--sport-primary)] via-[var(--sport-primary)] to-slate-900"></div>

  <!-- Decorative elements -->
  <div class="absolute inset-0 overflow-hidden">
    <div class="absolute -top-24 -right-24 w-[600px] h-[600px] bg-white/5 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-24 -left-24 w-[600px] h-[600px] bg-[var(--sport-secondary)]/10 rounded-full blur-3xl"></div>

    <!-- Grid pattern -->
    <div class="absolute inset-0 opacity-5">
      <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="sport-grid" x="0" y="0" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M40 0H0v40" fill="none" stroke="white" stroke-width="1"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#sport-grid)"/>
      </svg>
    </div>
  </div>

  <!-- Content -->
  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
      <!-- Text content -->
      <div>
        <!-- Status badge -->
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 backdrop-blur-sm border border-white/20 text-white text-sm font-medium mb-6">
          {isReady ? (
            <>
              <span class="w-2 h-2 rounded-full bg-green-400"></span>
              Available Now
            </>
          ) : (
            <>
              <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
              Coming Soon
            </>
          )}
        </div>

        <!-- Main headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
          All-in-one platform for<br />
          <span class="text-[var(--sport-secondary)]">{sport.namePlural}</span>
        </h1>

        <!-- Tagline -->
        <p class="text-xl text-white/90 font-medium mb-4">
          {sport.tagline}
        </p>

        <!-- Description -->
        <p class="text-lg text-white/70 max-w-xl mb-8">
          {sport.longDescription}
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row items-start gap-4 mb-10">
          <Button
            href="/admin/signup"
            variant="dark"
            size="lg"
            class="bg-white text-slate-900 hover:bg-white/90"
          >
            {isReady ? `Create your ${sport.name.toLowerCase()} club` : "Get early access"}
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
            </svg>
          </Button>
          <Button href="#features" variant="ghost" size="lg" class="text-white border-white/30 hover:bg-white/10">
            View features
          </Button>
        </div>

        <!-- Trust indicators -->
        <div class="flex flex-wrap items-center gap-6 text-sm text-white/60">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            <span>7-day free trial</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            <span>No credit card required</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            <span>Setup in 15 minutes</span>
          </div>
        </div>
      </div>

      <!-- Visual mockup -->
      <div class="relative hidden lg:block">
        <div class="relative">
          <!-- Browser mockup -->
          <div class="bg-white/10 backdrop-blur-sm rounded-2xl border border-white/20 shadow-2xl overflow-hidden">
            <div class="h-10 bg-white/10 flex items-center px-4 gap-2 border-b border-white/10">
              <div class="flex gap-1.5">
                <div class="w-3 h-3 rounded-full bg-white/20"></div>
                <div class="w-3 h-3 rounded-full bg-white/20"></div>
                <div class="w-3 h-3 rounded-full bg-white/20"></div>
              </div>
              <div class="flex-1 flex justify-center">
                <div class="px-4 py-1 bg-white/10 rounded-lg text-white/40 text-xs">
                  your{sport.slug}club.clubify.ie
                </div>
              </div>
            </div>
            <div class="p-4">
              <!-- Mock content -->
              <div class="space-y-4">
                <div class="flex gap-4">
                  <div class="w-16 h-16 rounded-xl bg-white/20"></div>
                  <div class="flex-1 space-y-2">
                    <div class="h-4 bg-white/30 rounded w-3/4"></div>
                    <div class="h-3 bg-white/20 rounded w-1/2"></div>
                  </div>
                </div>
                <div class="grid grid-cols-3 gap-3">
                  <div class="h-20 bg-white/15 rounded-lg"></div>
                  <div class="h-20 bg-white/15 rounded-lg"></div>
                  <div class="h-20 bg-white/15 rounded-lg"></div>
                </div>
                <div class="space-y-2">
                  <div class="h-3 bg-white/20 rounded w-full"></div>
                  <div class="h-3 bg-white/20 rounded w-5/6"></div>
                  <div class="h-3 bg-white/15 rounded w-4/6"></div>
                </div>
              </div>
            </div>
          </div>

          <!-- Mobile mockup overlay -->
          <div class="absolute -bottom-8 -right-8 w-36">
            <div class="bg-white/10 backdrop-blur-sm rounded-2xl border border-white/20 shadow-2xl overflow-hidden">
              <div class="h-4 bg-white/10 flex items-center justify-center">
                <div class="w-8 h-1 bg-white/30 rounded-full"></div>
              </div>
              <div class="p-2">
                <div class="space-y-2">
                  <div class="h-8 bg-white/20 rounded-lg"></div>
                  <div class="grid grid-cols-2 gap-1">
                    <div class="h-10 bg-white/15 rounded"></div>
                    <div class="h-10 bg-white/15 rounded"></div>
                  </div>
                  <div class="h-2 bg-white/20 rounded w-3/4"></div>
                  <div class="h-2 bg-white/15 rounded w-1/2"></div>
                </div>
              </div>
            </div>
          </div>

          <!-- Decorative sport icon -->
          <div class="absolute -top-4 -left-4 w-20 h-20 bg-[var(--sport-secondary)]/20 rounded-2xl flex items-center justify-center rotate-12">
            <div class="w-12 h-12 text-[var(--sport-secondary)]" set:html={sport.icon}></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce hidden md:block">
    <svg class="w-6 h-6 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
    </svg>
  </div>
</section>
