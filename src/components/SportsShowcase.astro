---
import { getAllSports, getReadySports, getComingSoonSports } from '../lib/sports';

const readySports = getReadySports();
const comingSoonSports = getComingSoonSports();
const allSports = getAllSports();
---

<section class="py-20 lg:py-28 bg-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-16">
      <div class="section-badge-pill mx-auto mb-4 w-fit">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        For Every Sport
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 mb-4">
        One platform, every club type
      </h2>
      <p class="text-lg text-slate-600 max-w-2xl mx-auto">
        Whether you're managing a GAA club, football team, or tennis club, Clubify adapts to your sport with specialized features and terminology.
      </p>
    </div>

    <!-- Sports Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-7 gap-4">
      {allSports.map((sport) => (
        <a
          href={`/sports/${sport.slug}`}
          class="group relative flex flex-col items-center gap-3 p-6 rounded-2xl border border-slate-200 bg-white hover:border-primary-200 hover:shadow-lg hover:shadow-primary-100/50 transition-all duration-300"
        >
          {/* Sport Icon */}
          <div
            class="w-14 h-14 rounded-xl flex items-center justify-center text-white shadow-lg group-hover:scale-110 transition-transform duration-300"
            style={`background: linear-gradient(135deg, ${sport.primaryColor}, ${sport.primaryColor}dd)`}
          >
            <div class="sport-showcase-icon text-white" aria-hidden="true" set:html={sport.icon}></div>
          </div>

          {/* Sport Name */}
          <span class="font-semibold text-slate-900 text-sm text-center">{sport.name}</span>

          {/* Status Badge */}
          {sport.status === 'ready' ? (
            <span class="absolute top-3 right-3 w-2 h-2 rounded-full bg-primary-500 animate-pulse"></span>
          ) : (
            <span class="text-xs font-medium text-amber-600 bg-amber-50 px-2 py-0.5 rounded-full">Soon</span>
          )}
        </a>
      ))}
    </div>

    <!-- Bottom CTA -->
    <div class="text-center mt-12">
      <p class="text-slate-500 mb-4">Don't see your sport listed?</p>
      <a
        href="/contact"
        class="inline-flex items-center gap-2 text-primary-600 font-semibold hover:text-primary-700 transition-colors"
      >
        Let us know what sport you need
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .sport-showcase-icon {
    width: 1.75rem;
    height: 1.75rem;
  }

  .sport-showcase-icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
