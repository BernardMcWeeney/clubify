---
const steps = [
  {
    number: "1",
    title: "Sign up & set up",
    description: "Create your account, upload your club crest, choose your colours, and pick your URL. Takes less than 5 minutes.",
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
    </svg>`,
    color: "#3b82f6"
  },
  {
    number: "2",
    title: "Add your content",
    description: "Pick a template, add your fixtures, news, and team info. Our editor makes it simple — no technical skills required.",
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"/>
    </svg>`,
    color: "#22c55e"
  },
  {
    number: "3",
    title: "Publish everywhere",
    description: "Hit publish and your content goes live on your website, mobile app, and social media — all at once.",
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>
    </svg>`,
    color: "#f59e0b"
  }
];
---

<section id="how-it-works" class="py-20 md:py-32 bg-white relative overflow-hidden">
  <!-- Background decoration -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-primary-500/5 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-accent-500/5 rounded-full blur-3xl"></div>
  </div>

  <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="text-center mb-16 md:mb-20">
      <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-semibold bg-primary-100 text-primary-700 mb-6">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
        </svg>
        Quick setup
      </span>
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-slate-900 mb-6">
        Live in <span class="text-primary-600">3 simple steps</span>
      </h2>
      <p class="text-xl text-slate-600 max-w-2xl mx-auto">
        No developers. No complicated setup. Just your club crest and a few minutes.
      </p>
    </div>

    <!-- Steps -->
    <div class="relative">
      <!-- Connecting line - desktop only -->
      <div class="hidden lg:block absolute top-24 left-[16.666%] right-[16.666%] h-0.5 bg-gradient-to-r from-blue-200 via-green-200 to-amber-200"></div>

      <div class="grid md:grid-cols-3 gap-8 lg:gap-12">
        {steps.map((step, index) => (
          <div class="relative group">
            <!-- Card -->
            <div class="bg-white rounded-2xl border border-slate-200 p-8 h-full hover:shadow-xl hover:border-slate-300 transition-all duration-300">
              <!-- Step number circle -->
              <div class="relative mb-6">
                <div class="w-12 h-12 rounded-full flex items-center justify-center text-white font-bold text-lg shadow-lg" style={`background-color: ${step.color}`}>
                  {step.number}
                </div>
                <!-- Connecting dot for desktop -->
                <div class="hidden lg:block absolute -top-3 left-1/2 -translate-x-1/2 w-4 h-4 rounded-full border-4 border-white shadow-md" style={`background-color: ${step.color}`}></div>
              </div>

              <!-- Icon -->
              <div class="mb-6">
                <div class="w-14 h-14 rounded-2xl flex items-center justify-center" style={`background-color: ${step.color}15`}>
                  <div style={`color: ${step.color}`}>
                    <Fragment set:html={step.icon} />
                  </div>
                </div>
              </div>

              <!-- Content -->
              <h3 class="text-xl font-bold text-slate-900 mb-3">{step.title}</h3>
              <p class="text-slate-600 leading-relaxed">{step.description}</p>
            </div>

            <!-- Arrow connector - desktop only -->
            {index < steps.length - 1 && (
              <div class="hidden lg:flex absolute top-1/2 -right-6 w-12 items-center justify-center -translate-y-1/2 z-10">
                <svg class="w-6 h-6 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                </svg>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="text-center mt-16">
      <a
        href="/admin/signup"
        class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-primary-600 to-primary-500 hover:from-primary-500 hover:to-primary-400 text-white font-bold rounded-xl transition-all shadow-lg shadow-primary-500/25"
      >
        Get started free
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
        </svg>
      </a>
      <p class="mt-4 text-slate-500 text-sm">No credit card required</p>
    </div>
  </div>
</section>
