---
import Section from './Section.astro';
import Button from './Button.astro';

const templates = [
  {
    name: "Classic Club",
    description: "The perfect all-rounder. Hero section, fixtures, news, and sponsors in a clean, professional layout.",
    bestFor: "Traditional clubs",
    color: "primary",
    accent: "#22c55e",
    mockup: {
      heroStyle: "banner",
      sections: ["fixtures", "news", "sponsors"]
    }
  },
  {
    name: "Matchday Focus",
    description: "Put the game at the centre. Perfect for clubs that want to highlight fixtures and results first.",
    bestFor: "Results-driven clubs",
    color: "accent",
    accent: "#f59e0b",
    popular: true,
    mockup: {
      heroStyle: "matchday",
      sections: ["scores", "table", "news"]
    }
  },
  {
    name: "Community First",
    description: "Celebrate your community. Highlight events, volunteers, and club activities alongside fixtures.",
    bestFor: "Community-focused clubs",
    color: "teal",
    accent: "#14b8a6",
    mockup: {
      heroStyle: "welcome",
      sections: ["events", "gallery", "fixtures"]
    }
  }
];
---

<section id="templates" class="py-20 md:py-32 bg-slate-50 relative overflow-hidden">
  <!-- Background decoration -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute -top-40 -right-40 w-80 h-80 bg-primary-500/5 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-40 -left-40 w-80 h-80 bg-accent-500/5 rounded-full blur-3xl"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="text-center mb-16">
      <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-semibold bg-primary-100 text-primary-700 mb-6">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"/>
        </svg>
        Professional templates
      </span>
      <h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-6">
        Choose your club's look
      </h2>
      <p class="text-xl text-slate-600 max-w-2xl mx-auto">
        Three professionally designed layouts. Pick the one that fits your club's personality.
      </p>
    </div>

    <!-- Templates showcase -->
    <div class="space-y-8">
      {templates.map((template, index) => {
        const isEven = index % 2 === 1;
        return (
          <div class={`group relative bg-white rounded-3xl border border-slate-200 shadow-sm hover:shadow-xl transition-all duration-500 overflow-hidden ${template.popular ? 'ring-2 ring-accent-500 ring-offset-4' : ''}`}>
            {template.popular && (
              <div class="absolute top-4 right-4 z-20 px-3 py-1 rounded-full bg-accent-500 text-white text-xs font-bold uppercase tracking-wider">
                Most Popular
              </div>
            )}

            <div class={`grid lg:grid-cols-2 ${isEven ? 'lg:flex-row-reverse' : ''}`}>
              <!-- Mockup side -->
              <div class={`relative p-6 lg:p-10 bg-gradient-to-br from-slate-100 to-slate-50 ${isEven ? 'lg:order-2' : ''}`}>
                <!-- Browser frame -->
                <div class="bg-white rounded-xl shadow-lg border border-slate-200 overflow-hidden transform group-hover:scale-[1.02] transition-transform duration-500">
                  <!-- Browser chrome -->
                  <div class="bg-slate-100 px-4 py-2.5 flex items-center gap-2 border-b border-slate-200">
                    <div class="flex gap-1.5">
                      <div class="w-2.5 h-2.5 rounded-full bg-red-400"></div>
                      <div class="w-2.5 h-2.5 rounded-full bg-yellow-400"></div>
                      <div class="w-2.5 h-2.5 rounded-full bg-green-400"></div>
                    </div>
                    <div class="flex-1 ml-3">
                      <div class="bg-white rounded px-3 py-1 text-xs text-slate-400 w-full max-w-xs">
                        yourclub.clubify.ie
                      </div>
                    </div>
                  </div>

                  <!-- Template mockup content -->
                  <div class="p-4 aspect-[4/3] bg-white">
                    <!-- Navigation -->
                    <div class="flex items-center justify-between mb-4">
                      <div class="flex items-center gap-2">
                        <div class="w-8 h-8 rounded-lg" style={`background-color: ${template.accent}`}></div>
                        <div class="h-2.5 w-20 bg-slate-800 rounded"></div>
                      </div>
                      <div class="flex gap-3">
                        <div class="h-2 w-12 bg-slate-300 rounded"></div>
                        <div class="h-2 w-12 bg-slate-300 rounded"></div>
                        <div class="h-2 w-12 bg-slate-300 rounded"></div>
                      </div>
                    </div>

                    <!-- Hero area - different for each template -->
                    {template.mockup.heroStyle === "banner" && (
                      <div class="rounded-lg overflow-hidden mb-4">
                        <div class="h-24 bg-gradient-to-r from-slate-800 to-slate-700 relative">
                          <div class="absolute inset-0 flex items-center justify-center">
                            <div class="text-center">
                              <div class="h-3 w-32 bg-white/90 rounded mx-auto mb-2"></div>
                              <div class="h-2 w-24 bg-white/60 rounded mx-auto"></div>
                            </div>
                          </div>
                          <div class="absolute bottom-2 right-2 h-5 w-16 rounded" style={`background-color: ${template.accent}`}></div>
                        </div>
                      </div>
                    )}

                    {template.mockup.heroStyle === "matchday" && (
                      <div class="bg-slate-900 rounded-lg p-3 mb-4">
                        <div class="flex items-center justify-between">
                          <div class="flex items-center gap-2">
                            <div class="w-8 h-8 rounded bg-slate-700"></div>
                            <div class="h-2.5 w-16 bg-slate-600 rounded"></div>
                          </div>
                          <div class="text-center">
                            <div class="flex items-center gap-2">
                              <div class="w-6 h-6 rounded-full" style={`background-color: ${template.accent}`}></div>
                              <span class="text-lg font-bold text-white">2 - 1</span>
                              <div class="w-6 h-6 rounded-full bg-slate-600"></div>
                            </div>
                            <div class="h-1.5 w-12 bg-slate-700 rounded mt-1 mx-auto"></div>
                          </div>
                          <div class="flex items-center gap-2">
                            <div class="h-2.5 w-16 bg-slate-600 rounded"></div>
                            <div class="w-8 h-8 rounded bg-slate-700"></div>
                          </div>
                        </div>
                      </div>
                    )}

                    {template.mockup.heroStyle === "welcome" && (
                      <div class="rounded-lg overflow-hidden mb-4" style={`background: linear-gradient(135deg, ${template.accent}20, ${template.accent}05)`}>
                        <div class="p-4 flex items-center gap-4">
                          <div class="w-16 h-16 rounded-full" style={`background-color: ${template.accent}30`}></div>
                          <div>
                            <div class="h-3 w-28 bg-slate-800 rounded mb-2"></div>
                            <div class="h-2 w-40 bg-slate-400 rounded"></div>
                          </div>
                        </div>
                      </div>
                    )}

                    <!-- Content grid -->
                    <div class="grid grid-cols-3 gap-3">
                      {template.mockup.sections.map((section) => (
                        <div class="bg-slate-50 rounded-lg p-2 border border-slate-100">
                          <div class="h-1.5 w-10 rounded mb-2" style={`background-color: ${template.accent}`}></div>
                          <div class="space-y-1.5">
                            <div class="h-1.5 w-full bg-slate-200 rounded"></div>
                            <div class="h-1.5 w-3/4 bg-slate-200 rounded"></div>
                            <div class="h-1.5 w-1/2 bg-slate-200 rounded"></div>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>

                <!-- Mobile preview -->
                <div class="absolute -right-2 bottom-4 lg:bottom-8 w-20 hidden sm:block">
                  <div class="bg-slate-900 rounded-2xl p-1.5 shadow-xl">
                    <div class="bg-white rounded-xl aspect-[9/16] p-2">
                      <div class="w-6 h-1 bg-slate-200 rounded-full mx-auto mb-2"></div>
                      <div class="h-8 rounded mb-2" style={`background-color: ${template.accent}20`}></div>
                      <div class="space-y-1">
                        <div class="h-1 w-full bg-slate-200 rounded"></div>
                        <div class="h-1 w-3/4 bg-slate-200 rounded"></div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Content side -->
              <div class={`p-8 lg:p-12 flex flex-col justify-center ${isEven ? 'lg:order-1' : ''}`}>
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium mb-4 w-fit" style={`background-color: ${template.accent}15; color: ${template.accent}`}>
                  Best for {template.bestFor}
                </div>

                <h3 class="text-2xl lg:text-3xl font-bold text-slate-900 mb-4">{template.name}</h3>
                <p class="text-lg text-slate-600 mb-6">{template.description}</p>

                <!-- Feature highlights -->
                <div class="grid grid-cols-2 gap-4 mb-8">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg flex items-center justify-center" style={`background-color: ${template.accent}15`}>
                      <svg class="w-5 h-5" style={`color: ${template.accent}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                      </svg>
                    </div>
                    <span class="text-sm font-medium text-slate-700">Mobile optimized</span>
                  </div>
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg flex items-center justify-center" style={`background-color: ${template.accent}15`}>
                      <svg class="w-5 h-5" style={`color: ${template.accent}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/>
                      </svg>
                    </div>
                    <span class="text-sm font-medium text-slate-700">Your club colours</span>
                  </div>
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg flex items-center justify-center" style={`background-color: ${template.accent}15`}>
                      <svg class="w-5 h-5" style={`color: ${template.accent}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                      </svg>
                    </div>
                    <span class="text-sm font-medium text-slate-700">Fast loading</span>
                  </div>
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg flex items-center justify-center" style={`background-color: ${template.accent}15`}>
                      <svg class="w-5 h-5" style={`color: ${template.accent}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                      </svg>
                    </div>
                    <span class="text-sm font-medium text-slate-700">Switch anytime</span>
                  </div>
                </div>

                <div class="flex flex-wrap gap-3">
                  <a
                    href="/admin/signup"
                    class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-semibold text-white transition-all hover:opacity-90"
                    style={`background-color: ${template.accent}`}
                  >
                    Use this template
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                    </svg>
                  </a>
                  <a
                    href="/templates"
                    class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 transition-all"
                  >
                    View details
                  </a>
                </div>
              </div>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Bottom note -->
    <div class="mt-16 text-center">
      <div class="inline-flex items-center gap-6 flex-wrap justify-center text-sm text-slate-500">
        <span class="flex items-center gap-2">
          <svg class="w-5 h-5 text-primary-500" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
          </svg>
          Mobile responsive
        </span>
        <span class="flex items-center gap-2">
          <svg class="w-5 h-5 text-primary-500" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
          </svg>
          Accessibility built-in
        </span>
        <span class="flex items-center gap-2">
          <svg class="w-5 h-5 text-primary-500" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
          </svg>
          Switch templates anytime
        </span>
      </div>
    </div>
  </div>
</section>
