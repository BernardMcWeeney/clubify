---
/**
 * AdminPageTemplate Component - Standardized page wrapper with breadcrumbs and header
 *
 * Usage:
 * <AdminPageTemplate
 *   title="Posts"
 *   subtitle="Manage your club's news and updates"
 *   breadcrumbs={[
 *     { label: 'Dashboard', href: `/${slug}/admin-portal` },
 *     { label: 'Posts' }
 *   ]}
 * >
 *   <Button slot="actions" href="posts/new">New Post</Button>
 *   <div>Page content...</div>
 * </AdminPageTemplate>
 */

import Breadcrumb, { type BreadcrumbItem } from './Breadcrumb.astro';

interface Props {
  /** Page title */
  title: string;
  /** Optional subtitle/description */
  subtitle?: string;
  /** Breadcrumb navigation items */
  breadcrumbs: BreadcrumbItem[];
  /** Use wide layout (1600px) for tables, default is standard (1280px) */
  wide?: boolean;
  /** Additional CSS classes for the content wrapper */
  class?: string;
}

const {
  title,
  subtitle,
  breadcrumbs,
  wide = false,
  class: className = '',
} = Astro.props;

const hasActions = Astro.slots.has('actions');
const maxWidthClass = wide ? 'max-w-[1600px]' : 'max-w-[1280px]';
---

<div class={`w-full ${maxWidthClass} mx-auto ${className}`}>
  <!-- Breadcrumbs -->
  <Breadcrumb items={breadcrumbs} class="mb-2" />

  <!-- Page Header -->
  <div class="flex items-start justify-between gap-4 mb-6">
    <div class="min-w-0 flex-1">
      <h1 class="text-2xl font-semibold text-slate-900">{title}</h1>
      {subtitle && (
        <p class="text-sm text-slate-500 mt-1">{subtitle}</p>
      )}
    </div>
    {hasActions && (
      <div class="flex items-center gap-2 flex-shrink-0">
        <slot name="actions" />
      </div>
    )}
  </div>

  <!-- Page Content -->
  <div class="space-y-6">
    <slot />
  </div>
</div>
