---
import Layout from '../../layouts/Layout.astro';
import { DatabaseService } from '../../lib/db';
import { getSport } from '../../lib/sports';

interface Props {
  title: string;
  club: {
    id: string;
    name: string;
    slug: string;
    county: string;
    crest_url: string | null;
    primary_color: string;
    secondary_color: string;
    accent_color: string;
    club_type: string;
  };
  user: {
    name: string;
  };
  member: {
    role: string;
  };
  currentPage?: string;
}

const { title, club, user, member, currentPage = 'dashboard' } = Astro.props;
const slug = club.slug;
const sport = getSport(club.club_type || 'gaa');

function hexToRgb(hex: string): { r: number; g: number; b: number } | null {
  if (!hex) return null;
  let clean = hex.replace('#', '');
  if (clean.length === 3) {
    clean = clean.split('').map((c) => c + c).join('');
  }
  if (clean.length !== 6) return null;
  const num = Number.parseInt(clean, 16);
  if (Number.isNaN(num)) return null;
  return {
    r: (num >> 16) & 255,
    g: (num >> 8) & 255,
    b: num & 255,
  };
}

function rgbToHex(r: number, g: number, b: number): string {
  const toHex = (value: number) => value.toString(16).padStart(2, '0');
  return `#${toHex(r)}${toHex(g)}${toHex(b)}`;
}

function mixHex(base: string, mix: string, weight = 0.15): string {
  const baseRgb = hexToRgb(base);
  const mixRgb = hexToRgb(mix);
  if (!baseRgb || !mixRgb) return base;
  const blend = (a: number, b: number) => Math.round(a + (b - a) * weight);
  return rgbToHex(
    blend(baseRgb.r, mixRgb.r),
    blend(baseRgb.g, mixRgb.g),
    blend(baseRgb.b, mixRgb.b)
  );
}

const accentColor = sport?.primaryColor || club.accent_color || club.primary_color || '#0d9488';
const accentRgb = hexToRgb(accentColor);
const accentSoft = accentRgb ? `rgba(${accentRgb.r}, ${accentRgb.g}, ${accentRgb.b}, 0.12)` : 'rgba(13, 148, 136, 0.12)';
const accentStrong = accentRgb ? `rgba(${accentRgb.r}, ${accentRgb.g}, ${accentRgb.b}, 0.2)` : 'rgba(13, 148, 136, 0.2)';
const accentBorder = accentRgb ? `rgba(${accentRgb.r}, ${accentRgb.g}, ${accentRgb.b}, 0.3)` : 'rgba(13, 148, 136, 0.3)';
const accentRing = accentRgb ? `rgba(${accentRgb.r}, ${accentRgb.g}, ${accentRgb.b}, 0.25)` : 'rgba(13, 148, 136, 0.25)';
const accentHover = mixHex(accentColor, '#000000', 0.16);

// Check for impersonation
let isImpersonating = false;
let impersonationData: { clubName?: string; superAdminEmail?: string } | null = null;

const impersonationCookie = Astro.cookies.get('clubify_impersonate')?.value;
if (impersonationCookie) {
  try {
    const parsed = JSON.parse(impersonationCookie);
    if (parsed.clubId === club.id) {
      isImpersonating = true;
      impersonationData = {
        clubName: parsed.clubName,
        superAdminEmail: parsed.superAdminEmail,
      };
    }
  } catch {
    // Invalid cookie, ignore
  }
}

// Get module configuration
const db = new DatabaseService(Astro.locals.runtime.env.DB);
const moduleConfig = await db.getModuleConfig(club.id);

const coreNavItems = [
  { id: 'dashboard', label: 'Dashboard', href: `/${slug}/admin-portal`, icon: 'home', module: null },
  { id: 'website', label: 'Website', href: `/${slug}/admin-portal/website`, icon: 'layout', module: null },
  { id: 'posts', label: 'Posts', href: `/${slug}/admin-portal/posts`, icon: 'posts', module: 'posts' },
  { id: 'pages', label: 'Pages', href: `/${slug}/admin-portal/pages`, icon: 'pages', module: null },
  { id: 'fixtures', label: 'Fixtures', href: `/${slug}/admin-portal/fixtures`, icon: 'calendar', module: 'fixtures' },
  { id: 'media', label: 'Gallery', href: `/${slug}/admin-portal/media`, icon: 'media', module: 'media' },
  { id: 'sponsors', label: 'Sponsors', href: `/${slug}/admin-portal/sponsors`, icon: 'badge', module: 'sponsors' },
  { id: 'forms', label: 'Forms', href: `/${slug}/admin-portal/forms`, icon: 'form', module: 'forms' },
  { id: 'inbox', label: 'Inbox', href: `/${slug}/admin-portal/inbox`, icon: 'inbox', module: 'inbox' },
];

const adminNavItems = [
  { id: 'team', label: 'Team & Roles', href: `/${slug}/admin-portal/team`, icon: 'users', module: null },
  { id: 'settings', label: 'Settings', href: `/${slug}/admin-portal/settings`, icon: 'settings', module: null },
  { id: 'audit', label: 'Audit Log', href: `/${slug}/admin-portal/audit`, icon: 'audit', module: null },
];

const moduleNavItems = [
  { id: 'membership', label: 'Membership', href: '#', icon: 'membership', module: null, badge: 'Soon', disabled: true },
  { id: 'fundraising', label: 'Fundraising', href: '#', icon: 'fundraising', module: null, badge: 'Soon', disabled: true },
  { id: 'payments', label: 'Payments', href: '#', icon: 'payments', module: null, badge: 'Soon', disabled: true },
  { id: 'policy', label: 'Policy & GDPR', href: '#', icon: 'shield', module: null, badge: 'Soon', disabled: true },
  { id: 'ticketing', label: 'Ticketing', href: '#', icon: 'ticket', module: null, badge: 'Soon', disabled: true },
  { id: 'merch', label: 'Merch', href: '#', icon: 'bag', module: null, badge: 'Soon', disabled: true },
];

const filterByModule = (item: { module: string | null }) => {
  if (!item.module) return true;
  return moduleConfig[item.module] !== false;
};

const navSections = [
  { id: 'core', label: 'Core', items: coreNavItems.filter(filterByModule) },
  { id: 'admin', label: 'Admin', items: adminNavItems },
  { id: 'modules', label: 'Modules', items: moduleNavItems },
];

const icons: Record<string, string> = {
  home: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>',
  posts: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>',
  pages: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>',
  calendar: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>',
  media: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>',
  layout: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"/>',
  badge: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l.7 2.154a1 1 0 00.95.69h2.264c.969 0 1.371 1.24.588 1.81l-1.833 1.332a1 1 0 00-.364 1.118l.7 2.154c.3.922-.755 1.688-1.538 1.118l-1.833-1.332a1 1 0 00-1.176 0l-1.833 1.332c-.783.57-1.838-.196-1.539-1.118l.7-2.154a1 1 0 00-.363-1.118L6.497 7.58c-.783-.57-.38-1.81.588-1.81h2.264a1 1 0 00.95-.69l.7-2.154z"/>',
  form: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h10M7 16h6M5 4h14a1 1 0 011 1v14a1 1 0 01-1 1H5a1 1 0 01-1-1V5a1 1 0 011-1z"/>',
  inbox: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V7a2 2 0 00-2-2H6a2 2 0 00-2 2v6m16 0l-3 5H7l-3-5m16 0H4"/>',
  users: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>',
  settings: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>',
  audit: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 3v4h4"/>',
  membership: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14a2 2 0 012 2v7a2 2 0 01-2 2H5a2 2 0 01-2-2v-7a2 2 0 012-2z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 8V6a4 4 0 118 0v2"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 15h8"/>',
  fundraising: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V6m0 2v8m0 0v2m0-2c-1.11 0-2.08-.402-2.599-1"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12a8 8 0 11-16 0 8 8 0 0116 0z"/>',
  payments: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h2m4 0h4m-9 4h12a2 2 0 002-2V8a2 2 0 00-2-2H6a2 2 0 00-2 2v9a2 2 0 002 2z"/>',
  shield: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3l7 4v5c0 5-3.5 8-7 9-3.5-1-7-4-7-9V7l7-4z"/>',
  ticket: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 9a2 2 0 012-2h12a2 2 0 012 2v2a2 2 0 00-2 2 2 2 0 002 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2a2 2 0 002-2 2 2 0 00-2-2V9z"/>',
  bag: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14l-1 11a2 2 0 01-2 2H8a2 2 0 01-2-2L5 8z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 8V6a3 3 0 016 0v2"/>',
};
---

<Layout title={title}>
  {isImpersonating && impersonationData && (
    <div class="fixed top-0 left-0 right-0 z-[100] bg-white/90 backdrop-blur border-b border-slate-200 shadow-sm">
      <div class="max-w-7xl mx-auto px-4 py-2.5 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl flex items-center justify-center" style={`background: ${accentSoft}`}>
            <svg class="w-5 h-5" fill="none" stroke={accentColor} viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
            </svg>
          </div>
          <span class="text-sm font-medium text-slate-700">
            Viewing as <strong class="text-slate-900">{impersonationData.clubName}</strong>
            <span class="text-slate-500 ml-2 hidden sm:inline">(Super Admin: {impersonationData.superAdminEmail})</span>
          </span>
        </div>
        <button
          id="exit-impersonation-btn"
          class="admin-btn-secondary text-xs"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
          </svg>
          <span class="hidden sm:inline">Exit</span>
        </button>
      </div>
    </div>
  )}
  <div
    class:list={["admin-shell", isImpersonating && "pt-12"]}
    style={`--admin-accent: ${accentColor}; --admin-accent-hover: ${accentHover}; --admin-accent-soft: ${accentSoft}; --admin-accent-strong: ${accentStrong}; --admin-accent-border: ${accentBorder}; --admin-ring: ${accentRing}; --admin-brand-primary: ${club.primary_color}; --admin-brand-secondary: ${club.secondary_color}; --admin-brand-accent: ${club.accent_color};`}
    data-sport={sport?.id}
  >
    <div class="relative flex min-h-screen">
      <!-- Sidebar -->
      <aside class="admin-sidebar fixed inset-y-0 left-0 w-72 hidden lg:flex flex-col z-40">
      <!-- Logo -->
      <div class="px-6 py-5 border-b border-slate-200/70">
        <a href="/" class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-2xl flex items-center justify-center text-white shadow-lg" style={`background: linear-gradient(135deg, ${accentColor}, ${accentHover})`}>
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z" fill="currentColor" opacity="0.3"/>
              <circle cx="12" cy="12" r="2" fill="currentColor"/>
            </svg>
          </div>
          <div>
            <p class="text-[0.65rem] uppercase tracking-[0.3em] text-slate-500">Clubify Hub</p>
            <span class="text-lg font-semibold text-slate-900 admin-display">Clubify</span>
          </div>
        </a>
      </div>

      <!-- Club info -->
      <div class="px-6 py-4 border-b border-slate-200/70">
        <div class="admin-panel-soft p-3">
          <div class="flex items-center gap-3">
            {club.crest_url ? (
              <img src={club.crest_url} alt={club.name} class="w-11 h-11 rounded-xl object-contain bg-white shadow-sm border border-slate-200"/>
            ) : (
              <div class="w-11 h-11 rounded-xl flex items-center justify-center text-white font-bold shadow-sm" style={`background-color: ${club.primary_color}`}>
                {club.name.charAt(0)}
              </div>
            )}
            <div class="flex-1 min-w-0">
              <p class="text-slate-900 font-semibold truncate text-sm">{club.name}</p>
              <p class="text-slate-500 text-xs">{club.county}</p>
            </div>
          </div>
          <div class="mt-3 flex items-center justify-between">
            <span class="admin-accent-pill">{sport.name}</span>
            <span class="text-[0.7rem] text-slate-500">{slug}.clubify.ie</span>
          </div>
        </div>
      </div>

      <!-- Navigation -->
      <nav class="flex-1 px-4 py-5 space-y-6 overflow-y-auto">
        {navSections.map((section) => (
          <div>
            <p class="px-3 text-[0.62rem] font-semibold uppercase tracking-[0.28em] text-slate-500">{section.label}</p>
            <div class="mt-2 space-y-1">
              {section.items.map((item) => (
                <a
                  href={item.href}
                  aria-disabled={item.disabled ? 'true' : undefined}
                  tabindex={item.disabled ? -1 : undefined}
                  class:list={[
                    'admin-nav-item',
                    currentPage === item.id && 'is-active',
                    item.disabled && 'is-disabled'
                  ]}
                >
                  <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={icons[item.icon]} />
                  <span>{item.label}</span>
                  {item.badge && <span class="admin-nav-badge">{item.badge}</span>}
                </a>
              ))}
            </div>
          </div>
        ))}
      </nav>

      <!-- User menu -->
      <div class="px-5 pb-5 pt-4 border-t border-slate-200/70">
        <div class="admin-panel-soft p-3 flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-slate-900 flex items-center justify-center text-white font-semibold shadow-sm text-sm">
            {user.name.charAt(0).toUpperCase()}
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-slate-900 text-sm font-medium truncate">{user.name}</p>
            <p class="text-slate-500 text-xs truncate capitalize">{member.role}</p>
          </div>
          <button id="logout-btn" class="p-2 text-slate-400 hover:text-red-500 transition-colors rounded-lg hover:bg-red-50" title="Sign out">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
            </svg>
          </button>
        </div>
      </div>
    </aside>

    <!-- Mobile sidebar overlay -->
    <div id="mobile-overlay" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-40 hidden lg:hidden"></div>

    <!-- Mobile sidebar -->
    <aside id="mobile-sidebar" class="admin-sidebar fixed inset-y-0 left-0 w-80 z-50 transform -translate-x-full transition-transform lg:hidden shadow-2xl">
      <div class="flex flex-col h-full">
        <div class="px-6 py-4 border-b border-slate-200/70 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-11 h-11 rounded-2xl flex items-center justify-center text-white shadow-lg" style={`background: linear-gradient(135deg, ${accentColor}, ${accentHover})`}>
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z" fill="currentColor" opacity="0.3"/>
                <circle cx="12" cy="12" r="2" fill="currentColor"/>
              </svg>
            </div>
            <div>
              <p class="text-[0.65rem] uppercase tracking-[0.3em] text-slate-400">Clubify Hub</p>
              <span class="text-lg font-semibold text-slate-900 admin-display">Clubify</span>
            </div>
          </div>
          <button id="close-mobile-menu" class="p-2 text-slate-500 hover:text-slate-900 rounded-lg hover:bg-slate-100">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>

        <!-- Mobile Club Info -->
        <div class="px-6 py-4 border-b border-slate-200/70">
          <div class="admin-panel-soft p-3">
            <div class="flex items-center gap-3">
              {club.crest_url ? (
                <img src={club.crest_url} alt={club.name} class="w-11 h-11 rounded-xl object-contain bg-white shadow-sm border border-slate-200"/>
              ) : (
                <div class="w-11 h-11 rounded-xl flex items-center justify-center text-white font-bold shadow-sm" style={`background-color: ${club.primary_color}`}>
                  {club.name.charAt(0)}
                </div>
              )}
              <div class="flex-1 min-w-0">
                <p class="text-slate-900 font-semibold truncate text-sm">{club.name}</p>
                <p class="text-slate-500 text-xs">{club.county}</p>
              </div>
            </div>
            <div class="mt-3 flex items-center justify-between">
              <span class="admin-accent-pill">{sport.name}</span>
              <span class="text-[0.7rem] text-slate-400">{slug}.clubify.ie</span>
            </div>
          </div>
        </div>

        <nav class="flex-1 px-4 py-5 space-y-6 overflow-y-auto">
          {navSections.map((section) => (
            <div>
              <p class="px-3 text-[0.62rem] font-semibold uppercase tracking-[0.28em] text-slate-400">{section.label}</p>
              <div class="mt-2 space-y-1">
                {section.items.map((item) => (
                  <a
                    href={item.href}
                    aria-disabled={item.disabled ? 'true' : undefined}
                    tabindex={item.disabled ? -1 : undefined}
                    class:list={[
                      'admin-nav-item',
                      currentPage === item.id && 'is-active',
                      item.disabled && 'is-disabled'
                    ]}
                  >
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={icons[item.icon]} />
                    <span>{item.label}</span>
                    {item.badge && <span class="admin-nav-badge">{item.badge}</span>}
                  </a>
                ))}
              </div>
            </div>
          ))}
        </nav>

        <!-- Mobile User -->
        <div class="px-5 pb-5 pt-4 border-t border-slate-200/70">
          <div class="admin-panel-soft p-3 flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-slate-900 flex items-center justify-center text-white font-semibold text-sm">
              {user.name.charAt(0).toUpperCase()}
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-slate-900 text-sm font-medium truncate">{user.name}</p>
              <p class="text-slate-500 text-xs truncate capitalize">{member.role}</p>
            </div>
          </div>
        </div>
      </div>
    </aside>

    <!-- Main content -->
    <main class="lg:ml-72 flex-1">
      <!-- Header -->
      <header class="admin-topbar sticky top-0 z-30">
        <div class="flex items-center justify-between px-6 py-4">
          <div class="flex items-center gap-4">
            <button id="mobile-menu-btn" class="lg:hidden p-2 text-slate-500 hover:text-slate-900 rounded-lg hover:bg-slate-100 transition-colors">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
              </svg>
            </button>
            <slot name="header-left">
              <div>
                <p class="text-[0.65rem] uppercase tracking-[0.28em] text-slate-400">Club Dashboard</p>
                <h1 class="text-xl sm:text-2xl font-semibold text-slate-900 admin-display">{title}</h1>
              </div>
            </slot>
          </div>

          <div class="flex items-center gap-3">
            <a
              href={`/${slug}`}
              target="_blank"
              class="admin-btn-secondary text-sm"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
              <span class="hidden sm:inline">View site</span>
            </a>
            <slot name="header-actions" />
          </div>
        </div>
      </header>

      <!-- Page content -->
      <div class="px-6 pb-10 pt-6">
        <slot />
      </div>
    </main>
  </div>
  </div>
</Layout>

<script>
  // Logout
  document.getElementById('logout-btn')?.addEventListener('click', async () => {
    await fetch('/api/auth/logout', { method: 'POST' });
    window.location.href = '/admin';
  });

  // Mobile menu
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileSidebar = document.getElementById('mobile-sidebar');
  const mobileOverlay = document.getElementById('mobile-overlay');
  const closeMobileMenu = document.getElementById('close-mobile-menu');

  function openMobileMenu() {
    mobileSidebar?.classList.remove('-translate-x-full');
    mobileOverlay?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeMobileMenuFn() {
    mobileSidebar?.classList.add('-translate-x-full');
    mobileOverlay?.classList.add('hidden');
    document.body.style.overflow = '';
  }

  mobileMenuBtn?.addEventListener('click', openMobileMenu);
  closeMobileMenu?.addEventListener('click', closeMobileMenuFn);
  mobileOverlay?.addEventListener('click', closeMobileMenuFn);

  // Exit impersonation
  document.getElementById('exit-impersonation-btn')?.addEventListener('click', async () => {
    const btn = document.getElementById('exit-impersonation-btn') as HTMLButtonElement;
    if (btn) {
      btn.disabled = true;
      btn.innerHTML = '<span class="animate-pulse">Exiting...</span>';
    }

    try {
      const response = await fetch('/api/super-admin/impersonate', { method: 'DELETE' });
      const result = await response.json();

      if (response.ok && result.redirectUrl) {
        window.location.href = result.redirectUrl;
      } else {
        throw new Error(result.error || 'Failed to exit impersonation');
      }
    } catch (error: any) {
      alert(error.message || 'Failed to exit impersonation');
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg><span class="hidden sm:inline">Exit</span>`;
      }
    }
  });
</script>
