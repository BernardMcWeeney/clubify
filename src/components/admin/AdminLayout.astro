---
import Layout from '../../layouts/Layout.astro';

interface Props {
  title: string;
  club: {
    id: string;
    name: string;
    slug: string;
    county: string;
    crest_url: string | null;
    primary_color: string;
  };
  user: {
    name: string;
  };
  member: {
    role: string;
  };
  currentPage?: string;
}

const { title, club, user, member, currentPage = 'dashboard' } = Astro.props;
const slug = club.slug;

const navItems = [
  { id: 'dashboard', label: 'Dashboard', href: `/${slug}/admin-portal`, icon: 'home' },
  { id: 'posts', label: 'Posts', href: `/${slug}/admin-portal/posts`, icon: 'posts' },
  { id: 'pages', label: 'Pages', href: `/${slug}/admin-portal/pages`, icon: 'pages' },
  { id: 'fixtures', label: 'Fixtures', href: `/${slug}/admin-portal/fixtures`, icon: 'calendar' },
  { id: 'media', label: 'Media', href: `/${slug}/admin-portal/media`, icon: 'media' },
  { id: 'homepage', label: 'Homepage', href: `/${slug}/admin-portal/homepage`, icon: 'layout' },
  { id: 'team', label: 'Team', href: `/${slug}/admin-portal/team`, icon: 'users' },
  { id: 'settings', label: 'Settings', href: `/${slug}/admin-portal/settings`, icon: 'settings' },
];

const icons: Record<string, string> = {
  home: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>',
  posts: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>',
  pages: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>',
  calendar: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>',
  media: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>',
  layout: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"/>',
  users: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>',
  settings: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>',
};
---

<Layout title={title}>
  <div class="min-h-screen bg-slate-50">
    <!-- Sidebar -->
    <aside class="fixed inset-y-0 left-0 w-64 bg-white border-r border-slate-200 hidden lg:block z-50 shadow-sm">
      <div class="flex flex-col h-full">
        <!-- Logo -->
        <div class="p-4 border-b border-slate-200">
          <a href="/" class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-green-500 to-green-600 flex items-center justify-center shadow-lg shadow-green-500/25">
              <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="none">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z" fill="currentColor" opacity="0.3"/>
                <circle cx="12" cy="12" r="2" fill="currentColor"/>
              </svg>
            </div>
            <span class="text-lg font-bold text-slate-900">Clubify</span>
          </a>
        </div>

        <!-- Club info -->
        <div class="p-4 border-b border-slate-200 bg-slate-50/50">
          <div class="flex items-center gap-3">
            {club.crest_url ? (
              <img src={club.crest_url} alt={club.name} class="w-10 h-10 rounded-lg object-contain bg-white shadow-sm"/>
            ) : (
              <div class="w-10 h-10 rounded-lg flex items-center justify-center text-white font-bold shadow-sm" style={`background-color: ${club.primary_color}`}>
                {club.name.charAt(0)}
              </div>
            )}
            <div class="flex-1 min-w-0">
              <p class="text-slate-900 font-medium truncate">{club.name}</p>
              <p class="text-slate-500 text-xs">{club.county}</p>
            </div>
          </div>
        </div>

        <!-- Navigation -->
        <nav class="flex-1 p-4 space-y-1 overflow-y-auto">
          {navItems.map((item) => (
            <a
              href={item.href}
              class={`flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all ${
                currentPage === item.id
                  ? 'bg-green-500 text-white shadow-md shadow-green-500/25'
                  : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900'
              }`}
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={icons[item.icon]} />
              <span class="font-medium">{item.label}</span>
            </a>
          ))}
        </nav>

        <!-- User menu -->
        <div class="p-4 border-t border-slate-200 bg-slate-50/50">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-slate-700 to-slate-800 flex items-center justify-center text-white font-medium shadow-sm">
              {user.name.charAt(0).toUpperCase()}
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-slate-900 text-sm font-medium truncate">{user.name}</p>
              <p class="text-slate-500 text-xs truncate capitalize">{member.role}</p>
            </div>
            <button id="logout-btn" class="p-2 text-slate-400 hover:text-red-500 transition-colors rounded-lg hover:bg-red-50" title="Sign out">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </aside>

    <!-- Mobile sidebar overlay -->
    <div id="mobile-overlay" class="fixed inset-0 bg-black/30 backdrop-blur-sm z-40 hidden lg:hidden"></div>

    <!-- Mobile sidebar -->
    <aside id="mobile-sidebar" class="fixed inset-y-0 left-0 w-64 bg-white border-r border-slate-200 z-50 transform -translate-x-full transition-transform lg:hidden shadow-xl">
      <div class="flex flex-col h-full">
        <div class="p-4 border-b border-slate-200 flex items-center justify-between">
          <span class="text-lg font-bold text-slate-900">Menu</span>
          <button id="close-mobile-menu" class="p-2 text-slate-500 hover:text-slate-900 rounded-lg hover:bg-slate-100">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>
        <nav class="flex-1 p-4 space-y-1 overflow-y-auto">
          {navItems.map((item) => (
            <a
              href={item.href}
              class={`flex items-center gap-3 px-3 py-2.5 rounded-xl transition-all ${
                currentPage === item.id
                  ? 'bg-green-500 text-white shadow-md shadow-green-500/25'
                  : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900'
              }`}
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={icons[item.icon]} />
              <span class="font-medium">{item.label}</span>
            </a>
          ))}
        </nav>
      </div>
    </aside>

    <!-- Main content -->
    <main class="lg:ml-64">
      <!-- Header -->
      <header class="sticky top-0 z-30 bg-white/80 backdrop-blur-xl border-b border-slate-200 shadow-sm">
        <div class="flex items-center justify-between px-6 py-4">
          <div class="flex items-center gap-4">
            <button id="mobile-menu-btn" class="lg:hidden p-2 text-slate-500 hover:text-slate-900 rounded-lg hover:bg-slate-100">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
              </svg>
            </button>
            <slot name="header-left">
              <h1 class="text-xl font-bold text-slate-900">{title}</h1>
            </slot>
          </div>

          <div class="flex items-center gap-3">
            <a href={`/${slug}`} target="_blank" class="flex items-center gap-2 px-4 py-2 border border-slate-300 text-slate-600 rounded-xl hover:bg-slate-100 hover:border-slate-400 transition-all text-sm font-medium">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
              View site
            </a>
            <slot name="header-actions" />
          </div>
        </div>
      </header>

      <!-- Page content -->
      <div class="p-6">
        <slot />
      </div>
    </main>
  </div>
</Layout>

<script>
  // Logout
  document.getElementById('logout-btn')?.addEventListener('click', async () => {
    await fetch('/api/auth/logout', { method: 'POST' });
    window.location.href = '/admin';
  });

  // Mobile menu
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileSidebar = document.getElementById('mobile-sidebar');
  const mobileOverlay = document.getElementById('mobile-overlay');
  const closeMobileMenu = document.getElementById('close-mobile-menu');

  function openMobileMenu() {
    mobileSidebar?.classList.remove('-translate-x-full');
    mobileOverlay?.classList.remove('hidden');
  }

  function closeMobileMenuFn() {
    mobileSidebar?.classList.add('-translate-x-full');
    mobileOverlay?.classList.add('hidden');
  }

  mobileMenuBtn?.addEventListener('click', openMobileMenu);
  closeMobileMenu?.addEventListener('click', closeMobileMenuFn);
  mobileOverlay?.addEventListener('click', closeMobileMenuFn);
</script>

<style>
  @import "../../styles/global.css";
</style>
