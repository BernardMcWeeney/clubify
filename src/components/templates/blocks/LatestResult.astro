---
interface Fixture {
  id: string;
  competition: string;
  home_team: string;
  away_team: string;
  venue?: string | null;
  match_date: string;
  home_score: number;
  away_score: number;
  status: string;
}

interface Props {
  fixture?: Fixture | null;
  clubName: string;
  primaryColor: string;
}

const { fixture, clubName, primaryColor } = Astro.props;

function formatDate(dateStr: string): string {
  const date = new Date(dateStr);
  return date.toLocaleDateString('en-IE', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  });
}

function getResultLabel(fixture: Fixture, clubName: string): { text: string; color: string } {
  const isHome = fixture.home_team.toLowerCase().includes(clubName.toLowerCase());
  const clubScore = isHome ? fixture.home_score : fixture.away_score;
  const opponentScore = isHome ? fixture.away_score : fixture.home_score;

  if (clubScore > opponentScore) {
    return { text: 'WIN', color: '#22c55e' };
  } else if (clubScore < opponentScore) {
    return { text: 'LOSS', color: '#ef4444' };
  }
  return { text: 'DRAW', color: '#f59e0b' };
}
---

<section class="py-20 bg-slate-50">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl font-bold text-slate-900 mb-10 text-center">Latest Result</h2>

    {fixture ? (
      <div class="max-w-2xl mx-auto bg-white rounded-3xl p-10 border border-slate-200 shadow-xl shadow-slate-200/50">
        <div class="text-center mb-6">
          <span
            class="inline-block px-4 py-1.5 text-sm font-semibold rounded-full text-white shadow-lg"
            style={`background-color: ${primaryColor}; box-shadow: 0 4px 14px ${primaryColor}40`}
          >
            {fixture.competition}
          </span>
          <span class="ml-3 text-sm text-slate-500">{formatDate(fixture.match_date)}</span>
        </div>

        <div class="flex items-center justify-center gap-6 mb-6">
          <div class="text-center flex-1">
            <p class="text-xl font-bold text-slate-900">{fixture.home_team}</p>
          </div>
          <div class="text-center bg-slate-100 rounded-2xl px-6 py-4">
            <div class="text-4xl font-bold text-slate-900">
              {fixture.home_score} - {fixture.away_score}
            </div>
          </div>
          <div class="text-center flex-1">
            <p class="text-xl font-bold text-slate-900">{fixture.away_team}</p>
          </div>
        </div>

        <div class="text-center">
          {(() => {
            const result = getResultLabel(fixture, clubName);
            return (
              <span
                class="inline-block px-5 py-2 text-sm font-bold rounded-full"
                style={`background-color: ${result.color}15; color: ${result.color}`}
              >
                {result.text}
              </span>
            );
          })()}
        </div>
      </div>
    ) : (
      <div class="max-w-2xl mx-auto bg-white rounded-3xl p-10 border border-slate-200 text-center">
        <div class="w-16 h-16 bg-slate-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <p class="text-slate-700 font-medium mb-2">No recent results</p>
        <p class="text-slate-500 text-sm">Check back after our next match</p>
      </div>
    )}
  </div>
</section>
