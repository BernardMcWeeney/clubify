---
interface Sponsor {
  id: string;
  name: string;
  logo_url?: string | null;
  website_url?: string | null;
  tier?: 'main' | 'gold' | 'silver' | 'bronze';
}

interface Props {
  sponsors?: Sponsor[];
  primaryColor: string;
}

const { sponsors = [], primaryColor } = Astro.props;
---

<section class="py-16 bg-white border-t border-slate-100">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    {sponsors.length > 0 ? (
      <>
        <h3 class="text-sm font-semibold text-slate-400 text-center mb-10 uppercase tracking-wider">
          Our Sponsors
        </h3>
        <div class="flex flex-wrap items-center justify-center gap-10 md:gap-14">
          {sponsors.map((sponsor) => (
            sponsor.website_url ? (
              <a
                href={sponsor.website_url}
                target="_blank"
                rel="noopener noreferrer"
                class="group"
                title={sponsor.name}
              >
                {sponsor.logo_url ? (
                  <img
                    src={sponsor.logo_url}
                    alt={sponsor.name}
                    class="h-14 w-auto object-contain grayscale opacity-50 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-300"
                  />
                ) : (
                  <div
                    class="px-5 py-2.5 rounded-xl text-slate-500 bg-slate-50 group-hover:bg-slate-100 group-hover:text-slate-700 transition-colors font-medium"
                  >
                    {sponsor.name}
                  </div>
                )}
              </a>
            ) : (
              <div title={sponsor.name}>
                {sponsor.logo_url ? (
                  <img
                    src={sponsor.logo_url}
                    alt={sponsor.name}
                    class="h-14 w-auto object-contain grayscale opacity-50"
                  />
                ) : (
                  <div class="px-5 py-2.5 rounded-xl text-slate-500 bg-slate-50 font-medium">
                    {sponsor.name}
                  </div>
                )}
              </div>
            )
          ))}
        </div>
      </>
    ) : (
      <div class="text-center py-6">
        <p class="text-slate-500 text-sm">Interested in sponsoring? Contact us!</p>
      </div>
    )}
  </div>
</section>
