---
interface Props {
  club: {
    name: string;
    county: string;
    tagline?: string | null;
    crest_url?: string | null;
    primary_color: string;
    secondary_color?: string;
  };
  slug: string;
  template?: 'classic' | 'matchday' | 'community';
  settings?: {
    showCrest?: boolean;
    ctaStyle?: 'buttons' | 'single' | 'none';
    overlay?: 'gradient' | 'mesh' | 'glass';
    height?: 'full' | 'large' | 'medium';
  };
}

const { club, slug, template = 'classic', settings = {} } = Astro.props;
const {
  showCrest = true,
  ctaStyle = 'buttons',
  overlay = 'gradient',
  height = 'large'
} = settings;

// Helper function to adjust color brightness
function adjustColor(color: string, amount: number): string {
  const hex = color.replace('#', '');
  const r = Math.max(0, Math.min(255, parseInt(hex.slice(0, 2), 16) + amount));
  const g = Math.max(0, Math.min(255, parseInt(hex.slice(2, 4), 16) + amount));
  const b = Math.max(0, Math.min(255, parseInt(hex.slice(4, 6), 16) + amount));
  return `#${r.toString(16).padStart(2, '0')}${g.toString(16).padStart(2, '0')}${b.toString(16).padStart(2, '0')}`;
}

// Convert hex to RGB for CSS variables
function hexToRgb(hex: string): string {
  const h = hex.replace('#', '');
  const r = parseInt(h.slice(0, 2), 16);
  const g = parseInt(h.slice(2, 4), 16);
  const b = parseInt(h.slice(4, 6), 16);
  return `${r}, ${g}, ${b}`;
}

// Height classes based on setting
const heightClasses = {
  full: 'min-h-screen',
  large: 'min-h-[85vh]',
  medium: 'min-h-[60vh]',
};

// Template-specific accent colors
const templateAccents = {
  classic: { accent: '#fbbf24', glow: 'rgba(251, 191, 36, 0.3)' },
  matchday: { accent: '#ef4444', glow: 'rgba(239, 68, 68, 0.3)' },
  community: { accent: '#14b8a6', glow: 'rgba(20, 184, 166, 0.3)' },
};

const accent = templateAccents[template];
const primaryRgb = hexToRgb(club.primary_color);
---

<section
  class={`relative ${heightClasses[height]} flex items-center justify-center overflow-hidden`}
  style={`--primary-rgb: ${primaryRgb}; --accent-color: ${accent.accent};`}
>
  <!-- Animated gradient background -->
  <div class="absolute inset-0 hero-gradient" style={`
    background: linear-gradient(
      135deg,
      ${club.primary_color} 0%,
      ${adjustColor(club.primary_color, -40)} 50%,
      ${adjustColor(club.primary_color, -60)} 100%
    );
  `}></div>

  <!-- Mesh gradient overlay for depth -->
  <div class="absolute inset-0 hero-mesh" style={`
    background-image:
      radial-gradient(at 20% 30%, rgba(255,255,255,0.15) 0%, transparent 50%),
      radial-gradient(at 80% 70%, ${accent.glow} 0%, transparent 40%),
      radial-gradient(at 50% 50%, rgba(255,255,255,0.05) 0%, transparent 60%);
  `}></div>

  <!-- Subtle pattern overlay -->
  <div class="absolute inset-0 opacity-[0.03]" style="background-image: url('data:image/svg+xml,%3Csvg width=&quot;60&quot; height=&quot;60&quot; viewBox=&quot;0 0 60 60&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot;%3E%3Cg fill=&quot;none&quot; fill-rule=&quot;evenodd&quot;%3E%3Cg fill=&quot;%23ffffff&quot; fill-opacity=&quot;1&quot;%3E%3Cpath d=&quot;M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z&quot;/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>

  <!-- Glass overlay panel (optional) -->
  {overlay === 'glass' && (
    <div class="absolute inset-x-0 top-1/2 -translate-y-1/2 h-[70%] mx-8 rounded-3xl backdrop-blur-sm bg-white/5 border border-white/10"></div>
  )}

  <!-- Content -->
  <div class="relative z-10 mx-auto max-w-5xl px-6 sm:px-8 lg:px-12 py-24 text-center hero-content">
    <!-- Crest with glow effect -->
    {showCrest && club.crest_url && (
      <div class="hero-crest mb-10">
        <div class="relative inline-block">
          <div class="absolute inset-0 blur-2xl opacity-50 scale-110" style={`background: radial-gradient(circle, ${accent.glow}, transparent 70%);`}></div>
          <img
            src={club.crest_url}
            alt={club.name}
            class="relative w-28 h-28 sm:w-36 sm:h-36 mx-auto object-contain drop-shadow-2xl"
            loading="eager"
          />
        </div>
      </div>
    )}

    <!-- Club name with gradient text effect -->
    <h1 class="hero-title text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-extrabold tracking-tight mb-6">
      <span class="text-white drop-shadow-lg" style="text-shadow: 0 4px 20px rgba(0,0,0,0.3);">
        {club.name}
      </span>
    </h1>

    <!-- County badge -->
    <div class="hero-subtitle flex items-center justify-center gap-3 mb-4">
      <span class="inline-flex items-center px-4 py-1.5 rounded-full text-sm font-semibold bg-white/15 text-white/95 backdrop-blur-sm border border-white/20">
        {club.county} GAA
      </span>
    </div>

    <!-- Tagline -->
    {club.tagline && (
      <p class="hero-tagline text-lg sm:text-xl text-white/75 max-w-2xl mx-auto mb-10 font-light leading-relaxed">
        {club.tagline}
      </p>
    )}

    <!-- CTA Buttons -->
    {ctaStyle === 'buttons' && (
      <div class="hero-cta flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-5">
        <a
          href={`/${slug}/fixtures`}
          class="group relative px-8 py-4 bg-white text-slate-900 font-bold rounded-2xl transition-all duration-300 shadow-xl shadow-black/20 hover:shadow-2xl hover:shadow-black/30 hover:-translate-y-0.5 overflow-hidden"
        >
          <span class="relative z-10 flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            View Fixtures
          </span>
          <div class="absolute inset-0 bg-gradient-to-r from-slate-100 to-white opacity-0 group-hover:opacity-100 transition-opacity"></div>
        </a>
        <a
          href={`/${slug}/news`}
          class="group px-8 py-4 bg-white/10 backdrop-blur-sm text-white font-bold rounded-2xl transition-all duration-300 border border-white/25 hover:bg-white/20 hover:border-white/40 hover:-translate-y-0.5"
        >
          <span class="flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
            </svg>
            Latest News
          </span>
        </a>
      </div>
    )}

    {ctaStyle === 'single' && (
      <div class="hero-cta">
        <a
          href={`/${slug}/fixtures`}
          class="inline-flex items-center gap-2 px-10 py-4 bg-white text-slate-900 font-bold rounded-2xl transition-all duration-300 shadow-xl hover:shadow-2xl hover:-translate-y-0.5"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
          </svg>
          Get Started
        </a>
      </div>
    )}
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 text-white/50 animate-bounce">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
    </svg>
  </div>
</section>

<style>
  /* Entrance animations */
  .hero-content {
    animation: heroFadeIn 0.8s ease-out forwards;
  }

  .hero-crest {
    animation: heroSlideDown 0.6s ease-out forwards;
    animation-delay: 0.1s;
    opacity: 0;
  }

  .hero-title {
    animation: heroSlideUp 0.6s ease-out forwards;
    animation-delay: 0.2s;
    opacity: 0;
  }

  .hero-subtitle {
    animation: heroSlideUp 0.6s ease-out forwards;
    animation-delay: 0.3s;
    opacity: 0;
  }

  .hero-tagline {
    animation: heroSlideUp 0.6s ease-out forwards;
    animation-delay: 0.4s;
    opacity: 0;
  }

  .hero-cta {
    animation: heroSlideUp 0.6s ease-out forwards;
    animation-delay: 0.5s;
    opacity: 0;
  }

  @keyframes heroFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes heroSlideUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes heroSlideDown {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Subtle gradient animation */
  .hero-gradient {
    background-size: 200% 200%;
    animation: gradientShift 15s ease infinite;
  }

  @keyframes gradientShift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  /* Mesh animation */
  .hero-mesh {
    animation: meshFloat 20s ease-in-out infinite;
  }

  @keyframes meshFloat {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.8; }
  }
</style>
