---
interface HighlightCard {
  title: string;
  description: string;
  link?: string;
  icon?: 'calendar' | 'users' | 'trophy' | 'heart' | 'info';
}

interface Props {
  cards?: HighlightCard[];
  primaryColor: string;
  slug: string;
}

const { cards, primaryColor, slug } = Astro.props;

// Default cards if none provided
const defaultCards: HighlightCard[] = [
  {
    title: 'Upcoming Events',
    description: 'Check out our calendar for matches, training, and social events.',
    link: `/${slug}/fixtures`,
    icon: 'calendar',
  },
  {
    title: 'Join Our Club',
    description: 'New members always welcome. Get involved with your local GAA club.',
    link: `/${slug}/contact`,
    icon: 'users',
  },
  {
    title: 'Club History',
    description: 'Learn about our proud history and achievements over the years.',
    link: `/${slug}/about`,
    icon: 'trophy',
  },
];

const displayCards = cards && cards.length > 0 ? cards : defaultCards;

const icons = {
  calendar: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>',
  users: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>',
  trophy: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>',
  heart: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>',
  info: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>',
};
---

<section class="py-16 bg-slate-900">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-3 gap-6">
      {displayCards.slice(0, 3).map((card) => (
        card.link ? (
          <a
            href={card.link}
            class="group bg-slate-800/50 rounded-2xl p-6 border border-slate-700/50 hover:border-slate-600 transition-all hover:transform hover:-translate-y-1"
          >
            <div
              class="w-12 h-12 rounded-xl flex items-center justify-center mb-4"
              style={`background-color: ${primaryColor}20`}
            >
              <svg
                class="w-6 h-6"
                style={`color: ${primaryColor}`}
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                set:html={icons[card.icon || 'info']}
              />
            </div>
            <h3 class="text-lg font-semibold text-white mb-2 group-hover:text-slate-200">
              {card.title}
            </h3>
            <p class="text-slate-400 text-sm">{card.description}</p>
          </a>
        ) : (
          <div class="bg-slate-800/50 rounded-2xl p-6 border border-slate-700/50">
            <div
              class="w-12 h-12 rounded-xl flex items-center justify-center mb-4"
              style={`background-color: ${primaryColor}20`}
            >
              <svg
                class="w-6 h-6"
                style={`color: ${primaryColor}`}
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                set:html={icons[card.icon || 'info']}
              />
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">{card.title}</h3>
            <p class="text-slate-400 text-sm">{card.description}</p>
          </div>
        )
      ))}
    </div>
  </div>
</section>
