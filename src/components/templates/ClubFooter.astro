---
interface Props {
  club: {
    name: string;
    crest_url?: string | null;
    primary_color: string;
  };
}

const { club } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-950 border-t border-slate-800 py-8">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        {club.crest_url ? (
          <img src={club.crest_url} alt={club.name} class="w-8 h-8 object-contain" />
        ) : (
          <div
            class="w-8 h-8 rounded flex items-center justify-center text-white font-bold text-sm"
            style={`background-color: ${club.primary_color}`}
          >
            {club.name.charAt(0)}
          </div>
        )}
        <span class="text-slate-400 text-sm">
          &copy; {currentYear} {club.name}. All rights reserved.
        </span>
      </div>

      <div class="flex items-center gap-2 text-slate-500 text-sm">
        <span>Powered by</span>
        <a href="https://clubify.ie" class="text-green-400 hover:text-green-300 font-medium">
          Clubify
        </a>
      </div>
    </div>
  </div>
</footer>
