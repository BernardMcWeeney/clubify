---
interface Props {
  club: {
    name: string;
    crest_url?: string | null;
    primary_color: string;
    contact_email?: string | null;
    contact_phone?: string | null;
    address?: string | null;
  };
  footerLinks?: Array<{ label: string; href: string }>;
  slug?: string;
}

const { club, footerLinks, slug } = Astro.props;
const currentYear = new Date().getFullYear();

const defaultLinks = slug
  ? [
      { label: 'News', href: `/${slug}/news` },
      { label: 'Fixtures', href: `/${slug}/fixtures` },
      { label: 'Contact', href: `/${slug}/contact` },
    ]
  : [];

const links = footerLinks && footerLinks.length > 0 ? footerLinks : defaultLinks;
---

<footer class="bg-slate-50 border-t border-slate-200 py-12">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-8 md:grid-cols-[1.2fr_0.8fr_0.8fr]">
      <div>
        <div class="flex items-center gap-3">
          {club.crest_url ? (
            <img src={club.crest_url} alt={club.name} class="w-12 h-12 object-contain" />
          ) : (
            <div
              class="w-12 h-12 rounded-xl flex items-center justify-center text-white font-bold shadow-md"
              style={`background-color: ${club.primary_color}`}
            >
              {club.name.charAt(0)}
            </div>
          )}
          <div>
            <p class="text-sm text-slate-500">Club website</p>
            <p class="text-lg font-semibold text-slate-900 font-display">{club.name}</p>
          </div>
        </div>
        <p class="text-sm text-slate-500 mt-4">&copy; {currentYear} {club.name}. All rights reserved.</p>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-slate-700 uppercase tracking-wide">Quick links</h3>
        <ul class="mt-3 space-y-2 text-sm text-slate-600">
          {links.map((link) => (
            <li>
              <a href={link.href} class="hover:text-slate-900 transition-colors">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-slate-700 uppercase tracking-wide">Contact</h3>
        <div class="mt-3 space-y-2 text-sm text-slate-600">
          {club.contact_email && <p>{club.contact_email}</p>}
          {club.contact_phone && <p>{club.contact_phone}</p>}
          {club.address && <p>{club.address}</p>}
          {!club.contact_email && !club.contact_phone && !club.address && (
            <p>Contact details coming soon.</p>
          )}
        </div>
        <div class="mt-4 flex items-center gap-2 text-slate-500 text-sm">
          <span>Powered by</span>
          <a href="https://clubify.ie" class="text-green-600 hover:text-green-700 font-semibold transition-colors">
            Clubify
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
