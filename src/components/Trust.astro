---
import Section from './Section.astro';

const trustPoints = [
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
    </svg>`,
    title: "GDPR Compliant",
    description: "Built with privacy by design. Full GDPR compliance for handling member data."
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
    </svg>`,
    title: "Secure by Default",
    description: "Enterprise-grade security. SSL encryption, secure authentication, and regular audits."
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
    </svg>`,
    title: "Irish Hosted",
    description: "Data stored in Ireland on Cloudflare's infrastructure. Fast, reliable, and compliant."
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
    </svg>`,
    title: "Audit Trails",
    description: "Complete visibility of who changed what and when. Perfect for club governance."
  }
];
---

<Section id="trust">
  <div class="grid lg:grid-cols-2 gap-16 items-center">
    <!-- Left content -->
    <div>
      <span class="inline-block text-primary-400 font-semibold text-sm uppercase tracking-wider mb-4">Built for Trust</span>
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-6">
        Security and governance built in from day one
      </h2>
      <p class="text-lg text-slate-400 mb-8">
        GAA clubs handle sensitive information. Clubify is built with the security, compliance, and governance features your club needs to operate with confidence.
      </p>

      <!-- Trust points -->
      <div class="grid sm:grid-cols-2 gap-6">
        {trustPoints.map((point) => (
          <div class="flex gap-4">
            <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-primary-500/10 border border-primary-500/20 flex items-center justify-center text-primary-400">
              <Fragment set:html={point.icon} />
            </div>
            <div>
              <h3 class="font-semibold text-white mb-1">{point.title}</h3>
              <p class="text-sm text-slate-400">{point.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Right visual -->
    <div class="relative">
      <div class="absolute inset-0 bg-gradient-to-r from-primary-500/20 to-accent-500/20 rounded-3xl blur-3xl"></div>
      <div class="relative bg-slate-800/50 rounded-2xl border border-slate-700/50 p-8">
        <!-- Shield illustration -->
        <div class="flex items-center justify-center mb-8">
          <div class="relative">
            <div class="w-32 h-32 rounded-full bg-gradient-to-br from-primary-500/20 to-primary-600/20 flex items-center justify-center">
              <div class="w-24 h-24 rounded-full bg-gradient-to-br from-primary-500/30 to-primary-600/30 flex items-center justify-center">
                <svg class="w-12 h-12 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
              </div>
            </div>
            <!-- Animated ring -->
            <div class="absolute inset-0 rounded-full border-2 border-primary-500/30 animate-ping" style="animation-duration: 3s;"></div>
          </div>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-3 gap-4 text-center">
          <div>
            <div class="text-2xl font-bold text-white">256-bit</div>
            <div class="text-xs text-slate-400 uppercase tracking-wider">SSL Encryption</div>
          </div>
          <div>
            <div class="text-2xl font-bold text-white">99.9%</div>
            <div class="text-xs text-slate-400 uppercase tracking-wider">Uptime SLA</div>
          </div>
          <div>
            <div class="text-2xl font-bold text-white">24/7</div>
            <div class="text-xs text-slate-400 uppercase tracking-wider">Monitoring</div>
          </div>
        </div>

        <!-- Compliance badges -->
        <div class="flex items-center justify-center gap-4 mt-8 pt-6 border-t border-slate-700/50">
          <div class="px-3 py-1.5 rounded-full bg-slate-700/50 text-xs text-slate-300 font-medium">GDPR</div>
          <div class="px-3 py-1.5 rounded-full bg-slate-700/50 text-xs text-slate-300 font-medium">ISO 27001</div>
          <div class="px-3 py-1.5 rounded-full bg-slate-700/50 text-xs text-slate-300 font-medium">SOC 2</div>
        </div>
      </div>
    </div>
  </div>
</Section>
