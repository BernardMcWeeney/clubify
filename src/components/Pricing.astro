---
const features = [
  { name: "Custom club website", included: true },
  { name: "Mobile-responsive design", included: true },
  { name: "3 professional templates", included: true },
  { name: "Fixtures & results management", included: true },
  { name: "News & posts with rich editor", included: true },
  { name: "Media library (up to 5GB)", included: true },
  { name: "Social media publishing", included: true },
  { name: "Unlimited team member accounts", included: true },
  { name: "Contact forms & inbox", included: true },
  { name: "Sponsor showcase", included: true },
  { name: "SSL certificate included", included: true },
  { name: "Free yourclub.clubify.ie domain", included: true },
  { name: "Custom domain support", included: true },
  { name: "GDPR compliant", included: true },
  { name: "Priority email support", included: true },
];
---

<section id="pricing" class="py-24 bg-gradient-to-b from-slate-50 to-white">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-16">
      <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-semibold bg-accent-100 text-accent-700 mb-4">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        Simple Pricing
      </span>
      <h2 class="text-4xl font-bold text-slate-900 mb-4">One Plan. Everything Included.</h2>
      <p class="text-xl text-slate-600 max-w-2xl mx-auto">
        Professional club websites without the complexity. Start with a free trial, then choose what works for you.
      </p>
    </div>

    <!-- Pricing Cards -->
    <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
      <!-- Monthly -->
      <div class="relative bg-white rounded-3xl border border-slate-200 shadow-lg overflow-hidden">
        <div class="p-8">
          <h3 class="text-xl font-bold text-slate-900 mb-1">Monthly</h3>
          <p class="text-slate-500 text-sm mb-6">Flexible month-to-month billing</p>
          <div class="flex items-baseline gap-1 mb-6">
            <span class="text-5xl font-black text-slate-900">€50</span>
            <span class="text-slate-500">/month</span>
          </div>
          <a
            href="/admin/signup"
            class="block w-full py-3.5 px-6 bg-slate-900 hover:bg-slate-800 text-white text-center font-semibold rounded-xl transition-colors"
          >
            Start 7-day free trial
          </a>
          <p class="text-center text-slate-500 text-xs mt-3">
            No credit card required to start
          </p>
        </div>
      </div>

      <!-- Annual -->
      <div class="relative">
        <!-- Best value badge -->
        <div class="absolute -top-4 left-1/2 -translate-x-1/2 z-10">
          <span class="inline-flex items-center gap-1.5 px-4 py-1.5 bg-primary-600 text-white text-sm font-semibold rounded-full shadow-lg shadow-primary-600/30">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M5 2a1 1 0 011 1v1h1a1 1 0 010 2H6v1a1 1 0 01-2 0V6H3a1 1 0 010-2h1V3a1 1 0 011-1zm0 10a1 1 0 011 1v1h1a1 1 0 110 2H6v1a1 1 0 11-2 0v-1H3a1 1 0 110-2h1v-1a1 1 0 011-1zM12 2a1 1 0 01.967.744L14.146 7.2 17.5 9.134a1 1 0 010 1.732l-3.354 1.935-1.18 4.455a1 1 0 01-1.933 0L9.854 12.8 6.5 10.866a1 1 0 010-1.732l3.354-1.935 1.18-4.455A1 1 0 0112 2z" clip-rule="evenodd"/>
            </svg>
            Save €100/year
          </span>
        </div>

        <div class="bg-white rounded-3xl border-2 border-primary-200 shadow-xl shadow-primary-100/50 overflow-hidden">
          <div class="p-8">
            <h3 class="text-xl font-bold text-slate-900 mb-1">Annual</h3>
            <p class="text-slate-500 text-sm mb-6">Best value - 2 months free</p>
            <div class="flex items-baseline gap-2 mb-2">
              <span class="text-5xl font-black text-primary-600">€500</span>
              <span class="text-slate-500">/year</span>
            </div>
            <p class="text-sm text-slate-500 mb-6">
              <span class="line-through">€600</span> · That's just €41.67/month
            </p>
            <a
              href="/admin/signup"
              class="block w-full py-3.5 px-6 bg-gradient-to-r from-primary-500 to-primary-600 hover:from-primary-600 hover:to-primary-700 text-white text-center font-semibold rounded-xl transition-all shadow-lg shadow-primary-500/25"
            >
              Start 7-day free trial
            </a>
            <p class="text-center text-slate-500 text-xs mt-3">
              No credit card required to start
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Features list -->
    <div class="mt-16 max-w-3xl mx-auto">
      <h4 class="text-center text-lg font-semibold text-slate-900 mb-8">Everything included in your subscription</h4>
      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-4">
        {features.map((feature) => (
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-primary-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            <span class="text-slate-700 text-sm">{feature.name}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Trial note -->
    <div class="mt-12 text-center p-6 bg-primary-50 rounded-2xl border border-primary-100 max-w-2xl mx-auto">
      <h4 class="font-bold text-slate-900 mb-2">7-Day Free Trial</h4>
      <p class="text-slate-600 text-sm">
        Try Clubify risk-free for 7 days. No credit card required to start.
        Set up your club, explore all features, and see the difference before you commit.
      </p>
    </div>
  </div>
</section>
