---
const keyFeatures = [
  "Custom club website with your branding",
  "Fixtures, results & news management",
  "Social media auto-publishing",
  "Unlimited team members",
  "Media library & sponsor showcase",
  "Priority email support"
];
---

<section id="pricing" class="py-24 bg-gradient-to-b from-slate-50 to-white">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-12">
      <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-semibold bg-accent-100 text-accent-700 mb-4">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        Simple Pricing
      </span>
      <h2 class="text-4xl font-bold text-slate-900 mb-4">Everything your club needs</h2>
      <p class="text-xl text-slate-600 max-w-2xl mx-auto">
        One plan, all features included. No hidden fees.
      </p>
    </div>

    <!-- Value comparison -->
    <div class="mb-10 max-w-2xl mx-auto">
      <div class="bg-slate-900 text-white rounded-2xl p-5 flex flex-col sm:flex-row items-center justify-between gap-4">
        <p class="text-lg font-semibold">Save thousands vs. hiring a developer</p>
        <div class="flex items-center gap-4 text-sm">
          <div class="text-center">
            <p class="text-slate-400 text-xs">DIY Website</p>
            <p class="text-lg font-bold text-red-400">€2,000+</p>
          </div>
          <svg class="w-5 h-5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
          </svg>
          <div class="text-center">
            <p class="text-slate-400 text-xs">Clubify</p>
            <p class="text-lg font-bold text-green-400">€500/yr</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Pricing Card -->
    <div class="max-w-lg mx-auto">
      <!-- Billing Toggle -->
      <div class="flex items-center justify-center gap-4 mb-6">
        <span id="monthly-label" class="text-sm font-medium text-slate-500">Monthly</span>
        <button
          id="billing-toggle"
          type="button"
          class="relative inline-flex h-7 w-14 items-center rounded-full bg-primary-600 transition-colors"
          role="switch"
          aria-checked="true"
        >
          <span class="sr-only">Toggle billing period</span>
          <span
            id="toggle-dot"
            class="inline-block h-5 w-5 transform rounded-full bg-white shadow-lg transition-transform translate-x-8"
          ></span>
        </button>
        <span id="annual-label" class="text-sm font-semibold text-slate-900">
          Annual
          <span class="ml-1.5 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-700">
            Save €100
          </span>
        </span>
      </div>

      <!-- Card -->
      <div class="relative bg-white rounded-3xl border-2 border-primary-500 shadow-xl overflow-hidden">
        <!-- Badge -->
        <div class="absolute top-0 right-0">
          <div class="bg-primary-600 text-white text-xs font-semibold px-4 py-1.5 rounded-bl-xl">
            7-day free trial
          </div>
        </div>

        <div class="p-8 pt-10">
          <!-- Price -->
          <div class="text-center mb-8">
            <div class="flex items-baseline justify-center gap-2">
              <span id="price-amount" class="text-6xl font-black text-slate-900">€500</span>
              <span id="price-period" class="text-xl text-slate-500">/year</span>
            </div>
            <p id="price-subtext" class="text-sm text-slate-500 mt-2">
              Just €41.67/month · <span class="line-through">€600</span>
            </p>
          </div>

          <!-- Features -->
          <ul class="space-y-4 mb-8">
            {keyFeatures.map((feature) => (
              <li class="flex items-start gap-3">
                <div class="flex-shrink-0 w-6 h-6 rounded-full bg-primary-100 flex items-center justify-center">
                  <svg class="w-4 h-4 text-primary-600" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                </div>
                <span class="text-slate-700">{feature}</span>
              </li>
            ))}
          </ul>

          <!-- CTA -->
          <a
            href="/admin/signup"
            class="block w-full py-4 px-6 bg-gradient-to-r from-primary-500 to-primary-600 hover:from-primary-600 hover:to-primary-700 text-white text-center text-lg font-semibold rounded-xl transition-all shadow-lg shadow-primary-500/25 hover:shadow-primary-500/40"
          >
            Start your free trial
          </a>

          <p class="text-center text-sm text-slate-500 mt-4">
            No credit card required
          </p>
        </div>
      </div>
    </div>

    <!-- Bottom CTA -->
    <div class="mt-12 text-center">
      <p class="text-slate-600 mb-2">Questions about pricing?</p>
      <a href="/contact" class="text-primary-600 font-semibold hover:text-primary-700 inline-flex items-center gap-1">
        Contact us
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggle = document.getElementById('billing-toggle');
    const toggleDot = document.getElementById('toggle-dot');
    const monthlyLabel = document.getElementById('monthly-label');
    const annualLabel = document.getElementById('annual-label');
    const priceAmount = document.getElementById('price-amount');
    const pricePeriod = document.getElementById('price-period');
    const priceSubtext = document.getElementById('price-subtext');

    let isAnnual = true;

    function updatePricing() {
      if (isAnnual) {
        toggleDot?.classList.remove('translate-x-1');
        toggleDot?.classList.add('translate-x-8');
        monthlyLabel?.classList.remove('text-slate-900', 'font-semibold');
        monthlyLabel?.classList.add('text-slate-500', 'font-medium');
        annualLabel?.classList.remove('text-slate-500');
        annualLabel?.classList.add('text-slate-900');
        if (priceAmount) priceAmount.textContent = '€500';
        if (pricePeriod) pricePeriod.textContent = '/year';
        if (priceSubtext) priceSubtext.innerHTML = 'Just €41.67/month · <span class="line-through">€600</span>';
      } else {
        toggleDot?.classList.remove('translate-x-8');
        toggleDot?.classList.add('translate-x-1');
        monthlyLabel?.classList.remove('text-slate-500', 'font-medium');
        monthlyLabel?.classList.add('text-slate-900', 'font-semibold');
        annualLabel?.classList.remove('text-slate-900');
        annualLabel?.classList.add('text-slate-500');
        if (priceAmount) priceAmount.textContent = '€50';
        if (pricePeriod) pricePeriod.textContent = '/month';
        if (priceSubtext) priceSubtext.innerHTML = 'Flexible, cancel anytime';
      }
    }

    toggle?.addEventListener('click', () => {
      isAnnual = !isAnnual;
      toggle.setAttribute('aria-checked', isAnnual.toString());
      updatePricing();
    });
  });
</script>
