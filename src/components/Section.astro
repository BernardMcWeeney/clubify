---
interface Props {
  id?: string;
  class?: string;
  container?: boolean;
}

const { id, class: className = '', container = true } = Astro.props;
---

<section id={id} class={`py-20 md:py-28 ${className}`}>
  {container ? (
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <slot />
    </div>
  ) : (
    <slot />
  )}
</section>
