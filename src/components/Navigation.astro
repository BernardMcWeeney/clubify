---
import Button from './Button.astro';
import { getAllSports, getReadySports, getComingSoonSports } from '../lib/sports';

const readySports = getReadySports();
const comingSoonSports = getComingSoonSports();

// Platform features for mega menu
const platformFeatures = [
  {
    title: 'Website & App',
    description: 'Professional club website with matching mobile app',
    icon: 'globe',
    href: '/features#website'
  },
  {
    title: 'Fixtures & Results',
    description: 'Manage matches, scores, and league tables',
    icon: 'calendar',
    href: '/features#fixtures'
  },
  {
    title: 'News Publishing',
    description: 'Share updates with your members instantly',
    icon: 'newspaper',
    href: '/features#news'
  },
  {
    title: 'Social Integration',
    description: 'Auto-post to Facebook, Instagram & Twitter',
    icon: 'share',
    href: '/features#social'
  },
  {
    title: 'Team Management',
    description: 'Organize teams, roles, and permissions',
    icon: 'users',
    href: '/features#teams'
  },
  {
    title: 'Push Notifications',
    description: 'Keep members informed with instant alerts',
    icon: 'bell',
    href: '/features#notifications'
  },
  {
    title: 'Media Library',
    description: 'Store and share photos and videos',
    icon: 'image',
    href: '/features#media'
  },
  {
    title: 'Contact Forms',
    description: 'Capture inquiries and manage responses',
    icon: 'message',
    href: '/features#forms'
  }
];

// Resources for mega menu
const resources = [
  { title: 'Help Centre', description: 'Guides and tutorials', href: '/help', icon: 'help-circle' },
  { title: 'Blog', description: 'Latest updates and tips', href: '/blog', icon: 'book-open' },
  { title: 'Contact Us', description: 'Get in touch with our team', href: '/contact', icon: 'mail' },
  { title: 'Status', description: 'System uptime and status', href: '/status', icon: 'activity' }
];

// Icon SVGs
const icons: Record<string, string> = {
  'globe': '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 21a9 9 0 100-18 9 9 0 000 18z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.6 9h16.8M3.6 15h16.8M12 3c2.5 2.5 3.5 5.5 3.5 9s-1 6.5-3.5 9c-2.5-2.5-3.5-5.5-3.5-9s1-6.5 3.5-9z"/>',
  'calendar': '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>',
  'newspaper': '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 12h6"/>',
  'share': '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>',
  'users': '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>',
  'bell': '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>',
  'image': '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>',
  'message': '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>',
  'help-circle': '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>',
  'book-open': '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>',
  'mail': '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>',
  'activity': '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M22 12h-4l-3 9L9 3l-3 9H2"/>'
};
---

<nav class="fixed top-0 left-0 right-0 z-50 transition-all duration-300" id="navbar">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-20 items-center justify-between">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="relative">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-primary-500 to-primary-600 flex items-center justify-center shadow-lg shadow-primary-500/25 group-hover:shadow-primary-500/40 transition-shadow">
            <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z" fill="currentColor" opacity="0.3"/>
              <path d="M12 6c-3.31 0-6 2.69-6 6s2.69 6 6 6 6-2.69 6-6-2.69-6-6-6zm0 10c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4z" fill="currentColor"/>
              <circle cx="12" cy="12" r="2" fill="currentColor"/>
            </svg>
          </div>
        </div>
        <span class="text-xl font-bold text-slate-900">Clubify</span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-1">
        <!-- Platform Dropdown -->
        <div class="relative" id="platform-dropdown">
          <button
            class="flex items-center gap-1.5 px-4 py-2 text-slate-600 hover:text-slate-900 transition-colors font-medium rounded-lg hover:bg-slate-100/50"
            id="platform-dropdown-btn"
            aria-expanded="false"
            aria-haspopup="true"
          >
            Platform
            <svg class="w-4 h-4 transition-transform duration-200 dropdown-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <!-- Platform Mega Menu -->
          <div
            class="absolute left-0 top-full pt-4 opacity-0 invisible transition-all duration-200 mega-menu"
            id="platform-dropdown-menu"
          >
            <div class="w-[580px] bg-white rounded-2xl shadow-2xl border border-slate-200/80 overflow-hidden">
              <div class="grid grid-cols-2 gap-px bg-slate-100">
                {platformFeatures.map((feature) => (
                  <a
                    href={feature.href}
                    class="flex items-start gap-4 p-5 bg-white hover:bg-slate-50 transition-colors group/item"
                  >
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-primary-50 to-primary-100 flex items-center justify-center flex-shrink-0 group-hover/item:from-primary-100 group-hover/item:to-primary-200 transition-colors">
                      <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={icons[feature.icon]} />
                    </div>
                    <div class="flex-1 min-w-0">
                      <span class="font-semibold text-slate-900 block mb-0.5">{feature.title}</span>
                      <span class="text-sm text-slate-500 line-clamp-2">{feature.description}</span>
                    </div>
                  </a>
                ))}
              </div>
              <div class="px-5 py-4 bg-slate-50 border-t border-slate-100 flex items-center justify-between">
                <span class="text-sm text-slate-500">Everything your club needs in one place</span>
                <a href="/features" class="text-sm font-semibold text-primary-600 hover:text-primary-700 flex items-center gap-1">
                  See all features
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Sports Dropdown -->
        <div class="relative" id="sports-dropdown">
          <button
            class="flex items-center gap-1.5 px-4 py-2 text-slate-600 hover:text-slate-900 transition-colors font-medium rounded-lg hover:bg-slate-100/50"
            id="sports-dropdown-btn"
            aria-expanded="false"
            aria-haspopup="true"
          >
            Sports
            <svg class="w-4 h-4 transition-transform duration-200 dropdown-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <!-- Sports Mega Menu -->
          <div
            class="absolute left-0 top-full pt-4 opacity-0 invisible transition-all duration-200 mega-menu"
            id="sports-dropdown-menu"
          >
            <div class="w-[420px] bg-white rounded-2xl shadow-2xl border border-slate-200/80 overflow-hidden">
              <div class="p-5">
                <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-4">Available Now</p>
                <div class="grid grid-cols-3 gap-3">
                  {readySports.map((sport) => (
                    <a
                      href={`/sports/${sport.slug}`}
                      class="flex flex-col items-center gap-2 p-4 rounded-xl border border-slate-200 hover:border-primary-200 hover:bg-primary-50/50 transition-all group/sport"
                    >
                      <div
                        class="w-12 h-12 rounded-xl flex items-center justify-center text-white text-lg font-bold shadow-lg"
                        style={`background: linear-gradient(135deg, ${sport.primaryColor}, ${sport.primaryColor}dd)`}
                      >
                        {sport.name.charAt(0)}
                      </div>
                      <span class="font-medium text-slate-900 text-sm">{sport.name}</span>
                      <span class="text-xs font-medium text-primary-600 bg-primary-100 px-2 py-0.5 rounded-full">Live</span>
                    </a>
                  ))}
                </div>
              </div>

              {comingSoonSports.length > 0 && (
                <div class="px-5 pb-5">
                  <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">Coming Soon</p>
                  <div class="flex flex-wrap gap-2">
                    {comingSoonSports.map((sport) => (
                      <a
                        href={`/sports/${sport.slug}`}
                        class="flex items-center gap-2 px-3 py-2 rounded-lg bg-slate-50 hover:bg-slate-100 transition-colors"
                      >
                        <div
                          class="w-6 h-6 rounded-md flex items-center justify-center text-white text-xs font-bold opacity-80"
                          style={`background-color: ${sport.primaryColor}`}
                        >
                          {sport.name.charAt(0)}
                        </div>
                        <span class="text-sm font-medium text-slate-600">{sport.name}</span>
                      </a>
                    ))}
                  </div>
                </div>
              )}

              <div class="px-5 py-4 bg-slate-50 border-t border-slate-100 flex items-center justify-between">
                <span class="text-sm text-slate-500">Don't see your sport?</span>
                <a href="/contact" class="text-sm font-semibold text-primary-600 hover:text-primary-700 flex items-center gap-1">
                  Let us know
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>

        <a href="/templates" class="px-4 py-2 text-slate-600 hover:text-slate-900 transition-colors font-medium rounded-lg hover:bg-slate-100/50">Templates</a>
        <a href="/pricing" class="px-4 py-2 text-slate-600 hover:text-slate-900 transition-colors font-medium rounded-lg hover:bg-slate-100/50">Pricing</a>

        <!-- Resources Dropdown -->
        <div class="relative" id="resources-dropdown">
          <button
            class="flex items-center gap-1.5 px-4 py-2 text-slate-600 hover:text-slate-900 transition-colors font-medium rounded-lg hover:bg-slate-100/50"
            id="resources-dropdown-btn"
            aria-expanded="false"
            aria-haspopup="true"
          >
            Resources
            <svg class="w-4 h-4 transition-transform duration-200 dropdown-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <!-- Resources Dropdown Menu -->
          <div
            class="absolute right-0 top-full pt-4 opacity-0 invisible transition-all duration-200 mega-menu"
            id="resources-dropdown-menu"
          >
            <div class="w-72 bg-white rounded-2xl shadow-2xl border border-slate-200/80 py-2 overflow-hidden">
              {resources.map((item) => (
                <a
                  href={item.href}
                  class="flex items-center gap-3 px-4 py-3 hover:bg-slate-50 transition-colors"
                >
                  <div class="w-9 h-9 rounded-lg bg-slate-100 flex items-center justify-center">
                    <svg class="w-5 h-5 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={icons[item.icon]} />
                  </div>
                  <div>
                    <span class="font-medium text-slate-900 block">{item.title}</span>
                    <span class="text-sm text-slate-500">{item.description}</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- CTA Buttons -->
      <div class="hidden lg:flex items-center gap-3">
        <a href="/admin/login" class="text-slate-600 hover:text-slate-900 transition-colors font-medium px-4 py-2 rounded-lg hover:bg-slate-100/50">
          Log in
        </a>
        <Button href="/admin/signup" variant="primary" size="md">
          Create your club
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </Button>
      </div>

      <!-- Mobile Menu Button -->
      <button class="lg:hidden p-2.5 text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-lg transition-colors" id="mobile-menu-btn" aria-label="Toggle menu">
        <svg class="w-6 h-6 menu-open" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg class="w-6 h-6 menu-close hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div class="hidden lg:hidden fixed inset-0 top-20 bg-white/98 backdrop-blur-lg z-40 overflow-y-auto" id="mobile-menu">
    <div class="px-4 py-6 max-w-lg mx-auto">
      <!-- Platform Section -->
      <div class="mb-6">
        <button class="flex items-center justify-between w-full py-2 text-left" id="mobile-platform-toggle">
          <span class="text-sm font-semibold text-slate-500 uppercase tracking-wider">Platform</span>
          <svg class="w-5 h-5 text-slate-500 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="grid grid-cols-2 gap-2 mt-3" id="mobile-platform-content">
          {platformFeatures.slice(0, 4).map((feature) => (
            <a
              href={feature.href}
              class="flex items-center gap-3 p-3 rounded-xl bg-slate-50 hover:bg-slate-100 transition-colors"
            >
              <div class="w-8 h-8 rounded-lg bg-primary-100 flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={icons[feature.icon]} />
              </div>
              <span class="font-medium text-slate-700 text-sm">{feature.title}</span>
            </a>
          ))}
        </div>
        <a href="/features" class="flex items-center gap-1 mt-3 text-sm font-semibold text-primary-600">
          See all features
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <!-- Sports Section -->
      <div class="mb-6">
        <p class="text-sm font-semibold text-slate-400 uppercase tracking-wider py-2">Sports</p>
        <div class="grid grid-cols-3 gap-2 mt-2">
          {readySports.map((sport) => (
            <a
              href={`/sports/${sport.slug}`}
              class="flex flex-col items-center gap-2 p-3 rounded-xl bg-slate-50 hover:bg-slate-100 transition-colors"
            >
              <div
                class="w-10 h-10 rounded-lg flex items-center justify-center text-white text-sm font-bold"
                style={`background-color: ${sport.primaryColor}`}
              >
                {sport.name.charAt(0)}
              </div>
              <span class="text-xs font-medium text-slate-700">{sport.name}</span>
            </a>
          ))}
        </div>
        {comingSoonSports.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-3">
            {comingSoonSports.slice(0, 4).map((sport) => (
              <a
                href={`/sports/${sport.slug}`}
                class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-slate-100 text-slate-600 text-sm"
              >
                {sport.name}
                <span class="text-xs text-amber-600">Soon</span>
              </a>
            ))}
          </div>
        )}
        <a href="/sports" class="flex items-center gap-1 mt-3 text-sm font-semibold text-primary-600">
          View all sports
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <hr class="border-slate-200 my-4" />

      <!-- Main Links -->
      <div class="space-y-1">
        <a href="/templates" class="flex items-center justify-between py-3 px-2 text-slate-700 hover:text-slate-900 font-medium rounded-lg hover:bg-slate-50 transition-colors">
          Templates
          <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
        <a href="/pricing" class="flex items-center justify-between py-3 px-2 text-slate-700 hover:text-slate-900 font-medium rounded-lg hover:bg-slate-50 transition-colors">
          Pricing
          <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
        <a href="/help" class="flex items-center justify-between py-3 px-2 text-slate-700 hover:text-slate-900 font-medium rounded-lg hover:bg-slate-50 transition-colors">
          Help Centre
          <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
        <a href="/contact" class="flex items-center justify-between py-3 px-2 text-slate-700 hover:text-slate-900 font-medium rounded-lg hover:bg-slate-50 transition-colors">
          Contact
          <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <hr class="border-slate-200 my-4" />

      <!-- Auth Section -->
      <div class="space-y-3">
        <a href="/admin/login" class="block w-full py-3 px-4 text-center text-slate-700 font-medium rounded-xl border border-slate-200 hover:bg-slate-50 transition-colors">
          Log in
        </a>
        <Button href="/admin/signup" variant="primary" size="lg" class="w-full justify-center">
          Create your club
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </Button>
      </div>
    </div>
  </div>
</nav>

<script>
  // Navbar state
  const navbar = document.getElementById('navbar');
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  // Dropdown elements
  const dropdowns = ['platform', 'sports', 'resources'].map(name => ({
    container: document.getElementById(`${name}-dropdown`),
    btn: document.getElementById(`${name}-dropdown-btn`),
    menu: document.getElementById(`${name}-dropdown-menu`)
  }));

  // Navbar scroll effect
  const handleScroll = () => {
    if (window.scrollY > 20) {
      navbar?.classList.add('bg-white/95', 'backdrop-blur-lg', 'shadow-sm', 'border-b', 'border-slate-200/50');
    } else {
      navbar?.classList.remove('bg-white/95', 'backdrop-blur-lg', 'shadow-sm', 'border-b', 'border-slate-200/50');
    }
  };

  window.addEventListener('scroll', handleScroll);
  handleScroll(); // Check initial state

  // Mobile menu toggle
  mobileMenuBtn?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.contains('hidden');
    mobileMenu?.classList.toggle('hidden');
    mobileMenuBtn.querySelector('.menu-open')?.classList.toggle('hidden');
    mobileMenuBtn.querySelector('.menu-close')?.classList.toggle('hidden');

    // Prevent body scroll when menu is open
    document.body.style.overflow = isOpen ? 'hidden' : '';
  });

  // Close mobile menu on link click
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      mobileMenuBtn?.querySelector('.menu-open')?.classList.remove('hidden');
      mobileMenuBtn?.querySelector('.menu-close')?.classList.add('hidden');
      document.body.style.overflow = '';
    });
  });

  // Desktop dropdown handling
  const isTouchDevice = 'ontouchstart' in window || navigator.maxTouchPoints > 0;

  dropdowns.forEach(({ container, btn, menu }) => {
    if (!container || !btn || !menu) return;

    const showMenu = () => {
      menu.classList.remove('opacity-0', 'invisible');
      menu.classList.add('opacity-100', 'visible');
      btn.setAttribute('aria-expanded', 'true');
      btn.querySelector('.dropdown-icon')?.classList.add('rotate-180');
    };

    const hideMenu = () => {
      menu.classList.add('opacity-0', 'invisible');
      menu.classList.remove('opacity-100', 'visible');
      btn.setAttribute('aria-expanded', 'false');
      btn.querySelector('.dropdown-icon')?.classList.remove('rotate-180');
    };

    if (isTouchDevice) {
      let startX = 0;
      let startY = 0;
      let moved = false;

      const toggleMenu = () => {
        const isOpen = btn.getAttribute('aria-expanded') === 'true';

        // Close all other dropdowns first
        dropdowns.forEach(({ btn: otherBtn, menu: otherMenu }) => {
          if (otherBtn !== btn && otherMenu) {
            otherMenu.classList.add('opacity-0', 'invisible');
            otherMenu.classList.remove('opacity-100', 'visible');
            otherBtn?.setAttribute('aria-expanded', 'false');
            otherBtn?.querySelector('.dropdown-icon')?.classList.remove('rotate-180');
          }
        });

        if (isOpen) {
          hideMenu();
        } else {
          showMenu();
        }
      };

      // Use pointer events so taps still register even after scroll momentum.
      if ('PointerEvent' in window) {
        btn.addEventListener('pointerdown', (e: PointerEvent) => {
          moved = false;
          startX = e.clientX;
          startY = e.clientY;
        });

        btn.addEventListener('pointermove', (e: PointerEvent) => {
          if (moved) return;
          if (Math.abs(e.clientX - startX) > 6 || Math.abs(e.clientY - startY) > 6) {
            moved = true;
          }
        });

        btn.addEventListener('pointerup', (e: PointerEvent) => {
          if (moved) return;
          e.preventDefault();
          e.stopPropagation();
          toggleMenu();
        });

        btn.addEventListener('pointercancel', () => {
          moved = false;
        });

        // Prevent the synthetic click from double-toggling.
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
        });
      } else {
        // Fallback: click to toggle
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          toggleMenu();
        });
      }
    } else {
      // Desktop: hover to show
      container.addEventListener('mouseenter', showMenu);
      container.addEventListener('mouseleave', hideMenu);
    }
  });

  // Close dropdowns when clicking outside (touch devices)
  if (isTouchDevice) {
    document.addEventListener('click', (e) => {
      dropdowns.forEach(({ container, btn, menu }) => {
        if (container && !container.contains(e.target as Node)) {
          menu?.classList.add('opacity-0', 'invisible');
          menu?.classList.remove('opacity-100', 'visible');
          btn?.setAttribute('aria-expanded', 'false');
          btn?.querySelector('.dropdown-icon')?.classList.remove('rotate-180');
        }
      });
    });
  }

  // Keyboard navigation
  dropdowns.forEach(({ btn, menu }) => {
    btn?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        const isOpen = btn.getAttribute('aria-expanded') === 'true';
        if (isOpen) {
          menu?.classList.add('opacity-0', 'invisible');
          menu?.classList.remove('opacity-100', 'visible');
          btn.setAttribute('aria-expanded', 'false');
        } else {
          menu?.classList.remove('opacity-0', 'invisible');
          menu?.classList.add('opacity-100', 'visible');
          btn.setAttribute('aria-expanded', 'true');
        }
      }
      if (e.key === 'Escape') {
        menu?.classList.add('opacity-0', 'invisible');
        menu?.classList.remove('opacity-100', 'visible');
        btn.setAttribute('aria-expanded', 'false');
        btn.focus();
      }
    });
  });
</script>

<style>
  .mega-menu {
    transform-origin: top center;
  }

  .mega-menu.visible {
    animation: menuEnter 0.2s ease-out forwards;
  }

  @keyframes menuEnter {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  #resources-dropdown-menu {
    transform-origin: top right;
  }

  #resources-dropdown-menu.visible {
    animation: menuEnterRight 0.2s ease-out forwards;
  }

  @keyframes menuEnterRight {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
