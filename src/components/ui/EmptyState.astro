---
interface Props {
  /** Icon to display (slot name: icon) */
  title: string;
  /** Description text */
  description?: string;
  /** Additional CSS classes */
  class?: string;
}

const {
  title,
  description,
  class: className = '',
} = Astro.props;
---

<div class:list={['rounded-2xl border border-slate-200 p-12 text-center shadow-sm', className]}>
  <div class="flex justify-center mb-4">
    <div class="w-16 h-16 rounded-full bg-slate-100 flex items-center justify-center">
      <slot name="icon">
        <svg class="w-8 h-8 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
        </svg>
      </slot>
    </div>
  </div>

  <h3 class="text-lg font-semibold text-slate-900 mb-2">{title}</h3>

  {description && (
    <p class="text-slate-500 mb-6 max-w-md mx-auto">{description}</p>
  )}

  <slot name="action" />
</div>
