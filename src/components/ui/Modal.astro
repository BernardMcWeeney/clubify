---
interface Props {
  /** Modal ID for targeting with JS */
  id: string;
  /** Modal title */
  title: string;
  /** Modal description */
  description?: string;
  /** Max width */
  maxWidth?: 'sm' | 'md' | 'lg' | 'xl';
  /** Show close button */
  showClose?: boolean;
}

const {
  id,
  title,
  description,
  maxWidth = 'md',
  showClose = true,
} = Astro.props;

const maxWidthClasses = {
  sm: 'max-w-sm',
  md: 'max-w-md',
  lg: 'max-w-lg',
  xl: 'max-w-xl',
};
---

<div
  id={id}
  class="hidden fixed inset-0 z-50 overflow-y-auto"
  aria-labelledby={`${id}-title`}
  role="dialog"
  aria-modal="true"
>
  <!-- Backdrop -->
  <div class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm transition-opacity" data-modal-backdrop></div>

  <!-- Modal positioning -->
  <div class="flex min-h-full items-center justify-center p-4">
    <!-- Modal content -->
    <div class:list={[
      'relative bg-white rounded-2xl shadow-xl border border-slate-200 w-full',
      maxWidthClasses[maxWidth]
    ]}>
      <!-- Header -->
      <div class="flex items-start justify-between p-6 border-b border-slate-200">
        <div>
          <h3 id={`${id}-title`} class="text-lg font-semibold text-slate-900">{title}</h3>
          {description && (
            <p class="mt-1 text-sm text-slate-500">{description}</p>
          )}
        </div>
        {showClose && (
          <button
            type="button"
            class="p-2 text-slate-400 hover:text-slate-600 hover:bg-slate-100 rounded-lg transition-colors"
            data-modal-close
            aria-label="Close modal"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        )}
      </div>

      <!-- Body -->
      <div class="p-6">
        <slot />
      </div>

      <!-- Footer (optional) -->
      <slot name="footer" />
    </div>
  </div>
</div>

<script define:vars={{ id }}>
  // Simple modal controller
  const modal = document.getElementById(id);
  if (modal) {
    const backdrop = modal.querySelector('[data-modal-backdrop]');
    const closeButtons = modal.querySelectorAll('[data-modal-close]');

    // Close handlers
    const close = () => modal.classList.add('hidden');

    backdrop?.addEventListener('click', close);
    closeButtons.forEach(btn => btn.addEventListener('click', close));

    // Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        close();
      }
    });

    // Expose open/close methods globally
    window[`${id}Modal`] = {
      open: () => modal.classList.remove('hidden'),
      close,
    };
  }
</script>
