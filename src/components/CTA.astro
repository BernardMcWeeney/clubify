---
import Section from './Section.astro';
import Button from './Button.astro';
---

<Section class="relative overflow-hidden">
  <!-- Background gradient -->
  <div class="absolute inset-0 bg-gradient-to-r from-primary-600 to-primary-500"></div>

  <!-- Pattern overlay -->
  <div class="absolute inset-0 opacity-10">
    <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="cta-pattern" x="0" y="0" width="40" height="40" patternUnits="userSpaceOnUse">
          <circle cx="20" cy="20" r="1" fill="white"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#cta-pattern)"/>
    </svg>
  </div>

  <!-- Content -->
  <div class="relative text-center">
    <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white mb-6">
      Ready to launch your club?
    </h2>
    <p class="text-lg text-white/80 max-w-2xl mx-auto mb-10">
      Join the growing number of GAA clubs using Clubify. Get your website and app live today.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <Button href="/admin/signup" variant="secondary" size="lg" class="bg-white text-primary-600 hover:bg-white/90 border-white">
        Create your club
        <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
        </svg>
      </Button>
      <a href="mailto:hello@clubify.ie" class="text-white/80 hover:text-white font-medium flex items-center gap-2 transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
        </svg>
        Or get in touch
      </a>
    </div>

    <!-- Trust note -->
    <p class="mt-10 text-white/60 text-sm">
      Free to get started. No credit card required. Cancel anytime.
    </p>
  </div>
</Section>
